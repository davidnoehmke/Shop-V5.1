{% if collection.handle == 'pflanzenbeleuchtung' %}
  {% assign accessory_collection = collections['pflanzenlicht-zubehor-erganzungen'] %}
  {% if accessory_collection != blank and accessory_collection.products_count > 0 %}
    <section class="led-accessories page-width" aria-labelledby="LedAccessoriesHeading-{{ section.id }}">
      <header class="led-accessories__head">
        <p class="led-accessories__eyebrow">{{ 'led_collection.upsell_eyebrow' | t }}</p>
        <h2 id="LedAccessoriesHeading-{{ section.id }}">{{ 'led_collection.upsell_heading' | t }}</h2>
        <p>{{ 'led_collection.upsell_intro' | t }}</p>
      </header>
      <div class="led-accessories__grid">
        {% for accessory in accessory_collection.products limit: 6 %}
          {% liquid
            assign compatibility = accessory.vendor
            if accessory.title contains 'Sun Mode Pro'
              assign compatibility = 'Venso Sun Mode Pro'
            elsif accessory.title contains 'Alta'
              assign compatibility = 'Soltech Grove'
            elsif accessory.title contains 'Stello'
              assign compatibility = 'Soltech Aspect / Vita'
            elsif accessory.title contains 'Luna'
              assign compatibility = 'Soltech Pendelleuchten'
            elsif accessory.title contains 'Willow'
              assign compatibility = 'Soltech Vita'
            endif
          %}
          <article class="led-accessories__card">
            <a class="led-accessories__media" href="{{ accessory.url }}">
              {% if accessory.featured_image != blank %}
                {{ accessory.featured_image | image_url: width: 520, height: 520, crop: 'center' | image_tag: loading: 'lazy', widths: '240,360,520', sizes: '(max-width: 749px) 42vw, 18vw', alt: accessory.featured_image.alt | default: accessory.title }}
              {% endif %}
            </a>
            <div class="led-accessories__body">
              <span>{{ 'led_collection.upsell_for' | t }} {{ compatibility | escape }}</span>
              <h3><a href="{{ accessory.url }}">{{ accessory.title }}</a></h3>
              <div class="led-accessories__bottom">
                <strong>{{ accessory.price | money }}</strong>
                <a href="{{ accessory.url }}">{{ 'led_collection.upsell_details' | t }} <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
      <p class="led-accessories__note">{{ 'led_collection.upsell_note' | t }}</p>
    </section>
  {% endif %}
{% endif %}

{% stylesheet %}
.led-accessories{padding-block:clamp(3rem,7vw,6rem);border-top:1px solid var(--border)}
.led-accessories__head{max-width:820px;margin-bottom:1.4rem}
.led-accessories__eyebrow{margin:0 0 .6rem;color:var(--accent);font-size:.72rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
.led-accessories__head h2{margin:0;font-size:clamp(1.55rem,3vw,2.5rem);line-height:1.12;letter-spacing:-.035em}
.led-accessories__head>p:last-child{color:var(--muted);line-height:1.65}
.led-accessories__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem}
.led-accessories__card{display:grid;grid-template-columns:120px minmax(0,1fr);gap:.85rem;align-items:center;padding:.75rem;border:1px solid var(--border);background:var(--surface)}
.led-accessories__media{aspect-ratio:1;display:grid;place-items:center;background:var(--background)}
.led-accessories__media img{width:100%;height:100%;object-fit:contain;padding:.35rem}
.led-accessories__body{min-width:0}
.led-accessories__body>span{display:inline-block;margin-bottom:.35rem;color:var(--accent);font-size:.62rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase}
.led-accessories__card h3{margin:0;font-size:.88rem;line-height:1.3}
.led-accessories__card h3 a{color:inherit;text-decoration:none}
.led-accessories__bottom{display:flex;align-items:center;justify-content:space-between;gap:.7rem;margin-top:.65rem;padding-top:.55rem;border-top:1px solid var(--border);font-size:.72rem}
.led-accessories__bottom a{color:var(--accent);font-weight:800;text-decoration:none}
.led-accessories__note{margin:.8rem 0 0;color:var(--muted);font-size:.74rem}
@media(max-width:1080px){.led-accessories__grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:749px){.led-accessories__grid{grid-template-columns:1fr}.led-accessories__card{grid-template-columns:92px minmax(0,1fr)}}
{% endstylesheet %}

{% schema %}
{"name":"LED Zubehör Upsell","settings":[],"presets":[{"name":"LED Zubehör Upsell"}]}
{% endschema %}

