{% assign current_year = 'now' | date: '%Y' %}
<footer class="site-footer">
  <div class="page-width site-footer__inner">
    <div class="site-footer__brand">
      <strong>{{ shop.name }}</strong>
      {% if section.settings.text != blank %}<div class="site-footer__text">{{ section.settings.text }}</div>{% else %}<p>{{ 'footer.text' | t }}</p>{% endif %}
    </div>
    <div class="site-footer__system">
      <span>{% if request.locale.iso_code == 'de' %}Wissen · Konfigurieren · Pflanzen{% else %}Learn · Configure · Grow{% endif %}</span>
      <p>{% if request.locale.iso_code == 'de' %}Dynamische Pflanzenlösungen mit transparenten Inhalts- und Produktdaten.{% else %}Dynamic plant solutions with transparent product and ingredient data.{% endif %}</p>
    </div>
    {% if section.settings.menu != blank %}
      <nav aria-label="{{ 'accessibility.footer_menu' | t }}">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}<a href="{{ routes.root_url }}pages/impressum">Impressum</a></nav>
    {% endif %}
    <small>{{ 'footer.copyright' | t: year: current_year, shop: shop.name }}</small>
  </div>
</footer>

{% stylesheet %}
  .site-footer { border-top: 1px solid var(--border); background: var(--surface); }
  .site-footer__inner { padding-block: clamp(2.5rem,5vw,4.5rem); display: grid; grid-template-columns: minmax(260px,1.25fr) minmax(220px,.75fr) minmax(300px,1fr); gap: clamp(2rem,5vw,5rem); align-items: start; }
  .site-footer__brand > strong { font-family: var(--heading-font); font-size: 1.35rem; }
  .site-footer__brand p { max-width: 46ch; margin: .6rem 0 0; color: var(--muted); font-size: .84rem; line-height:1.55; }
  .site-footer__text > *:first-child { margin-top: .6rem; }
  .site-footer__text > *:last-child { margin-bottom: 0; }
  .site-footer__system { padding-left: 1rem; border-left: 1px solid var(--border); }
  .site-footer__system span { color: var(--accent); font-size: .7rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  .site-footer__system p { margin: .65rem 0 0; color: var(--muted); font-size: .8rem; line-height: 1.55; }
  .site-footer nav { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .7rem 1.4rem; }
  .site-footer a { min-height: 32px; display:flex;align-items:center;font-size: .78rem; text-decoration: none; }
  .site-footer a:hover { color: var(--accent); }
  .site-footer small { grid-column: 1 / -1; padding-top: 1.25rem; border-top: 1px solid var(--border); color: var(--muted); }
  @media (max-width: 900px) { .site-footer__inner { grid-template-columns: 1fr 1fr; } .site-footer nav { grid-column:1/-1; } .site-footer small { grid-column:1/-1; } }
  @media (max-width: 640px) { .site-footer__inner { grid-template-columns: 1fr; } .site-footer__system { padding-left:0;border-left:0;border-top:1px solid var(--border);padding-top:1rem; } .site-footer nav { grid-column:auto; } .site-footer small { grid-column:auto; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "t:sections.footer.menu", "default": "footer" },
    { "type": "richtext", "id": "text", "label": "t:sections.footer.text" }
  ]
}
{% endschema %}
