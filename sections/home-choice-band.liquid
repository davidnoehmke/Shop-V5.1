{% comment %}Best-of live sync trigger.{% endcomment %}
{% liquid
  assign choice_image_alt = section.settings.image.alt | default: section.settings.heading
%}

<section class="home-choice page-width" aria-labelledby="HomeChoiceHeading-{{ section.id }}">
  <div class="home-choice__inner">
    <div class="home-choice__media" data-leaf-reveal>
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1300 | image_tag: widths: '480, 760, 1000, 1300', sizes: '(min-width: 800px) 46vw, 100vw', loading: 'lazy', alt: choice_image_alt }}
      {% else %}
        <span aria-hidden="true">{{ 'lifestyle-2' | placeholder_svg_tag }}</span>
      {% endif %}
    </div>

    <div class="home-choice__content" data-leaf-reveal style="--leaf-delay: 100ms">
      {% if section.settings.eyebrow != blank %}<p class="home-choice__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="HomeChoiceHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<div class="home-choice__text rte">{{ section.settings.text }}</div>{% endif %}
      <div class="home-choice__buttons">
        {% if section.settings.primary_link != blank %}<a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
        {% if section.settings.secondary_link != blank %}<a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
        <a class="button button--secondary" href="{{ routes.root_url }}{% unless routes.root_url == '/' %}/{% endunless %}pages/pflanzenlicht-konfigurator">Pflanzenlicht konfigurieren</a>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .home-choice { padding-block: var(--space-section); }
  .home-choice__inner { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); min-height: 520px; overflow: hidden; border-radius: clamp(18px, 3vw, 34px); background: var(--accent-soft); }
  .home-choice__media { min-height: 420px; overflow: hidden; }
  .home-choice__media img, .home-choice__media span, .home-choice__media svg { width: 100%; height: 100%; object-fit: cover; }
  .home-choice__media img { transition: transform .8s var(--ease-out); }
  .home-choice__content { align-self: center; padding: clamp(2rem, 6vw, 5.5rem); }
  .home-choice__eyebrow { margin: 0 0 .75rem; color: var(--accent); font-size: .76rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .home-choice h2 { max-width: 13ch; margin: 0 0 1rem; font-size: clamp(2.2rem, 4.5vw, 4.6rem); line-height: .98; }
  .home-choice__text { max-width: 55ch; color: color-mix(in srgb, var(--text), transparent 24%); }
  .home-choice__buttons { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.6rem; }
  .home-choice__buttons .button { gap: .55rem; }
  .home-choice__buttons .button span { transition: transform .25s var(--ease-out); }
  .home-choice__buttons .button:hover span { transform: translateX(.2rem); }
  @media (hover: hover) and (pointer: fine) { .home-choice__inner:hover .home-choice__media img { transform: scale(1.035); } }
  @media (max-width: 800px) { .home-choice__inner { grid-template-columns: 1fr; } .home-choice__media { min-height: 300px; aspect-ratio: 16 / 10; } }
  @media (max-width: 540px) { .home-choice__buttons { display: grid; } .home-choice__buttons .button { width: 100%; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Home Entscheidungshilfe",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Individuelles Substrat" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Stelle dein Substrat passend zusammen" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Wähle Pflanzenprofil und Volumen oder lies zuerst die Grundlagen.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primärer CTA", "default": "Substrat konfigurieren" },
    { "type": "url", "id": "primary_link", "label": "Primärer Link" },
    { "type": "text", "id": "secondary_label", "label": "Sekundärer CTA", "default": "Grundlagen lesen" },
    { "type": "url", "id": "secondary_link", "label": "Sekundärer Link" }
  ],
  "presets": [{ "name": "Home Entscheidungshilfe" }]
}
{% endschema %}
