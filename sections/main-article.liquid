{% liquid
  if request.locale.iso_code == 'de'
    assign article_eyebrow = 'LEAFerservice Ratgeber'
    assign back_label = 'Alle Ratgeber'
    assign related_heading = 'Passend weiterlesen'
    assign read_label = 'Ratgeber lesen'
    assign cta_eyebrow_default = 'Nächster sinnvoller Schritt'
    assign cta_heading_default = 'Finde das passende Substrat für deine Pflanze.'
    assign cta_text_default = 'Wähle ein Pflanzenprofil und vergleiche Menge, Preis und Rezeptur vor dem Kauf.'
    assign cta_label_default = 'Substrat konfigurieren'
    assign comment_eyebrow = 'Austausch'
    assign comment_heading = 'Was funktioniert bei dir?'
    assign comment_intro = 'Teile deine Erfahrung mit Substrat, Standort oder Pflege. Kommentare werden vor der Veröffentlichung geprüft.'
    assign comment_name = 'Name'
    assign comment_email = 'E-Mail'
    assign comment_body = 'Kommentar'
    assign comment_submit = 'Kommentar senden'
    assign comment_success = 'Danke – dein Kommentar wird vor der Veröffentlichung geprüft.'
    assign comment_empty = 'Noch keine veröffentlichten Kommentare. Du kannst den Austausch starten.'
  else
    assign article_eyebrow = 'LEAFerservice guides'
    assign back_label = 'All guides'
    assign related_heading = 'Continue reading'
    assign read_label = 'Read guide'
    assign cta_eyebrow_default = 'A practical next step'
    assign cta_heading_default = 'Find the right substrate for your plant.'
    assign cta_text_default = 'Choose a plant profile and compare volume, price and recipe before buying.'
    assign cta_label_default = 'Configure substrate'
    assign comment_eyebrow = 'Discussion'
    assign comment_heading = 'What works for you?'
    assign comment_intro = 'Share your experience with substrate, placement or plant care. Comments are reviewed before publication.'
    assign comment_name = 'Name'
    assign comment_email = 'Email'
    assign comment_body = 'Comment'
    assign comment_submit = 'Submit comment'
    assign comment_success = 'Thank you – your comment will be reviewed before publication.'
    assign comment_empty = 'No published comments yet. You can start the discussion.'
  endif

  assign cta_eyebrow = section.settings.cta_eyebrow | default: cta_eyebrow_default
  assign cta_heading = section.settings.cta_heading | default: cta_heading_default
  assign cta_label = section.settings.cta_label | default: cta_label_default
  assign article_alt = article.image.alt | default: article.title
  assign article_knowledge_atoms = article.metafields.leafer.knowledge_atoms.value
  assign article_solution_links = article.metafields.leafer.solution_links.value
  assign article_related_products = article.metafields.leafer.related_products.value
%}

<article class="main-article">
  <header class="main-article__header page-width">
    <nav class="main-article__breadcrumbs" aria-label="{{ 'product.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a><span aria-hidden="true">/</span>
      <a href="{{ blog.url }}">{{ blog.title | escape }}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{{ article.title | escape }}</span>
    </nav>
    <p class="main-article__eyebrow">{{ article_eyebrow }}</p>
    <h1>{{ article.title | escape }}</h1>
    <div class="main-article__meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
        {% if request.locale.iso_code == 'de' %}{{ article.published_at | date: '%d.%m.%Y' }}{% else %}{{ article.published_at | date: '%B %d, %Y' }}{% endif %}
      </time>
      {% if article.author != blank %}<span>{{ article.author | escape }}</span>{% endif %}
      {% if article.tags.size > 0 %}
        <span>{% for tag in article.tags %}{% unless forloop.first %} · {% endunless %}{% render 'leaf-localized-label', text: tag %}{% endfor %}</span>
      {% endif %}
    </div>
  </header>

  {% if article.image != blank %}
    <figure class="main-article__hero page-width">
      {{ article.image | image_url: width: 2200 | image_tag: widths: '750, 1100, 1500, 1800, 2200', sizes: '(min-width: 1280px) 1240px, calc(100vw - 2rem)', loading: 'eager', fetchpriority: 'high', alt: article_alt }}
    </figure>
  {% endif %}

  <section
    class="main-article__tools page-width"
    data-article-tools
    data-progress-label="{{ 'article_tools.progress' | t | escape }}"
    data-focus-open="{{ 'article_tools.focus_open' | t | escape }}"
    data-focus-close="{{ 'article_tools.focus_close' | t | escape }}"
    aria-label="{{ 'article_tools.aria' | t | escape }}"
  >
    <div class="main-article__tools-head">
      <div>
        <p class="main-article__tools-eyebrow">{{ 'article_tools.eyebrow' | t }}</p>
        <p class="main-article__progress-text" data-article-progress aria-live="polite">0 % {{ 'article_tools.progress' | t }}</p>
      </div>
      <button class="main-article__focus-button" type="button" data-article-focus aria-pressed="false">{{ 'article_tools.focus_open' | t }}</button>
    </div>
    <nav class="main-article__toc" data-article-toc aria-label="{{ 'article_tools.toc_aria' | t | escape }}">
      <p>{{ 'article_tools.toc_heading' | t }}</p>
      <ol data-article-toc-list></ol>
    </nav>
  </section>

  {% if article_knowledge_atoms != blank %}
    <section class="main-article__knowledge page-width" aria-labelledby="ArticleKnowledge-{{ section.id }}">
      <div class="main-article__knowledge-head">
        <p>{% if request.locale.iso_code == 'de' %}Wissensprofil{% else %}Knowledge profile{% endif %}</p>
        <h2 id="ArticleKnowledge-{{ section.id }}">{% if request.locale.iso_code == 'de' %}Die wichtigsten Faktoren auf einen Blick{% else %}The key factors at a glance{% endif %}</h2>
      </div>
      <div class="main-article__knowledge-grid">
        {% for atom in article_knowledge_atoms %}
          <article class="main-article__knowledge-card">
            <strong>{{ atom.label | escape }}</strong>
            <p>{{ atom.value | escape }}</p>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <div class="main-article__layout page-width">
    {% assign article_body = article.content %}
    <div class="main-article__body rte" data-article-body>{{ article_body }}</div>

    <aside class="main-article__rail">
      <a class="main-article__back" href="{{ blog.url }}"><span aria-hidden="true">←</span> {{ back_label }}</a>
      {% if article.tags.size > 0 %}
        <div class="main-article__tags" aria-label="Tags">
          {% for tag in article.tags %}<span>{% render 'leaf-localized-label', text: tag %}</span>{% endfor %}
        </div>
      {% endif %}
    </aside>
  </div>

  {% if article_solution_links != blank %}
    <section class="main-article__solutions page-width" aria-labelledby="ArticleSolutions-{{ section.id }}">
      <div class="main-article__solutions-head">
        <p>{% if request.locale.iso_code == 'de' %}Problem → Lösung{% else %}Problem → solution{% endif %}</p>
        <h2 id="ArticleSolutions-{{ section.id }}">{% if request.locale.iso_code == 'de' %}Passende nächste Schritte{% else %}Practical next steps{% endif %}</h2>
      </div>
      <div class="main-article__solutions-grid">
        {% for solution in article_solution_links %}
          {% liquid
            assign solution_url = solution.url
            assign solution_prefix = solution_url | slice: 0, 1
            assign solution_locale_prefix = solution_url | slice: 0, routes.root_url.size
            if routes.root_url != '/' and solution_prefix == '/' and solution_locale_prefix != routes.root_url
              assign solution_url = solution_url | prepend: routes.root_url
            endif
          %}
          <a class="main-article__solution-card" href="{{ solution_url | escape }}">
            <span>{{ solution.problem | escape }}</span>
            <strong>{{ solution.label | escape }}</strong>
            <em aria-hidden="true">→</em>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if article_related_products != blank %}
    <section class="main-article__products page-width" aria-labelledby="ArticleProducts-{{ section.id }}">
      <div class="main-article__products-head">
        <p>{% if request.locale.iso_code == 'de' %}Verknüpfte Lösungen{% else %}Linked solutions{% endif %}</p>
        <h2 id="ArticleProducts-{{ section.id }}">{% if request.locale.iso_code == 'de' %}Produkte aus diesem Ratgeber{% else %}Products from this guide{% endif %}</h2>
      </div>
      <div class="main-article__products-grid">
        {% for linked_product in article_related_products limit: 8 %}
          {% if linked_product.url == blank or linked_product.title == blank %}{% continue %}{% endif %}
          {% assign linked_product_alt = linked_product.featured_image.alt | default: linked_product.title %}
          <article class="main-article__product-card">
            <a class="main-article__product-media" href="{{ linked_product.url }}">
              {% if linked_product.featured_image != blank %}
                {{ linked_product.featured_image | image_url: width: 720 | image_tag: widths: '260, 420, 560, 720', sizes: '(max-width: 620px) 100vw, (max-width: 900px) 50vw, 25vw', loading: 'lazy', alt: linked_product_alt }}
              {% endif %}
            </a>
            <div>
              <h3><a href="{{ linked_product.url }}">{{ linked_product.title | escape }}</a></h3>
              {% if linked_product.metafields.leafer.intro.value != blank %}<p>{{ linked_product.metafields.leafer.intro.value | truncate: 150 | escape }}</p>{% endif %}
              <a href="{{ linked_product.url }}">{% if request.locale.iso_code == 'de' %}Lösung ansehen{% else %}View solution{% endif %} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_cta %}
    <section class="main-article__cta page-width" aria-labelledby="ArticleCta-{{ section.id }}">
      <div>
        <p>{{ cta_eyebrow | escape }}</p>
        <h2 id="ArticleCta-{{ section.id }}">{{ cta_heading | escape }}</h2>
        {% if section.settings.cta_text != blank %}<div class="rte">{{ section.settings.cta_text }}</div>{% else %}<p class="main-article__cta-text">{{ cta_text_default }}</p>{% endif %}
      </div>
      <a class="button" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ cta_label | escape }} <span aria-hidden="true">→</span></a>
    </section>
  {% endif %}

  {% if blog.handle == 'leafers-nice2know-blog' and article.handle == 'bims-oder-perlit-unterschiede-pflanzsubstrat' or blog.handle == 'leafers-nice2know-blog' and article.handle == 'monstera-thai-constellation-substrat-mischung' %}
    <section class="main-article__comments page-width" aria-labelledby="ArticleComments-{{ section.id }}">
      <div class="main-article__comments-head">
        <p>{{ comment_eyebrow }}</p>
        <h2 id="ArticleComments-{{ section.id }}">{{ comment_heading }}</h2>
        <p>{{ comment_intro }}</p>
      </div>

      {% paginate article.comments by 20 %}
        <div class="main-article__comments-list">
          {% for comment in article.comments %}
            <article class="main-article__comment">
              <header>
                <strong>{{ comment.author | escape }}</strong>
                <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: '%d.%m.%Y' }}</time>
              </header>
              <div class="rte">{{ comment.content }}</div>
            </article>
          {% else %}
            <p class="main-article__comments-empty">{{ comment_empty }}</p>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="main-article__comments-pagination" aria-label="{{ comment_heading }}">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}

        <div class="main-article__comment-form">
          {% form 'new_comment', article %}
            {% if form.posted_successfully? %}
              <p class="main-article__comment-success" role="status">{{ comment_success }}</p>
            {% else %}
              {{ form.errors | default_errors }}
              <div class="main-article__comment-fields">
                <label>
                  <span>{{ comment_name }}</span>
                  <input type="text" name="comment[author]" value="{{ form.author | escape }}" autocomplete="name" required>
                </label>
                <label>
                  <span>{{ comment_email }}</span>
                  <input type="email" name="comment[email]" value="{{ form.email | escape }}" autocomplete="email" required>
                </label>
                <label class="main-article__comment-message">
                  <span>{{ comment_body }}</span>
                  <textarea name="comment[body]" rows="6" required>{{ form.body }}</textarea>
                </label>
              </div>
              <button class="button" type="submit">{{ comment_submit }}</button>
            {% endif %}
          {% endform %}
        </div>
      {% endpaginate %}
    </section>
  {% endif %}

  {% if section.settings.show_related and blog.articles.size > 1 %}
    <section class="main-article__related page-width" aria-labelledby="RelatedArticles-{{ section.id }}">
      <h2 id="RelatedArticles-{{ section.id }}">{{ related_heading }}</h2>
      <div class="main-article__related-grid">
        {% assign related_count = 0 %}
        {% for related_article in blog.articles %}
          {% unless related_article.id == article.id %}
            {% liquid
              assign related_alt = related_article.image.alt | default: related_article.title
              assign related_excerpt = related_article.excerpt_or_content | strip_html | strip | truncate: 120
              assign related_count = related_count | plus: 1
            %}
            <article class="main-article__related-card">
              <a class="main-article__related-media" href="{{ related_article.url }}" aria-label="{{ related_article.title | escape }}">
                {% if related_article.image != blank %}
                  {{ related_article.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy', alt: related_alt }}
                {% else %}
                  <span aria-hidden="true">{{ 'lifestyle-1' | placeholder_svg_tag }}</span>
                {% endif %}
              </a>
              <div>
                <h3><a href="{{ related_article.url }}">{{ related_article.title | escape }}</a></h3>
                {% if related_excerpt != blank %}<p>{{ related_excerpt | escape }}</p>{% endif %}
                <a href="{{ related_article.url }}">{{ read_label }} <span aria-hidden="true">→</span></a>
              </div>
            </article>
            {% if related_count >= section.settings.related_limit %}{% break %}{% endif %}
          {% endunless %}
        {% endfor %}
      </div>
    </section>
  {% endif %}
</article>

{% stylesheet %}
  .main-article { padding-block: clamp(2rem, 6vw, 6rem); }
  .main-article__header { max-width: 1120px; }
  .main-article__breadcrumbs { display: flex; flex-wrap: wrap; gap: .45rem; margin-bottom: clamp(2rem, 5vw, 4rem); color: var(--muted); font-size: .75rem; }
  .main-article__breadcrumbs a { color: inherit; }
  .main-article__eyebrow, .main-article__cta > div > p { margin: 0 0 .7rem; color: var(--accent); font-size: .75rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .main-article h1 { max-width: 28ch; margin: 0; font-size: clamp(1.8rem, 3.2vw, 2.75rem); line-height: 1.2; letter-spacing: -.025em; }
  .main-article__meta { display: flex; flex-wrap: wrap; gap: .65rem 1.25rem; margin-top: 1.4rem; color: var(--muted); font-size: .8rem; }
  .main-article__hero { margin-top: clamp(2rem, 6vw, 5rem); }
  .main-article__hero img { width: 100%; max-height: 760px; border-radius: var(--radius-large); object-fit: cover; }
  .main-article__layout { display: grid; grid-template-columns: minmax(0, 820px) minmax(220px, 1fr); gap: clamp(2rem, 8vw, 8rem); align-items: start; margin-top: clamp(2.5rem, 6vw, 5rem); }
  .main-article__body { min-width: 0; font-size: clamp(1rem, 1.4vw, 1.12rem); line-height: 1.75; }
  .main-article__body h2 { margin: 2.2em 0 .65em; font-size: clamp(1.35rem, 2.6vw, 1.9rem); line-height: 1.2; letter-spacing: -.025em; }
  .main-article__body h3 { margin: 1.8em 0 .55em; font-size: clamp(1.1rem, 2.2vw, 1.35rem); line-height: 1.2; }
  .main-article__body img { height: auto; border-radius: var(--radius-large); }
  .main-article__body blockquote { margin: 2rem 0; padding: 1.2rem 1.4rem; border-left: 4px solid var(--accent); background: color-mix(in srgb, var(--accent-soft), transparent 35%); }
  .main-article__body table { width: 100%; border-collapse: collapse; }
  .main-article__body th, .main-article__body td { padding: .8rem; border: 1px solid var(--border); text-align: left; vertical-align: top; }
  .main-article__rail { position: sticky; top: 110px; display: grid; gap: 1rem; }
  .main-article__back { display: inline-flex; align-items: center; gap: .45rem; color: var(--accent); font-weight: 800; text-decoration: none; }
  .main-article__tags { display: flex; flex-wrap: wrap; gap: .45rem; }
  .main-article__tags span { padding: .4rem .65rem; border: 1px solid var(--border); border-radius: 999px; color: var(--muted); font-size: .72rem; }
  .main-article__knowledge, .main-article__solutions, .main-article__products { margin-top: clamp(2.5rem, 6vw, 5rem); }
  .main-article__knowledge-head > p, .main-article__solutions-head > p, .main-article__products-head > p { margin: 0 0 .65rem; color: var(--accent); font-size: .75rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .main-article__knowledge-head h2, .main-article__solutions-head h2, .main-article__products-head h2 { margin: 0 0 1.25rem; font-size: clamp(1.35rem, 2.6vw, 1.9rem); line-height: 1.2; }
  .main-article__knowledge-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .85rem; }
  .main-article__knowledge-card, .main-article__solution-card, .main-article__product-card { min-width: 0; overflow-wrap: anywhere; }
  .main-article__solution-card:focus-visible, .main-article__product-card a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .main-article__knowledge-card { padding: 1rem 1.1rem; border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--surface); }
  .main-article__knowledge-card strong { display: block; margin-bottom: .4rem; color: var(--accent); font-size: .82rem; }
  .main-article__knowledge-card p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.55; }
  .main-article__solutions-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  .main-article__solution-card { display: grid; grid-template-columns: 1fr auto; gap: .25rem 1rem; padding: 1rem 1.1rem; border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--surface); color: inherit; text-decoration: none; }
  .main-article__solution-card span { grid-column: 1 / -1; color: var(--muted); font-size: .78rem; }
  .main-article__solution-card strong { font-size: .96rem; }
  .main-article__solution-card em { color: var(--accent); font-style: normal; font-weight: 900; }
  .main-article__products-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .85rem; }
  .main-article__product-card { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--surface); }
  .main-article__product-media { display: block; aspect-ratio: 1 / 1; overflow: hidden; background: var(--accent-soft); }
  .main-article__product-media img { width: 100%; height: 100%; object-fit: cover; }
  .main-article__product-card > div { padding: .95rem; }
  .main-article__product-card h3 { margin: 0; font-size: 1rem; line-height: 1.25; }
  .main-article__product-card h3 a, .main-article__product-card > div > a { color: inherit; text-decoration: none; }
  .main-article__product-card p { margin: .55rem 0; color: var(--muted); font-size: .82rem; line-height: 1.5; }
  .main-article__product-card > div > a { color: var(--accent); font-size: .8rem; font-weight: 800; }
  .main-article__body .article-data-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin: 1.2rem 0 2rem; }
  .main-article__body .article-data-grid > div { padding: .9rem 1rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  .main-article__body .article-data-grid strong, .main-article__body .article-data-grid span { display: block; }
  .main-article__body .article-data-grid strong { margin-bottom: .25rem; color: var(--accent); }
  .main-article__body .article-data-grid span { color: var(--muted); font-size: .88rem; }
  .main-article__body figure { margin: 1.75rem 0; }
  .main-article__body figcaption { margin-top: .55rem; color: var(--muted); font-size: .8rem; line-height: 1.5; }
  .main-article__body .article-solution-stack { display: grid; gap: .75rem; }
  .main-article__body .article-solution-stack p { margin: 0; padding: .95rem 1rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  .main-article__cta { display: flex; align-items: center; justify-content: space-between; gap: clamp(1.5rem, 5vw, 4rem); margin-top: var(--space-section); padding: clamp(1.5rem, 5vw, 4rem); border-radius: var(--radius-large); background: var(--text); color: var(--background); }
  .main-article__cta > div { max-width: 760px; }
  .main-article__cta > div > p:first-child { color: var(--accent-soft); }
  .main-article__cta h2 { margin: 0; font-size: clamp(1.35rem, 2.6vw, 1.9rem); line-height: 1.2; }
  .main-article__cta .rte, .main-article__cta-text { max-width: 62ch; color: color-mix(in srgb, var(--background), transparent 22%); }
  .main-article__cta .button { flex: 0 0 auto; gap: .5rem; background: var(--accent-soft); color: var(--text); }
  .main-article__comments { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(1.5rem, 5vw, 5rem); margin-top: var(--space-section); padding-top: clamp(2rem, 5vw, 4rem); border-top: 1px solid var(--border); }
  .main-article__comments-head > p:first-child { margin: 0 0 .65rem; color: var(--accent); font-size: .75rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .main-article__comments-head h2 { margin: 0; font-size: clamp(1.35rem, 2.6vw, 1.9rem); line-height: 1.2; letter-spacing: -.025em; }
  .main-article__comments-head > p:last-child { max-width: 55ch; color: var(--muted); }
  .main-article__comments-list { display: grid; gap: .75rem; }
  .main-article__comment { padding: 1rem 1.1rem; border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--surface); }
  .main-article__comment header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; margin-bottom: .6rem; }
  .main-article__comment time, .main-article__comments-empty { color: var(--muted); font-size: .82rem; }
  .main-article__comment-form { margin-top: 1rem; padding: 1.2rem; border: 1px solid var(--border); border-radius: var(--radius-large); background: color-mix(in srgb, var(--surface), transparent 10%); }
  .main-article__comment-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem; margin-bottom: 1rem; }
  .main-article__comment-fields label { display: grid; gap: .4rem; color: var(--muted); font-size: .78rem; font-weight: 750; }
  .main-article__comment-fields input, .main-article__comment-fields textarea { width: 100%; border: 1px solid var(--border); border-radius: 8px; padding: .8rem .9rem; background: var(--background); color: var(--text); }
  .main-article__comment-message { grid-column: 1 / -1; }
  .main-article__comment-success { margin: 0; color: var(--accent); font-weight: 800; }
  .main-article__comments-pagination { margin-top: 1rem; }
  .main-article__related { margin-top: var(--space-section); }
  .main-article__related > h2 { margin: 0 0 1.5rem; font-size: clamp(1.35rem, 2.6vw, 1.9rem); }
  .main-article__related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .main-article__related-card { min-width: 0; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--surface); }
  .main-article__related-media { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--accent-soft); }
  .main-article__related-media img, .main-article__related-media span, .main-article__related-media svg { width: 100%; height: 100%; object-fit: cover; }
  .main-article__related-card > div { padding: 1.15rem; }
  .main-article__related-card h3 { margin: 0; font-size: clamp(1.1rem, 2.2vw, 1.35rem); line-height: 1.2; }
  .main-article__related-card h3 a, .main-article__related-card > div > a { color: inherit; text-decoration: none; }
  .main-article__related-card p { color: var(--muted); font-size: .88rem; }
  .main-article__related-card > div > a { color: var(--accent); font-size: .82rem; font-weight: 800; }
  .main-article__tools { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 420px); gap: 1rem; margin-top: clamp(2rem, 5vw, 4rem); }
  .main-article__tools-head, .main-article__toc { border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--surface); }
  .main-article__tools-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.2rem; }
  .main-article__tools-eyebrow, .main-article__toc > p { margin: 0; color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .main-article__progress-text { margin: .25rem 0 0; color: var(--muted); font-size: .86rem; }
  .main-article__focus-button { border: 1px solid var(--accent); border-radius: 999px; padding: .75rem 1rem; background: transparent; color: var(--accent); font: inherit; font-size: .82rem; font-weight: 800; cursor: pointer; }
  .main-article__focus-button:hover, .main-article__focus-button:focus-visible { background: var(--accent); color: var(--background); }
  .main-article__toc { padding: 1rem 1.2rem; }
  .main-article__toc ol { display: flex; flex-wrap: wrap; gap: .5rem; margin: .7rem 0 0; padding: 0; list-style: none; }
  .main-article__toc li { margin: 0; }
  .main-article__toc a { display: block; padding: .42rem .7rem; border-radius: 999px; background: var(--accent-soft); color: var(--text); font-size: .78rem; line-height: 1.25; text-decoration: none; }
  .main-article__toc a:hover, .main-article__toc a:focus-visible, .main-article__toc a[aria-current="true"] { background: var(--accent); color: var(--background); }
  .main-article--focus .main-article__layout { grid-template-columns: minmax(0, 900px); justify-content: center; }
  .main-article--focus .main-article__rail { display: none; }
  .main-article--focus .main-article__tools { max-width: 900px; grid-template-columns: 1fr; }
  .main-article__body h2 { scroll-margin-top: 120px; }
  .main-article__body .article-faq { margin: 1rem 0; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  .main-article__body .article-faq summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.15rem; color: var(--text); font-weight: 800; cursor: pointer; list-style: none; }
  .main-article__body .article-faq summary::-webkit-details-marker { display: none; }
  .main-article__body .article-faq summary::after { content: '+'; color: var(--accent); font-size: 1.35rem; line-height: 1; }
  .main-article__body .article-faq[open] summary::after { content: '−'; }
  .main-article__body .article-faq summary:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent), white 35%); outline-offset: -3px; }
  .main-article__body .article-faq p { margin: 0; padding: 0 1.15rem 1.1rem; color: var(--muted); }
  @media (max-width: 900px) {
    .main-article__layout { grid-template-columns: 1fr; }
    .main-article__comments { grid-template-columns: 1fr; }
    .main-article__rail { position: static; grid-row: 1; }
    .main-article__cta { align-items: flex-start; flex-direction: column; }
    .main-article__related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .main-article__knowledge-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .main-article__products-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .main-article__related-grid { grid-template-columns: 1fr; }
    .main-article__comment-fields { grid-template-columns: 1fr; }
    .main-article__cta .button { width: 100%; }
    .main-article__knowledge-grid, .main-article__solutions-grid, .main-article__products-grid, .main-article__body .article-data-grid { grid-template-columns: 1fr; }
  }
  .main-article__body .interior-guide__steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; padding: 0; list-style: none; }
  .interior-guide__steps li, .interior-guide__note, .interior-guide__scenarios section { padding: 1rem; border: 1px solid var(--border); background: var(--surface); }
  .interior-guide__steps li > span { display: block; color: var(--accent); font-size: .85rem; margin-bottom: .4rem; }
  .interior-guide__steps li > strong { display: block; }
  .interior-guide__steps p, .interior-guide__note p, .interior-guide__scenarios p { margin-bottom: 0; }
  .interior-guide__scenarios { display: grid; gap: 1rem; }
  .main-article__body .interior-guide__scenarios h3 { margin-top: 0; }
  @media (max-width: 620px) { .main-article__body .interior-guide__steps { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% javascript %}
  (() => {
    const tools = document.querySelector('[data-article-tools]');
    if (!tools) return;
    const article = tools.closest('.main-article');
    const body = article?.querySelector('[data-article-body]');
    const tocList = tools.querySelector('[data-article-toc-list]');
    const progress = tools.querySelector('[data-article-progress]');
    const focusButton = tools.querySelector('[data-article-focus]');
    if (!article || !body || !tocList || !progress || !focusButton) return;
    const progressLabel = tools.dataset.progressLabel || 'read';
    const focusOpen = tools.dataset.focusOpen || 'Open focus mode';
    const focusClose = tools.dataset.focusClose || 'Close focus mode';

    const headings = [...body.querySelectorAll('h2')];
    headings.forEach((heading, index) => {
      if (!heading.id) heading.id = `ArticleSection-${index + 1}-${heading.textContent.trim().toLowerCase().replace(/[^a-z0-9äöüß]+/gi, '-').replace(/^-|-$/g, '')}`;
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent.trim();
      link.addEventListener('click', () => {
        heading.focus({preventScroll: true});
      });
      item.append(link);
      tocList.append(item);
    });
    if (!headings.length) tools.querySelector('[data-article-toc]').hidden = true;

    const updateProgress = () => {
      const start = body.getBoundingClientRect().top + window.scrollY - window.innerHeight * .35;
      const end = body.getBoundingClientRect().bottom + window.scrollY - window.innerHeight * .65;
      const value = end <= start ? 100 : Math.min(100, Math.max(0, ((window.scrollY - start) / (end - start)) * 100));
      progress.textContent = `${Math.round(value)} % ${progressLabel}`;
      const visible = headings.reduce((current, heading) => {
        if (heading.getBoundingClientRect().top <= window.innerHeight * .3) return heading;
        return current;
      }, headings[0]);
      headings.forEach((heading) => {
        const link = tocList.querySelector(`a[href="#${heading.id}"]`);
        if (link) link.setAttribute('aria-current', heading === visible ? 'true' : 'false');
      });
    };

    focusButton.addEventListener('click', () => {
      const active = article.classList.toggle('main-article--focus');
      focusButton.setAttribute('aria-pressed', active ? 'true' : 'false');
      focusButton.textContent = active ? focusClose : focusOpen;
    });
    window.addEventListener('scroll', updateProgress, {passive: true});
    window.addEventListener('resize', updateProgress);
    updateProgress();
  })();
{% endjavascript %}
