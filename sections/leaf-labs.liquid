<section class="leaf-labs page-width" data-leaf-labs>
  <header class="leaf-labs__hero">
    <p class="leaf-labs__eyebrow">{{ 'labs.eyebrow' | t }}</p>
    <h1>{{ 'labs.heading' | t }}</h1>
    <p class="leaf-labs__intro">{{ 'labs.intro' | t }}</p>
    <p
      class="leaf-labs__freshness"
      data-labs-freshness
      data-label="{{ 'labs.updated_label' | t | escape }}"
      aria-live="polite"
    >
      {{ 'labs.fallback_status' | t }}
    </p>
  </header>

  <div class="leaf-labs__grid">
    <article class="leaf-labs__card" data-labs-key="commerce-platform">
      <p
        class="leaf-labs__status"
        data-labs-value="commerce-platform"
        data-suffix="{{ 'labs.cards.commerce.unit' | t | escape }}"
      >
        {{ 'labs.cards.commerce.fallback_value' | t }}
      </p>
      <h2>{{ 'labs.cards.commerce.title' | t }}</h2>
      <p>{{ 'labs.cards.commerce.text' | t }}</p>
    </article>

    <article class="leaf-labs__card" data-labs-key="data-analytics">
      <p
        class="leaf-labs__status"
        data-labs-value="data-analytics"
        data-suffix="{{ 'labs.cards.analytics.unit' | t | escape }}"
      >
        {{ 'labs.cards.analytics.fallback_value' | t }}
      </p>
      <h2>{{ 'labs.cards.analytics.title' | t }}</h2>
      <p>{{ 'labs.cards.analytics.text' | t }}</p>
    </article>

    <article class="leaf-labs__card" data-labs-key="ai-automation">
      <p
        class="leaf-labs__status"
        data-labs-value="ai-automation"
        data-multiple="{{ 'labs.cards.ai.multiple_value' | t | escape }}"
        data-single="{{ 'labs.cards.ai.single_value' | t | escape }}"
      >
        {{ 'labs.cards.ai.fallback_value' | t }}
      </p>
      <h2>{{ 'labs.cards.ai.title' | t }}</h2>
      <p>{{ 'labs.cards.ai.text' | t }}</p>
    </article>

    <article class="leaf-labs__card" data-labs-key="ai-native-development">
      <p
        class="leaf-labs__status"
        data-labs-value="ai-native-development"
        data-active="{{ 'labs.cards.development.active_value' | t | escape }}"
      >
        {{ 'labs.cards.development.fallback_value' | t }}
      </p>
      <h2>{{ 'labs.cards.development.title' | t }}</h2>
      <p>{{ 'labs.cards.development.text' | t }}</p>
    </article>
  </div>

  <aside class="leaf-labs__security">
    <strong>{{ 'labs.security_title' | t }}</strong>
    <span>{{ 'labs.security_text' | t }}</span>
  </aside>

  <div class="leaf-labs__cta">
    <h2>{{ 'labs.cta_heading' | t }}</h2>
    <p>{{ 'labs.cta_text' | t }}</p>
    <a class="button" href="mailto:management@leaferservice.com">{{ 'labs.cta_button' | t }}</a>
  </div>
</section>

{% stylesheet %}
  .leaf-labs {
    padding-top: clamp(3rem, 7vw, 7rem);
    padding-bottom: clamp(3rem, 7vw, 7rem);
  }

  .leaf-labs__hero {
    max-width: 820px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .leaf-labs__eyebrow {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .leaf-labs__hero h1 {
    margin: 0.5rem 0 1.2rem;
    font-size: clamp(2.4rem, 6vw, 5.5rem);
    line-height: 0.95;
  }

  .leaf-labs__intro {
    margin: 0 auto;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    opacity: 0.82;
  }

  .leaf-labs__freshness {
    margin-top: 1rem;
    font-size: 0.85rem;
    opacity: 0.68;
  }

  .leaf-labs__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .leaf-labs__card,
  .leaf-labs__security,
  .leaf-labs__cta {
    border: 1px solid rgba(var(--color-foreground), 0.14);
  }

  .leaf-labs__card {
    min-height: 210px;
    padding: clamp(1.4rem, 3vw, 2.4rem);
  }

  .leaf-labs__card[hidden] {
    display: none;
  }

  .leaf-labs__card h2 {
    margin: 0.5rem 0;
    font-size: clamp(1.35rem, 2vw, 1.9rem);
  }

  .leaf-labs__status {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .leaf-labs__security,
  .leaf-labs__cta {
    margin-top: 1rem;
    padding: clamp(1.4rem, 3vw, 2.4rem);
  }

  .leaf-labs__security {
    display: grid;
    gap: 0.5rem;
  }

  .leaf-labs__cta {
    margin-top: 3rem;
    text-align: center;
  }

  @media (max-width: 749px) {
    .leaf-labs__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const endpoint = 'https://vbqimcwaxcydegqlkkgw.supabase.co/functions/v1/public-labs';

    const refresh = async (root) => {
      if (!root) return;

      try {
        const response = await fetch(endpoint, {
          method: 'GET',
          headers: { Accept: 'application/json' },
          cache: 'no-store'
        });

        if (!response.ok) return;

        const payload = await response.json();
        const metrics = payload && payload.metrics ? payload.metrics : {};
        const capabilities = new Set(Array.isArray(payload.capabilities) ? payload.capabilities : []);

        root.querySelectorAll('[data-labs-key]').forEach((card) => {
          card.hidden = !capabilities.has(card.dataset.labsKey);
        });

        const commerce = root.querySelector('[data-labs-value="commerce-platform"]');
        const commerceValue = Number(metrics.commerce_records_floor);
        if (commerce && Number.isFinite(commerceValue)) {
          const plus = metrics.commerce_records_rounded ? '+' : '';
          commerce.textContent = `${commerceValue}${plus} ${commerce.dataset.suffix || ''}`.trim();
        }

        const analytics = root.querySelector('[data-labs-value="data-analytics"]');
        const reportingDays = Number(metrics.reporting_days);
        if (analytics && Number.isFinite(reportingDays)) {
          analytics.textContent = `${reportingDays} ${analytics.dataset.suffix || ''}`.trim();
        }

        const automation = root.querySelector('[data-labs-value="ai-automation"]');
        if (automation && typeof metrics.multiple_controlled_workflows === 'boolean') {
          automation.textContent = metrics.multiple_controlled_workflows
            ? automation.dataset.multiple || ''
            : automation.dataset.single || '';
        }

        const development = root.querySelector('[data-labs-value="ai-native-development"]');
        if (development && metrics.ai_native_active === true) {
          development.textContent = development.dataset.active || '';
        }

        const freshness = root.querySelector('[data-labs-freshness]');
        if (freshness && payload.generated_at) {
          const generatedAt = new Date(payload.generated_at);
          if (!Number.isNaN(generatedAt.getTime())) {
            const formatted = new Intl.DateTimeFormat(document.documentElement.lang || undefined, {
              dateStyle: 'medium',
              timeStyle: 'short'
            }).format(generatedAt);
            freshness.textContent = `${freshness.dataset.label || ''} ${formatted}`.trim();
          }
        }
      } catch {
        return;
      }
    };

    document.querySelectorAll('[data-leaf-labs]').forEach((root) => refresh(root));

    document.addEventListener('shopify:section:load', (event) => {
      const root = event.target.matches('[data-leaf-labs]')
        ? event.target
        : event.target.querySelector('[data-leaf-labs]');
      refresh(root);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LEAF Labs",
  "settings": [],
  "presets": [
    {
      "name": "LEAF Labs"
    }
  ]
}
{% endschema %}