{% liquid
  if request.locale.iso_code == 'de'
    assign eyebrow = 'Projekte & B2B'
    assign heading = 'Größer planen? Wir sind offen für B2B.'
    assign copy = 'Für gewerbliche Pflanzenprojekte, Wiederverkäufer und größere Mengen verbinden wir Pflanzen, Gefäße, Substrate und Beleuchtung zu einer passenden Lösung.'
    assign primary = 'B2B-Anfrage stellen'
    assign secondary = 'EU-Versand ansehen'
    assign shipping = 'Versand aus Deutschland · Lieferung nach Deutschland & in die EU'
    assign image_alt_default = 'LEAFerservice Pflanzenprojekt mit Gefäß, Substrat und Beleuchtung'
  else
    assign eyebrow = 'Projects & B2B'
    assign heading = 'Planning bigger? We are open to B2B.'
    assign copy = 'For commercial plant projects, resellers and larger quantities, we connect plants, planters, substrates and lighting into a coherent solution.'
    assign primary = 'Send a B2B enquiry'
    assign secondary = 'View EU shipping'
    assign shipping = 'Shipping from Germany · Delivery across Germany and the EU'
    assign image_alt_default = 'LEAFerservice plant project with planter, substrate and lighting'
  endif
  assign b2b_link = section.settings.b2b_link | default: '/pages/kooperationen-pflanzenprojekte'
  assign shipping_link = section.settings.shipping_link | default: '/pages/versand'
%}
<section class="leaf-prefooter" aria-labelledby="LeafPrefooter-{{ section.id }}">
  <div class="page-width leaf-prefooter__grid">
    <div class="leaf-prefooter__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '420,640,900,1200,1400', sizes: '(min-width: 900px) 42vw, 100vw', loading: 'lazy', alt: section.settings.image.alt | default: image_alt_default }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
    <div class="leaf-prefooter__content">
      <p class="leaf-prefooter__eyebrow">{{ eyebrow }}</p>
      <h2 id="LeafPrefooter-{{ section.id }}">{{ heading }}</h2>
      <p class="leaf-prefooter__copy">{{ copy }}</p>
      <p class="leaf-prefooter__shipping">{{ shipping }}</p>
      {% capture b2b_href %}{% render 'leaf-localized-url', url: b2b_link %}{% endcapture %}
      {% capture shipping_href %}{% render 'leaf-localized-url', url: shipping_link %}{% endcapture %}
      <div class="leaf-prefooter__actions">
        <a class="button" href="{{ b2b_href | strip | escape }}">{{ primary }} <span aria-hidden="true">→</span></a>
        <a class="leaf-prefooter__link" href="{{ shipping_href | strip | escape }}">{{ secondary }} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.leaf-prefooter{padding-block:clamp(2.5rem,6vw,6rem);border-top:1px solid var(--border);background:color-mix(in srgb,var(--surface),#edf1e9 34%)}
.leaf-prefooter__grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);align-items:stretch}
.leaf-prefooter__media{min-height:420px;overflow:hidden;background:var(--surface)}
.leaf-prefooter__media img,.leaf-prefooter__media svg{width:100%;height:100%;object-fit:cover}
.leaf-prefooter__content{display:flex;flex-direction:column;justify-content:center;padding:clamp(2rem,5vw,5rem);border:1px solid var(--border);border-left:0;background:var(--background)}
.leaf-prefooter__eyebrow{margin:0 0 .75rem;color:var(--accent);font-size:.76rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
.leaf-prefooter h2{max-width:14ch;margin:0;font-size: clamp(1.35rem, 2.6vw, 1.9rem);line-height: 1.2;letter-spacing: -.025em}
.leaf-prefooter__copy{max-width:60ch;margin:1.25rem 0 0;color:var(--muted);font-size:clamp(1rem,1.5vw,1.15rem);line-height:1.6}
.leaf-prefooter__shipping{margin:1.5rem 0 0;padding-top:1rem;border-top:1px solid var(--border);font-size:.9rem;font-weight:750}
.leaf-prefooter__actions{display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;margin-top:1.5rem}
.leaf-prefooter__link{color:inherit;font-weight:800;text-decoration-thickness:1px;text-underline-offset:.25em}
@media(max-width:760px){.leaf-prefooter{padding-block:0}.leaf-prefooter__grid{grid-template-columns:1fr}.leaf-prefooter__media{min-height:0;aspect-ratio:4/3}.leaf-prefooter__content{padding:1.5rem 1.25rem 2rem;border-inline:0}.leaf-prefooter h2{font-size: clamp(1.35rem, 2.6vw, 1.9rem)}.leaf-prefooter__actions{align-items:stretch;flex-direction:column}.leaf-prefooter__actions .button,.leaf-prefooter__link{width:100%}.leaf-prefooter__link{padding:.8rem 0}}
{% endstylesheet %}
{% schema %}
{
  "name": "B2B & EU Pre-Footer",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Eigenes Projektbild" },
    { "type": "url", "id": "b2b_link", "label": "B2B-Link" },
    { "type": "url", "id": "shipping_link", "label": "Versand-Link" }
  ],
  "presets": [{ "name": "B2B & EU Pre-Footer" }]
}
{% endschema %}