{% liquid
  assign collection_faq = collection.metafields.leafer.faq.value
  assign collection_keywords = collection.metafields.leafer.keywords.value
  assign collection_guide = collection.metafields.leafer.guide.value
  assign knowledge_atoms = collection.metafields.leafer.knowledge_atoms.value
  assign has_guide = false
  if collection_guide != blank or collection_faq != blank or collection_keywords != blank or knowledge_atoms != blank
    assign has_guide = true
  endif
%}

{% if has_guide %}
  <section class="leaf-collection-guide page-width" id="CollectionKnowledge" aria-labelledby="LeafCollectionGuideHeading-{{ section.id }}">
    <div class="leaf-collection-guide__shell">
      <header class="leaf-collection-guide__intro">
        <span class="leaf-collection-guide__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 5h6c1.2 0 2 .8 2 2v12c0-1.2-.8-2-2-2H4V5Zm16 0h-6c-1.2 0-2 .8-2 2v12c0-1.2.8-2 2-2h6V5Z"/></svg>
        </span>
        <p>{{ 'collection.guide.eyebrow' | t }}</p>
        <h2 id="LeafCollectionGuideHeading-{{ section.id }}">{{ 'collection.guide.heading' | t: collection: collection.title }}</h2>
      </header>

      <div class="leaf-collection-guide__content">
        {% if collection_guide != blank %}
          <details class="leaf-collection-guide__panel">
            <summary class="leaf-collection-guide__panel-heading">
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 20h14M7 17V9l5-4 5 4v8M10 17v-5h4v5"/></svg></span>
              <strong>{% if request.locale.iso_code == 'de' %}Praxiswissen{% else %}Practical guidance{% endif %}</strong>
              <span class="leaf-collection-guide__plus" aria-hidden="true">+</span>
            </summary>
            <div class="leaf-collection-guide__body rte">{{ collection_guide | escape | newline_to_br }}</div>
          </details>
        {% endif %}

        {% if knowledge_atoms != blank %}
          <div class="leaf-collection-guide__knowledge">
            <p class="leaf-collection-guide__knowledge-eyebrow">{{ 'collection.guide.atoms_eyebrow' | t }}</p>
            <h3>{{ 'collection.guide.atoms_heading' | t }}</h3>
            {% render 'leaf-content-atoms', atoms: knowledge_atoms, mode: 'long', limit: 12 %}
          </div>
        {% endif %}

        {% if collection_keywords != blank %}
          <div class="leaf-collection-guide__topics" aria-label="{{ 'collection.guide.topics' | t }}">
            {% for keyword in collection_keywords %}
              <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V10M12 14c-4 0-7-3-7-7 4 0 7 3 7 7ZM12 12c4 0 7-3 7-7-4 0-7 3-7 7Z"/></svg>{{ keyword | escape }}</span>
            {% endfor %}
          </div>
        {% endif %}

        {% if collection_faq != blank %}
          <div class="leaf-collection-guide__faq">
            <div class="leaf-collection-guide__faq-heading">
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 5h14v11H9l-4 4V5ZM9 9h6M9 12h4"/></svg></span>
              <h3>{% if request.locale.iso_code == 'de' %}Häufige Fragen{% else %}Common questions{% endif %}</h3>
            </div>
            {% for item in collection_faq %}
              {% if item.question != blank and item.answer != blank %}
                <details>
                  <summary>
                    <span>{{ item.question | escape }}</span>
                    <span class="leaf-collection-guide__plus" aria-hidden="true">+</span>
                  </summary>
                  <div class="rte">{{ item.answer | escape | newline_to_br }}</div>
                </details>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .leaf-collection-guide { margin-block: var(--space-section); padding-block: clamp(2.5rem, 5vw, 5rem); border-block: 1px solid var(--border); }
  .leaf-collection-guide__shell { display: grid; grid-template-columns: minmax(280px, .72fr) minmax(0, 1.28fr); gap: clamp(2.5rem, 7vw, 7rem); align-items: start; }
  .leaf-collection-guide__intro { position: sticky; top: 110px; }
  .leaf-collection-guide__icon { width: 48px; height: 48px; display: grid; place-items: center; margin-bottom: 1rem; border: 1px solid color-mix(in srgb, var(--accent), transparent 45%); color: var(--accent); }
  .leaf-collection-guide__icon svg, .leaf-collection-guide__panel-heading svg, .leaf-collection-guide__faq-heading svg, .leaf-collection-guide__topics svg { fill: none; stroke: currentColor; stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; }
  .leaf-collection-guide__icon svg { width: 25px; }
  .leaf-collection-guide__intro > p { margin: 0 0 .55rem; color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .leaf-collection-guide h2 { margin: 0; max-width: 14ch; font-size: clamp(2.2rem, 4vw, 3.8rem); line-height: .98; letter-spacing: -.045em; }
  .leaf-collection-guide__intro .rte { margin-top: 1rem; color: var(--muted); line-height: 1.65; }
  .leaf-collection-guide__content { display: grid; gap: 1rem; }
  .leaf-collection-guide__panel, .leaf-collection-guide__knowledge, .leaf-collection-guide__faq { border: 1px solid var(--border); background: var(--surface); padding: clamp(1.1rem, 2vw, 1.6rem); }
  .leaf-collection-guide__knowledge-eyebrow { margin: 0 0 .35rem; color: var(--accent); font-size: .7rem; font-weight: 850; letter-spacing: .11em; text-transform: uppercase; }
  .leaf-collection-guide__knowledge h3 { margin: 0 0 1rem; font-size: clamp(1.35rem, 2.2vw, 1.9rem); }
  .leaf-collection-guide__knowledge .leaf-atoms { margin: 0; }
  .leaf-collection-guide__panel-heading, .leaf-collection-guide__faq-heading { display: flex; align-items: center; gap: .75rem; margin-bottom: 1rem; }
  .leaf-collection-guide__panel > summary { min-height: 58px; margin: 0; cursor: pointer; list-style: none; }
  .leaf-collection-guide__panel > summary::-webkit-details-marker { display: none; }
  .leaf-collection-guide__panel > summary::marker { content: ''; }
  .leaf-collection-guide__panel > summary .leaf-collection-guide__plus { margin-left: auto; }
  .leaf-collection-guide__panel[open] > summary .leaf-collection-guide__plus { transform: rotate(45deg); background: var(--accent); color: #fff; }
  .leaf-collection-guide__panel-heading > span, .leaf-collection-guide__faq-heading > span { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--border); color: var(--accent); }
  .leaf-collection-guide__panel-heading svg, .leaf-collection-guide__faq-heading svg { width: 19px; }
  .leaf-collection-guide__panel-heading strong { font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }
  .leaf-collection-guide__body { max-width: 78ch; padding-top: .35rem; color: var(--muted); line-height: 1.72; }
  .leaf-collection-guide__topics { display: flex; flex-wrap: wrap; gap: .5rem; }
  .leaf-collection-guide__topics span { min-height: 38px; display: inline-flex; align-items: center; gap: .45rem; padding: .45rem .65rem; border: 1px solid var(--border); background: var(--background); font-size: .76rem; font-weight: 750; }
  .leaf-collection-guide__topics svg { width: 16px; color: var(--accent); }
  .leaf-collection-guide__faq-heading h3 { margin: 0; font-size: 1.35rem; }
  .leaf-collection-guide__faq details { border-top: 1px solid var(--border); }
  .leaf-collection-guide__faq details:last-child { border-bottom: 1px solid var(--border); }
  .leaf-collection-guide__faq summary { min-height: 62px; display: flex; justify-content: space-between; gap: 1rem; align-items: center; cursor: pointer; font-weight: 800; list-style: none; }
  .leaf-collection-guide__faq summary::-webkit-details-marker { display: none; }
  .leaf-collection-guide__plus { width: 30px; height: 30px; flex: 0 0 auto; display: grid; place-items: center; border: 1px solid var(--border); transition: transform .2s ease, background .2s ease; }
  .leaf-collection-guide__faq details[open] .leaf-collection-guide__plus { transform: rotate(45deg); background: var(--accent); color: #fff; }
  .leaf-collection-guide__faq .rte { max-width: 70ch; padding: 0 2.5rem 1rem 0; color: var(--muted); line-height: 1.65; }
  @media (max-width: 900px) {
    .leaf-collection-guide__shell { grid-template-columns: 1fr; gap: 2rem; }
    .leaf-collection-guide__intro { position: static; }
    .leaf-collection-guide h2 { max-width: 18ch; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kollektions-Ratgeber",
  "settings": [],
  "presets": [{ "name": "Kollektions-Ratgeber" }]
}
{% endschema %}
