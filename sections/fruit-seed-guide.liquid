{% liquid
  assign first_product = blank
  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank and first_product == blank
      assign first_product = block.settings.product
    endif
  endfor

  assign hero_image = section.settings.image
  if hero_image == blank and first_product != blank
    assign hero_image = first_product.featured_image
  endif
  assign hero_alt = section.settings.image_alt | default: section.settings.heading
%}

<section class="fruit-guide" aria-labelledby="FruitGuideHeading-{{ section.id }}">
  <div class="fruit-guide__hero">
    {% if hero_image != blank %}
      {{ hero_image | image_url: width: 2200 | image_tag: widths: '750, 1100, 1500, 1800, 2200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'fruit-guide__hero-image', alt: hero_alt }}
    {% else %}
      <div class="fruit-guide__hero-placeholder" aria-hidden="true"></div>
    {% endif %}
    <div class="fruit-guide__hero-shade" aria-hidden="true"></div>

    <div class="page-width fruit-guide__hero-copy">
      {% if section.settings.eyebrow != blank %}<p class="fruit-guide__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1 id="FruitGuideHeading-{{ section.id }}">{{ section.settings.heading }}</h1>
      {% if section.settings.intro != blank %}<div class="fruit-guide__intro rte">{{ section.settings.intro }}</div>{% endif %}
      {% if section.settings.collection_link != blank %}<a class="button" href="{{ section.settings.collection_link }}">{{ section.settings.collection_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>

  <div class="page-width fruit-guide__body">
    <ul class="fruit-guide__principles" aria-label="{{ section.settings.principles_label | escape }}">
      {% if section.settings.principle_one != blank %}<li>{{ section.settings.principle_one | escape }}</li>{% endif %}
      {% if section.settings.principle_two != blank %}<li>{{ section.settings.principle_two | escape }}</li>{% endif %}
      {% if section.settings.principle_three != blank %}<li>{{ section.settings.principle_three | escape }}</li>{% endif %}
    </ul>

    <header class="fruit-guide__section-head">
      <p class="fruit-guide__eyebrow">{{ section.settings.products_eyebrow | escape }}</p>
      <h2>{{ section.settings.products_heading | escape }}</h2>
      {% if section.settings.products_intro != blank %}<div class="rte">{{ section.settings.products_intro }}</div>{% endif %}
    </header>

    <div class="fruit-guide__grid">
      {% for block in section.blocks %}
        {% if block.type == 'product' %}
          {% liquid
            assign card_product = block.settings.product
            assign botanical_name = card_product.metafields.leaferservice.botanischer_name.value | default: block.settings.botanical_name
            assign product_intro = card_product.metafields.leafer.intro.value
            if product_intro == blank and card_product != blank
              assign product_intro = card_product.description | strip_html | strip | truncate: 150
            endif
            assign product_price = card_product.price_min | money
            assign product_alt = card_product.featured_image.alt | default: card_product.title
          %}

          {% if card_product != blank %}
            <article class="fruit-guide__card" {{ block.shopify_attributes }}>
              <a class="fruit-guide__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
                {% if card_product.featured_image != blank %}
                  {{ card_product.featured_image | image_url: width: 900 | image_tag: widths: '320, 480, 680, 900', sizes: '(min-width: 1100px) 20vw, (min-width: 700px) 33vw, 100vw', loading: 'lazy', alt: product_alt }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>

              <div class="fruit-guide__card-copy">
                <p class="fruit-guide__card-type">{{ block.settings.badge | default: card_product.type | escape }}</p>
                <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
                {% if botanical_name != blank %}<p class="fruit-guide__botanical"><i>{{ botanical_name | escape }}</i></p>{% endif %}
                {% if block.settings.note != blank %}<p class="fruit-guide__note">{{ block.settings.note | escape }}</p>{% elsif product_intro != blank %}<p class="fruit-guide__note">{{ product_intro | escape }}</p>{% endif %}
                <div class="fruit-guide__commerce">
                  <strong>{% if card_product.price_varies %}{{ 'product.from_price' | t: price: product_price }}{% else %}{{ product_price }}{% endif %}</strong>
                  <span>{% if card_product.available %}{% if request.locale.iso_code == 'de' %}Verfügbar{% else %}Available{% endif %}{% else %}{{ 'product.sold_out' | t }}{% endif %}</span>
                </div>
                <a class="button button--secondary fruit-guide__link" href="{{ card_product.url }}">
                  {% if request.locale.iso_code == 'de' %}Produkt auswählen{% else %}Choose product{% endif %}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

    <aside class="fruit-guide__notice" aria-labelledby="FruitNotice-{{ section.id }}">
      <div aria-hidden="true">i</div>
      <div>
        <h2 id="FruitNotice-{{ section.id }}">{{ section.settings.notice_heading | escape }}</h2>
        <div class="rte">{{ section.settings.notice_text }}</div>
      </div>
    </aside>

    {% if section.settings.steps != blank %}
      <section class="fruit-guide__steps" aria-labelledby="FruitSteps-{{ section.id }}">
        <header class="fruit-guide__section-head">
          <p class="fruit-guide__eyebrow">{{ section.settings.steps_eyebrow | escape }}</p>
          <h2 id="FruitSteps-{{ section.id }}">{{ section.settings.steps_heading | escape }}</h2>
        </header>
        <div class="rte">{{ section.settings.steps }}</div>
      </section>
    {% endif %}

    {% assign faq_blocks = section.blocks | where: 'type', 'faq' %}
    {% if faq_blocks.size > 0 %}
      <section class="fruit-guide__faq" aria-labelledby="FruitFaq-{{ section.id }}">
        <header class="fruit-guide__section-head">
          <p class="fruit-guide__eyebrow">{{ section.settings.faq_eyebrow | escape }}</p>
          <h2 id="FruitFaq-{{ section.id }}">{{ section.settings.faq_heading | escape }}</h2>
        </header>
        <div class="fruit-guide__faq-list">
          {% for block in faq_blocks %}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }} <span aria-hidden="true">+</span></summary>
              <div class="rte">{{ block.settings.answer }}</div>
            </details>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .fruit-guide { background: var(--background); color: var(--text); }
  .fruit-guide__hero { position: relative; min-height: clamp(560px, 70vw, 760px); display: grid; align-items: end; overflow: hidden; background: #31402b; color: #fff; }
  .fruit-guide__hero-image, .fruit-guide__hero-placeholder, .fruit-guide__hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fruit-guide__hero-image { object-fit: cover; object-position: center; }
  .fruit-guide__hero-placeholder { background: radial-gradient(circle at 72% 28%, #9caf83, transparent 24%), linear-gradient(135deg, #26371f, #6f805f); }
  .fruit-guide__hero-shade { background: linear-gradient(90deg, rgba(17,26,14,.88), rgba(17,26,14,.48) 56%, rgba(17,26,14,.1)); }
  .fruit-guide__hero-copy { position: relative; z-index: 1; padding-block: clamp(3rem, 8vw, 6rem); }
  .fruit-guide__eyebrow { margin: 0 0 .7rem; color: var(--accent); font-size: .75rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .fruit-guide__hero .fruit-guide__eyebrow { color: #d8e5c6; }
  .fruit-guide h1 { max-width: 13ch; margin: 0; font-size: clamp(2.8rem, 7vw, 6.5rem); line-height: .93; letter-spacing: -.055em; }
  .fruit-guide__intro { max-width: 680px; margin-top: 1.2rem; font-size: clamp(1rem, 1.8vw, 1.22rem); }
  .fruit-guide__hero .button { margin-top: 1.5rem; gap: .5rem; }
  .fruit-guide__body { padding-block: var(--space-section); }
  .fruit-guide__principles { margin: 0 0 var(--space-section); padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; list-style: none; }
  .fruit-guide__principles li { padding: 1rem 1.15rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); font-weight: 750; text-align: center; }
  .fruit-guide__section-head { max-width: 760px; margin-bottom: 2rem; }
  .fruit-guide__section-head h2, .fruit-guide__notice h2 { margin: 0; font-size: clamp(2rem, 5vw, 4.4rem); line-height: 1; letter-spacing: -.045em; }
  .fruit-guide__section-head .rte { margin-top: 1rem; color: var(--muted); }
  .fruit-guide__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .9rem; }
  .fruit-guide__card { min-width: 0; display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--surface); }
  .fruit-guide__media { aspect-ratio: 4 / 4.5; display: block; overflow: hidden; background: #f2eee5; }
  .fruit-guide__media img, .fruit-guide__media svg { width: 100%; height: 100%; object-fit: contain; }
  .fruit-guide__card-copy { flex: 1; display: flex; flex-direction: column; padding: 1rem; }
  .fruit-guide__card-type { margin: 0 0 .45rem; color: var(--accent); font-size: .67rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .fruit-guide__card h3 { margin: 0; font-size: 1.25rem; line-height: 1.08; }
  .fruit-guide__card h3 a { text-decoration: none; }
  .fruit-guide__botanical { margin: .4rem 0 0; color: var(--accent); font-size: .8rem; }
  .fruit-guide__note { margin: .8rem 0 1rem; color: var(--muted); font-size: .82rem; }
  .fruit-guide__commerce { margin-top: auto; display: flex; justify-content: space-between; gap: .5rem; align-items: baseline; }
  .fruit-guide__commerce span { color: var(--muted); font-size: .72rem; }
  .fruit-guide__link { width: 100%; min-height: 44px; margin-top: .8rem; padding-inline: .75rem; gap: .4rem; font-size: .77rem; }
  .fruit-guide__notice { margin-top: var(--space-section); padding: clamp(1.25rem, 4vw, 2.5rem); display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; border: 1px solid color-mix(in srgb, var(--accent), transparent 65%); border-radius: var(--radius-large); background: color-mix(in srgb, var(--accent), transparent 92%); }
  .fruit-guide__notice > div:first-child { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: var(--accent); color: #fff; font-family: Georgia, serif; font-style: italic; font-weight: 800; }
  .fruit-guide__notice h2 { font-size: clamp(1.6rem, 3vw, 2.5rem); }
  .fruit-guide__notice .rte { max-width: 75ch; margin-top: .75rem; }
  .fruit-guide__steps, .fruit-guide__faq { margin-top: var(--space-section); }
  .fruit-guide__steps > .rte { max-width: 820px; }
  .fruit-guide__steps ol { padding-left: 1.4rem; display: grid; gap: 1rem; }
  .fruit-guide__faq-list { max-width: 900px; border-top: 1px solid var(--border); }
  .fruit-guide__faq details { border-bottom: 1px solid var(--border); }
  .fruit-guide__faq summary { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; list-style: none; font-weight: 800; }
  .fruit-guide__faq summary::-webkit-details-marker { display: none; }
  .fruit-guide__faq summary span { transition: transform .2s ease; }
  .fruit-guide__faq details[open] summary span { transform: rotate(45deg); }
  .fruit-guide__faq details .rte { max-width: 72ch; padding-bottom: 1.2rem; color: var(--muted); }

  @media (max-width: 1180px) { .fruit-guide__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .fruit-guide__principles { grid-template-columns: 1fr; } .fruit-guide__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) { .fruit-guide__hero { min-height: 680px; } .fruit-guide__hero-shade { background: linear-gradient(0deg, rgba(17,26,14,.94), rgba(17,26,14,.38)); } .fruit-guide__grid { grid-template-columns: 1fr; } .fruit-guide__media { aspect-ratio: 16 / 10; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Obstsaatgut Ratgeber",
  "tag": "section",
  "class": "section-fruit-seed-guide",
  "max_blocks": 14,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero-Bild" },
    { "type": "text", "id": "image_alt", "label": "Alternativtext Hero-Bild", "default": "Obstsaatgut und junge Obstpflanzen für die Anzucht" },
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "LEAFerservice · Obstsaatgut" },
    { "type": "inline_richtext", "id": "heading", "label": "Hauptüberschrift", "default": "Obst aus Samen – ein Pflanzenprojekt mit Geduld" },
    { "type": "richtext", "id": "intro", "label": "Einleitung", "default": "<p>Wähle Saatgut nach Standort, Vorbehandlung und deinem Pflanzenziel. Jede Art entwickelt sich in ihrem eigenen Tempo.</p>" },
    { "type": "text", "id": "collection_label", "label": "Buttontext", "default": "Saatgut auswählen" },
    { "type": "url", "id": "collection_link", "label": "Buttonlink" },
    { "type": "text", "id": "principles_label", "label": "Barrierefreie Bezeichnung der Merkmale", "default": "Grundsätze unserer Saatgutberatung" },
    { "type": "text", "id": "principle_one", "label": "Merkmal 1", "default": "Vorbehandlung passend zur Art" },
    { "type": "text", "id": "principle_two", "label": "Merkmal 2", "default": "Keimdauer naturbedingt unterschiedlich" },
    { "type": "text", "id": "principle_three", "label": "Merkmal 3", "default": "Keine pauschalen Erfolgsversprechen" },
    { "type": "text", "id": "products_eyebrow", "label": "Produktbereich Überzeile", "default": "Direkt aus dem Shop" },
    { "type": "text", "id": "products_heading", "label": "Produktbereich Überschrift", "default": "Welches Obstprojekt passt zu dir?" },
    { "type": "richtext", "id": "products_intro", "label": "Produktbereich Einleitung", "default": "<p>Vergleiche Standort, Vorbehandlung und Projektcharakter. Preis und Verfügbarkeit werden live aus Shopify geladen.</p>" },
    { "type": "text", "id": "notice_heading", "label": "Hinweisüberschrift", "default": "Aus Samen entsteht ein genetisch eigenständiges Unikat" },
    { "type": "richtext", "id": "notice_text", "label": "Hinweistext", "default": "<p>Obstpflanzen aus Samen sind keine sortenechten Kopien der Mutterpflanze. Wuchs, Blüte, Frucht und Keimdauer können variieren. Eine feste Keimquote oder spätere Ernte wird nicht zugesichert.</p>" },
    { "type": "text", "id": "steps_eyebrow", "label": "Schritte Überzeile", "default": "Vom Saatkorn zum Jungtrieb" },
    { "type": "text", "id": "steps_heading", "label": "Schritte Überschrift", "default": "So beginnst du kontrolliert" },
    { "type": "richtext", "id": "steps", "label": "Anzuchtschritte", "default": "<ol><li><strong>Art prüfen:</strong> Kläre, ob das Saatgut Wärme oder eine kühle Vorbehandlung braucht.</li><li><strong>Sauber vorbereiten:</strong> Entferne Fruchtreste und nutze ein geeignetes, luftiges Anzuchtmedium.</li><li><strong>Gleichmäßig halten:</strong> Feucht, aber nicht dauerhaft nass; hell, aber Jungtriebe zunächst vor starker Mittagssonne schützen.</li><li><strong>Geduldig beobachten:</strong> Erst umtopfen, wenn Wurzeln und Jungtrieb stabil genug sind.</li></ol>" },
    { "type": "text", "id": "faq_eyebrow", "label": "FAQ Überzeile", "default": "Gut zu wissen" },
    { "type": "text", "id": "faq_heading", "label": "FAQ Überschrift", "default": "Fragen vor der Aussaat" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Saatgutprodukt",
      "settings": [
        { "type": "product", "id": "product", "label": "Shopify-Produkt" },
        { "type": "text", "id": "badge", "label": "Kennzeichnung", "default": "Obstsaatgut" },
        { "type": "text", "id": "botanical_name", "label": "Botanischer Name" },
        { "type": "textarea", "id": "note", "label": "Kurze Entscheidungshilfe" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage" },
        { "type": "richtext", "id": "answer", "label": "Antwort" }
      ]
    }
  ],
  "presets": [{ "name": "Obstsaatgut Ratgeber" }]
}
{% endschema %}
