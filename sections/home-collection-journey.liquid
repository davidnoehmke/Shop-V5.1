{% liquid
  assign section_heading = section.settings.heading
  assign section_intro = section.settings.intro
%}

<section class="home-journey" id="HomeJourney-{{ section.id }}" data-home-journey data-result-prefix="{{ section.settings.result_prefix | escape }}" data-result-suffix="{{ section.settings.result_suffix | escape }}" aria-labelledby="HomeJourneyHeading-{{ section.id }}">
  <div class="page-width">
    <header class="home-journey__header" data-leaf-reveal>
      <div>
        {% if section.settings.eyebrow != blank %}<p class="home-journey__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section_heading != blank %}<h2 id="HomeJourneyHeading-{{ section.id }}">{{ section_heading | escape }}</h2>{% endif %}
        {% if section_intro != blank %}<div class="home-journey__intro rte">{{ section_intro }}</div>{% endif %}
      </div>
      <div class="home-journey__status" data-journey-status aria-live="polite">{{ section.settings.result_prefix }} {{ section.blocks.size }} {{ section.settings.result_suffix }}</div>
    </header>

    <div class="home-journey__filters" role="group" aria-label="{{ section.settings.filter_label | escape }}">
      <button type="button" class="home-journey__filter is-active" data-journey-filter="all" aria-pressed="true">{{ section.settings.filter_all | escape }}</button>
      <button type="button" class="home-journey__filter" data-journey-filter="substrate" aria-pressed="false">{{ section.settings.filter_substrate | escape }}</button>
      <button type="button" class="home-journey__filter" data-journey-filter="interieur" aria-pressed="false">{{ section.settings.filter_interieur | escape }}</button>
      <button type="button" class="home-journey__filter" data-journey-filter="grow" aria-pressed="false">{{ section.settings.filter_grow | escape }}</button>
      <button type="button" class="home-journey__filter" data-journey-filter="equipment" aria-pressed="false">{{ section.settings.filter_equipment | escape }}</button>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="home-journey__grid" role="list" id="HomeJourneyGrid-{{ section.id }}">
        {% for block in section.blocks %}
          {% liquid
            assign selected_collection = block.settings.collection
            assign destination = block.settings.fallback_link
            assign card_title = block.settings.title
            assign card_eyebrow = block.settings.eyebrow
            assign card_badge = block.settings.badge
            assign card_copy = block.settings.copy
            assign card_cta = block.settings.cta_label
            assign card_category = block.settings.category
            assign card_icon = ''

            if selected_collection != blank
              assign destination = selected_collection.url
              assign collection_eyebrow = selected_collection.metafields.custom.homepage_eyebrow.value
              assign collection_intro = selected_collection.metafields.custom.homepage_intro.value
              assign collection_badge = selected_collection.metafields.custom.homepage_badge.value
              assign collection_cta = selected_collection.metafields.custom.homepage_cta.value
              assign collection_icon = selected_collection.metafields.custom.homepage_icon.value

              if card_icon == blank
                assign card_icon = collection_icon
              endif
              if card_title == blank
                assign card_title = selected_collection.title
              endif
              if card_eyebrow == blank
                assign card_eyebrow = collection_eyebrow
              endif
              if card_badge == blank
                assign card_badge = collection_badge
              endif
              if card_copy == blank
                assign card_copy = collection_intro
              endif
              if card_cta == blank
                assign card_cta = collection_cta
              endif
            endif

            if card_title == blank
              assign card_title = block.settings.fallback_title
            endif
            if card_copy == blank
              assign card_copy = block.settings.fallback_copy
            endif
            if card_cta == blank
              assign card_cta = section.settings.card_cta
            endif
            if destination == blank
              assign destination = routes.collections_url
            endif
            if card_icon == blank
              case card_category
                when 'substrate'
                  assign card_icon = 'root'
                when 'interieur'
                  assign card_icon = 'light'
                when 'grow'
                  assign card_icon = 'seedling'
                else
                  assign card_icon = 'care'
              endcase
            endif

            assign card_image_alt = card_title
            if selected_collection.featured_image.alt != blank
              assign card_image_alt = selected_collection.featured_image.alt
            elsif block.settings.image.alt != blank
              assign card_image_alt = block.settings.image.alt
            endif

            assign featured_class = ''
            if forloop.index <= 2
              assign featured_class = ' home-journey__card--featured'
            endif
          %}

          {% if card_title != blank %}
            <article class="home-journey__card{{ featured_class }}" role="listitem" data-journey-card data-category="{{ card_category | escape }}" data-leaf-reveal style="--leaf-delay: {{ forloop.index0 | times: 70 }}ms" {{ block.shopify_attributes }}>
              <a class="home-journey__media" href="{{ destination }}" aria-label="{{ card_title | escape }}">
                {% if selected_collection.featured_image != blank %}
                  {{ selected_collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 600, 900, 1200', sizes: '(min-width: 1180px) 50vw, (min-width: 760px) 50vw, 100vw', alt: card_image_alt }}
                {% elsif block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 600, 900, 1200', sizes: '(min-width: 1180px) 50vw, (min-width: 760px) 50vw, 100vw', alt: card_image_alt }}
                {% else %}
                  <span class="home-journey__placeholder" aria-hidden="true">{{ 'collection-1' | placeholder_svg_tag }}</span>
                {% endif %}
                <span class="home-journey__visual-meta">
                  <span class="home-journey__icon" aria-hidden="true">
                    {% case card_icon %}
                      {% when 'light' %}
                        <svg viewBox="0 0 32 32"><path d="M16 3v3M16 26v3M3 16h3M26 16h3M6.8 6.8l2.1 2.1M23.1 23.1l2.1 2.1M25.2 6.8l-2.1 2.1M8.9 23.1l-2.1 2.1"/><circle cx="16" cy="16" r="6.5"/></svg>
                      {% when 'seedling' %}
                        <svg viewBox="0 0 32 32"><path d="M16 28V14M16 20c-6-.8-10-4.4-10-10 6 0 10 3.5 10 9M16 17c5.6-.7 9.6-4.2 10-10-6 0-10 3.4-10 8.8"/></svg>
                      {% when 'planter' %}
                        <svg viewBox="0 0 32 32"><path d="M9 13h14l-1.8 14H10.8L9 13ZM7 9h18v4H7zM16 9V5M16 7c-4-.4-6.5-2.6-6.5-6 4 0 6.5 2.3 6.5 5.4M16 6c3.8-.4 6.3-2.5 6.5-5.8-4 0-6.5 2.1-6.5 5.2"/></svg>
                      {% when 'care' %}
                        <svg viewBox="0 0 32 32"><path d="M16 4c3.8 5 7 8.8 7 13a7 7 0 0 1-14 0c0-4.2 3.2-8 7-13Z"/><path d="M5 27h22M12 25c1.6-2 2.9-3.2 4-3.2S18.4 23 20 25"/></svg>
                      {% when 'bundle' %}
                        <svg viewBox="0 0 32 32"><path d="M5 11h22v16H5zM3 7h26v4H3zM16 7v20M10 7c-2.2 0-4-1.4-4-3s1.4-2.7 3.3-2.7C12.5 1.3 16 7 16 7M22 7c2.2 0 4-1.4 4-3s-1.4-2.7-3.3-2.7C19.5 1.3 16 7 16 7"/></svg>
                      {% else %}
                        <svg viewBox="0 0 32 32"><path d="M16 29V14M16 23c-6-.8-10-4.7-10-11 6 0 10 3.8 10 9.6M16 18c5.7-.7 9.7-4.4 10-11-6 0-10 3.7-10 9.4M12 29h8"/></svg>
                    {% endcase %}
                  </span>
                  {% if card_badge != blank %}<span class="home-journey__badge">{{ card_badge | escape }}</span>{% endif %}
                </span>
              </a>

              <div class="home-journey__body">
                {% if card_eyebrow != blank %}<p class="home-journey__eyebrow">{{ card_eyebrow | escape }}</p>{% endif %}
                <h3><a href="{{ destination }}">{{ card_title | escape }}</a></h3>
                {% if card_copy != blank %}<p>{{ card_copy | escape }}</p>{% endif %}
                {% if selected_collection != blank %}<span class="home-journey__count">{{ selected_collection.products_count }} {{ section.settings.product_label | escape }}</span>{% endif %}
                <a class="button button--secondary home-journey__link" href="{{ destination }}">{{ card_cta | escape }} <span aria-hidden="true">→</span></a>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
      <p class="home-journey__empty" data-journey-empty hidden>{{ section.settings.empty_label | escape }}</p>
    {% endif %}

    {% if section.settings.all_link != blank %}
      <div class="home-journey__footer" data-leaf-reveal>
        <a class="button" href="{{ section.settings.all_link }}">{{ section.settings.all_label | escape }} <span aria-hidden="true">→</span></a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-journey { padding: var(--space-section) 0; background: linear-gradient(135deg, color-mix(in srgb, var(--surface), var(--background) 28%), var(--background)); }
  .home-journey__header { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.6rem; }
  .home-journey__header > div:first-child { max-width: 800px; }
  .home-journey__eyebrow { margin: 0 0 .8rem; color: var(--accent); font-size: .76rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .home-journey h2 { margin: 0 0 1rem; font-size: clamp(2.2rem, 5vw, 5rem); line-height: .96; letter-spacing: -.055em; }
  .home-journey__intro { max-width: 64ch; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.12rem); }
  .home-journey__status { flex: 0 0 auto; color: var(--muted); font-size: .78rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
  .home-journey__filters { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: 1.35rem; }
  .home-journey__filter { min-height: 42px; padding-inline: 1rem; border: 1px solid var(--border); border-radius: 999px; background: transparent; color: var(--text); font-size: .8rem; }
  .home-journey__filter:hover, .home-journey__filter.is-active { border-color: var(--accent); background: var(--accent); color: #fff; }
  .home-journey__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1rem; }
  .home-journey__card { grid-column: span 3; min-width: 0; display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-large); background: var(--background); box-shadow: 0 14px 38px color-mix(in srgb, var(--text), transparent 94%); transition: transform .35s var(--ease-out), box-shadow .35s var(--ease-out), border-color .25s ease; }
  .home-journey__card--featured { grid-column: span 6; }
  .home-journey__media { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--accent-soft); }
  .home-journey__card--featured .home-journey__media { aspect-ratio: 16 / 9; }
  .home-journey__media img, .home-journey__placeholder, .home-journey__placeholder svg { width: 100%; height: 100%; object-fit: cover; }
  .home-journey__media img { transition: transform .65s var(--ease-out), filter .35s ease; }
  .home-journey__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5,12,7,.12), transparent 45%, rgba(5,12,7,.16)); pointer-events: none; }
  .home-journey__visual-meta { position: absolute; z-index: 2; inset: .8rem .8rem auto; display: flex; align-items: center; justify-content: space-between; gap: .65rem; pointer-events: none; }
  .home-journey__icon { width: 46px; height: 46px; flex: 0 0 46px; display: grid; place-items: center; border: 1px solid color-mix(in srgb, #fff, transparent 48%); border-radius: 50%; background: color-mix(in srgb, var(--text), transparent 14%); color: #fff; backdrop-filter: blur(10px); box-shadow: 0 7px 22px rgba(0,0,0,.16); }
  .home-journey__icon svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; }
  .home-journey__badge { padding: .4rem .65rem; border: 1px solid color-mix(in srgb, #fff, transparent 50%); border-radius: 999px; background: color-mix(in srgb, var(--text), transparent 12%); color: #fff; font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; backdrop-filter: blur(8px); }
  .home-journey__body { flex: 1; display: flex; flex-direction: column; padding: 1.2rem; }
  .home-journey__body .home-journey__eyebrow { margin-bottom: .45rem; font-size: .68rem; }
  .home-journey h3 { margin: 0 0 .6rem; font-size: clamp(1.25rem, 2.2vw, 2.15rem); line-height: 1.02; letter-spacing: -.03em; }
  .home-journey h3 a { text-decoration: none; }
  .home-journey__body > p:not(.home-journey__eyebrow) { margin: 0 0 .8rem; color: var(--muted); font-size: .86rem; line-height: 1.55; }
  .home-journey__count { margin-top: auto; color: var(--muted); font-size: .72rem; font-weight: 750; }
  .home-journey__link { width: 100%; min-height: 44px; margin-top: 1rem; padding-inline: .9rem; gap: .45rem; font-size: .78rem; }
  .home-journey__link span, .home-journey__footer .button span { transition: transform .25s var(--ease-out); }
  .home-journey__link:hover span, .home-journey__footer .button:hover span { transform: translateX(.2rem); }
  .home-journey__empty { margin: 1.5rem 0 0; color: var(--muted); text-align: center; }
  .home-journey__footer { display: flex; justify-content: center; margin-top: 2rem; }
  .home-journey__footer .button { gap: .6rem; }
  .home-journey__card[hidden] { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .home-journey__card:hover { transform: translateY(-7px); border-color: color-mix(in srgb, var(--accent), transparent 58%); box-shadow: var(--shadow-soft); }
    .home-journey__card:hover .home-journey__media img { transform: scale(1.05); filter: saturate(1.04); }
  }

  @media (max-width: 1000px) { .home-journey__card { grid-column: span 4; } .home-journey__card--featured { grid-column: span 6; } }
  @media (max-width: 760px) { .home-journey__header { align-items: start; flex-direction: column; gap: .7rem; } .home-journey__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .home-journey__card, .home-journey__card--featured { grid-column: span 1; } .home-journey__card--featured .home-journey__media { aspect-ratio: 4 / 3; } }
  @media (max-width: 560px) { .home-journey { padding-block: 3.2rem; } .home-journey__filters { flex-wrap: nowrap; overflow-x: auto; padding-bottom: .3rem; scrollbar-width: none; } .home-journey__filters::-webkit-scrollbar { display: none; } .home-journey__filter { flex: 0 0 auto; } .home-journey__grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(82vw, 330px); gap: .8rem; overflow-x: auto; padding: .1rem 0 .7rem; scroll-snap-type: x mandatory; overscroll-behavior-inline: contain; scrollbar-width: none; } .home-journey__grid::-webkit-scrollbar { display: none; } .home-journey__card, .home-journey__card--featured { scroll-snap-align: start; } .home-journey__visual-meta { inset: .65rem .65rem auto; } .home-journey__icon { width: 42px; height: 42px; flex-basis: 42px; } .home-journey__body { padding: 1rem; } .home-journey__footer .button { width: 100%; } }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-home-journey]').forEach((root) => {
    const buttons = [...root.querySelectorAll('[data-journey-filter]')];
    const cards = [...root.querySelectorAll('[data-journey-card]')];
    const status = root.querySelector('[data-journey-status]');
    const empty = root.querySelector('[data-journey-empty]');
    const prefix = root.dataset.resultPrefix || '';
    const suffix = root.dataset.resultSuffix || '';

    const update = (filter) => {
      let visible = 0;
      cards.forEach((card) => {
        const isVisible = filter === 'all' || card.dataset.category === filter;
        card.hidden = !isVisible;
        card.setAttribute('aria-hidden', String(!isVisible));
        if (isVisible) visible += 1;
      });
      buttons.forEach((button) => {
        const isActive = button.dataset.journeyFilter === filter;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });
      if (status) status.textContent = `${prefix} ${visible} ${suffix}`.trim();
      if (empty) empty.hidden = visible !== 0;
    };

    buttons.forEach((button) => button.addEventListener('click', () => update(button.dataset.journeyFilter)));
  });
{% endjavascript %}

{% schema %}
{
  "name": "Home Systemfinder",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Nach deinem Projekt" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Finde den passenden Einstieg" },
    { "type": "richtext", "id": "intro", "label": "Einleitung", "default": "<p>Substrat, Raumgestaltung, Anzucht oder Ausstattung: Wähle deinen nächsten sinnvollen Schritt.</p>" },
    { "type": "text", "id": "filter_label", "label": "Filterbezeichnung", "default": "Sortiment filtern" },
    { "type": "text", "id": "filter_all", "label": "Filter alle", "default": "Alles" },
    { "type": "text", "id": "filter_substrate", "label": "Filter Substrat", "default": "Substrat & Wurzelraum" },
    { "type": "text", "id": "filter_interieur", "label": "Filter Interieur", "default": "Interieur Solutions" },
    { "type": "text", "id": "filter_grow", "label": "Filter Anzucht", "default": "Anzucht & Aussaat" },
    { "type": "text", "id": "filter_equipment", "label": "Filter Ausstattung", "default": "Gefäße & Pflege" },
    { "type": "text", "id": "result_prefix", "label": "Ergebnis-Präfix", "default": "Sichtbar:" },
    { "type": "text", "id": "result_suffix", "label": "Ergebnis-Suffix", "default": "Bereiche" },
    { "type": "text", "id": "product_label", "label": "Produktbezeichnung", "default": "Produkte" },
    { "type": "text", "id": "card_cta", "label": "Standard-CTA", "default": "Entdecken" },
    { "type": "text", "id": "empty_label", "label": "Leertext", "default": "Für diesen Filter sind aktuell keine Bereiche hinterlegt." },
    { "type": "text", "id": "all_label", "label": "CTA gesamtes Sortiment", "default": "Gesamtes Sortiment ansehen" },
    { "type": "url", "id": "all_link", "label": "Link gesamtes Sortiment" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "select", "id": "category", "label": "Bereich", "options": [
          { "value": "substrate", "label": "Substrat & Wurzelraum" },
          { "value": "interieur", "label": "Interieur Solutions" },
          { "value": "grow", "label": "Anzucht & Aussaat" },
          { "value": "equipment", "label": "Gefäße & Pflege" }
        ], "default": "substrate" },
        { "type": "image_picker", "id": "image", "label": "Fallback-Bild" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow-Override" },
        { "type": "text", "id": "badge", "label": "Badge-Override" },
        { "type": "text", "id": "title", "label": "Titel-Override" },
        { "type": "textarea", "id": "copy", "label": "Text-Override" },
        { "type": "text", "id": "cta_label", "label": "CTA-Override" },
        { "type": "url", "id": "fallback_link", "label": "Fallback-Link" },
        { "type": "text", "id": "fallback_title", "label": "Fallback-Titel" },
        { "type": "textarea", "id": "fallback_copy", "label": "Fallback-Text" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Home Systemfinder", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
