{% if collection.handle == 'venso' %}
{% paginate collection.products by 24 %}
{% liquid
  assign hero = all_products['venso-sunlite-xl-25w-led-pflanzenlampe']
  if hero == blank or hero.featured_image == blank
    assign hero = collection.products.first
  endif
  assign hero_alt = hero.featured_image.alt | default: hero.title
  assign visible_count = 0
%}
<div class="venso-landing">
  <header class="venso-landing__hero">
    <div class="venso-landing__hero-copy">
      <p class="venso-landing__kicker">{{ 'sections.venso-brand-landing.kicker' | t }}</p>
      <h1>{{ 'sections.venso-brand-landing.title' | t }}</h1>
      <p class="venso-landing__lead">{{ 'sections.venso-brand-landing.lead' | t }}</p>
      <div class="venso-landing__actions">
        <a class="venso-landing__button venso-landing__button--primary" href="#venso-auswahl">{{ 'sections.venso-brand-landing.explore' | t }} <span aria-hidden="true">↗</span></a>
        <a class="venso-landing__button venso-landing__button--secondary" href="#venso-produkte">{{ 'sections.venso-brand-landing.all' | t }}</a>
      </div>
      <p class="venso-landing__signal">{{ 'sections.venso-brand-landing.signal' | t }}</p>
    </div>
    <div class="venso-landing__hero-media">
      <span class="venso-landing__halo" aria-hidden="true"></span>
      {% if hero != blank and hero.featured_image != blank %}
        {{ hero.featured_image | image_url: width: 1200 | image_tag: class: 'venso-landing__hero-image', widths: '400,600,800,1000,1200', sizes: '(min-width: 900px) 42vw, 90vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
      {% endif %}
      <span class="venso-landing__media-caption">VENSO <small>{{ 'sections.venso-brand-landing.hero_caption' | t }}</small></span>
    </div>
  </header>
  <div class="venso-landing__inner">
    <section class="venso-landing__chooser" id="venso-auswahl" aria-labelledby="VensoChooser-{{ section.id }}">
      <header class="venso-landing__intro">
        <p class="venso-landing__kicker">{{ 'sections.venso-brand-landing.selector_tag' | t }}</p>
        <h2 id="VensoChooser-{{ section.id }}">{{ 'sections.venso-brand-landing.selector_title' | t }}</h2>
        <p>{{ 'sections.venso-brand-landing.selector_text' | t }}</p>
      </header>
      <nav class="venso-landing__jumps" aria-label="{{ 'sections.venso-brand-landing.nav_label' | t | escape }}">
        <a href="#venso-product-sunlite-7w-led-pflanzenlampe-mit-teleskopstab"><b>01</b>{{ 'sections.venso-brand-landing.nav_single' | t }} <span aria-hidden="true">↗</span></a>
        <a href="#venso-product-venso-sunlite-xl-25w-led-pflanzenlampe"><b>02</b>{{ 'sections.venso-brand-landing.nav_large' | t }} <span aria-hidden="true">↗</span></a>
        <a href="#venso-product-venso-e27-pflanzenlampe-indoor-plants-7w-15w"><b>03</b>{{ 'sections.venso-brand-landing.nav_e27' | t }} <span aria-hidden="true">↗</span></a>
        <a href="#venso-product-venso-led-wall-spot-pflanzenleuchte-60-150-cm"><b>04</b>{{ 'sections.venso-brand-landing.nav_wall' | t }} <span aria-hidden="true">↗</span></a>
      </nav>
    </section>
    <section class="venso-landing__catalog" id="venso-produkte" aria-labelledby="VensoCatalog-{{ section.id }}">
      <header class="venso-landing__intro">
        <p class="venso-landing__kicker">{{ 'sections.venso-brand-landing.catalog_tag' | t }}</p>
        <h2 id="VensoCatalog-{{ section.id }}">{{ 'sections.venso-brand-landing.catalog_title' | t }}</h2>
        <p>{{ 'sections.venso-brand-landing.catalog_text' | t }}</p>
      </header>
      <div class="venso-landing__products">
        {% for product in collection.products %}
          {% if product.vendor contains 'Venso' %}
            {% liquid
              assign visible_count = visible_count | plus: 1
              assign label = 'sections.venso-brand-landing.group_general'
              if product.handle contains 'sunlite-xl'
                assign label = 'sections.venso-brand-landing.group_large'
              elsif product.handle contains 'sunlite-7w'
                assign label = 'sections.venso-brand-landing.group_single'
              elsif product.handle contains 'indoor-plants'
                assign label = 'sections.venso-brand-landing.group_e27'
              elsif product.handle contains 'grow-light-winter'
                assign label = 'sections.venso-brand-landing.group_winter'
              elsif product.handle contains 'grow-light-cultura'
                assign label = 'sections.venso-brand-landing.group_cultura'
              elsif product.handle contains 'grow-light-flexia'
                assign label = 'sections.venso-brand-landing.group_flexia'
              elsif product.handle contains 'wall-spot'
                assign label = 'sections.venso-brand-landing.group_wall'
              endif
              assign intro = product.metafields.leafer.subtitle.value | default: product.metafields.leafer.primary_function.value
              if intro == blank
                assign intro = product.description | strip_html | truncatewords: 22
              endif
              assign alt = product.featured_image.alt | default: product.title
              assign power = product.metafields.lighting.rated_power_w.value
              assign beam = product.metafields.lighting.beam_angle.value
              assign socket = product.metafields.lighting.socket_connector.value
            %}
            <article class="venso-landing__product" id="venso-product-{{ product.handle }}">
              <div class="venso-landing__product-media">
                {% if product.featured_image != blank %}
                  {{ product.featured_image | image_url: width: 1100 | image_tag: class: 'venso-landing__photo', widths: '360,540,720,900,1100', sizes: '(min-width: 1000px) 43vw, 94vw', loading: 'lazy', alt: alt }}
                {% else %}
                  <span class="venso-landing__no-photo" aria-hidden="true">VENSO</span>
                {% endif %}
                <span class="venso-landing__photo-brand" aria-hidden="true">VENSO</span>
              </div>
              <div class="venso-landing__product-copy">
                <p class="venso-landing__product-label"><span>{{ forloop.index | prepend: '0' }}</span> {{ label | t }}</p>
                <h3>{{ product.title | escape }}</h3>
                <p class="venso-landing__description">{{ intro | strip_html | escape }}</p>
                <dl class="venso-landing__specs">
                  {% if power != blank %}<div><dt>{{ 'sections.venso-brand-landing.power' | t }}</dt><dd>{{ power }} W</dd></div>{% endif %}
                  {% if beam != blank %}<div><dt>{{ 'sections.venso-brand-landing.beam' | t }}</dt><dd>{{ beam | escape }}</dd></div>{% endif %}
                  {% if socket != blank %}<div><dt>{{ 'sections.venso-brand-landing.socket' | t }}</dt><dd>{{ socket | escape }}</dd></div>{% endif %}
                </dl>
                <div class="venso-landing__buy">
                  <div class="venso-landing__price">{% if product.price_varies %}<small>{{ 'sections.venso-brand-landing.from' | t }}</small>{% endif %}<strong>{{ product.price | money }}</strong></div>
                  <a class="venso-landing__button venso-landing__button--primary" href="{{ product.url }}">{{ 'sections.venso-brand-landing.view' | t }} <span aria-hidden="true">↗</span></a>
                </div>
                <p class="venso-landing__availability">{{ 'sections.venso-brand-landing.availability' | t }}</p>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
      {% if visible_count == 0 %}<p class="venso-landing__empty">{{ 'sections.venso-brand-landing.empty' | t }}</p>{% endif %}
      {% if paginate.pages > 1 %}<nav class="venso-landing__pagination" aria-label="{{ 'sections.venso-brand-landing.pagination' | t | escape }}">{{ paginate | default_pagination }}</nav>{% endif %}
    </section>
    <aside class="venso-landing__consult" aria-labelledby="VensoConsult-{{ section.id }}">
      <div><p class="venso-landing__kicker">{{ 'sections.venso-brand-landing.consult_tag' | t }}</p><h2 id="VensoConsult-{{ section.id }}">{{ 'sections.venso-brand-landing.consult_title' | t }}</h2><p>{{ 'sections.venso-brand-landing.consult_text' | t }}</p></div>
      <a class="venso-landing__button venso-landing__button--light" href="mailto:management@leaferservice.com?subject=VENSO%20Lichtberatung">{{ 'sections.venso-brand-landing.consult_cta' | t }} <span aria-hidden="true">↗</span></a>
    </aside>
    {% if section.settings.show_faq %}
      <section class="venso-landing__faq" aria-labelledby="VensoFaq-{{ section.id }}">
        <header class="venso-landing__intro"><p class="venso-landing__kicker">{{ 'sections.venso-brand-landing.faq_tag' | t }}</p><h2 id="VensoFaq-{{ section.id }}">{{ 'sections.venso-brand-landing.faq_title' | t }}</h2></header>
        <div class="venso-landing__faq-list">
          <details><summary>{{ 'sections.venso-brand-landing.q1' | t }}</summary><p>{{ 'sections.venso-brand-landing.a1' | t }}</p></details>
          <details><summary>{{ 'sections.venso-brand-landing.q2' | t }}</summary><p>{{ 'sections.venso-brand-landing.a2' | t }}</p></details>
          <details><summary>{{ 'sections.venso-brand-landing.q3' | t }}</summary><p>{{ 'sections.venso-brand-landing.a3' | t }}</p></details>
        </div>
      </section>
    {% endif %}
    <p class="venso-landing__footer">{{ 'sections.venso-brand-landing.footer' | t }}</p>
  </div>
</div>
{% endpaginate %}
{% endif %}

{% stylesheet %}
.venso-landing{--vl-ink:#183428;--vl-green:#244d3a;--vl-muted:#63766a;--vl-line:#dee8dd;color:var(--vl-ink);font-family:Helvetica,"Helvetica Neue",Arial,sans-serif}
.venso-landing *{box-sizing:border-box}
.venso-landing a{text-decoration:none}
.venso-landing__hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);background:#f1f5ee;min-height:480px;overflow:hidden}
.venso-landing__hero-copy{align-self:center;padding:clamp(2rem,5vw,5rem) clamp(1.25rem,5vw,6rem)}
.venso-landing__kicker{color:#578063;text-transform:uppercase;letter-spacing:.13em;font-size:.68rem;font-weight:750;margin:0 0 1rem}
.venso-landing h1,.venso-landing h2,.venso-landing h3{font-family:inherit;color:var(--vl-ink);letter-spacing:-.04em}
.venso-landing h1{font-size:clamp(2rem,4.2vw,3.6rem);line-height:1.08;max-width:15ch;margin:0 0 1.25rem}
.venso-landing__lead{font-size:clamp(.91rem,1.4vw,1.04rem);line-height:1.72;max-width:55ch;color:#4e6654;margin:0}
.venso-landing__actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:1.7rem 0}
.venso-landing__button{display:inline-flex;align-items:center;justify-content:center;gap:1rem;min-height:44px;padding:.8rem 1.15rem;border-radius:3px;font-size:.81rem;font-weight:700;line-height:1.3;transition:background .2s,border-color .2s}
.venso-landing__button--primary{background:var(--vl-green);border:1px solid var(--vl-green);color:white}
.venso-landing__button--primary:hover{background:#183b2b;color:white}
.venso-landing__button--secondary{background:transparent;border:1px solid #9fb7a4;color:var(--vl-green)}
.venso-landing__button--secondary:hover{background:#e6ede2}
.venso-landing__signal{font-size:.7rem;color:#6c836f;letter-spacing:.015em}
.venso-landing__hero-media{position:relative;display:flex;justify-content:center;align-items:center;isolation:isolate;min-width:0;padding:2rem;background:radial-gradient(circle,#f8faf5 0%,#dbe8d9 70%,#d3e3d5 100%)}
.venso-landing__halo{position:absolute;z-index:-1;border:1px solid #bdcfbd;width:min(78%,440px);aspect-ratio:1;border-radius:50%;box-shadow:0 0 0 60px #cbdcc93d}
.venso-landing__hero-image{max-width:100%;max-height:430px;object-fit:contain;filter:drop-shadow(0 14px 20px #173c2733)}
.venso-landing__media-caption{position:absolute;bottom:1.2rem;left:2rem;display:flex;gap:.75rem;align-items:center;font-size:.76rem;letter-spacing:.18em;font-weight:750;color:#43694d}
.venso-landing__media-caption small{letter-spacing:normal;font-size:.65rem;font-weight:400}
.venso-landing__inner{width:min(100% - 3rem,1220px);margin:0 auto}
.venso-landing__chooser{padding:clamp(2.5rem,5.5vw,4.5rem) 0 0;scroll-margin-top:2rem}
.venso-landing__intro{max-width:700px;margin:0 0 1.75rem}
.venso-landing__intro h2{font-size:clamp(1.5rem,2.5vw,2.15rem);line-height:1.2;margin:0 0 .7rem}
.venso-landing__intro>p:last-child{color:var(--vl-muted);font-size:.87rem;line-height:1.7;margin:0}
.venso-landing__jumps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem}
.venso-landing__jumps a{display:flex;align-items:center;gap:.65rem;background:#f6f9f4;border:1px solid var(--vl-line);color:var(--vl-ink);padding:1.1rem .85rem;font-size:.81rem;font-weight:700}
.venso-landing__jumps a:hover{background:#e9f1e6;border-color:#86a68c}
.venso-landing__jumps b{font-weight:600;color:#629370;font-size:.7rem}
.venso-landing__jumps span{margin-left:auto;color:#629370}
.venso-landing__catalog{padding:clamp(3rem,6vw,5rem) 0 0;scroll-margin-top:2rem}
.venso-landing__products{display:grid;gap:clamp(1.5rem,3vw,2.7rem)}
.venso-landing__product{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);min-width:0;background:#fff;border:1px solid var(--vl-line);scroll-margin-top:2rem}
.venso-landing__product:nth-child(even) .venso-landing__product-media{order:2}
.venso-landing__product:nth-child(even) .venso-landing__product-copy{order:1}
.venso-landing__product-media{position:relative;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#f7f9f4,#ebf1e9);padding:2rem;min-height:340px;overflow:hidden}
.venso-landing__photo{width:100%;height:320px;object-fit:contain;transition:transform .25s}
.venso-landing__photo-brand{position:absolute;bottom:1rem;left:1.4rem;color:#87a58d;letter-spacing:.2em;font-size:.7rem;font-weight:750}
.venso-landing__no-photo{color:#87a58d;letter-spacing:.2em}
.venso-landing__product-copy{display:flex;flex-direction:column;justify-content:center;min-width:0;padding:clamp(1.5rem,4vw,3.6rem)}
.venso-landing__product-label{display:flex;gap:.7rem;align-items:center;font-size:.69rem;text-transform:uppercase;letter-spacing:.08em;font-weight:750;color:#598265}
.venso-landing__product h3{font-size:clamp(1.28rem,2.1vw,2rem);line-height:1.2;overflow-wrap:anywhere;margin:1rem 0 .7rem}
.venso-landing__description{font-size:.88rem;color:var(--vl-muted);line-height:1.7;margin:0}
.venso-landing__specs{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.4rem 0}
.venso-landing__specs div{padding:.65rem .75rem;min-width:72px;background:#f2f7f1;border:1px solid #e4ece2}
.venso-landing__specs dt{color:#718679;font-size:.62rem}
.venso-landing__specs dd{font-size:.79rem;color:#294b37;font-weight:750;margin:.2rem 0 0}
.venso-landing__buy{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.venso-landing__price{display:flex;flex-direction:column;gap:.15rem}
.venso-landing__price small{font-size:.67rem;color:var(--vl-muted)}
.venso-landing__price strong{font-size:1.27rem;letter-spacing:-.03em}
.venso-landing__availability{color:#738579;font-size:.7rem;line-height:1.6;margin:1rem 0 0}
.venso-landing__consult{display:flex;align-items:center;justify-content:space-between;gap:2rem;margin:clamp(2.5rem,5vw,5rem) 0 0;padding:clamp(1.75rem,5vw,4rem);background:#1c3f30;color:#e3f1e3}
.venso-landing__consult .venso-landing__kicker{color:#b3d2b5}
.venso-landing__consult h2{color:#fff;font-size:clamp(1.55rem,2.5vw,2.25rem);margin:0 0 .8rem;line-height:1.2}
.venso-landing__consult p:last-child{max-width:60ch;color:#caddcc;font-size:.87rem;line-height:1.65}
.venso-landing__button--light{color:#1e432e;background:#e0edd9;border:1px solid #e0edd9;flex-shrink:0}
.venso-landing__button--light:hover{background:#fff}
.venso-landing__faq{padding:clamp(3rem,5vw,4.5rem) 0 2rem}
.venso-landing__faq-list{border-top:1px solid var(--vl-line)}
.venso-landing__faq details{border-bottom:1px solid var(--vl-line)}
.venso-landing__faq summary{position:relative;cursor:pointer;list-style:none;font-weight:700;font-size:.91rem;padding:1.2rem 2rem 1.2rem 0}
.venso-landing__faq summary::-webkit-details-marker{display:none}
.venso-landing__faq summary:after{content:"+";position:absolute;right:.4rem;top:1rem;font-size:1.2rem;color:#759477}
.venso-landing__faq details[open] summary:after{content:"−"}
.venso-landing__faq details p{max-width:82ch;color:var(--vl-muted);font-size:.87rem;line-height:1.75;margin:0 0 1.2rem}
.venso-landing__empty{padding:2rem;background:#f4f8f2}
.venso-landing__pagination{padding:1.5rem;text-align:center}
.venso-landing__footer{text-align:center;padding:0 0 2rem;color:#728477;font-size:.7rem}
.venso-landing a:focus-visible,.venso-landing summary:focus-visible{outline:3px solid #4e936c;outline-offset:3px}
@media(hover:hover) and (prefers-reduced-motion:no-preference){.venso-landing__product:hover .venso-landing__photo{transform:scale(1.035)}}
@media(max-width:980px){.venso-landing__hero-copy{padding:2rem}.venso-landing__jumps{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.venso-landing__hero{grid-template-columns:1fr;min-height:0}.venso-landing__hero-copy{padding:2rem 1.2rem 1.5rem}.venso-landing h1{font-size:clamp(1.85rem,7vw,2.5rem)}.venso-landing__hero-media{min-height:260px;padding:1.7rem}.venso-landing__hero-image{max-height:280px}.venso-landing__inner{width:min(100% - 2rem,1220px)}.venso-landing__product{grid-template-columns:1fr}.venso-landing__product:nth-child(even) .venso-landing__product-media,.venso-landing__product:nth-child(even) .venso-landing__product-copy{order:initial}.venso-landing__product-media{min-height:225px;padding:1rem}.venso-landing__photo{height:220px}.venso-landing__product-copy{padding:1.3rem}.venso-landing__product h3{font-size:1.33rem}.venso-landing__intro h2{font-size:1.55rem}.venso-landing__consult{flex-direction:column;align-items:flex-start;padding:1.7rem}.venso-landing__button--light{width:100%}}
@media(max-width:420px){.venso-landing__actions{display:grid}.venso-landing__jumps{gap:.45rem}.venso-landing__jumps a{font-size:.73rem;padding:.85rem .6rem}.venso-landing__photo{height:195px}.venso-landing__buy .venso-landing__button{width:100%}}
@media(prefers-reduced-motion:reduce){.venso-landing__button,.venso-landing__photo{transition:none}}
{% endstylesheet %}

