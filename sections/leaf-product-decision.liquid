{% liquid
  assign subtitle = product.metafields.leafer.subtitle.value
  assign intro = product.metafields.leafer.intro.value
  assign primary_function = product.metafields.leafer.primary_function.value
  assign suitable_for = product.metafields.leafer.suitable_for.value
  assign water_behavior = product.metafields.leafer.water_behavior.value
  assign mixing_ratio = product.metafields.leafer.mixing_ratio.value
  assign application = product.metafields.leafer.additive_application.value
  assign warning = product.metafields.leafer.warning.value
  assign configurator_enabled = product.metafields.leaf_configurator.enabled.value
  assign configurator_role = product.metafields.leaf_configurator.role.value
  assign plant_groups = product.metafields.leaf_configurator.plant_groups.value
  assign volume_liters = product.metafields.leaf_configurator.volume_liters.value
  assign manufacturer = product.metafields.lighting.manufacturer.value
  assign model = product.metafields.lighting.model.value
  assign rated_power = product.metafields.lighting.rated_power_w.value
  assign spectrum = product.metafields.lighting.spectrum.value
  assign cct = product.metafields.lighting.cct_k.value
  assign beam_angle = product.metafields.lighting.beam_angle.value
  assign ppfd = product.metafields.lighting.ppfd_reference.value
  assign coverage = product.metafields.lighting.coverage_guidance.value
  assign distance = product.metafields.lighting.recommended_distance.value
  assign mounting = product.metafields.lighting.mounting.value
  assign ip_rating = product.metafields.lighting.ip_rating.value
  assign voltage = product.metafields.lighting.voltage.value
  assign socket_connector = product.metafields.lighting.socket_connector.value
  assign use_cases = product.metafields.lighting.use_cases.value
  assign safety = product.metafields.lighting.safety_notes.value
  assign manual_url = product.metafields.lighting.manual_url.value
  assign is_lighting = false
  if product.metafields.lighting.manufacturer.value != blank or configurator_role == 'plant_light_recommendation' or configurator_role == 'aquascape_light_configurator' or configurator_role == 'plant_station'
    assign is_lighting = true
  endif
  assign advisor_collection = collection
  if advisor_collection == blank and product.collections.first != blank
    assign advisor_collection = product.collections.first
  endif
  if advisor_collection != blank
    assign advisor_url = advisor_collection.url | append: '#LeafAdvisor'
  else
    assign advisor_url = routes.collections_url | append: '/all#LeafAdvisor'
  endif
  assign configurator_title = 'product.decision.advisor_title' | t
  assign configurator_text = 'product.decision.advisor_text' | t
  assign has_content = false
  if subtitle != blank or intro != blank or primary_function != blank or suitable_for != blank or water_behavior != blank or mixing_ratio != blank or application != blank or warning != blank or manufacturer != blank or model != blank or rated_power != blank or spectrum != blank or cct != blank or beam_angle != blank or ppfd != blank or coverage != blank or distance != blank or mounting != blank or ip_rating != blank or voltage != blank or socket_connector != blank or use_cases != blank or safety != blank or manual_url != blank
    assign has_content = true
  endif
%}

{% if has_content %}
<section class="leaf-knowledge page-width" aria-labelledby="LeafKnowledgeHeading-{{ section.id }}">
  <header class="leaf-knowledge__head">
    <div>
      <p class="leaf-knowledge__eyebrow">{{ 'product.decision.eyebrow' | t }}</p>
      <h2 id="LeafKnowledgeHeading-{{ section.id }}">{{ 'product.decision.heading' | t }}</h2>
    </div>
    {% if subtitle != blank %}<p class="leaf-knowledge__lead">{{ subtitle | escape }}</p>{% endif %}
    {% if intro != blank %}<div class="leaf-knowledge__intro rte">{{ intro | escape | newline_to_br }}</div>{% endif %}
  </header>

  <div class="leaf-knowledge__clusters">
    {% if is_lighting %}
      {% if manufacturer != blank or model != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">◇</span><span>{{ 'product.decision.identity' | t }}</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% if manufacturer != blank %}{{ manufacturer | escape }}{% endif %}{% if model != blank %}<br>{{ model | escape }}{% endif %}</div>
        </details>
      {% endif %}
      {% if rated_power != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">↯</span><span>Leistung</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{{ rated_power | escape }} W</div>
        </details>
      {% endif %}
      {% if spectrum != blank or cct != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">☼</span><span>Spektrum</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% if spectrum != blank %}{{ spectrum | escape }}{% endif %}{% if cct != blank %}<br>{{ cct | escape }}{% endif %}</div>
        </details>
      {% endif %}
      {% if coverage != blank or distance != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">⌖</span><span>Fläche & Abstand</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% if coverage != blank %}{{ coverage | escape }}{% endif %}{% if distance != blank %}<br>{{ distance | escape }}{% endif %}</div>
        </details>
      {% endif %}
      {% if beam_angle != blank or ppfd != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">↔</span><span>{{ 'product.decision.light_distribution' | t }}</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% if beam_angle != blank %}{{ 'product.decision.beam_angle' | t }}: {{ beam_angle | escape }}{% endif %}{% if ppfd != blank %}<br>{{ ppfd | escape }}{% endif %}</div>
        </details>
      {% endif %}
      {% if mounting != blank or socket_connector != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">⌂</span><span>{{ 'product.decision.installation' | t }}</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% if mounting != blank %}{{ mounting | escape }}{% endif %}{% if socket_connector != blank %}<br>{{ socket_connector | escape }}{% endif %}</div>
        </details>
      {% endif %}
      {% if ip_rating != blank or voltage != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">□</span><span>{{ 'product.decision.electrical' | t }}</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% if voltage != blank %}{{ voltage | escape }}{% endif %}{% if ip_rating != blank %}<br>{{ ip_rating | escape }}{% endif %}</div>
        </details>
      {% endif %}
      {% if use_cases != blank or plant_groups != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">⌁</span><span>Einsatz</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% if use_cases != blank %}{% render 'leaf-metafield-value', field: product.metafields.lighting.use_cases %}{% endif %}{% if plant_groups != blank %}<br>{% render 'leaf-metafield-value', field: product.metafields.leaf_configurator.plant_groups %}{% endif %}</div>
        </details>
      {% endif %}
      {% if safety != blank or manual_url != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">◇</span><span>{{ 'product.decision.safety' | t }}</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% if safety != blank %}{{ safety | escape | newline_to_br }}{% endif %}{% if manual_url != blank %}<br><a href="{{ manual_url }}" rel="noopener">{{ 'product.decision.manual' | t }}</a>{% endif %}</div>
        </details>
      {% endif %}
    {% else %}
      {% if primary_function != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">✦</span><span>{{ 'product.decision.function' | t }}</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% render 'leaf-metafield-value', field: product.metafields.leafer.primary_function %}</div>
        </details>
      {% endif %}
      {% if suitable_for != blank or plant_groups != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">⌁</span><span>{{ 'product.decision.suitable_for' | t }}</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% if suitable_for != blank %}{% render 'leaf-metafield-value', field: product.metafields.leafer.suitable_for %}{% endif %}{% if plant_groups != blank %}<br>{% render 'leaf-metafield-value', field: product.metafields.leaf_configurator.plant_groups %}{% endif %}</div>
        </details>
      {% endif %}
      {% if water_behavior != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">◌</span><span>{{ 'product.decision.water' | t }}</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value"><div class="leaf-knowledge__visual leaf-knowledge__visual--water" aria-hidden="true"><span></span><span></span><span></span></div>{% render 'leaf-metafield-value', field: product.metafields.leafer.water_behavior %}</div>
        </details>
      {% endif %}
      {% if mixing_ratio != blank or volume_liters != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">◫</span><span>{{ 'product.decision.ratio' | t }}</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value"><div class="leaf-knowledge__visual leaf-knowledge__visual--ratio" aria-hidden="true"><span></span><span></span><span></span><span></span></div>{% if mixing_ratio != blank %}{% render 'leaf-metafield-value', field: product.metafields.leafer.mixing_ratio %}{% endif %}{% if volume_liters != blank %}<br>{{ volume_liters | escape }} L{% endif %}</div>
        </details>
      {% endif %}
      {% if application != blank %}
        <details class="leaf-knowledge__tile">
          <summary><span class="leaf-knowledge__icon" aria-hidden="true">→</span><span>{{ 'product.decision.application' | t }}</span><span class="leaf-knowledge__info" aria-hidden="true">i</span></summary>
          <div class="leaf-knowledge__value">{% render 'leaf-metafield-value', field: product.metafields.leafer.additive_application %}</div>
        </details>
      {% endif %}
    {% endif %}
  </div>

  {% if warning != blank %}<details class="leaf-knowledge__notice"><summary>{{ 'product.decision.notice' | t }}</summary><div>{% render 'leaf-metafield-value', field: product.metafields.leafer.warning %}</div></details>{% endif %}

  {% if configurator_enabled %}
    <div class="leaf-knowledge__cta">
      <div><strong>{{ configurator_title }}</strong><span>{{ configurator_text }}</span></div>
      <a class="button" href="{{ advisor_url }}">{{ 'product.decision.advisor_cta' | t }}</a>
    </div>
  {% endif %}
</section>
{% endif %}

{% stylesheet %}
.leaf-knowledge{margin-block:var(--space-section);padding-block:clamp(1.5rem,4vw,3rem);border-block:1px solid var(--border)}
.leaf-knowledge__head{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.3fr);gap:clamp(1rem,4vw,4rem);align-items:end}
.leaf-knowledge__eyebrow{margin:0 0 .45rem;color:var(--accent);font-size:.7rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}
.leaf-knowledge h2{margin:0;font-size:clamp(1.7rem,4vw,3.2rem);line-height:1;letter-spacing:-.04em}
.leaf-knowledge__lead,.leaf-knowledge__intro{margin:0;color:var(--muted);line-height:1.55}
.leaf-knowledge__clusters{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.65rem;margin-top:1.4rem}
.leaf-knowledge__tile{position:relative;border:1px solid var(--border);border-radius:14px;background:var(--surface);transition:transform .18s ease,border-color .18s ease}
.leaf-knowledge__tile:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--accent),var(--border) 45%)}
.leaf-knowledge__tile summary{list-style:none;display:grid;grid-template-columns:auto 1fr auto;gap:.6rem;align-items:center;min-height:58px;padding:.7rem .8rem;cursor:pointer;font-size:.78rem;font-weight:800}
.leaf-knowledge__tile summary::-webkit-details-marker{display:none}
.leaf-knowledge__icon{display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;background:color-mix(in srgb,var(--accent) 10%,var(--surface));color:var(--accent);font-size:1rem}
.leaf-knowledge__info{display:grid;place-items:center;width:1.25rem;height:1.25rem;border:1px solid var(--border);border-radius:50%;color:var(--muted);font-size:.65rem}
.leaf-knowledge__value{padding:0 .85rem .9rem;color:var(--muted);font-size:.82rem;line-height:1.5;overflow-wrap:anywhere}
.leaf-knowledge__visual{height:42px;margin:.1rem 0 .7rem;display:flex;align-items:end;gap:5px}
.leaf-knowledge__visual span{display:block;flex:1;border-radius:2px;background:color-mix(in srgb,var(--accent) 68%,var(--surface))}
.leaf-knowledge__visual--water span:nth-child(1){height:38%}.leaf-knowledge__visual--water span:nth-child(2){height:68%}.leaf-knowledge__visual--water span:nth-child(3){height:100%}
.leaf-knowledge__visual--ratio span:nth-child(1){height:100%}.leaf-knowledge__visual--ratio span:nth-child(2){height:76%}.leaf-knowledge__visual--ratio span:nth-child(3){height:52%}.leaf-knowledge__visual--ratio span:nth-child(4){height:30%}
.leaf-knowledge__tile[open]{border-color:color-mix(in srgb,var(--accent),var(--border) 45%);background:color-mix(in srgb,var(--accent) 4%,var(--surface))}
.leaf-knowledge__notice{margin-top:.8rem;border-left:3px solid var(--accent);background:var(--surface);padding:.8rem 1rem}
.leaf-knowledge__notice summary{cursor:pointer;font-weight:800}
.leaf-knowledge__notice div{margin-top:.55rem;color:var(--muted);font-size:.84rem;line-height:1.5}
.leaf-knowledge__cta{margin-top:.8rem;padding:1rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;border:1px solid var(--border);border-radius:14px;background:color-mix(in srgb,var(--accent) 4%,var(--surface))}
.leaf-knowledge__cta strong,.leaf-knowledge__cta span{display:block}.leaf-knowledge__cta span{margin-top:.2rem;color:var(--muted);font-size:.8rem}
@media (hover:hover) and (min-width:781px){.leaf-knowledge__tile:not([open]) .leaf-knowledge__value{display:none}.leaf-knowledge__tile:focus-within .leaf-knowledge__value{display:block}}
@media(max-width:780px){.leaf-knowledge__head{grid-template-columns:1fr;align-items:start}.leaf-knowledge__clusters{grid-template-columns:repeat(2,minmax(0,1fr))}.leaf-knowledge__cta{align-items:stretch;flex-direction:column}}
@media(max-width:430px){.leaf-knowledge__clusters{grid-template-columns:1fr}}
{% endstylesheet %}

{% schema %}
{"name":"Wissenscluster","settings":[],"presets":[{"name":"Wissenscluster"}]}
{% endschema %}