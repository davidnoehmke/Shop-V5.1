{% liquid
  assign room_id = 'LeafBotanicalRoom-' | append: section.id
  assign language_code = request.locale.iso_code | split: '-' | first
  assign room_heading_parts = 'botanical_room.heading' | t | split: '. '
  assign scene_alt = section.settings.scene_alt
  assign setup_url = section.settings.setup_url
  if language_code == 'en'
    assign scene_alt = 'botanical_room.scene_alt' | t
  endif
%}
{{ 'leaf-botanical-room.css' | asset_url | stylesheet_tag }}

<leaf-botanical-room id="{{ room_id }}" class="leaf-room" aria-labelledby="{{ room_id }}-title">
  <div class="leaf-room__header">
    <div>
      <p class="leaf-room__eyebrow">{{ 'botanical_room.eyebrow' | t }}</p>
      <h2 id="{{ room_id }}-title"><span>{{ room_heading_parts.first | escape_once }}.</span> <em>{{ room_heading_parts.last | escape_once }}</em></h2>
    </div>
    <div>
      <p class="leaf-room__intro">{{ 'botanical_room.intro' | t }}</p>
      {% unless section.settings.compact_navigation %}
      <div class="leaf-room__actions">
        <a class="leaf-room__button" href="#{{ room_id }}-worlds">{{ 'botanical_room.primary_cta' | t }} <span aria-hidden="true">↓</span></a>
        <a class="leaf-room__shop-link" href="{% render 'leaf-localized-url', url: routes.all_products_collection_url %}">{{ 'botanical_room.shop_cta' | t }} <span aria-hidden="true">↗</span></a>
      </div>
      {% endunless %}
    </div>
  </div>

  <div class="leaf-room__scene">
    {% if section.settings.scene_image != blank %}
      {{ section.settings.scene_image | image_url: width: 2200 | image_tag: class: 'leaf-room__image', widths: '480, 750, 1100, 1500, 1800, 2200', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'lazy', alt: scene_alt }}
    {% else %}
      <div class="leaf-room__image-empty">{{ 'botanical_room.image_missing' | t }}</div>
    {% endif %}
    <div class="leaf-room__scene-caption"><span>{{ 'botanical_room.scene_hint' | t }}</span><span>{{ 'botanical_room.scene_label' | t }}</span></div>

    {% for block in section.blocks %}
      {% if block.settings.show_hotspot %}
        {% liquid
          assign title_key = 'botanical_room.worlds.' | append: block.settings.world
          assign item_title = title_key | t
          assign world_url = block.settings.landing_url
          if language_code == 'en' and block.settings.title_en != blank
            assign item_title = block.settings.title_en
          elsif language_code != 'en' and block.settings.title_de != blank
            assign item_title = block.settings.title_de
          endif
          if world_url == blank
            if block.settings.world == 'knowledge'
              assign world_url = section.settings.knowledge_blog.url
            elsif block.settings.collection != blank
              assign world_url = block.settings.collection.url
            endif
          endif
        %}
        {% if world_url != blank %}
          <a class="leaf-room__hotspot" href="{% render 'leaf-localized-url', url: world_url %}" style="--hotspot-x:{{ block.settings.x }}%;--hotspot-y:{{ block.settings.y }}%" aria-label="{{ item_title | escape_once }}: {{ 'botanical_room.open_world' | t | escape_once }}"><span class="leaf-room__point" aria-hidden="true">{{ forloop.index }}</span><span class="leaf-room__hotspot-label">{{ item_title | replace: '&amp;nbsp;', ' ' | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' | replace: ' ', ' ' | escape_once }}</span></a>
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if setup_url != blank %}
      <a class="leaf-room__setup" href="{% render 'leaf-localized-url', url: setup_url %}">{{ 'botanical_room.setup_cta' | t }} <span aria-hidden="true">↗</span></a>
    {% endif %}
  </div>

  <p class="leaf-room__image-note">{{ 'botanical_room.image_note' | t }}</p>

  {% unless section.settings.compact_navigation %}
  <nav id="{{ room_id }}-worlds" class="leaf-room__nav" aria-label="{{ 'botanical_room.navigation' | t }}">
    {% for block in section.blocks %}
      {% liquid
        assign title_key = 'botanical_room.worlds.' | append: block.settings.world
        assign item_title = title_key | t
        assign world_url = block.settings.landing_url
        if language_code == 'en' and block.settings.title_en != blank
          assign item_title = block.settings.title_en
        elsif language_code != 'en' and block.settings.title_de != blank
          assign item_title = block.settings.title_de
        endif
        if world_url == blank
          if block.settings.world == 'knowledge'
            assign world_url = section.settings.knowledge_blog.url
          elsif block.settings.collection != blank
            assign world_url = block.settings.collection.url
          endif
        endif
      %}
      {% if world_url != blank %}
        <a class="leaf-room__tab" href="{% render 'leaf-localized-url', url: world_url %}" {{ block.shopify_attributes }}><span aria-hidden="true">0{{ forloop.index }}</span>{{ item_title | replace: '&amp;nbsp;', ' ' | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' | replace: ' ', ' ' | escape_once }}<b aria-hidden="true">↗</b></a>
      {% endif %}
    {% endfor %}
  </nav>
  {% endunless %}
</leaf-botanical-room>

{% schema %}
{
  "name": "Pflanzenraum · Navigation",
  "tag": "section",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 6,
  "settings": [
    {"type":"checkbox","id":"compact_navigation","label":"Kompakte Navigation ohne doppelte Einstiege","default":false},
    { "type": "image_picker", "id": "scene_image", "label": "Raumbild" },
    { "type": "text", "id": "scene_alt", "label": "Bildbeschreibung", "default": "Pflanzenecke vor einem alten Bücherregal mit botanischen Werken – KI-generiertes Inspirationsbild." },
    { "type": "url", "id": "setup_url", "label": "Ziel für Pflanzenraum planen" },
    { "type": "blog", "id": "knowledge_blog", "label": "Pflanzenwissen-Blog" }
  ],
  "blocks": [
    {
      "type": "world",
      "name": "Produktwelt",
      "settings": [
        { "type": "select", "id": "world", "label": "Bereich", "default": "plants", "options": [{ "value": "plants", "label": "Pflanzen" }, { "value": "lighting", "label": "Pflanzenlicht" }, { "value": "planters", "label": "Gefäße" }, { "value": "substrates", "label": "Substrate" }, { "value": "propagation", "label": "Anzucht" }, { "value": "knowledge", "label": "Pflanzenwissen" }] },
        { "type": "url", "id": "landing_url", "label": "Eigene Landingpage" },
        { "type": "collection", "id": "collection", "label": "Fallback-Kollektion" },
        { "type": "text", "id": "title_de", "label": "Titel · Deutsch" },
        { "type": "text", "id": "title_en", "label": "Titel · English" },
        { "type": "checkbox", "id": "show_hotspot", "label": "Punkt im Bild anzeigen", "default": true },
        { "type": "range", "id": "x", "label": "Punkt horizontal", "min": 5, "max": 95, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Punkt vertikal", "min": 5, "max": 90, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "presets": [{ "name": "Pflanzenraum · Navigation" }]
}
{% endschema %}
