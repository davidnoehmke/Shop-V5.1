{% liquid
  assign hero_heading = section.settings.heading
  if hero_heading == blank
    assign hero_heading = 'hero.heading' | t
  endif
%}

<section class="hero" style="--hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }}" aria-labelledby="HeroHeading-{{ section.id }}">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2600 | image_tag: widths: '750, 1100, 1500, 2000, 2600', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'hero__image', alt: 'Pflanzenversorgung mit Substrat, Gefäß und Pflanzenlicht' }}
  {% else %}
    <div class="hero__fallback" aria-hidden="true"><span></span><span></span><span></span></div>
  {% endif %}
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="page-width hero__inner">
    <div class="hero__content" data-leaf-reveal>
      {% if section.settings.eyebrow != blank %}<p class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1 id="HeroHeading-{{ section.id }}">{{ hero_heading }}</h1>
      {% if section.settings.text != blank %}<div class="hero__text rte">{{ section.settings.text }}</div>{% else %}<p>{{ 'hero.text' | t }}</p>{% endif %}
      <div class="hero__buttons">
        {% if section.settings.primary_link != blank %}
          <a class="button" href="{{ section.settings.primary_link }}">
            {% if section.settings.primary_label != blank %}{{ section.settings.primary_label }}{% else %}{{ 'general.shop_now' | t }}{% endif %}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}
        {% if section.settings.secondary_link != blank %}
          <a class="button button--secondary" href="{{ section.settings.secondary_link }}">
            {% if section.settings.secondary_label != blank %}{{ section.settings.secondary_label }}{% else %}{{ 'hero.configure' | t }}{% endif %}
          </a>
        {% endif %}
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="hero__benefits" data-leaf-reveal style="--leaf-delay: 120ms">
        {% for block in section.blocks %}
          <div class="hero__benefit" {{ block.shopify_attributes }}>
            <svg viewBox="0 0 32 32" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'shipping' %}<path d="M3 9h16v13H3zM19 14h5l5 5v3H19zM8 26a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM24 26a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
                {% when 'quality' %}<path d="M8 11h16l-1 17H9L8 11ZM12 11V7a4 4 0 0 1 8 0v4M13 17l3 3 5-6"/>
                {% else %}<path d="M16 29V15M16 23C9 22 5 18 5 10c7 0 11 4 11 11M16 18c6-1 10-5 11-12-7 0-11 4-11 10"/>
              {% endcase %}
            </svg>
            <div>
              {% if block.settings.heading != blank %}<strong>{{ block.settings.heading }}</strong>{% endif %}
              {% if block.settings.text != blank %}<span>{{ block.settings.text }}</span>{% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero { position: relative; min-height: clamp(530px, 60vw, 690px); display: grid; overflow: hidden; background: #c9c0ae; }
  .hero__image, .hero__shade, .hero__fallback { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__image { object-fit: cover; object-position: center; transform: scale(1.015); }
  .hero__shade { background: linear-gradient(90deg, rgba(232,226,213,var(--hero-overlay)) 0%, rgba(232,226,213,.68) 43%, rgba(232,226,213,.08) 76%); }
  .hero__fallback { background: linear-gradient(110deg, #d7cfbf 0 44%, #b4ab97 44% 66%, #53643f 66%); }
  .hero__fallback span { position: absolute; right: 6%; bottom: -10%; width: 18%; height: 85%; border-radius: 100% 0 100% 0; background: #243c1c; transform: rotate(24deg); opacity: .9; }
  .hero__fallback span:nth-child(2) { right: 21%; bottom: -18%; width: 13%; height: 72%; transform: rotate(-17deg); background: #687a45; }
  .hero__fallback span:nth-child(3) { right: 36%; bottom: 6%; width: 15%; height: 60%; border-radius: 9px; background: #f0e7d7; transform: none; }
  .hero__inner { position: relative; min-height: inherit; display: grid; align-content: space-between; padding-block: clamp(3.6rem, 7vw, 6rem) 2.4rem; }
  .hero__content { max-width: 720px; }
  .hero__eyebrow { margin: 0 0 .85rem; color: var(--accent); font-size: .76rem; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
  .hero h1 { max-width: 12ch; margin: 0 0 1rem; font-size: clamp(2.8rem, 5.3vw, 5.45rem); line-height: .98; letter-spacing: -.04em; }
  .hero__text, .hero__content > p { max-width: 600px; font-size: clamp(1rem, 1.5vw, 1.16rem); }
  .hero__buttons { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.65rem; }
  .hero__buttons .button { gap: .65rem; }
  .hero__buttons .button:first-child span { transition: transform .25s var(--ease-out); }
  .hero__buttons .button:first-child:hover span { transform: translateX(.2rem); }
  .hero .button { border-color: var(--accent); background: var(--accent); color: #fff; }
  .hero .button--secondary { border-color: color-mix(in srgb, var(--text), transparent 35%); background: color-mix(in srgb, var(--background), transparent 16%); color: var(--text); backdrop-filter: blur(8px); }
  .hero__benefits { display: flex; flex-wrap: wrap; gap: clamp(1.2rem, 4vw, 3.5rem); margin-top: 3.5rem; }
  .hero__benefit { display: flex; align-items: center; gap: .75rem; max-width: 220px; }
  .hero__benefit svg { width: 31px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; }
  .hero__benefit strong, .hero__benefit span { display: block; }
  .hero__benefit strong { font-size: .82rem; }
  .hero__benefit span { font-size: .75rem; }

  @media (prefers-reduced-motion: no-preference) {
    .hero__image { animation: leaf-hero-breathe 14s ease-in-out infinite alternate; }
    @keyframes leaf-hero-breathe { from { transform: scale(1.015); } to { transform: scale(1.055); } }
  }

  @media (max-width: 700px) {
    .hero { min-height: 760px; }
    .hero__image { height: 46%; object-position: center 38%; }
    .hero__shade { background: linear-gradient(0deg, rgba(232,226,213,1) 0 55%, rgba(232,226,213,.74) 70%, rgba(232,226,213,.08) 100%); }
    .hero__inner { align-content: end; padding-block: 2rem 1.25rem; }
    .hero__content { padding-top: 42svh; }
    .hero h1 { max-width: 13ch; font-size: clamp(2.45rem, 10.8vw, 4rem); line-height: .96; }
    .hero__content > p, .hero__text { font-size: 1rem; line-height: 1.55; }
    .hero__buttons { display: grid; grid-template-columns: 1fr; gap: .65rem; margin-top: 1.2rem; }
    .hero__buttons .button { width: 100%; }
    .hero__benefits { display: grid; grid-template-columns: 1fr 1fr; gap: .85rem; margin-top: 1.4rem; }
  }

  @media (max-width: 420px) { .hero { min-height: 790px; } .hero__image { height: 40%; } .hero__content { padding-top: 35svh; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    { "type": "image_picker", "id": "brand_logo", "label": "Markenlogo" },
    { "type": "checkbox", "id": "show_brand_logo", "label": "Logo im Hero anzeigen", "default": true },
    { "type": "range", "id": "brand_logo_width", "label": "Logo-Breite", "min": 160, "max": 320, "step": 10, "default": 250, "unit": "px" },
    { "type": "image_picker", "id": "image", "label": "t:sections.hero.image" },
    { "type": "range", "id": "overlay", "label": "t:sections.hero.overlay", "min": 20, "max": 100, "step": 5, "default": 70, "unit": "%" },
    { "type": "text", "id": "eyebrow", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "t:sections.hero.heading" },
    { "type": "richtext", "id": "text", "label": "t:sections.hero.text" },
    { "type": "text", "id": "primary_label", "label": "t:sections.hero.primary_label" },
    { "type": "url", "id": "primary_link", "label": "t:sections.hero.primary_link" },
    { "type": "text", "id": "secondary_label", "label": "t:sections.hero.secondary_label" },
    { "type": "url", "id": "secondary_link", "label": "t:sections.hero.secondary_link" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:sections.hero.benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "t:sections.hero.icon", "options": [
          { "value": "shipping", "label": "t:options.shipping" },
          { "value": "quality", "label": "t:options.quality" },
          { "value": "natural", "label": "t:options.natural" }
        ], "default": "natural" },
        { "type": "text", "id": "heading", "label": "t:sections.hero.benefit_heading" },
        { "type": "text", "id": "text", "label": "t:sections.hero.benefit_text" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "t:sections.hero.name" }]
}
{% endschema %}
