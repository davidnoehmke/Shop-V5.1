{% comment %} LEAF Enterprise V8 — isolated preview section. No live homepage integration. {% endcomment %}
{% liquid
  assign is_en = false
  if request.locale.iso_code == 'en'
    assign is_en = true
  endif
%}
<section class="leaf-v8" aria-labelledby="leaf-v8-title">
  <div class="leaf-v8__hero">
    <div class="leaf-v8__inner leaf-v8__hero-grid">
      <div>
        <p class="leaf-v8__eyebrow">LEAFerservice / Living Systems</p>
        <h1 id="leaf-v8-title">{% if is_en %}Better living starts at the roots.{% else %}Besser wachsen beginnt an der Wurzel.{% endif %}</h1>
        <p class="leaf-v8__lead">{% if is_en %}Thoughtful solutions for plants, substrate, lighting and watering. Find the system that fits your space.{% else %}Durchdachte Lösungen für Pflanzen, Substrat, Licht und Bewässerung. Finde das System, das zu deinem Raum passt.{% endif %}</p>
        <div class="leaf-v8__actions"><a class="leaf-v8__button" href="#leaf-v8-worlds">{% if is_en %}Explore solutions{% else %}Lösungen entdecken{% endif %} <span aria-hidden="true">↗</span></a><a class="leaf-v8__textlink" href="#leaf-v8-irrigation">{% if is_en %}Discover watering{% else %}Bewässerung entdecken{% endif %} →</a></div>
      </div>
      <div class="leaf-v8__visual" role="img" aria-label="{% if is_en %}Abstract illustration of water, roots and growing plants{% else %}Abstrakte Darstellung von Wasser, Wurzeln und wachsenden Pflanzen{% endif %}">
        <svg viewBox="0 0 540 520" aria-hidden="true" focusable="false"><circle cx="310" cy="242" r="202" fill="#dbe5d4"/><circle cx="308" cy="236" r="146" fill="#b7ccb1"/><path d="M301 412V167M301 291C221 289 172 249 161 166c74 3 124 42 140 125M301 250c12-104 74-154 159-155-2 90-55 141-159 155" fill="#325a45" stroke="#204331" stroke-width="8" stroke-linecap="round"/><path d="M301 410c-35 25-65 41-108 49m108-49c43 24 71 41 120 48m-120-48-8 65" fill="none" stroke="#5f7657" stroke-width="8" stroke-linecap="round"/><path d="M89 404h390" stroke="#95a88c" stroke-width="3"/><path d="M83 359c0-20 23-42 23-42s23 22 23 42a23 23 0 0 1-46 0Z" fill="#6d948d"/></svg>
      </div>
    </div>
  </div>
  <div id="leaf-v8-worlds" class="leaf-v8__inner leaf-v8__section">
    <div class="leaf-v8__section-head"><p class="leaf-v8__eyebrow">01 / {% if is_en %}Solutions{% else %}Produktwelten{% endif %}</p><h2>{% if is_en %}Start with what your plants need.{% else %}Starte mit dem, was deine Pflanzen brauchen.{% endif %}</h2></div>
    <div class="leaf-v8__worlds">
      <a href="/collections/fertige-substratmischungen"><span class="leaf-v8__world-icon" aria-hidden="true">◈</span><h3>{% if is_en %}Ready-made substrate{% else %}Fertige Substratmischungen{% endif %}</h3><p>{% if is_en %}Curated recipes for different roots.{% else %}Abgestimmte Rezepturen für unterschiedliche Wurzeln.{% endif %}</p><span aria-hidden="true">↗</span></a>
      <a href="/pages/substrat-konfigurator"><span class="leaf-v8__world-icon" aria-hidden="true">✳</span><h3>{% if is_en %}Mix your own{% else %}Substrat selbst konfigurieren{% endif %}</h3><p>{% if is_en %}Build your own custom recipe.{% else %}Deine eigene Mischung Schritt für Schritt.{% endif %}</p><span aria-hidden="true">↗</span></a>
      <a href="/collections/pflanzenbeleuchtung"><span class="leaf-v8__world-icon" aria-hidden="true">☼</span><h3>{% if is_en %}Plant lighting{% else %}Pflanzenbeleuchtung{% endif %}</h3><p>{% if is_en %}Light for your plant and room.{% else %}Passendes Licht für Pflanze und Standort.{% endif %}</p><span aria-hidden="true">↗</span></a>
      <a href="#leaf-v8-irrigation"><span class="leaf-v8__world-icon" aria-hidden="true">◉</span><h3>{% if is_en %}Smart watering{% else %}Bedarfsgerecht bewässern{% endif %}</h3><p>{% if is_en %}Discover water-efficient systems.{% else %}Bewässerungslösungen für den Alltag.{% endif %}</p><span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div id="leaf-v8-irrigation" class="leaf-v8__section leaf-v8__irrigation">
    <div class="leaf-v8__inner">
      <div class="leaf-v8__section-head"><p class="leaf-v8__eyebrow">02 / Blumat</p><h2>{% if is_en %}Water exactly where it matters.{% else %}Wasser dort, wo es gebraucht wird.{% endif %}</h2><p>{% if is_en %}Explore selected Blumat systems. Price, product image and availability are always retrieved from Shopify.{% else %}Entdecke ausgewählte Blumat-Systeme. Preis, Produktbild und Verfügbarkeit kommen direkt aus Shopify.{% endif %}</p></div>
      <div class="leaf-v8__products">
        {% assign blumat_handles = 'blumat-classic-automatische-pflanzenbewasserung-3er-set,blumat-easy-flaschenadapter-fur-pflanzenbewasserung-3er-set,tropf-blumat-set12,blumat-digital' | split: ',' %}
        {% for handle in blumat_handles %}
          {% assign item = all_products[handle] %}
          {% if item != blank %}
            <article class="leaf-v8__product">
              <a href="{{ item.url }}" class="leaf-v8__product-media">{% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 680 | image_tag: loading: 'lazy', alt: item.title, widths: '320,480,680', sizes: '(max-width: 700px) 80vw, 25vw' }}{% else %}<span class="leaf-v8__no-image" aria-hidden="true">◉</span>{% endif %}</a>
              <div class="leaf-v8__product-content">
                {% if item.metafields.custom.homepage_badge.value != blank %}<p class="leaf-v8__tag">{{ item.metafields.custom.homepage_badge.value | escape }}</p>{% else %}<p class="leaf-v8__tag">Blumat</p>{% endif %}
                <h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                {% assign short_intro = item.metafields.custom.homepage_intro.value | default: item.metafields.leafer.intro.value %}
                {% if short_intro != blank %}<p class="leaf-v8__product-intro">{{ short_intro | strip_html | truncate: 110 | escape }}</p>{% endif %}
                <div class="leaf-v8__product-footer"><span>{{ item.price_min | money }}</span><a href="{{ item.url }}">{% if is_en %}View product{% else %}Produkt ansehen{% endif %} ↗</a></div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="leaf-v8__inner leaf-v8__bottom"><p class="leaf-v8__eyebrow">03 / LEAF philosophy</p><h2>{% if is_en %}Less noise. More clarity.{% else %}Weniger Informationsflut. Mehr Klarheit.{% endif %}</h2><p>{% if is_en %}One verified property, one meaningful presentation. Details belong where they help you make a decision.{% else %}Eine verifizierte Eigenschaft, eine sinnvolle Darstellung. Details erscheinen dort, wo sie deine Entscheidung unterstützen.{% endif %}</p></div>
</section>
<style>
.leaf-v8{--v8-ink:#183b2d;--v8-muted:#52645c;--v8-bg:#f5f6ef;--v8-accent:#d7ee86;color:var(--v8-ink);background:var(--v8-bg);font-family:inherit}
.leaf-v8 *{box-sizing:border-box}.leaf-v8__inner{width:min(100% - 48px,1280px);margin:auto}.leaf-v8__hero{background:#e9eee2;padding:clamp(55px,8vw,128px) 0}.leaf-v8__hero-grid{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:5vw}
.leaf-v8__eyebrow{font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#54735a;margin:0 0 25px}.leaf-v8 h1{font-size:clamp(45px,6.6vw,92px);line-height:1.01;letter-spacing:-.055em;font-weight:650;margin:0 0 28px;max-width:800px}.leaf-v8 h2{font-size:clamp(28px,3.5vw,52px);line-height:1.11;letter-spacing:-.04em;margin:0}.leaf-v8 h3{font-size:20px;line-height:1.2;letter-spacing:-.02em;margin:0}.leaf-v8 p{line-height:1.55}.leaf-v8__lead{font-size:clamp(16px,1.65vw,21px);max-width:600px;color:var(--v8-muted);margin:0 0 32px}.leaf-v8__actions{display:flex;flex-wrap:wrap;align-items:center;gap:25px}.leaf-v8__button{display:inline-flex;gap:30px;align-items:center;background:var(--v8-ink);color:#fff!important;padding:17px 24px;text-decoration:none;min-height:52px;font-weight:650}.leaf-v8__button:hover{background:#28533d}.leaf-v8__textlink{color:var(--v8-ink);font-weight:650;text-decoration:none}.leaf-v8__visual svg{width:100%;height:auto;max-height:520px}
.leaf-v8__section{padding:clamp(60px,7vw,110px) 0}.leaf-v8__section-head{max-width:760px;margin:0 0 38px}.leaf-v8__section-head>p:last-child{max-width:650px;color:var(--v8-muted)}.leaf-v8__worlds{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.leaf-v8__worlds>a{position:relative;min-height:280px;background:white;padding:30px 25px;display:flex;flex-direction:column;gap:14px;text-decoration:none;color:var(--v8-ink);border-bottom:3px solid transparent}.leaf-v8__worlds>a:hover{border-color:#719a64}.leaf-v8__worlds p{color:var(--v8-muted);font-size:14px;margin:0}.leaf-v8__worlds>a>span:last-child{margin-top:auto;align-self:end}.leaf-v8__world-icon{display:grid;place-items:center;border:1px solid #b9d0b5;width:47px;height:47px;font-size:24px}
.leaf-v8__irrigation{background:#dde7d8}.leaf-v8__products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.leaf-v8__product{background:#fff;display:flex;flex-direction:column;min-width:0}.leaf-v8__product-media{aspect-ratio:1/1;display:grid;place-items:center;background:#f2f4ee;overflow:hidden}.leaf-v8__product-media img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}.leaf-v8__product-content{padding:24px;display:flex;flex-direction:column;flex:1;gap:12px}.leaf-v8__product h3 a{text-decoration:none;color:inherit}.leaf-v8__tag{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:#52785b;margin:0}.leaf-v8__product-intro{font-size:14px;color:var(--v8-muted);margin:0}.leaf-v8__product-footer{margin-top:auto;padding-top:20px;display:flex;gap:12px;justify-content:space-between;align-items:center;font-size:13px}.leaf-v8__product-footer span{font-size:18px;font-weight:700}.leaf-v8__product-footer a{color:inherit}.leaf-v8__bottom{padding:100px 0;max-width:800px}.leaf-v8__bottom>p:last-child{font-size:18px;color:var(--v8-muted);max-width:600px}
@media(max-width:990px){.leaf-v8__worlds,.leaf-v8__products{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.leaf-v8__inner{width:min(100% - 28px,1280px)}.leaf-v8__hero{padding:60px 0 30px}.leaf-v8__hero-grid{grid-template-columns:1fr;gap:10px}.leaf-v8__visual{max-width:360px;margin:auto}.leaf-v8__worlds,.leaf-v8__products{grid-template-columns:1fr 1fr;gap:9px}.leaf-v8__worlds>a{min-height:230px;padding:18px 15px}.leaf-v8__worlds h3,.leaf-v8__product h3{font-size:16px}.leaf-v8__product-content{padding:14px}.leaf-v8__product-footer{flex-direction:column;align-items:start}.leaf-v8__product-footer span{font-size:16px}.leaf-v8__section{padding:60px 0}.leaf-v8__bottom{padding:75px 0}.leaf-v8__world-icon{width:40px;height:40px}}
</style>
{% schema %}
{"name":"LEAF Enterprise V8 Preview","settings":[],"presets":[{"name":"LEAF Enterprise V8 Preview"}]}
{% endschema %}