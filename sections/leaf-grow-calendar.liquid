{% assign de = request.locale.iso_code == 'de' %}
{% assign months_de = 'Jan,Feb,Mär,Apr,Mai,Jun,Jul,Aug,Sep,Okt,Nov,Dez' | split: ',' %}{% assign months_en = 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec' | split: ',' %}{% if de %}{% assign month_labels = months_de %}{% else %}{% assign month_labels = months_en %}{% endif %}
<section class="leaf-grow" data-grow-calendar aria-labelledby="leaf-grow-heading">
  <div class="leaf-grow__shell">
    <header class="leaf-grow__hero">
      <div class="leaf-grow__hero-copy">
        <span class="leaf-grow__eyebrow">{% if de %}LEAFERSERVICE · GARTENWISSEN{% else %}LEAFERSERVICE · GROWING GUIDE{% endif %}</span>
        <h2 id="leaf-grow-heading">{% if de %}Dein Garten beginnt <em>hier.</em>{% else %}Your garden starts <em>here.</em>{% endif %}</h2>
        <p>{% if de %}Entdecke, was du wann aussäen, vorziehen und ernten kannst. Ein ganzjähriger Pflanzenkalender für Fensterbank, Balkon und Garten.{% else %}Discover what to sow, start indoors and harvest throughout the year. A plant calendar for windowsills, balconies and gardens.{% endif %}</p>
        <div class="leaf-grow__hero-actions"><a class="leaf-grow__button" href="#leaf-grow-explore">{% if de %}Pflanzen entdecken{% else %}Explore plants{% endif %}<span aria-hidden="true">↗</span></a><a class="leaf-grow__hero-link" href="#leaf-grow-guide">{% if de %}So funktioniert's{% else %}How it works{% endif %}</a></div>
        <div class="leaf-grow__hero-facts"><span><strong>30</strong> {% if de %}Pflanzenarten{% else %}plant types{% endif %}</span><span><strong>12</strong> {% if de %}Monate{% else %}months{% endif %}</span><span><strong>4</strong> {% if de %}Kategorien{% else %}categories{% endif %}</span></div>
      </div>
      <div class="leaf-grow__hero-art" aria-hidden="true">
        <span class="leaf-grow__orb leaf-grow__orb--one"></span><span class="leaf-grow__orb leaf-grow__orb--two"></span>
        <svg class="leaf-grow__sprout" viewBox="0 0 100 110" fill="none" aria-hidden="true" focusable="false"><path d="M49 96V42" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M49 58C26 56 20 40 23 26c19-1 34 10 26 32Z" fill="currentColor" opacity=".56"/><path d="M50 47c-2-23 13-35 33-35 2 18-7 32-33 35Z" fill="currentColor" opacity=".84"/><path d="M50 82c8-18 21-22 38-20-3 16-16 26-38 20Z" fill="currentColor" opacity=".42"/><path d="M25 97h48" stroke="currentColor" stroke-linecap="round" stroke-width="3"/></svg>
        <div class="leaf-grow__hero-art-label">{% if de %}Wachsen. Lernen. Ernten.{% else %}Grow. Learn. Harvest.{% endif %}</div>
      </div>
    </header>
    <div class="leaf-grow__explore" id="leaf-grow-explore">
      <div class="leaf-grow__section-intro"><div><span class="leaf-grow__kicker">{% if de %}DEIN ANBAUPLAN{% else %}YOUR GROWING PLAN{% endif %}</span><h2>{% if de %}Was wächst in deinem Monat?{% else %}What grows this month?{% endif %}</h2><p>{% if de %}Wähle einen Monat, suche deine Lieblingspflanze und entdecke die passenden Arbeitsschritte.{% else %}Choose a month, find a plant and see what to do next.{% endif %}</p></div><span class="leaf-grow__season" data-season-text>{% if de %}Ganzjährig planen{% else %}Plan all year{% endif %}</span></div>
      <nav class="leaf-grow__months" aria-label="{% if de %}Monat auswählen{% else %}Choose a month{% endif %}" data-month-nav hidden>
        {% for month in (1..12) %}{% assign midx = month | minus: 1 %}
        <button class="leaf-grow__month" type="button" data-month-button="{{ month }}" aria-pressed="false"><span>{{ month_labels[midx] }}</span></button>
        {% endfor %}
      </nav>
      <div class="leaf-grow__filters" data-controls hidden>
        <label class="leaf-grow__filter"><span>{% if de %}Monat{% else %}Month{% endif %}</span><select data-month><option value="0">{% if de %}Ganzes Jahr{% else %}All year{% endif %}</option>{% for month in (1..12) %}<option value="{{ month }}">{{ month }}</option>{% endfor %}</select></label>
        <label class="leaf-grow__filter leaf-grow__filter--search"><span>{% if de %}Pflanze suchen{% else %}Search plants{% endif %}</span><input type="search" data-search placeholder="{% if de %}z. B. Tomate, Basilikum …{% else %}e.g. tomato, basil …{% endif %}" autocomplete="off"></label>
        <label class="leaf-grow__filter"><span>{% if de %}Kategorie{% else %}Category{% endif %}</span><select data-category><option value="">{% if de %}Alle Pflanzen{% else %}All plants{% endif %}</option><option value="Gemüse">{% if de %}Gemüse{% else %}Vegetables{% endif %}</option><option value="Kräuter">{% if de %}Kräuter{% else %}Herbs{% endif %}</option><option value="Blumen">{% if de %}Blumen{% else %}Flowers{% endif %}</option><option value="Obst">{% if de %}Obst{% else %}Fruit{% endif %}</option></select></label>
        <button class="leaf-grow__reset" type="button" data-reset>{% if de %}Zurücksetzen{% else %}Reset{% endif %}</button>
      </div>
      <div class="leaf-grow__resultbar"><h2>{% if de %}Pflanzen entdecken{% else %}Explore plants{% endif %}</h2><span data-count role="status" aria-live="polite">{% if de %}30 Pflanzen{% else %}30 plants{% endif %}</span></div>
      <div class="leaf-grow__grid">
        {% assign plants = "Tomate|Tomato|Gemüse|Vegetables|2,3,4|5,6|7,8,9,10;Paprika|Sweet pepper|Gemüse|Vegetables|1,2,3|5,6|7,8,9;Chili|Chilli|Gemüse|Vegetables|1,2,3|5,6|7,8,9;Gurke|Cucumber|Gemüse|Vegetables|4,5|5,6|7,8,9;Zucchini|Courgette|Gemüse|Vegetables|4,5|5,6|7,8,9;Kürbis|Pumpkin|Gemüse|Vegetables|4,5|5,6|9,10;Radieschen|Radish|Gemüse|Vegetables||3,4,5,6,7,8,9|4,5,6,7,8,9,10;Möhre|Carrot|Gemüse|Vegetables||3,4,5,6|6,7,8,9,10;Erbse|Pea|Gemüse|Vegetables||3,4,5|6,7,8;Buschbohne|Bush bean|Gemüse|Vegetables||5,6,7|7,8,9;Rote Bete|Beetroot|Gemüse|Vegetables||4,5,6|7,8,9,10;Spinat|Spinach|Gemüse|Vegetables||3,4,8,9|4,5,9,10;Feldsalat|Lamb's lettuce|Gemüse|Vegetables||8,9|10,11,12;Kohlrabi|Kohlrabi|Gemüse|Vegetables|2,3,4|4,5,6,7|6,7,8,9;Brokkoli|Broccoli|Gemüse|Vegetables|3,4|5,6|7,8,9;Lauch|Leek|Gemüse|Vegetables|2,3|4,5|9,10,11;Basilikum|Basil|Kräuter|Herbs|3,4|5,6|6,7,8,9;Petersilie|Parsley|Kräuter|Herbs||3,4,5,6,7|6,7,8,9,10;Dill|Dill|Kräuter|Herbs||4,5,6,7|6,7,8,9;Koriander|Coriander|Kräuter|Herbs||4,5,6,7|6,7,8,9;Schnittlauch|Chives|Kräuter|Herbs|3,4|4,5|5,6,7,8,9;Thymian|Thyme|Kräuter|Herbs|3,4|5,6|6,7,8,9;Oregano|Oregano|Kräuter|Herbs|3,4|5,6|6,7,8,9;Sonnenblume|Sunflower|Blumen|Flowers|3,4|4,5|8,9,10;Ringelblume|Calendula|Blumen|Flowers||4,5,6|6,7,8,9;Kapuzinerkresse|Nasturtium|Blumen|Flowers|4|5,6|7,8,9;Cosmea|Cosmos|Blumen|Flowers|3,4|5,6|7,8,9;Zinnie|Zinnia|Blumen|Flowers|4|5,6|7,8,9;Erdbeere|Strawberry|Obst|Fruit||3,4,8,9|5,6,7;Melone|Melon|Obst|Fruit|4|5,6|8,9" | split: ';' %}
        {% for plant in plants %}{% assign p = plant | split: '|' %}
          <article class="leaf-grow__card" data-plant data-cat="{{ p[2] | escape }}" data-months="{{ p[4] }},{{ p[5] }},{{ p[6] }}">
            <div class="leaf-grow__card-head leaf-grow__card-head--{% case p[2] %}{% when 'Gemüse' %}vegetable{% when 'Kräuter' %}herb{% when 'Blumen' %}flower{% else %}fruit{% endcase %}">
              <span class="leaf-grow__card-category">{% if de %}{{ p[2] }}{% else %}{{ p[3] }}{% endif %}</span>
              <svg class="leaf-grow__sprout" viewBox="0 0 100 110" fill="none" aria-hidden="true" focusable="false"><path d="M49 96V42" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M49 58C26 56 20 40 23 26c19-1 34 10 26 32Z" fill="currentColor" opacity=".56"/><path d="M50 47c-2-23 13-35 33-35 2 18-7 32-33 35Z" fill="currentColor" opacity=".84"/><path d="M50 82c8-18 21-22 38-20-3 16-16 26-38 20Z" fill="currentColor" opacity=".42"/><path d="M25 97h48" stroke="currentColor" stroke-linecap="round" stroke-width="3"/></svg>
            </div>
            <div class="leaf-grow__card-body">
              <h3>{% if de %}{{ p[0] }}{% else %}{{ p[1] }}{% endif %}</h3>
              <dl class="leaf-grow__times">
                {% if p[4] != blank %}<div class="leaf-grow__time"><dt>{% if de %}Vorziehen{% else %}Start indoors{% endif %}</dt><dd>{% assign list_items = p[4] | split: ',' %}{% for n in list_items %}{% assign nidx = n | minus: 1 %}{{ month_labels[nidx] }}{% unless forloop.last %}<span aria-hidden="true"> · </span>{% endunless %}{% endfor %}</dd></div>{% endif %}
                {% if p[5] != blank %}<div class="leaf-grow__time"><dt>{% if de %}Säen / pflanzen{% else %}Sow / plant{% endif %}</dt><dd>{% assign list_items = p[5] | split: ',' %}{% for n in list_items %}{% assign nidx = n | minus: 1 %}{{ month_labels[nidx] }}{% unless forloop.last %}<span aria-hidden="true"> · </span>{% endunless %}{% endfor %}</dd></div>{% endif %}
                {% if p[6] != blank %}<div class="leaf-grow__time"><dt>{% if de %}Ernte / Blüte{% else %}Harvest / bloom{% endif %}</dt><dd>{% assign list_items = p[6] | split: ',' %}{% for n in list_items %}{% assign nidx = n | minus: 1 %}{{ month_labels[nidx] }}{% unless forloop.last %}<span aria-hidden="true"> · </span>{% endunless %}{% endfor %}</dd></div>{% endif %}
              </dl>
            </div>
          </article>
        {% endfor %}
      </div>
      <p class="leaf-grow__empty" data-empty hidden>{% if de %}Keine Pflanzen gefunden. Probiere einen anderen Monat oder Suchbegriff.{% else %}No matching plants. Try another month or search term.{% endif %}</p>
    </div>
    <section class="leaf-grow__next" id="leaf-grow-guide" aria-labelledby="leaf-grow-next-title">
      <div><span class="leaf-grow__kicker">{% if de %}DEIN NÄCHSTER SCHRITT{% else %}YOUR NEXT STEP{% endif %}</span><h2 id="leaf-grow-next-title">{% if de %}Von der Idee zur ersten Pflanze.{% else %}From idea to first seedling.{% endif %}</h2><p>{% if de %}Lege zuerst den Aussaattermin fest. Anschließend brauchst du ein passendes Anzuchtmedium, einen Topf mit Wasserabzug und einen hellen Standort. Die konkreten Bedingungen hängen von der Pflanzenart ab.{% else %}Choose your sowing date first. Then prepare a suitable growing medium, a container with drainage and plenty of light. Exact conditions depend on the plant.{% endif %}</p></div>
      <div class="leaf-grow__next-links"><a href="{{ routes.root_url }}blogs/leafers-nice2know-blog/anzucht-leicht-gemacht">{% if de %}Anzucht Schritt für Schritt{% else %}Seed starting guide{% endif %}<span aria-hidden="true">↗</span></a><a href="{{ routes.root_url }}collections/anzucht-aussaat">{% if de %}Anzuchtzubehör entdecken{% else %}Seed starting supplies{% endif %}<span aria-hidden="true">↗</span></a><a href="{{ routes.root_url }}pages/individuelles-substrat">{% if de %}Individuelles Substrat wählen{% else %}Choose your substrate{% endif %}<span aria-hidden="true">↗</span></a></div>
    </section>
    <p class="leaf-grow__disclaimer">{% if de %}Alle Monatsangaben sind grobe Richtwerte für gemäßigtes mitteleuropäisches Klima, keine verbindlichen Pflanztermine. Sorte, Saatgutanleitung, Frost und Bodentemperatur haben Vorrang. Bei Blumen kann die letzte Zeile Blüte oder Samenernte bezeichnen.{% else %}Month ranges are approximate for temperate Central Europe, not fixed planting dates. Cultivar, seed packet instructions, frost and soil temperature take priority. For flowers, the last row can indicate flowering or seed harvest.{% endif %}</p>
  </div>
</section>
{% stylesheet %}
.leaf-grow{--grow-forest:#294a36;--grow-ink:#24372b;--grow-sage:#e9eee3;--grow-cream:#f7f6f0;--grow-border:#d9dfd4;--grow-muted:#607465;--grow-white:#fff;color:var(--grow-ink);font-family:inherit;line-height:1.55}.leaf-grow *{box-sizing:border-box}.leaf-grow [hidden]{display:none!important}.leaf-grow__shell{max-width:1240px;margin:0 auto;padding:clamp(12px,3vw,32px)}.leaf-grow a{color:inherit}.leaf-grow__hero{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);overflow:hidden;border-radius:24px;background:var(--grow-forest);color:#f8f7ed;min-height:395px}.leaf-grow__hero-copy{padding:clamp(28px,5vw,64px)}.leaf-grow__eyebrow,.leaf-grow__kicker{display:block;font-size:.72rem;font-weight:700;letter-spacing:.17em;line-height:1.6}.leaf-grow__eyebrow{color:#c6dbc4}.leaf-grow__hero h2{font-size:clamp(2.35rem,5vw,4.7rem);line-height:1.07;letter-spacing:-.045em;margin:18px 0;max-width:640px;color:#fff}.leaf-grow__hero h2 em{font-style:normal;color:#d8e5b8}.leaf-grow__hero p{max-width:520px;color:#e0e9db;font-size:clamp(1rem,1.6vw,1.15rem);margin:0}.leaf-grow__hero-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin:28px 0}.leaf-grow__button{display:inline-flex;align-items:center;gap:18px;padding:13px 20px;min-height:48px;background:#e2ebc9;color:var(--grow-forest)!important;border-radius:999px;text-decoration:none;font-weight:700}.leaf-grow__button:hover{background:#fff}.leaf-grow__hero-link{color:#f1f6e9!important;font-weight:600;text-underline-offset:5px}.leaf-grow__hero-facts{display:flex;flex-wrap:wrap;gap:20px;color:#d4e3d4;font-size:.8rem}.leaf-grow__hero-facts strong{font-size:1.1rem;color:#fff}.leaf-grow__hero-art{position:relative;display:grid;place-items:center;overflow:hidden;background:linear-gradient(155deg,#dae6cb,#b9cfb0 70%,#a3bb9e);color:#365941}.leaf-grow__hero-art .leaf-grow__sprout{width:min(62%,270px);height:auto;position:relative;z-index:1;filter:drop-shadow(0 18px 10px #36594133)}.leaf-grow__orb{position:absolute;display:block;border-radius:50%;border:1px solid #edf2df9c}.leaf-grow__orb--one{width:340px;height:340px}.leaf-grow__orb--two{width:470px;height:470px}.leaf-grow__hero-art-label{position:absolute;bottom:30px;left:28px;right:28px;text-align:center;color:#2d5137;font-size:.85rem;letter-spacing:.04em;font-weight:600}.leaf-grow__explore{padding:48px 0 36px}.leaf-grow__section-intro{display:flex;gap:20px;justify-content:space-between;align-items:flex-end;margin-bottom:22px}.leaf-grow__section-intro h2,.leaf-grow__next h2{font-size:clamp(1.65rem,3vw,2.45rem);line-height:1.2;letter-spacing:-.035em;color:var(--grow-forest);margin:7px 0 8px}.leaf-grow__section-intro p,.leaf-grow__next p{margin:0;color:var(--grow-muted);max-width:680px}.leaf-grow__kicker{color:#67846b}.leaf-grow__season{font-size:.8rem;background:var(--grow-sage);color:var(--grow-forest);border-radius:30px;padding:10px 15px;white-space:nowrap}.leaf-grow__months{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:6px;padding:9px;background:var(--grow-cream);border:1px solid var(--grow-border);border-radius:16px;margin-bottom:18px}.leaf-grow__month{font:inherit;min-height:44px;border:1px solid transparent;border-radius:11px;background:transparent;color:var(--grow-forest);cursor:pointer;font-weight:600;transition:background .15s ease}.leaf-grow__month:hover{background:#e3eade}.leaf-grow__month[aria-pressed=true]{background:var(--grow-forest);color:#fff}.leaf-grow__filters{display:flex;align-items:flex-end;flex-wrap:wrap;gap:12px;margin:18px 0 30px}.leaf-grow__filter{display:flex;flex-direction:column;gap:6px;min-width:155px;flex:1;font-size:.8rem;font-weight:700;color:var(--grow-forest)}.leaf-grow__filter--search{flex:2;min-width:230px}.leaf-grow__filter :is(select,input){font:inherit;font-size:.95rem;font-weight:400;color:var(--grow-ink);height:48px;width:100%;padding:0 13px;border:1px solid #c8d3c6;border-radius:10px;background:#fff}.leaf-grow__reset{font:inherit;border:1px solid var(--grow-border);border-radius:10px;min-height:48px;padding:0 15px;background:var(--grow-sage);color:var(--grow-forest);cursor:pointer}.leaf-grow__resultbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 20px;border-bottom:1px solid var(--grow-border);padding-bottom:14px}.leaf-grow__resultbar h2{font-size:1.35rem;color:var(--grow-forest);margin:0}.leaf-grow__resultbar span{color:var(--grow-muted);font-size:.9rem}.leaf-grow__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.leaf-grow__card{border-radius:17px;overflow:hidden;background:#fff;border:1px solid var(--grow-border);transition:box-shadow .16s ease,transform .16s ease}.leaf-grow__card:hover{box-shadow:0 14px 28px #244a3212;transform:translateY(-2px)}.leaf-grow__card[hidden]{display:none}.leaf-grow__card-head{height:124px;display:flex;align-items:flex-start;justify-content:space-between;padding:18px 20px;position:relative;overflow:hidden;color:#45644b;background:#e4eade}.leaf-grow__card-head--herb{background:#e7edda;color:#648552}.leaf-grow__card-head--flower{background:#f3ead9;color:#aa9764}.leaf-grow__card-head--fruit{background:#f1e8e4;color:#af7e72}.leaf-grow__card-category{position:relative;z-index:2;background:#ffffffcf;padding:6px 10px;border-radius:20px;font-size:.72rem;font-weight:700;letter-spacing:.03em;color:#34523d}.leaf-grow__card-head .leaf-grow__sprout{width:90px;height:100px;position:absolute;right:19px;bottom:-17px;transform:rotate(-13deg)}.leaf-grow__card-body{padding:18px 20px 21px}.leaf-grow__card h3{margin:0 0 13px;font-size:1.28rem;line-height:1.2;letter-spacing:-.02em;color:var(--grow-forest)}.leaf-grow__times{margin:0}.leaf-grow__time{display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding:9px 0;border-top:1px solid #ecf0e9;font-size:.86rem}.leaf-grow__time dt{color:var(--grow-muted)}.leaf-grow__time dd{margin:0;font-weight:650;color:var(--grow-ink);text-align:right;max-width:62%;line-height:1.35}.leaf-grow__empty{padding:28px;background:var(--grow-cream);border-radius:12px;color:var(--grow-muted);text-align:center}.leaf-grow__next{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:28px;padding:clamp(24px,3vw,40px);border-radius:20px;background:var(--grow-cream);border:1px solid var(--grow-border)}.leaf-grow__next-links{display:grid;gap:9px;align-content:center}.leaf-grow__next-links a{display:flex;align-items:center;justify-content:space-between;padding:12px 15px;min-height:46px;background:#fff;border:1px solid var(--grow-border);border-radius:10px;text-decoration:none;font-weight:600;color:var(--grow-forest)}.leaf-grow__next-links a:hover{background:var(--grow-sage)}.leaf-grow__disclaimer{font-size:.77rem;line-height:1.6;color:var(--grow-muted);margin:16px 4px}.leaf-grow :focus-visible{outline:3px solid #b0c884;outline-offset:3px}
@media(max-width:950px){.leaf-grow__hero{grid-template-columns:1fr 34%}.leaf-grow__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.leaf-grow__months{grid-template-columns:repeat(6,minmax(0,1fr))}.leaf-grow__hero-art .leaf-grow__sprout{width:78%}}
@media(max-width:680px){.leaf-grow__shell{padding:10px}.leaf-grow__hero{grid-template-columns:1fr;min-height:0;border-radius:18px}.leaf-grow__hero-copy{padding:30px 24px}.leaf-grow__hero-art{min-height:165px}.leaf-grow__hero-art .leaf-grow__sprout{width:110px;height:150px}.leaf-grow__hero-art-label{left:auto;right:14px;bottom:12px}.leaf-grow__hero-facts{gap:12px}.leaf-grow__explore{padding-top:32px}.leaf-grow__section-intro{align-items:flex-start;flex-direction:column;gap:12px}.leaf-grow__months{grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;padding:5px}.leaf-grow__month{min-height:43px}.leaf-grow__filter,.leaf-grow__filter--search{flex:1 1 100%;min-width:0}.leaf-grow__grid{grid-template-columns:1fr;gap:12px}.leaf-grow__card-head{height:100px}.leaf-grow__card-body{padding:16px 18px}.leaf-grow__next{grid-template-columns:1fr;gap:18px}.leaf-grow__resultbar h2{font-size:1.17rem}}
@media(prefers-reduced-motion:reduce){.leaf-grow__month,.leaf-grow__card{transition:none}.leaf-grow__card:hover{transform:none}}
{% endstylesheet %}
<script src="{{ 'leaf-grow-calendar.js' | asset_url }}" defer></script>
{% schema %}{"name":"LEAF Grow Calendar","settings":[],"presets":[{"name":"LEAF Grow Calendar"}]}{% endschema %}