{% assign de = false %}{% if request.locale.iso_code == 'de' %}{% assign de = true %}{% endif %}
<section class="leaf-grow page-width" data-grow-calendar>
<h2>{% if de %}Dein Aussaatkalender{% else %}Your growing calendar{% endif %}</h2>
<p>{% if de %}Richtwerte für gemäßigtes mitteleuropäisches Klima. Sorte, Frost und Bodentemperatur beachten. Die dritte Spalte bezeichnet bei Blumen Blüte oder Samenernte.{% else %}Indicative dates for temperate Central Europe. Consider cultivar, frost and soil temperature. For flowers the final column indicates flowering or seed harvest.{% endif %}</p>
<div data-controls hidden><label>{% if de %}Monat{% else %}Month{% endif %}<select data-month><option value="0">{% if de %}Alle Monate{% else %}All months{% endif %}</option>{% for m in (1..12) %}<option value="{{ m }}">{{ m }}</option>{% endfor %}</select></label><label>{% if de %}Pflanze suchen{% else %}Find a plant{% endif %}<input type="search" data-search></label><label>{% if de %}Kategorie{% else %}Category{% endif %}<select data-category><option value="">{% if de %}Alle{% else %}All{% endif %}</option>{% assign cats = 'Gemüse|Kräuter|Blumen|Obst' | split: '|' %}{% assign en_cats = 'Vegetables|Herbs|Flowers|Fruit' | split: '|' %}{% for c in cats %}<option value="{{ c }}">{% if de %}{{ c }}{% else %}{{ en_cats[forloop.index0] }}{% endif %}</option>{% endfor %}</select></label></div>
<p data-count role="status"></p>
<div class="leaf-grow-grid">
{% assign plants = "Tomate|Tomato|Gemüse|Vegetables|2,3,4|5,6|7,8,9,10;Paprika|Sweet pepper|Gemüse|Vegetables|1,2,3|5,6|7,8,9;Chili|Chilli|Gemüse|Vegetables|1,2,3|5,6|7,8,9;Gurke|Cucumber|Gemüse|Vegetables|4,5|5,6|7,8,9;Zucchini|Courgette|Gemüse|Vegetables|4,5|5,6|7,8,9;Kürbis|Pumpkin|Gemüse|Vegetables|4,5|5,6|9,10;Radieschen|Radish|Gemüse|Vegetables||3,4,5,6,7,8,9|4,5,6,7,8,9,10;Möhre|Carrot|Gemüse|Vegetables||3,4,5,6|6,7,8,9,10;Erbse|Pea|Gemüse|Vegetables||3,4,5|6,7,8;Buschbohne|Bush bean|Gemüse|Vegetables||5,6,7|7,8,9;Rote Bete|Beetroot|Gemüse|Vegetables||4,5,6|7,8,9,10;Spinat|Spinach|Gemüse|Vegetables||3,4,8,9|4,5,9,10;Feldsalat|Lamb's lettuce|Gemüse|Vegetables||8,9|10,11,12;Kohlrabi|Kohlrabi|Gemüse|Vegetables|2,3,4|4,5,6,7|6,7,8,9;Brokkoli|Broccoli|Gemüse|Vegetables|3,4|5,6|7,8,9;Lauch|Leek|Gemüse|Vegetables|2,3|4,5|9,10,11;Basilikum|Basil|Kräuter|Herbs|3,4|5,6|6,7,8,9;Petersilie|Parsley|Kräuter|Herbs||3,4,5,6,7|6,7,8,9,10;Dill|Dill|Kräuter|Herbs||4,5,6,7|6,7,8,9;Koriander|Coriander|Kräuter|Herbs||4,5,6,7|6,7,8,9;Schnittlauch|Chives|Kräuter|Herbs|3,4|4,5|5,6,7,8,9;Thymian|Thyme|Kräuter|Herbs|3,4|5,6|6,7,8,9;Oregano|Oregano|Kräuter|Herbs|3,4|5,6|6,7,8,9;Sonnenblume|Sunflower|Blumen|Flowers|3,4|4,5|8,9,10;Ringelblume|Calendula|Blumen|Flowers||4,5,6|6,7,8,9;Kapuzinerkresse|Nasturtium|Blumen|Flowers|4|5,6|7,8,9;Cosmea|Cosmos|Blumen|Flowers|3,4|5,6|7,8,9;Zinnie|Zinnia|Blumen|Flowers|4|5,6|7,8,9;Erdbeere|Strawberry|Obst|Fruit||3,4,8,9|5,6,7;Melone|Melon|Obst|Fruit|4|5,6|8,9" | split: ';' %}
{% for plant in plants %}{% assign p = plant | split: '|' %}
<article data-plant data-cat="{{ p[2] | escape }}" data-months="{{ p[4] }},{{ p[5] }},{{ p[6] }}">
<h3>{% if de %}{{ p[0] }}{% else %}{{ p[1] }}{% endif %}</h3>
<p>{% if de %}{{ p[2] }}{% else %}{{ p[3] }}{% endif %}</p>
<dl><dt>{% if de %}Vorziehen{% else %}Start indoors{% endif %}</dt><dd>{{ p[4] | default: '–' | replace: ',', ', ' }}</dd><dt>{% if de %}Aussaat / Pflanzung{% else %}Sow / plant{% endif %}</dt><dd>{{ p[5] | default: '–' | replace: ',', ', ' }}</dd><dt>{% if de %}Ernte / Blüte{% else %}Harvest / flowering{% endif %}</dt><dd>{{ p[6] | default: '–' | replace: ',', ', ' }}</dd></dl>
</article>{% endfor %}
</div>
<p><a href="{{ routes.root_url }}pages/individuelles-substrat">{% if de %}Passendes Substrat entdecken{% else %}Explore suitable substrates{% endif %}</a></p>
</section>
{% stylesheet %}
.leaf-grow{padding-block:2rem}.leaf-grow [data-controls]:not([hidden]){display:flex;flex-wrap:wrap;gap:1rem;margin-block:1rem}.leaf-grow label{display:grid;gap:.4rem;flex:1 1 160px}.leaf-grow input,.leaf-grow select{font:inherit;padding:.7rem;min-height:44px;border:1px solid var(--border);border-radius:8px;background:var(--background);color:var(--text);width:100%}.leaf-grow-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:1rem}.leaf-grow article{border:1px solid var(--border);border-radius:var(--radius-large);padding:1rem;background:var(--surface)}.leaf-grow article[hidden]{display:none}.leaf-grow h3{margin:0}.leaf-grow dl{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;font-size:.9rem}.leaf-grow dd{margin:0}.leaf-grow :focus-visible{outline:2px solid var(--accent);outline-offset:3px}
{% endstylesheet %}
<script src="{{ 'leaf-grow-calendar.js' | asset_url }}" defer></script>

{% schema %}{"name":"LEAF Grow Calendar","settings":[],"presets":[{"name":"LEAF Grow Calendar"}]}{% endschema %}