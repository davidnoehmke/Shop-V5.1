{% assign p_substrate = all_products['leaferpinienrinde-premium-pinienrinde'] %}{% assign p_light = all_products['soltech-vita-grow-light-par30'] %}{% assign p_grow = all_products['anzuchtbox-mit-deckel-fur-aussaat-stecklinge'] %}{% assign p_care = all_products['elho-selbstbewasserungssystem-schwarz'] %}
<section class="home-discovery" data-home-discovery><div class="page-width"><div class="home-discovery__intro"><p class="home-discovery__eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="home-discovery__lead">{{ section.settings.text }}</div><div class="home-discovery__filters" role="group" aria-label="{{ section.settings.filter_label }}"><button type="button" class="home-discovery__filter is-active" data-filter="all" aria-pressed="true">{{ section.settings.filter_all }}</button><button type="button" class="home-discovery__filter" data-filter="substrate" aria-pressed="false">{{ section.settings.filter_substrate }}</button><button type="button" class="home-discovery__filter" data-filter="interieur" aria-pressed="false">{{ section.settings.filter_interieur }}</button><button type="button" class="home-discovery__filter" data-filter="grow" aria-pressed="false">{{ section.settings.filter_grow }}</button><button type="button" class="home-discovery__filter" data-filter="care" aria-pressed="false">{{ section.settings.filter_care }}</button></div></div><aside class="home-discovery__service"><div><p class="home-discovery__eyebrow">{{ section.settings.service_eyebrow }}</p><h3>{{ section.settings.service_heading }}</h3><p>{{ section.settings.service_text }}</p></div><a href="{{ section.settings.service_link }}">{{ section.settings.service_cta }}</a></aside><div class="home-discovery__path">
{% assign topic='substrate' %}<article class="home-discovery__story" data-item data-topic="{{ topic }}"><p class="home-discovery__eyebrow">1 · Wurzelraum</p><h3>Was soll das Substrat leisten?</h3><p>Struktur, Luftführung und Feuchtigkeit müssen zur Pflanze und zu deiner Gießroutine passen. Ein Bestandteil erfüllt dabei eine konkrete Funktion.</p><a href="{{ routes.root_url }}collections/substratwelt-pflanzsubstrate-mischungen-zusatze">Substratwelt ansehen</a></article>{% assign product=p_substrate %}{% render 'home-discovery-product', product: product, topic: topic, label: section.settings.highlight_label, details: section.settings.details_label %}<figure class="home-discovery__image-break">{% if section.settings.break_image_1 %}{{ section.settings.break_image_1 | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 70vw, 100vw', alt: section.settings.break_alt_1 }}{% endif %}<figcaption>{{ section.settings.break_caption_1 }}</figcaption></figure>
{% assign topic='interieur' %}<article class="home-discovery__story" data-item data-topic="{{ topic }}"><p class="home-discovery__eyebrow">2 · Raum & Licht</p><h3>Wie bekommt deine Pflanze ihren Platz?</h3><p>Gefäß, Aufstellung und Licht verändern, wie eine Pflanze im Raum wirkt und wie du sie versorgst. Die Interieur Solutions verbinden diese Perspektiven.</p><a href="{{ routes.root_url }}collections/interieur-solutions">Interieur Solutions entdecken</a></article>{% assign product=p_light %}{% render 'home-discovery-product', product: product, topic: topic, label: section.settings.highlight_label, details: section.settings.details_label %}<figure class="home-discovery__image-break">{% if section.settings.break_image_2 %}{{ section.settings.break_image_2 | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 70vw, 100vw', alt: section.settings.break_alt_2 }}{% endif %}<figcaption>{{ section.settings.break_caption_2 }}</figcaption></figure>
{% assign topic='grow' %}<article class="home-discovery__story" data-item data-topic="{{ topic }}"><p class="home-discovery__eyebrow">3 · Aussaat & Stecklinge</p><h3>Was braucht ein guter Start?</h3><p>Bei Aussaat und Stecklingen zählen ein passendes Medium, kontrollierbare Feuchtigkeit und ein geschützter Standort. Kleine Schritte machen den Prozess nachvollziehbar.</p><a href="{{ routes.root_url }}collections/anzucht-aussaat">Anzucht ansehen</a></article>{% assign product=p_grow %}{% render 'home-discovery-product', product: product, topic: topic, label: section.settings.highlight_label, details: section.settings.details_label %}<figure class="home-discovery__image-break">{% if section.settings.break_image_3 %}{{ section.settings.break_image_3 | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 70vw, 100vw', alt: section.settings.break_alt_3 }}{% endif %}<figcaption>{{ section.settings.break_caption_3 }}</figcaption></figure>
{% assign topic='care' %}<article class="home-discovery__story" data-item data-topic="{{ topic }}"><p class="home-discovery__eyebrow">4 · Gefäß & Wasser</p><h3>Wie wird Pflege im Alltag einfacher?</h3><p>Ein Gefäß mit Ablauf und eine nachvollziehbare Wasserversorgung helfen dabei, die Pflege an deinen Alltag anzupassen. Nicht jede Pflanze braucht dieselbe Routine.</p><a href="{{ routes.root_url }}collections/pflanzenpflege-werkzeuge">Gefäße & Pflege ansehen</a></article>{% assign product=p_care %}{% render 'home-discovery-product', product: product, topic: topic, label: section.settings.highlight_label, details: section.settings.details_label %}
</div><p class="home-discovery__empty" data-empty hidden>{{ section.settings.empty_label }}</p></div></section>
{% stylesheet %}.home-discovery{padding:5rem 0;background:#f5f1e8}.home-discovery__intro{max-width:760px;margin:0 auto 2.5rem;text-align:center}.home-discovery__eyebrow{margin:0 0 .75rem;color:#4e6a39;font-size:.78rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.home-discovery h2,.home-discovery h3{margin-top:0}.home-discovery__lead{color:#4c5149;line-height:1.65}.home-discovery__filters{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;margin-top:1.5rem}.home-discovery__filter{border:1px solid #718565;border-radius:999px;padding:.7rem 1rem;background:transparent;color:#30432a;cursor:pointer;font:inherit}.home-discovery__filter.is-active,.home-discovery__filter:hover,.home-discovery__filter:focus-visible{background:#30432a;color:#fff}.home-discovery__path{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.home-discovery__story,.home-discovery__product{border-radius:1.25rem;overflow:hidden;background:#fff;box-shadow:0 8px 26px rgba(38,50,31,.08)}.home-discovery__story{display:flex;flex-direction:column;justify-content:center;padding:clamp(1.5rem,4vw,3rem)}.home-discovery__story p:not(.home-discovery__eyebrow),.home-discovery__product-body p:not(.home-discovery__eyebrow):not(.home-discovery__function){color:#555b52;line-height:1.6}.home-discovery__story a,.home-discovery__product a{align-self:flex-start;margin-top:.75rem;color:#304f2e;font-weight:700;text-underline-offset:.2em}.home-discovery__product img{display:block;width:100%;aspect-ratio:1.25;object-fit:cover}.home-discovery__product-body{padding:1.5rem}.home-discovery__image-break{grid-column:1/-1;margin:1rem 0 0;border-radius:1.25rem;overflow:hidden;background:#e8e1d3}.home-discovery__image-break img{display:block;width:100%;max-height:340px;object-fit:cover}.home-discovery__image-break figcaption{padding:.85rem 1rem;color:#4c5149;font-size:.9rem}.home-discovery__function{margin:-.35rem 0 .7rem;color:#4e6a39;font-size:.9rem;font-weight:700}.home-discovery__rating{margin:.5rem 0;color:#6c4d1d;font-size:.9rem}.home-discovery__rating span:first-child{letter-spacing:.08em}@media(max-width:749px){.home-discovery{padding:3.5rem 0}.home-discovery__path{grid-template-columns:1fr}}{% endstylesheet %}
{% javascript %}document.querySelectorAll('[data-home-discovery]').forEach((section)=>{const buttons=section.querySelectorAll('[data-filter]');const items=section.querySelectorAll('[data-item]');const empty=section.querySelector('[data-empty]');buttons.forEach((button)=>button.addEventListener('click',()=>{const filter=button.dataset.filter;let count=0;buttons.forEach((item)=>{const active=item===button;item.classList.toggle('is-active',active);item.setAttribute('aria-pressed',active?'true':'false')});items.forEach((item)=>{const show=filter==='all'||item.dataset.topic===filter;item.hidden=!show;if(show)count++});empty.hidden=count>0}))});{% endjavascript %}
{% schema %}{"name":"Homepage Entdeckungsweg","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Kurz erklärt, dann passend weiter"},{"type":"text","id":"heading","label":"Überschrift","default":"Finde deinen nächsten sinnvollen Schritt"},{"type":"richtext","id":"text","label":"Einleitung","default":"<p>Entdecke die Idee hinter einer Lösung und direkt danach ein passendes Highlight aus dem Sortiment. Du entscheidest selbst, wie tief du einsteigst.</p>"},{"type":"text","id":"filter_label","label":"Filter","default":"Themen filtern"},{"type":"text","id":"filter_all","label":"Alle","default":"Alle Themen"},{"type":"text","id":"filter_substrate","label":"Substrat","default":"Substrat"},{"type":"text","id":"filter_interieur","label":"Interieur","default":"Interieur Solutions"},{"type":"text","id":"filter_grow","label":"Anzucht","default":"Anzucht & Aussaat"},{"type":"text","id":"filter_care","label":"Pflege","default":"Gefäß & Bewässerung"},{"type":"text","id":"highlight_label","label":"Highlight","default":"Highlight aus dem Sortiment"},{"type":"text","id":"details_label","label":"Details","default":"Details ansehen"},{"type":"text","id":"empty_label","label":"Leer","default":"Für diesen Themenfilter sind aktuell keine Bereiche hinterlegt."},{"type":"image_picker","id":"break_image_1","label":"Bild nach Substrat"},{"type":"text","id":"break_alt_1","label":"Alt-Text Bild 1","default":"Substratkonfigurator und Drainage für Pflanzsubstrate"},{"type":"text","id":"break_caption_1","label":"Bildunterschrift 1","default":"Ein gutes Substrat wird verständlich, wenn jede Komponente eine Aufgabe bekommt."},{"type":"image_picker","id":"break_image_2","label":"Bild nach Interieur"},{"type":"text","id":"break_alt_2","label":"Alt-Text Bild 2","default":"Pflanzenbeleuchtung für Zimmerpflanzen im Innenraum"},{"type":"text","id":"break_caption_2","label":"Bildunterschrift 2","default":"Licht ist Teil des Standorts – und darf sich in den Raum integrieren."},{"type":"image_picker","id":"break_image_3","label":"Bild nach Anzucht"},{"type":"text","id":"break_alt_3","label":"Alt-Text Bild 3","default":"Anzucht und Pflanzenpflege im geschützten Indoor-Bereich"},{"type":"text","id":"break_caption_3","label":"Bildunterschrift 3","default":"Anzucht wird planbarer, wenn Medium, Feuchtigkeit und Umgebung zusammenspielen."},{"type":"text","id":"service_eyebrow","label":"Service Eyebrow","default":"Auch für größere Projekte"},{"type":"text","id":"service_heading","label":"Service Überschrift","default":"Lieferung und Aufbau nach Absprache"},{"type":"textarea","id":"service_text","label":"Service Text","default":"Bei größeren Pflanzenwelten, Regalen, Gewächshäusern oder Terrarien arrangiere ich gerne die Lieferung und – sofern möglich – auch den Aufbau vor Ort."},{"type":"text","id":"service_cta","label":"Service Link","default":"Projekt anfragen"},{"type":"url","id":"service_link","label":"Service Ziel"}],"presets":[{"name":"Homepage Entdeckungsweg"}]}{% endschema %}