</style>

<script>
(()=>{
  const root=document.getElementById('LeafInteriorStory-{{ section.id }}');
  if(!root||root.dataset.ready==='1')return;
  root.dataset.ready='1';

  const zones=[
    {
      id:'overview',
      kicker:'Gesamtwirkung',
      title:'Ein Pflanzenraum funktioniert als System',
      copy:'Die Wirkung entsteht nicht durch möglichst viele Einzelprodukte, sondern durch abgestimmte Ebenen: große Pflanzen als Anker, ruhigere Gefäße, strukturierte Substrate, bewusst gesetztes Licht und kleinere botanische Szenen.',
      points:['Statement-Pflanzen definieren Blickachsen.','Gefäße wiederholen Material und Form.','Licht verbindet Pflegebedarf und Atmosphäre.'],ctaLabel:'Interieur Solutions entdecken',ctaHref:'/collections/interieur-solutions',secondaryLabel:'Pflanzenlicht konfigurieren',secondaryHref:'/pages/pflanzenlicht-konfigurator'
    },
    {
      id:'plants',
      kicker:'Statement-Pflanzen',
      title:'Große Blätter geben dem Raum seine Architektur',
      copy:'Die Monstera wirkt hier wie ein Möbelstück: groß genug als visueller Anker, aber mit freiem Raum um die Blätter. Ergänzende Pflanzen wiederholen die Grünwirkung, ohne mit dem Hauptmotiv zu konkurrieren.',
      points:['Ein Hauptmotiv statt vieler gleich großer Pflanzen.','Höhenstaffelung erzeugt Tiefe.','Freiraum um große Blätter bewahrt Ruhe.'],ctaLabel:'Zimmerpflanzen auswählen',ctaHref:'/collections/zimmerpflanzen-1',secondaryLabel:'Mit Raumplanung verbinden',secondaryHref:'/collections/interieur-solutions'
    },
    {
      id:'planter',
      kicker:'Gefäß & Substrat',
      title:'Technik und Gestaltung müssen zusammenpassen',
      copy:'Große Gefäße geben den Wurzeln Reserve und stabilisieren die Proportion im Raum. Das Substrat wird nach Pflanze und Bewässerung gewählt; mineralische und grobe Komponenten können Luftführung und Drainage gezielt beeinflussen.',
      points:['Gefäßgröße folgt Wurzelraum und Pflanzenmaß.','Material und Farbe wiederholen die Raumoberflächen.','Substrat wird funktional statt dekorativ geplant.'],ctaLabel:'Substrat konfigurieren',ctaHref:'/products/leafer-substrat-konfigurator',secondaryLabel:'Pflanzgefäße auswählen',secondaryHref:'/collections/pflanzgefasse'
    },
    {
      id:'light',
      kicker:'Pflanzenbeleuchtung',
      title:'Grow Light kann wie Interior Lighting aussehen',
      copy:'Die Beleuchtung sitzt nicht als sichtbare Technik neben der Einrichtung, sondern wird in Pendel-, Spot- oder Regallösungen integriert. Entscheidend sind Position, Abstand und Lichtbedarf der Pflanze.',
      points:['Lichtquelle möglichst in vorhandene Achsen integrieren.','Abstand und Abstrahlwinkel auf die Pflanze abstimmen.','Warm wirkendes Interior und Pflanzennutzen verbinden.'],ctaLabel:'Pflanzenlicht konfigurieren',ctaHref:'/pages/pflanzenlicht-konfigurator',secondaryLabel:'Interieur Solutions ansehen',secondaryHref:'/collections/interieur-solutions'
    },
    {
      id:'terrarium',
      kicker:'Terrarium',
      title:'Eine kleine Pflanzenwelt als eigenständiger Blickpunkt',
      copy:'Das Terrarium bildet eine kompakte zweite Ebene im Raum. Sukkulenten, mineralischer Aufbau und Glasgefäß unterscheiden sich bewusst von den großen Solitärpflanzen und schaffen einen konzentrierten Detailpunkt.',
      points:['Kleinere Maßstäbe ergänzen große Pflanzen.','Glas bringt eine neue Materialebene ein.','Substrataufbau und Pflanzenwahl gemeinsam planen.'],ctaLabel:'Sukkulentenwelt entdecken',ctaHref:'/collections/sukkulentenwelt',secondaryLabel:'Terrarium-Lösungen ansehen',secondaryHref:'/collections/interieur-solutions'
    },
    {
      id:'vertical',
      kicker:'Vertikale Begrünung',
      title:'Höhe nutzen, ohne Stellfläche zu verlieren',
      copy:'Regale und obere Ebenen tragen kleinere Pflanzen und hängende Triebe. Dadurch wandert das Grün in die Höhe und der Raum wirkt dichter begrünt, ohne dass Boden und Laufwege vollgestellt werden.',
      points:['Vertikale Ebenen entlasten den Boden.','Hängepflanzen verbinden Möbel und Architektur.','Pflegezugang trotz dichter Begrünung erhalten.'],ctaLabel:'Rankhilfen & Vertikalgrün',ctaHref:'/collections/pflanzenzubehor-rankhilfen',secondaryLabel:'Interieur Solutions ansehen',secondaryHref:'/collections/interieur-solutions'
    }
  ];

  const scene=root.querySelector('[data-story-scene]');
  const buttons=[...root.querySelectorAll('[data-zone]')];
  const count=root.querySelector('[data-zone-count]');
  const kicker=root.querySelector('[data-zone-kicker]');
  const title=root.querySelector('[data-zone-title]');
  const copy=root.querySelector('[data-zone-copy]');
  const points=root.querySelector('[data-zone-points]');
  const cta=root.querySelector('[data-zone-cta]');
  const secondary=root.querySelector('[data-zone-secondary]');
  const prev=root.querySelector('[data-zone-prev]');
  const next=root.querySelector('[data-zone-next]');
  let index=0;

  function esc(v){return String(v).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch]))}

  function activate(id){
    const nextIndex=zones.findIndex(z=>z.id===id);
    if(nextIndex<0)return;
    index=nextIndex;
    const zone=zones[index];
    const source=root.querySelector('.leaf-story__hotspot[data-zone="'+zone.id+'"]');

    buttons.forEach(btn=>{
      const active=btn.dataset.zone===zone.id;
      btn.classList.toggle('is-active',active);
      btn.setAttribute('aria-current',active?'true':'false');
    });

    scene.classList.toggle('is-overview',zone.id==='overview');
    if(source){
      scene.style.setProperty('--focus-x',(source.dataset.x||50)+'%');
      scene.style.setProperty('--focus-y',(source.dataset.y||50)+'%');
      scene.style.backgroundPosition=source.dataset.bg||'50% 50%';
    }

    count.textContent=(index+1)+' / '+zones.length;
    kicker.textContent=zone.kicker;
    title.textContent=zone.title;
    copy.textContent=zone.copy;
    points.innerHTML=zone.points.map(p=>'<li>'+esc(p)+'</li>').join('');
    if(cta){cta.textContent=zone.ctaLabel+' →';cta.href=zone.ctaHref}
    if(secondary){secondary.textContent=zone.secondaryLabel;secondary.href=zone.secondaryHref}
    prev.disabled=index===0;
    next.disabled=index===zones.length-1;
    next.textContent=index===zones.length-1?'Ende':'Weiter →';
  }

  buttons.forEach(btn=>btn.addEventListener('click',()=>activate(btn.dataset.zone)));
  prev.addEventListener('click',()=>activate(zones[Math.max(0,index-1)].id));
  next.addEventListener('click',()=>activate(zones[Math.min(zones.length-1,index+1)].id));

  activate('overview');
})();
</script>


