  .leaf-story__tabs{
    margin:8px 10px 0;
    padding-bottom:2px;
    scroll-snap-type:x proximity;
  }
  .leaf-story__tabs button{
    min-height:40px;
    padding:0 11px;
    font-size:.7rem;
    scroll-snap-align:start;
  }
  .leaf-story__content{
    margin:34px 16px 0;
    padding-top:25px;
  }
  .leaf-story__content-lead{display:block}
  .leaf-story__content-lead h2{
    font-size:1.65rem;
  }
