  }
  .leaf-story__focus{
    background:radial-gradient(circle at var(--focus-x) var(--focus-y),transparent 0 10%,rgba(2,7,2,.02) 20%,rgba(2,7,2,.58) 64%,rgba(2,7,2,.72) 100%);
  }
