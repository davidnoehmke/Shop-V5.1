{% capture interior_url %}{% render 'leaf-localized-url', url: '/collections/interieur-solutions' %}{% endcapture %}
{% capture substrate_url %}{% render 'leaf-localized-url', url: '/products/leafer-substrat-konfigurator' %}{% endcapture %}
{% capture light_url %}{% render 'leaf-localized-url', url: '/pages/pflanzenlicht-konfigurator' %}{% endcapture %}
{% capture plants_url %}{% render 'leaf-localized-url', url: '/collections/zimmerpflanzen-1' %}{% endcapture %}
{% capture planters_url %}{% render 'leaf-localized-url', url: '/collections/pflanzgefasse' %}{% endcapture %}
{% capture succulents_url %}{% render 'leaf-localized-url', url: '/collections/sukkulentenwelt' %}{% endcapture %}
{% capture supports_url %}{% render 'leaf-localized-url', url: '/collections/pflanzenzubehor-rankhilfen' %}{% endcapture %}
{% capture all_products_url %}{% render 'leaf-localized-url', url: routes.all_products_collection_url %}{% endcapture %}


<article id="LeafInteriorStory-{{ section.id }}" class="leaf-story" data-leaf-story>
  <header class="leaf-story__hero">
    <div>
      <span class="leaf-story__eyebrow">{{ 'interior_story.hero_eyebrow' | t }}</span>
      <h1>{{ article.title }}</h1>
      <p>{{ article.summary | strip_html }}</p>
    </div>
    <span class="leaf-story__draft">{{ 'interior_story.draft' | t }}</span>
  </header>

  <section class="leaf-story__experience" aria-label="{{ 'interior_story.experience_aria' | t | escape }}">
    <div class="leaf-story__scene-wrap">
      <div class="leaf-story__scene is-overview" data-story-scene style="--focus-x:50%;--focus-y:50%;">
        <div class="leaf-story__focus" aria-hidden="true"></div>

        <button type="button" class="leaf-story__hotspot is-active" data-zone="overview" data-x="50" data-y="50" data-bg="50% 50%" aria-label="{{ 'interior_story.hotspot_overview_aria' | t | escape }}">
          <span>00</span><strong>{{ 'interior_story.hotspot_overview_label' | t }}</strong>
        </button>
        <button type="button" class="leaf-story__hotspot leaf-story__hotspot--plants" data-zone="plants" data-x="30" data-y="43" data-bg="31% 50%" aria-label="{{ 'interior_story.hotspot_plants_aria' | t | escape }}">
          <span>01</span><strong>{{ 'interior_story.hotspot_plants_label' | t }}</strong>
        </button>
        <button type="button" class="leaf-story__hotspot leaf-story__hotspot--planter" data-zone="planter" data-x="35" data-y="63" data-bg="38% 63%" aria-label="{{ 'interior_story.hotspot_planter_aria' | t | escape }}">
          <span>02</span><strong>{{ 'interior_story.hotspot_planter_label' | t }}</strong>
        </button>
        <button type="button" class="leaf-story__hotspot leaf-story__hotspot--light" data-zone="light" data-x="54" data-y="32" data-bg="54% 34%" aria-label="{{ 'interior_story.hotspot_light_aria' | t | escape }}">
          <span>03</span><strong>{{ 'interior_story.hotspot_light_label' | t }}</strong>
        </button>
        <button type="button" class="leaf-story__hotspot leaf-story__hotspot--terrarium" data-zone="terrarium" data-x="79" data-y="52" data-bg="76% 53%" aria-label="{{ 'interior_story.hotspot_terrarium_aria' | t | escape }}">
          <span>04</span><strong>{{ 'interior_story.hotspot_terrarium_label' | t }}</strong>
        </button>
        <button type="button" class="leaf-story__hotspot leaf-story__hotspot--vertical" data-zone="vertical" data-x="70" data-y="22" data-bg="68% 28%" aria-label="{{ 'interior_story.hotspot_vertical_aria' | t | escape }}">
          <span>05</span><strong>{{ 'interior_story.hotspot_vertical_label' | t }}</strong>
        </button>
      </div>

      <div class="leaf-story__scene-hint">
        <span>{{ 'interior_story.hint_tap' | t }}</span>
        <span>{{ 'interior_story.hint_focus' | t }}</span>
      </div>
    </div>

    <aside class="leaf-story__panel" aria-live="polite">
      <div class="leaf-story__counter"><span data-zone-count>1 / 6</span></div>
      <span class="leaf-story__panel-kicker" data-zone-kicker>{{ 'interior_story.overview_kicker' | t }}</span>
      <h2 data-zone-title>{{ 'interior_story.overview_title' | t }}</h2>
      <p data-zone-copy>{{ 'interior_story.overview_copy' | t }}</p>
      <ul data-zone-points>
        <li>{{ 'interior_story.overview_point_1' | t }}</li>
        <li>{{ 'interior_story.overview_point_2' | t }}</li>
        <li>{{ 'interior_story.overview_point_3' | t }}</li>
      </ul>

      <!-- LEAF CONVERSION CTA START -->
      <div class="leaf-story__cta" data-zone-cta-wrap>
        <a class="leaf-story__cta-primary" data-zone-cta href="{{ interior_url | strip | escape }}">{{ 'interior_story.overview_cta' | t }} <span aria-hidden="true">→</span></a>
        <a class="leaf-story__cta-secondary" data-zone-secondary href="{{ interior_url | strip | escape }}">{{ 'interior_story.overview_cta' | t }}</a>
      </div>
      <!-- LEAF CONVERSION CTA END -->

      <div class="leaf-story__controls">
        <button type="button" data-zone-prev aria-label="{{ 'interior_story.prev' | t | escape }}">{{ 'interior_story.prev' | t }}</button>
        <button type="button" data-zone-next>{{ 'interior_story.next' | t }}</button>
      </div>
    </aside>
  </section>

  <nav class="leaf-story__tabs" aria-label="{{ 'interior_story.tabs_aria' | t | escape }}">
    <button type="button" class="is-active" data-zone="overview">{{ 'interior_story.hotspot_overview_label' | t }}</button>
    <button type="button" data-zone="plants">{{ 'interior_story.hotspot_plants_label' | t }}</button>
    <button type="button" data-zone="planter">{{ 'interior_story.planter_kicker' | t }}</button>
    <button type="button" data-zone="light">{{ 'interior_story.hotspot_light_label' | t }}</button>
    <button type="button" data-zone="terrarium">{{ 'interior_story.hotspot_terrarium_label' | t }}</button>
    <button type="button" data-zone="vertical">{{ 'interior_story.vertical_kicker' | t }}</button>
  </nav>

  <section class="leaf-story__content" aria-labelledby="leaf-story-how">
    <div class="leaf-story__content-lead">
      <span class="leaf-story__eyebrow">{{ 'interior_story.content_eyebrow' | t }}</span>
      <h2 id="leaf-story-how">{{ 'interior_story.content_heading' | t }}</h2>
    </div>
    <div class="leaf-story__content-grid">
      <div>
        <h3>{{ 'interior_story.card_plants_title' | t }}</h3>
        <p>{{ 'interior_story.card_plants_text' | t }}</p>
      </div>
      <div>
        <h3>{{ 'interior_story.card_substrate_title' | t }}</h3>
        <p>{{ 'interior_story.card_substrate_text' | t }}</p>
      </div>
      <div>
        <h3>{{ 'interior_story.card_light_title' | t }}</h3>
        <p>{{ 'interior_story.card_light_text' | t }}</p>
      </div>
      <div>
        <h3>{{ 'interior_story.card_scenes_title' | t }}</h3>
        <p>{{ 'interior_story.card_scenes_text' | t }}</p>
      </div>
    </div>

    <div class="leaf-story__pathways" aria-label="{{ 'interior_story.pathways_aria' | t | escape }}">
      <a href="{{ interior_url | strip | escape }}"><strong>{{ 'interior_story.path_interior_title' | t }}</strong><span>{{ 'interior_story.path_interior_text' | t }}</span></a>
      <a href="{{ substrate_url | strip | escape }}"><strong>{{ 'interior_story.path_substrate_title' | t }}</strong><span>{{ 'interior_story.path_substrate_text' | t }}</span></a>
      <a href="{{ light_url | strip | escape }}"><strong>{{ 'interior_story.path_light_title' | t }}</strong><span>{{ 'interior_story.path_light_text' | t }}</span></a>
      <a href="{{ plants_url | strip | escape }}"><strong>{{ 'interior_story.path_plants_title' | t }}</strong><span>{{ 'interior_story.path_plants_text' | t }}</span></a>
      <a href="{{ planters_url | strip | escape }}"><strong>{{ 'interior_story.path_planters_title' | t }}</strong><span>{{ 'interior_story.path_planters_text' | t }}</span></a>
      <a href="{{ succulents_url | strip | escape }}"><strong>{{ 'interior_story.path_succulents_title' | t }}</strong><span>{{ 'interior_story.path_succulents_text' | t }}</span></a>
    </div>
  </section>

  <section class="leaf-story__article-copy">
    {{ article.content }}
  </section>

  <nav class="leaf-story__related" aria-label="{{ 'interior_story.related_aria' | t | escape }}">
    <a href="{{ interior_url | strip | escape }}">{{ 'interior_story.related_interior' | t }}</a>
    <a href="{{ all_products_url | strip | escape }}">{{ 'interior_story.related_all' | t }}</a>
  </nav>
</article>

<style>
#LeafInteriorStory-{{ section.id }}{
  --ls-bg:#0b100b;
  --ls-panel:#101710;
  --ls-line:rgba(255,255,255,.14);
  --ls-text:#f6f5ed;
  --ls-muted:rgba(246,245,237,.68);
  --ls-accent:#b9f2a7;
  --ls-ink:#102013;
  color:var(--ls-text);
  background:var(--ls-bg);
  padding:clamp(18px,3vw,44px);
}
#LeafInteriorStory-{{ section.id }} *{box-sizing:border-box}
#LeafInteriorStory-{{ section.id }} button{font:inherit}

.leaf-story__hero{
  max-width:1500px;
  margin:0 auto 22px;
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:24px;
}
.leaf-story__hero>div{max-width:930px}
.leaf-story__eyebrow{
  color:var(--ls-accent);
  font-size:.7rem;
  letter-spacing:.17em;
  font-weight:800;
}
.leaf-story__hero h1{
  margin:7px 0 8px;
  max-width: 28ch;
  color:#fff;
  font-size: clamp(1.8rem, 3.2vw, 2.75rem);
  line-height: 1.2;
  letter-spacing: -.025em;
}
.leaf-story__hero p{
  margin:0;
  max-width:780px;
  color:var(--ls-muted);
  font-size:clamp(.96rem,1.3vw,1.14rem);
  line-height:1.55;
}
.leaf-story__draft{
  padding:9px 11px;
  border:1px solid var(--ls-line);
  color:var(--ls-muted);
  font-size:.72rem;
  white-space:nowrap;
}

.leaf-story__experience{
  max-width:1500px;
  margin:0 auto;
  display:grid;
  grid-template-columns:minmax(0,1.8fr) minmax(320px,.72fr);
  gap:14px;
}
.leaf-story__scene-wrap{
  position:relative;
  min-width:0;
}
.leaf-story__scene{
  --focus-x:50%;
  --focus-y:50%;
  position:relative;
  min-height:640px;
  overflow:hidden;
  border:1px solid var(--ls-line);
  background-image:url('https://cdn.shopify.com/s/files/1/0949/8876/3521/files/interieur-solution-pflanzenraum-panorama.png?v=1790445342');
  background-size:cover;
  background-position:50% 50%;
  transition:background-position .55s cubic-bezier(.22,.7,.24,1),filter .4s ease;
}
.leaf-story__scene::before{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(180deg,rgba(3,8,3,.18),transparent 30%,transparent 66%,rgba(3,8,3,.35));
  pointer-events:none;
}
.leaf-story__focus{
  position:absolute;
  inset:0;
  opacity:1;
  background:radial-gradient(circle at var(--focus-x) var(--focus-y),transparent 0 11%,rgba(2,7,2,.02) 20%,rgba(2,7,2,.58) 69%,rgba(2,7,2,.72) 100%);
  transition:opacity .35s ease,background .45s ease;
  pointer-events:none;
}
.leaf-story__scene.is-overview .leaf-story__focus{opacity:0}

.leaf-story__hotspot{
  position:absolute;
  z-index:4;
  min-height:44px;
  padding:6px 9px;
  display:flex;
  align-items:center;
  gap:7px;
  border:1px solid rgba(255,255,255,.30);
  background:rgba(8,14,8,.76);
  color:#fff;
  cursor:pointer;
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  transition:opacity .25s ease,transform .25s ease,border-color .25s ease;
}
.leaf-story__hotspot span{
  width:29px;
  height:29px;
  display:grid;
  place-items:center;
  background:rgba(255,255,255,.10);
  color:#fff;
  font-size:.65rem;
  font-weight:800;
}
.leaf-story__hotspot strong{font-size:.72rem}
.leaf-story__hotspot.is-active{
  border-color:var(--ls-accent);
  transform:translateY(-2px);
}
.leaf-story__hotspot.is-active span{
  background:var(--ls-accent);
  color:var(--ls-ink);
}
.leaf-story__scene:not(.is-overview) .leaf-story__hotspot:not(.is-active){opacity:.48}

.leaf-story__hotspot[data-zone="overview"]{left:47%;top:49%}
.leaf-story__hotspot--plants{left:24%;top:38%}
.leaf-story__hotspot--planter{left:31%;top:63%}
.leaf-story__hotspot--light{left:50%;top:27%}
.leaf-story__hotspot--terrarium{right:8%;top:48%}
.leaf-story__hotspot--vertical{right:18%;top:18%}

.leaf-story__scene-hint{
  position:absolute;
  left:12px;
  bottom:12px;
  z-index:5;
  display:flex;
  gap:1px;
}
.leaf-story__scene-hint span{
  padding:7px 9px;
  border:1px solid rgba(255,255,255,.18);
  background:rgba(8,14,8,.72);
  color:rgba(255,255,255,.75);
  font-size:.66rem;
}

.leaf-story__panel{
  min-width:0;
  padding:24px;
  display:flex;
  flex-direction:column;
  border:1px solid var(--ls-line);
  background:var(--ls-panel);
}
.leaf-story__counter{
  margin-bottom:auto;
  color:var(--ls-muted);
  font-size:.68rem;
  letter-spacing:.12em;
}
.leaf-story__panel-kicker{
  margin-top:26px;
  color:var(--ls-accent);
  font-size:.68rem;
  letter-spacing:.13em;
  text-transform:uppercase;
  font-weight:800;
}
.leaf-story__panel h2{
  margin:7px 0 10px;
  color:#fff;
  font-size: clamp(1.35rem, 2.6vw, 1.9rem);
  line-height: 1.2;
  letter-spacing:-.025em;
}
.leaf-story__panel p{
  margin:0;
  color:var(--ls-muted);
  font-size:.88rem;
  line-height:1.65;
}
.leaf-story__panel ul{
  margin:18px 0 0;
  padding:0;
  list-style:none;
  border-top:1px solid var(--ls-line);
}
.leaf-story__panel li{
  padding:10px 0;
  border-bottom:1px solid var(--ls-line);
  color:#fff;
  font-size:.78rem;
  line-height:1.4;
}
.leaf-story__panel li::before{
  content:"↗";
  margin-right:8px;
  color:var(--ls-accent);
}
.leaf-story__controls{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
  margin-top:24px;
}
.leaf-story__controls button{
  min-height:44px;
  border:1px solid var(--ls-line);
  background:#151d15;
  color:#fff;
  cursor:pointer;
}
.leaf-story__controls button:last-child{
  border-color:var(--ls-accent);
  background:var(--ls-accent);
  color:var(--ls-ink);
  font-weight:800;
}

.leaf-story__tabs{
  max-width:1500px;
  margin:10px auto 0;
  display:flex;
  gap:6px;
  overflow-x:auto;
  scrollbar-width:none;
}
.leaf-story__tabs::-webkit-scrollbar{display:none}
.leaf-story__tabs button{
  flex:0 0 auto;
  min-height:42px;
  padding:0 13px;
  border:1px solid var(--ls-line);
  background:transparent;
  color:var(--ls-muted);
  cursor:pointer;
  white-space:nowrap;
}
.leaf-story__tabs button.is-active{
  border-color:var(--ls-accent);
  color:#fff;
}

.leaf-story__content{
  max-width:1500px;
  margin:54px auto 0;
  padding-top:34px;
  border-top:1px solid var(--ls-line);
}
.leaf-story__content-lead{
  display:grid;
  grid-template-columns:.7fr 1.3fr;
  gap:24px;
  align-items:end;
}
.leaf-story__content-lead h2{
  margin:6px 0 0;
  color:#fff;
  font-size: clamp(1.35rem, 2.6vw, 1.9rem);
  line-height: 1.2;
  letter-spacing: -.025em;
}
.leaf-story__content-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:1px;
  margin-top:25px;
  border:1px solid var(--ls-line);
  background:var(--ls-line);
}
.leaf-story__content-grid>div{
  min-height:190px;
  padding:20px;
  background:#101610;
}
.leaf-story__content-grid h3{
  margin:0 0 8px;
  color:#fff;
  font-size:1rem;
}
.leaf-story__content-grid p,
.leaf-story__article-copy{
  color:var(--ls-muted);
  font-size:.84rem;
  line-height:1.65;
}
.leaf-story__article-copy{
  max-width:880px;
  margin:42px auto 0;
}
.leaf-story__article-copy h2,
.leaf-story__article-copy h3{color:#fff}
.leaf-story__related{
  max-width:880px;
  margin:28px auto 0;
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}
.leaf-story__related a{
  min-height:44px;
  padding:0 14px;
  display:inline-flex;
  align-items:center;
  border:1px solid var(--ls-line);
  color:#fff;
  text-decoration:none;
}

@media(max-width:1050px){
  .leaf-story__experience{grid-template-columns:1fr}
  .leaf-story__scene{min-height:520px}
  .leaf-story__panel{min-height:0}
  .leaf-story__counter{margin-bottom:0}
  .leaf-story__panel-kicker{margin-top:14px}
  .leaf-story__content-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}

@media(max-width:700px){
  #LeafInteriorStory-{{ section.id }}{padding:0 0 30px}
  .leaf-story__hero{
    display:block;
    margin:0;
    padding:16px 16px 14px;
  }
  .leaf-story__draft{display:none}
  .leaf-story__hero h1{
    max-width:none;
    margin:5px 0 7px;
    font-size:clamp(1.9rem,9vw,2.55rem);
  }
  .leaf-story__hero p{
    font-size:.83rem;
    line-height:1.48;
  }
  .leaf-story__experience{
    display:block;
  }
  .leaf-story__scene-wrap{
    margin:0 10px;
  }
  .leaf-story__scene{
    min-height:0;
    height:300px;
    background-size:auto 100%;
    background-position:50% 50%;
  }
  .leaf-story__scene:not(.is-overview){
    background-size:auto 114%;
  }
  .leaf-story__focus{
    background:radial-gradient(circle at var(--focus-x) var(--focus-y),transparent 0 10%,rgba(2,7,2,.02) 20%,rgba(2,7,2,.58) 64%,rgba(2,7,2,.72) 100%);
  }
  .leaf-story__hotspot{
    width:42px;
    min-width:42px;
    height:42px;
    min-height:42px;
    padding:0;
    display:grid;
    place-items:center;
  }
  .leaf-story__hotspot span{width:28px;height:28px}
  .leaf-story__hotspot strong{display:none}
  .leaf-story__hotspot[data-zone="overview"]{left:46%;top:47%}
  .leaf-story__hotspot--plants{left:20%;top:38%}
  .leaf-story__hotspot--planter{left:29%;top:65%}
  .leaf-story__hotspot--light{left:50%;top:24%}
  .leaf-story__hotspot--terrarium{right:5%;top:48%}
  .leaf-story__hotspot--vertical{right:16%;top:15%}
  .leaf-story__scene:not(.is-overview) .leaf-story__hotspot:not(.is-active){opacity:.25}
  .leaf-story__scene-hint{left:6px;bottom:6px}
  .leaf-story__scene-hint span:last-child{display:none}
  .leaf-story__panel{
    margin:0 10px;
    padding:16px 14px 14px;
    border-top:0;
  }
  .leaf-story__panel-kicker{margin-top:11px}
  .leaf-story__panel h2{
    margin:5px 0 7px;
    font-size:1.35rem;
  }
  .leaf-story__panel p{
    font-size:.8rem;
    line-height:1.55;
  }
  .leaf-story__panel ul{margin-top:13px}
  .leaf-story__panel li{padding:8px 0;font-size:.73rem}
  .leaf-story__controls{margin-top:14px}
  .leaf-story__tabs{
    margin:8px 10px 0;
    padding-bottom:2px;
    scroll-snap-type:x proximity;
  }
  .leaf-story__tabs button{
    min-height:40px;
    padding:0 11px;
    font-size:.7rem;
    scroll-snap-align:start;
  }
  .leaf-story__content{
    margin:34px 16px 0;
    padding-top:25px;
  }
  .leaf-story__content-lead{display:block}
  .leaf-story__content-lead h2{
    font-size:1.65rem;
  }
  .leaf-story__content-grid{
    grid-template-columns:1fr;
    margin-top:18px;
  }
  .leaf-story__content-grid>div{
    min-height:0;
    padding:16px;
  }
  .leaf-story__article-copy{
    margin:30px 16px 0;
    font-size:.8rem;
  }
  .leaf-story__related{
    margin:24px 16px 0;
    display:grid;
  }
  .leaf-story__related a{
    justify-content:center;
  }
}

@media(prefers-reduced-motion:reduce){
  .leaf-story__scene,.leaf-story__focus,.leaf-story__hotspot{transition:none}
}

/* LEAF CONVERSION CTA CSS START */
.leaf-story__cta{
  display:grid;
  gap:7px;
  margin-top:20px;
}
.leaf-story__cta a{
  min-height:48px;
  padding:0 14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  text-decoration:none;
  transition:transform .2s ease,border-color .2s ease,background .2s ease;
}
.leaf-story__cta-primary{
  border:1px solid var(--ls-accent);
  background:var(--ls-accent);
  color:var(--ls-ink);
  font-weight:850;
}
.leaf-story__cta-secondary{
  border:1px solid var(--ls-line);
  color:#fff;
  background:rgba(255,255,255,.02);
  font-size:.78rem;
}
.leaf-story__cta a:hover,
.leaf-story__cta a:focus-visible{
  transform:translateY(-1px);
}
.leaf-story__cta-secondary:hover,
.leaf-story__cta-secondary:focus-visible{
  border-color:var(--ls-accent);
}
