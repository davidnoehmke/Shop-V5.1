</style>

<script>
(()=>{
  const root=document.getElementById('LeafInteriorStory-{{ section.id }}');
  if(!root||root.dataset.ready==='1')return;
  root.dataset.ready='1';

  const zones=[
    {
      id:'overview',
      kicker:{{ 'interior_story.overview_kicker' | t | json }},
      title:{{ 'interior_story.overview_title' | t | json }},
      copy:{{ 'interior_story.overview_copy' | t | json }},
      points:[{{ 'interior_story.overview_point_1' | t | json }},{{ 'interior_story.overview_point_2' | t | json }},{{ 'interior_story.overview_point_3' | t | json }}],
      ctaLabel:{{ 'interior_story.overview_cta' | t | json }},ctaHref:{{ interior_url | strip | json }},
      secondaryLabel:{{ 'interior_story.overview_secondary' | t | json }},secondaryHref:{{ light_url | strip | json }}
    },
    {
      id:'plants',
      kicker:{{ 'interior_story.plants_kicker' | t | json }},
      title:{{ 'interior_story.plants_title' | t | json }},
      copy:{{ 'interior_story.plants_copy' | t | json }},
      points:[{{ 'interior_story.plants_point_1' | t | json }},{{ 'interior_story.plants_point_2' | t | json }},{{ 'interior_story.plants_point_3' | t | json }}],
      ctaLabel:{{ 'interior_story.plants_cta' | t | json }},ctaHref:{{ plants_url | strip | json }},
      secondaryLabel:{{ 'interior_story.plants_secondary' | t | json }},secondaryHref:{{ interior_url | strip | json }}
    },
    {
      id:'planter',
      kicker:{{ 'interior_story.planter_kicker' | t | json }},
      title:{{ 'interior_story.planter_title' | t | json }},
      copy:{{ 'interior_story.planter_copy' | t | json }},
      points:[{{ 'interior_story.planter_point_1' | t | json }},{{ 'interior_story.planter_point_2' | t | json }},{{ 'interior_story.planter_point_3' | t | json }}],
      ctaLabel:{{ 'interior_story.planter_cta' | t | json }},ctaHref:{{ substrate_url | strip | json }},
      secondaryLabel:{{ 'interior_story.planter_secondary' | t | json }},secondaryHref:{{ planters_url | strip | json }}
    },
    {
      id:'light',
      kicker:{{ 'interior_story.light_kicker' | t | json }},
      title:{{ 'interior_story.light_title' | t | json }},
      copy:{{ 'interior_story.light_copy' | t | json }},
      points:[{{ 'interior_story.light_point_1' | t | json }},{{ 'interior_story.light_point_2' | t | json }},{{ 'interior_story.light_point_3' | t | json }}],
      ctaLabel:{{ 'interior_story.light_cta' | t | json }},ctaHref:{{ light_url | strip | json }},
      secondaryLabel:{{ 'interior_story.light_secondary' | t | json }},secondaryHref:{{ interior_url | strip | json }}
    },
    {
      id:'terrarium',
      kicker:{{ 'interior_story.terrarium_kicker' | t | json }},
      title:{{ 'interior_story.terrarium_title' | t | json }},
      copy:{{ 'interior_story.terrarium_copy' | t | json }},
      points:[{{ 'interior_story.terrarium_point_1' | t | json }},{{ 'interior_story.terrarium_point_2' | t | json }},{{ 'interior_story.terrarium_point_3' | t | json }}],
      ctaLabel:{{ 'interior_story.terrarium_cta' | t | json }},ctaHref:{{ succulents_url | strip | json }},
      secondaryLabel:{{ 'interior_story.terrarium_secondary' | t | json }},secondaryHref:{{ interior_url | strip | json }}
    },
    {
      id:'vertical',
      kicker:{{ 'interior_story.vertical_kicker' | t | json }},
      title:{{ 'interior_story.vertical_title' | t | json }},
      copy:{{ 'interior_story.vertical_copy' | t | json }},
      points:[{{ 'interior_story.vertical_point_1' | t | json }},{{ 'interior_story.vertical_point_2' | t | json }},{{ 'interior_story.vertical_point_3' | t | json }}],
      ctaLabel:{{ 'interior_story.vertical_cta' | t | json }},ctaHref:{{ supports_url | strip | json }},
      secondaryLabel:{{ 'interior_story.vertical_secondary' | t | json }},secondaryHref:{{ interior_url | strip | json }}
    }
  ];

  const scene=root.querySelector('[data-story-scene]');
  const buttons=[...root.querySelectorAll('[data-zone]')];
  const count=root.querySelector('[data-zone-count]');
  const kicker=root.querySelector('[data-zone-kicker]');
  const title=root.querySelector('[data-zone-title]');
  const copy=root.querySelector('[data-zone-copy]');
  const points=root.querySelector('[data-zone-points]');
  const cta=root.querySelector('[data-zone-cta]');
  const secondary=root.querySelector('[data-zone-secondary]');
  const prev=root.querySelector('[data-zone-prev]');
  const next=root.querySelector('[data-zone-next]');
  let index=0;

  function esc(v){return String(v).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch]))}

  function activate(id){
    const nextIndex=zones.findIndex(z=>z.id===id);
    if(nextIndex<0)return;
    index=nextIndex;
    const zone=zones[index];
    const source=root.querySelector('.leaf-story__hotspot[data-zone="'+zone.id+'"]');

    buttons.forEach(btn=>{
      const active=btn.dataset.zone===zone.id;
      btn.classList.toggle('is-active',active);
      btn.setAttribute('aria-current',active?'true':'false');
    });

    scene.classList.toggle('is-overview',zone.id==='overview');
    if(source){
      scene.style.setProperty('--focus-x',(source.dataset.x||50)+'%');
      scene.style.setProperty('--focus-y',(source.dataset.y||50)+'%');
      scene.style.backgroundPosition=source.dataset.bg||'50% 50%';
    }

    count.textContent=(index+1)+' / '+zones.length;
    kicker.textContent=zone.kicker;
    title.textContent=zone.title;
    copy.textContent=zone.copy;
    points.innerHTML=zone.points.map(p=>'<li>'+esc(p)+'</li>').join('');
    if(cta){cta.textContent=zone.ctaLabel+' →';cta.href=zone.ctaHref}
    if(secondary){secondary.textContent=zone.secondaryLabel;secondary.href=zone.secondaryHref}
    prev.disabled=index===0;
    next.disabled=index===zones.length-1;
    next.textContent=index===zones.length-1?{{ 'interior_story.end' | t | json }}:{{ 'interior_story.next' | t | json }};
  }

  buttons.forEach(btn=>btn.addEventListener('click',()=>activate(btn.dataset.zone)));
  prev.addEventListener('click',()=>activate(zones[Math.max(0,index-1)].id));
  next.addEventListener('click',()=>activate(zones[Math.min(zones.length-1,index+1)].id));

  activate('overview');
})();
</script>


