}
@media(max-width:900px){
  .leaf-story__pathways{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:700px){
  .leaf-story__cta{margin-top:14px}
  .leaf-story__cta a{min-height:46px;font-size:.76rem}
  .leaf-story__pathways{
