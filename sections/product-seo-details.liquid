{%- liquid
  if request.locale.iso_code == 'de'
    assign label_index = 2
    assign details_eyebrow = 'product.content.details_eyebrow' | t
    assign details_heading = 'product.content.details_heading' | t
    assign faq_heading = 'Häufige Fragen'
    assign description_heading = 'Weitere Produktdetails'
  else
    assign label_index = 3
    assign details_eyebrow = 'product.content.details_eyebrow' | t
    assign details_heading = 'product.content.details_heading' | t
    assign faq_heading = 'Frequently asked questions'
    assign description_heading = 'More product details'
  endif
  assign fact_definitions = 'custom|light_style|Lichtcharakter|Light character||custom|lighting_position|Beleuchtungsposition|Lighting position||custom|recommended_room|Geeignete Räume|Recommended rooms||leafer|primary_function|Hauptfunktion|Primary function||leafer|suitable_for|Geeignet für|Suitable for||leafer|ingredients|Bestandteile|Ingredients||leafer|water_behavior|Wasserverhalten|Water behaviour||leafer|planter_type|Gefäßtyp|Planter type||leaferservice|botanischer_name|Botanischer Name|Botanical name||leaferservice|keimtemperatur|Keimtemperatur|Germination temperature||leaferservice|keimdauer|Keimdauer|Germination time||leaferservice|aussaatzeit|Aussaatzeit|Sowing period||leaferservice|aussaattiefe|Aussaattiefe|Sowing depth||leaferservice|standort|Standort|Location||leaferservice|substrat_empfehlung|Substrat|Substrate||leaferservice|giessen|Gießen|Watering||leaferservice|schwierigkeitsgrad|Schwierigkeitsgrad|Difficulty||leaferservice|mehrjaehrig|Mehrjährig|Perennial||leaferservice|winterhaerte|Winterhärte|Winter hardiness||lighting|manufacturer|Hersteller|Manufacturer||lighting|model|Modell|Model||lighting|rated_power_w|Nennleistung|Rated power||lighting|cct_k|Farbtemperatur|Color temperature||lighting|spectrum|Spektrum|Spectrum||lighting|ppf_umol_s|PPF|PPF||lighting|ppfd_reference|PPFD-Referenz|PPFD reference||lighting|coverage_guidance|Ausleuchtung|Coverage||lighting|recommended_distance|Empfohlener Abstand|Recommended distance||lighting|timer_control|Timer / Steuerung|Timer / control||lighting|dimmable|Dimmbar|Dimmable||lighting|ip_rating|Schutzart|IP rating||lighting|socket_connector|Sockel / Anschluss|Socket / connector||lighting|voltage|Spannung|Voltage||lighting|use_cases|Einsatzbereiche|Use cases||lighting|beam_angle|Abstrahlwinkel|Beam angle||lighting|weee_disposal|Entsorgung|Disposal||lighting|manufacturer_address|Herstelleranschrift|Manufacturer address||leaf_configurator|plant_groups|Pflanzengruppen|Plant groups||leaf_configurator|volume_liters|Volumen|Volume' | split: '||'
-%}
{%- capture source_status -%}{%- render 'leaf-product-source-status', product: product -%}{%- endcapture -%}
{%- capture product_kind -%}{%- render 'leaf-product-kind', product: product -%}{%- endcapture -%}
{%- liquid
  assign structured_description = false
  if product_kind == 'mix' or product_kind == 'component' or source_status == 'review'
    if product.metafields.leafer.primary_function.value != blank and product.metafields.leafer.suitable_for.value != blank
      assign structured_description = true
    endif
  endif
-%}
{%- capture facts_markup -%}
  {%- for definition in fact_definitions -%}
    {%- liquid
      assign parts = definition | split: '|'
      assign field_namespace = parts[0]
      assign field_key = parts[1]
      assign fact = product.metafields[field_namespace][field_key]
      if field_key == 'schwierigkeitsgrad' and fact.value == blank
        assign fact = product.metafields.leafer.difficulty
      endif
    -%}
    {%- liquid
      assign show_fact = false
      if fact.value != blank or fact.type == 'boolean'
        assign show_fact = true
      endif
      if structured_description
        if field_key == 'primary_function' or field_key == 'suitable_for' or field_key == 'water_behavior'
          assign show_fact = false
        endif
      endif
      if field_key == 'ingredients'
        if product_kind == 'mix' or product_kind == 'component' and structured_description
          assign show_fact = false
        endif
      endif
      if field_key == 'plant_groups' and product.metafields.leafer.suitable_for.value != blank
        assign show_fact = false
      endif
      if source_status == 'review' and field_namespace == 'lighting'
        if field_key == 'ppf_umol_s' or field_key == 'ppfd_reference' or field_key == 'coverage_guidance' or field_key == 'recommended_distance'
          assign show_fact = false
        endif
      endif
    -%}
    {%- if show_fact -%}
      {%- liquid
        assign fact_icon = 'info'
        if field_namespace == 'lighting'
          assign fact_icon = 'light'
        elsif field_key == 'ingredients' or field_key == 'mixing_ratio' or field_key == 'additive_application'
          assign fact_icon = 'layers'
        elsif field_key == 'water_behavior' or field_key == 'giessen'
          assign fact_icon = 'water'
        elsif field_key == 'botanischer_name' or field_key == 'suitable_for' or field_key == 'use_cases' or field_key == 'standort'
          assign fact_icon = 'leaf'
        elsif field_key == 'schwierigkeitsgrad'
          assign fact_icon = 'care'
        endif
      -%}
      <div class="product-seo-details__fact">
        <span class="product-seo-details__fact-icon" aria-hidden="true">{% render 'leaf-knowledge-icon', icon_key: fact_icon %}</span>
        <div class="product-seo-details__fact-copy"><dt>{{ parts[label_index] | escape }}</dt><dd>
        {%- if field_key == 'botanischer_name' -%}<i>{%- endif -%}
        {%- if field_namespace == 'lighting' and field_key == 'rated_power_w' -%}
          {% render 'leaf-unit-value', field: fact, unit: 'W' %}
        {%- elsif field_namespace == 'lighting' and field_key == 'cct_k' -%}
          {% render 'leaf-unit-value', field: fact, unit: 'K' %}
        {%- elsif field_namespace == 'lighting' and field_key == 'ppf_umol_s' -%}
          {% render 'leaf-unit-value', field: fact, unit: 'µmol/s' %}
        {%- elsif field_namespace == 'leaf_configurator' and field_key == 'volume_liters' -%}
          {% render 'leaf-unit-value', field: fact, unit: 'L' %}
        {%- else -%}
          {%- render 'leaf-metafield-value', field: fact -%}
        {%- endif -%}
        {%- if field_key == 'botanischer_name' -%}</i>{%- endif -%}
      </dd></div></div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture description_markup -%}{%- render 'leaf-product-description', product: product -%}{%- endcapture -%}
{%- capture guide_markup -%}{%- render 'leaf-product-pathways', product: product -%}{%- endcapture -%}
{%- capture faq_markup -%}{%- render 'product-faq-entries', product: product -%}{%- endcapture -%}
{%- liquid
  assign facts_markup = facts_markup | strip
  assign faq_markup = faq_markup | strip
-%}
{% if facts_markup != blank or guide_markup != blank or section.settings.show_embedded_description or section.settings.show_embedded_faq %}
  <section class="product-seo-details page-width" {% if facts_markup != blank %}aria-labelledby="ProductDetails-{{ section.id }}"{% else %}aria-label="{{ 'product.content.guides' | t }}"{% endif %}>
    {% if facts_markup != blank %}<header class="product-seo-details__header">
      <p class="product-seo-details__eyebrow">{{ details_eyebrow }}</p>
      <h2 id="ProductDetails-{{ section.id }}">{{ details_heading | escape }}</h2>
      
    </header>{% endif %}
    {% if facts_markup != blank %}<div class="product-seo-details__facts"><dl>{{ facts_markup }}</dl></div>{% endif %}
    {% if description_markup != blank and section.settings.show_embedded_description %}
      <details class="product-seo-details__description">
        <summary>
          <span class="product-seo-details__description-icon" aria-hidden="true">{% render 'leaf-knowledge-icon', icon_key: 'leaf' %}</span>
          <span>{{ description_heading }}</span>
          <span class="product-seo-details__description-plus" aria-hidden="true">+</span>
        </summary>
        <div class="product-seo-details__description-body rte">{{ description_markup }}</div>
      </details>
    {% endif %}
    {% if faq_markup != blank and section.settings.show_embedded_faq %}
      <div class="product-seo-details__faq">
        <div class="product-seo-details__faq-head"><p class="product-seo-details__eyebrow">FAQ</p><h3>{{ faq_heading }}</h3></div>
        <div class="product-seo-details__faq-list">{{ faq_markup }}</div>
      </div>
    {% endif %}
    {{ guide_markup }}
  </section>
{% endif %}

{% stylesheet %}
  .product-seo-details { margin-block: clamp(1.5rem, 4vw, 3rem); padding-block: clamp(1.25rem, 3vw, 2.5rem); border-block: 1px solid var(--border); }
  .product-seo-details__header { max-width: 760px; }
  .product-seo-details__eyebrow { margin: 0 0 .55rem; color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .product-seo-details h2 { margin: 0; max-width: 18ch; font-size: clamp(1.35rem, 2.6vw, 1.9rem); line-height: 1.2; letter-spacing: -.025em; text-wrap: balance; }
  .product-seo-details__intro { max-width: 64ch; margin: 1rem 0 0; color: var(--muted); font-size: clamp(1rem, 4.2vw, 1.2rem); line-height: 1.65; }
  .product-seo-details__description { max-width: 900px; margin-top: clamp(2rem, 7vw, 4rem); border-block: 1px solid var(--border); }
  .product-seo-details__description summary { min-height: 68px; display: grid; grid-template-columns: 36px minmax(0,1fr) 32px; gap: .8rem; align-items: center; cursor: pointer; list-style: none; color: var(--text); font-weight: 800; }
  .product-seo-details__description summary::-webkit-details-marker { display: none; }
  .product-seo-details__description summary::marker { content: ''; }
  .product-seo-details__description-icon { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--border); color: var(--accent); }
  .product-seo-details__description-icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; }
  .product-seo-details__description-plus { width: 30px; height: 30px; display: grid; place-items: center; font-size: 1.2rem; transition: transform .2s ease; }
  .product-seo-details__description[open] .product-seo-details__description-plus { transform: rotate(45deg); }
  .product-seo-details__description-body { max-width: 76ch; padding: 0 0 1.4rem 2.8rem; color: var(--muted); line-height: 1.72; }
  .product-seo-details__facts, .product-seo-details__knowledge, .product-seo-details__faq { margin-top: clamp(1.2rem, 3vw, 2rem); }
  .product-seo-details__knowledge { max-width: 980px; }
  .product-seo-details__knowledge > .leaf-atoms { margin-top: 1rem; }
  .product-seo-details h3 { margin: 0 0 1rem; font-size: clamp(1.1rem, 2.2vw, 1.35rem); line-height: 1.2; letter-spacing: -.025em; }
  .product-seo-details__facts dl { margin: 0; display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--border); }
  .product-seo-details__facts dl > div { display: grid; grid-template-columns: 34px minmax(0,1fr); gap: .7rem; align-items: start; padding: .95rem .15rem; border-bottom: 1px solid var(--border); }
  .product-seo-details__fact-icon { width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid var(--border); color: var(--accent); }
  .product-seo-details__fact-icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; }
  .product-seo-details__fact-copy { min-width: 0; }
  .product-seo-details dt { color: var(--muted); font-size: .78rem; font-weight: 800; letter-spacing: .035em; text-transform: uppercase; }
  .product-seo-details dd { margin: 0; line-height: 1.55; overflow-wrap: anywhere; }
  .product-seo-details__notice { margin-top: 1.4rem; padding: 1rem 1.1rem; border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 12px; background: var(--surface); line-height: 1.55; }
  .product-seo-details__faq { max-width: 900px; }
  .product-seo-details__faq-head { margin-bottom: 1rem; }
  .product-seo-details__faq-list { display: grid; gap: .65rem; }
  .product-seo-details__faq-item { overflow: clip; border: 1px solid var(--border); border-radius: 16px; background: var(--surface); transition: border-color .2s ease, background .2s ease, box-shadow .2s ease; }
  .product-seo-details__faq-item[open] { border-color: color-mix(in srgb, var(--accent) 32%, var(--border)); background: color-mix(in srgb, var(--accent) 4%, var(--surface)); box-shadow: 0 10px 30px rgba(0,0,0,.035); }
  .product-seo-details__faq-item summary { min-height: 60px; padding: .95rem 1rem; display: grid; grid-template-columns: minmax(0,1fr) 34px; align-items: center; gap: .8rem; cursor: pointer; list-style: none; font-size: .98rem; font-weight: 780; line-height: 1.35; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  .product-seo-details__faq-item summary::-webkit-details-marker { display: none; }
  .product-seo-details__faq-item summary::marker { content: ''; }
  .product-seo-details__faq-item summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; border-radius: 14px; }
  .product-seo-details__faq-icon { position: relative; width: 34px; height: 34px; border-radius: 50%; background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .product-seo-details__faq-icon::before, .product-seo-details__faq-icon::after { content: ''; position: absolute; top: 50%; left: 50%; width: 13px; height: 1.5px; border-radius: 10px; background: var(--accent); transform: translate(-50%,-50%); transition: transform .2s ease, opacity .2s ease; }
  .product-seo-details__faq-icon::after { transform: translate(-50%,-50%) rotate(90deg); }
  .product-seo-details__faq-item[open] .product-seo-details__faq-icon::after { transform: translate(-50%,-50%) rotate(0); opacity: 0; }
  .product-seo-details__faq-answer { padding: 0 1rem 1rem; }
  .product-seo-details__faq-answer p { max-width: 70ch; margin: 0; color: var(--muted); font-size: .95rem; line-height: 1.65; }
  @media (min-width: 700px) {
    .product-seo-details__facts dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .product-seo-details__facts dl > div { grid-template-columns: 36px minmax(0,1fr); gap: .8rem; padding: 1rem; }
    .product-seo-details__facts dl > div:nth-child(odd) { border-right: 1px solid var(--border); }
    .product-seo-details__faq-item summary { min-height: 68px; padding: 1rem 1.15rem; font-size: 1.02rem; }
    .product-seo-details__faq-answer { padding: 0 1.15rem 1.15rem; }
  }
  @media (max-width: 560px) { .product-seo-details__description-body { padding-left: 0; } }
  @media (prefers-reduced-motion: reduce) { .product-seo-details__faq-item, .product-seo-details__faq-icon::before, .product-seo-details__faq-icon::after, .product-seo-details__description-plus { transition: none; } }
{% endstylesheet %}
{% schema %}
{"name":"SEO-Produktwissen","settings":[{"type":"checkbox","id":"show_embedded_description","label":"Beschreibung zusätzlich anzeigen","default":false},{"type":"checkbox","id":"show_embedded_faq","label":"FAQ zusätzlich anzeigen","default":false}],"presets":[{"name":"SEO-Produktwissen"}]}
{% endschema %}
