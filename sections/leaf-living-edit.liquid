{% assign scene_product = section.settings.product %}
{% assign scene_image = section.settings.image | default: scene_product.images[1] | default: scene_product.featured_image %}
<section class="leaf-living" aria-labelledby="LeafLiving-{{ section.id }}">
  <div class="leaf-living__image">
    {% assign scene_alt = scene_image.alt | default: scene_product.title %}
    {% if scene_image != blank %}{{ scene_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '540, 750, 1100, 1600', sizes: '(min-width: 900px) 60vw, 100vw', alt: scene_alt }}{% endif %}
    {% if scene_product != blank %}<a class="leaf-living__tag" href="{{ scene_product.url }}"><span aria-hidden="true">+</span><span>{{ scene_product.title | escape }}<small>{% if scene_product.price_varies %}{{ 'visual_shop.product.from' | t }} {% endif %}{{ scene_product.price | money }}</small></span></a>{% endif %}
  </div>
  <div class="leaf-living__copy">
    <p class="leaf-living__eyebrow">{{ 'visual_shop.living.eyebrow' | t }}</p>
    <h2 id="LeafLiving-{{ section.id }}">{{ 'visual_shop.living.heading' | t }}</h2>
    <p>{{ 'visual_shop.living.intro' | t }}</p>
    {% assign topics = 'light,pot,soil' | split: ',' %}
    {% for topic in topics %}
      {% assign title_key = 'visual_shop.living.' | append: topic | append: '_title' %}
      {% assign body_key = 'visual_shop.living.' | append: topic | append: '_body' %}
      {% assign link_key = 'visual_shop.living.' | append: topic | append: '_link' %}
      {% assign target = section.settings.lighting %}
      {% if topic == 'pot' %}{% assign target = section.settings.planters %}{% elsif topic == 'soil' %}{% assign target = section.settings.substrates %}{% endif %}
      <details><summary><span class="leaf-living__number">0{{ forloop.index }}</span>{{ title_key | t }}<span class="leaf-living__plus" aria-hidden="true">+</span></summary><div><p>{{ body_key | t }}</p>{% if target != blank %}<a href="{{ target.url }}">{{ link_key | t }} ↗</a>{% endif %}</div></details>
    {% endfor %}
    <a class="leaf-living__planner" href="{{ section.settings.help_link }}">{{ 'visual_shop.living.help' | t }} ↗</a>
  </div>
</section>
{% stylesheet %}
.leaf-living{display:grid;grid-template-columns:1.2fr 1fr;background:#253b2d;color:#fff;margin:0;isolation:isolate}
.leaf-living *{box-sizing:border-box}
.leaf-living__image{position:relative;min-height:600px;background:#e6e9df;overflow:hidden}
.leaf-living__image>img{width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0}
.leaf-living__tag{position:absolute;left:24px;right:24px;bottom:24px;display:flex;gap:14px;align-items:center;width:fit-content;max-width:calc(100% - 48px);padding:14px 20px;background:rgb(255 255 255 / .95);color:#253b2d;text-decoration:none;border-radius:4px;font-size:.85rem;line-height:1.4}
.leaf-living__tag>span:first-child{font-size:1.8rem;font-weight:400}.leaf-living__tag small{display:block;font-weight:700;margin-top:4px;font-size:.85rem}
.leaf-living__copy{padding:clamp(32px,5vw,76px);align-self:center}
.leaf-living__eyebrow{font-size:.7rem!important;text-transform:uppercase;letter-spacing:.15em;color:#d5e0c3!important;margin:0 0 20px}
.leaf-living h2{font-size:clamp(2.25rem,4.2vw,4.5rem);font-weight:500;letter-spacing:-.04em;line-height:1.04;color:#fff;margin:0 0 24px;max-width:13ch}
.leaf-living__copy>p{color:#d9e2d3;font-size:.95rem;line-height:1.7;max-width:40ch}
.leaf-living details{border-bottom:1px solid #64745e}
.leaf-living summary{display:flex;gap:14px;align-items:center;cursor:pointer;min-height:64px;list-style:none;font-size:1rem;font-weight:550;padding:14px 0}
.leaf-living summary::-webkit-details-marker{display:none}
.leaf-living__number{font-size:.7rem;color:#ceddb7;letter-spacing:.08em}.leaf-living__plus{margin-left:auto;font-size:1.5rem;font-weight:300}.leaf-living details[open] .leaf-living__plus{transform:rotate(45deg)}
.leaf-living details>div{padding:0 0 18px 32px}.leaf-living details p{font-size:.88rem;line-height:1.6;color:#d9e2d3;margin-top:0}
.leaf-living a:focus-visible,.leaf-living summary:focus-visible{outline:2px solid #e2ebd6;outline-offset:4px}
.leaf-living details a,.leaf-living__planner{color:#fff;min-height:44px;display:inline-flex;align-items:center;text-underline-offset:5px;font-size:.87rem}
.leaf-living__planner{margin-top:22px;font-weight:650}
@media(max-width:899px){.leaf-living{grid-template-columns:1fr}.leaf-living__image{min-height:0;aspect-ratio:1.2}.leaf-living__copy{padding:36px 24px 44px}.leaf-living h2{max-width:18ch}.leaf-living__tag{left:16px;bottom:16px;right:16px;max-width:calc(100% - 32px);padding:12px 16px}}
{% endstylesheet %}
{% schema %}
{"name":"LEAF Wohnwelt","settings":[{"type":"product","id":"product","label":"Produkt im Bild"},{"type":"image_picker","id":"image","label":"Anwendungsbild (optional)"},{"type":"collection","id":"lighting","label":"Pflanzenlicht"},{"type":"collection","id":"planters","label":"Gefäße"},{"type":"collection","id":"substrates","label":"Substrate"},{"type":"url","id":"help_link","label":"Beratung"}],"presets":[{"name":"LEAF Wohnwelt"}]}
{% endschema %}
