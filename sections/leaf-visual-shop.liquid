{{ 'leaf-visual-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'leaf-visual-shop.js' | asset_url }}" defer></script>
<leaf-visual-shop class="leaf-vshop" id="LeafVisualShop-{{ section.id }}">
  <div class="leaf-vshop__shell">
    <header class="leaf-vshop__heading">
      <div><p class="leaf-vshop__eyebrow">{{ 'visual_shop.edit.eyebrow' | t }}</p><h2>{{ 'visual_shop.edit.heading' | t }}</h2></div>
      <p>{{ 'visual_shop.edit.intro' | t }}</p>
    </header>
    <div class="leaf-vshop__filters" role="group" aria-label="{{ 'visual_shop.edit.filter_label' | t }}" hidden>
      {% assign groups = 'all,lighting,planters,substrates,sets' | split: ',' %}
      {% for group in groups %}
        {% assign label_key = 'visual_shop.groups.' | append: group %}
        <button type="button" data-filter="{{ group }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ label_key | t }}</button>
      {% endfor %}
    </div>
    <p class="leaf-vshop__count" aria-live="polite" aria-atomic="true" data-results data-label="{{ 'visual_shop.edit.results' | t }}"></p>
    <div class="leaf-vshop__grid">
      {% for block in section.blocks %}
        {% assign item = block.settings.product %}
        {% if item != blank and item.featured_image != blank %}
          {% assign dialog_id = 'VisualProduct-' | append: section.id | append: '-' | append: block.id %}
          {% assign benefit_key = 'visual_shop.uses.' | append: block.settings.use %}
          <article class="leaf-vshop__card" data-category="{{ block.settings.category }}" {{ block.shopify_attributes }}>
            <a class="leaf-vshop__image" href="{{ item.url }}">
              {% assign image_alt = item.featured_image.alt | default: item.title %}
              {{ item.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '240, 360, 540, 750, 1000', sizes: '(min-width: 1000px) 30vw, (min-width: 640px) 45vw, 90vw', alt: image_alt }}
              <span class="leaf-vshop__image-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="leaf-vshop__card-copy">
              <p class="leaf-vshop__brand">{{ item.vendor | escape }}</p>
              <h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
              <p class="leaf-vshop__benefit">{{ benefit_key | t }}</p>
              <div class="leaf-vshop__card-bottom"><p class="leaf-vshop__price">{% if item.price_varies %}{{ 'visual_shop.product.from' | t }} {% endif %}{{ item.price | money }}</p><button type="button" class="leaf-vshop__quick" data-open="{{ dialog_id }}" aria-haspopup="dialog" aria-label="{{ 'visual_shop.product.quick_named' | t: product: item.title | escape }}" hidden>{{ 'visual_shop.product.quick' | t }} <span aria-hidden="true">+</span></button></div>
              {% unless item.available %}<p class="leaf-vshop__unavailable">{{ 'visual_shop.product.unavailable' | t }}</p>{% endunless %}
            </div>
            <dialog class="leaf-vshop__dialog" id="{{ dialog_id }}" aria-labelledby="{{ dialog_id }}-title">
              <button type="button" class="leaf-vshop__close" data-close aria-label="{{ 'visual_shop.product.close' | t }}">×</button>
              <div class="leaf-vshop__detail">
                <div class="leaf-vshop__gallery">
                  {% for photo in item.images limit: 3 %}
                    {% assign photo_alt = photo.alt | default: item.title %}
                    {{ photo | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 750, 1000', sizes: '(min-width: 850px) 48vw, 88vw', alt: photo_alt }}
                  {% endfor %}
                </div>
                <div class="leaf-vshop__detail-copy">
                  <p class="leaf-vshop__eyebrow">{{ item.vendor | escape }}</p><h2 id="{{ dialog_id }}-title">{{ item.title | escape }}</h2><p>{{ benefit_key | t }}</p>
                  {% assign selected = item.selected_or_first_available_variant %}
                  <p class="leaf-vshop__detail-price" data-price>{{ selected.price | money }}</p>
                  <p class="leaf-vshop__tax">{{ 'visual_shop.product.tax' | t }} <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{{ 'visual_shop.product.shipping' | t }}</a></p>
                  {% assign product_form_id = dialog_id | append: '-form' %}
                  {% form 'product', item, id: product_form_id %}
                    <label for="{{ dialog_id }}-variant">{{ 'visual_shop.product.variant' | t }}</label>
                    <select id="{{ dialog_id }}-variant" name="id" data-variant>
                      {% for variant in item.variants %}
                        <option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if variant.id == selected.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} · {{ variant.price | money }}{% unless variant.available %} · {{ 'visual_shop.product.unavailable' | t }}{% endunless %}</option>
                      {% endfor %}
                    </select>
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" name="add" class="leaf-vshop__buy" {% unless item.available %}disabled{% endunless %}>{% if item.available %}{{ 'visual_shop.product.add' | t }}{% else %}{{ 'visual_shop.product.unavailable' | t }}{% endif %}</button>
                  {% endform %}
                  <a class="leaf-vshop__text-link" href="{{ item.url }}">{{ 'visual_shop.product.details' | t }} ↗</a>
                </div>
              </div>
            </dialog>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    <div class="leaf-vshop__end"><p>{{ 'visual_shop.edit.end' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'visual_shop.edit.all' | t }} <span aria-hidden="true">↗</span></a></div>
  </div>
</leaf-visual-shop>
{% schema %}
{
  "name": "LEAF Visual Shopping",
  "settings": [],
  "max_blocks": 12,
  "blocks": [{
    "type": "product",
    "name": "Produkt",
    "settings": [
      {"type":"product","id":"product","label":"Produkt"},
      {"type":"select","id":"category","label":"Bereich","default":"lighting","options":[{"value":"lighting","label":"Pflanzenlicht"},{"value":"planters","label":"Gefäße"},{"value":"substrates","label":"Substrate"},{"value":"sets","label":"Sets"}]},
      {"type":"select","id":"use","label":"Einsatz","default":"single","options":[{"value":"single","label":"Einzelpflanze"},{"value":"shelf","label":"Pflanzenregal"},{"value":"room","label":"Licht im Raum"},{"value":"planter","label":"Pflanzgefäß"},{"value":"water","label":"Bewässerung"},{"value":"aroid","label":"Alocasia"},{"value":"dry","label":"Kakteen"},{"value":"seed","label":"Anzucht"},{"value":"repot","label":"Umtopfen"}]}
    ]
  }],
  "presets": [{"name":"LEAF Visual Shopping"}]
}
{% endschema %}
