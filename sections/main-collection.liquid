  .main-collection__context-icon svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .main-collection__active-context strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .78rem; }
  .main-collection__context-count { min-width: 30px; height: 28px; display: grid; place-items: center; border: 1px solid var(--border); color: var(--accent); font-size: .7rem; font-weight: 850; }
