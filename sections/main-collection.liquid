{% liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign hero_intro = collection.metafields.leafer.intro.value | strip_html | strip
  assign knowledge_atoms = collection.metafields.leafer.knowledge_atoms.value
  if hero_intro == blank
    assign hero_intro = collection.description | strip_html | strip | truncatewords: 38
  endif

  assign hero_image = collection.image
  assign hero_image_is_product = false
  if hero_image == blank and collection.products.first != blank
    assign hero_image = collection.products.first.featured_image
    assign hero_image_is_product = true
  endif

  assign product_types = collection.products | map: 'type' | compact | uniq | sort_natural
  assign has_type_filters = false
  if section.settings.show_type_filters and product_types.size > 1
    assign has_type_filters = true
  endif

  if request.locale.iso_code == 'de'
    assign hero_eyebrow = 'Kollektion'
    assign discover_label = 'Produkte entdecken'
    assign filter_label = 'Sortiment filtern'
    assign curated_label = 'Kuratiertes Sortiment'
    assign compare_label = 'Direkt vergleichen'
    assign knowledge_label = 'Wissen & Anwendung'
    assign landscape_label = 'Produktlandschaft'
  else
    assign hero_eyebrow = 'Collection'
    assign discover_label = 'Explore products'
    assign filter_label = 'Filter assortment'
    assign curated_label = 'Curated assortment'
    assign compare_label = 'Compare directly'
    assign knowledge_label = 'Knowledge & use'
    assign landscape_label = 'Product landscape'
  endif
%}

<section class="main-collection page-width">
  <header class="main-collection__hero">
    <div class="main-collection__hero-copy">
      <p class="main-collection__eyebrow">
        <span class="main-collection__eyebrow-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 20V9l8-5 8 5v11M8 20v-7h8v7"/></svg>
        </span>
        {{ hero_eyebrow }}
      </p>
      <h1>{{ collection.title | escape }}</h1>
      {% if hero_intro != blank %}<p class="main-collection__intro">{{ hero_intro | escape }}</p>{% endif %}
      {% if knowledge_atoms != blank %}
        <div class="main-collection__knowledge">
          {% render 'leaf-content-atoms', atoms: knowledge_atoms, mode: 'chips', limit: 4 %}
        </div>
      {% endif %}

      <div class="main-collection__actions">
        <a class="main-collection__primary-action" href="#CollectionProducts-{{ section.id }}">{{ discover_label }} <span aria-hidden="true">↓</span></a>
        {% if has_type_filters %}
          <a class="main-collection__secondary-action" href="#CollectionFilters-{{ section.id }}">{{ filter_label }} <span aria-hidden="true">→</span></a>
        {% endif %}
      </div>

      <div class="main-collection__signals" aria-label="{{ collection.title | escape }}">
        <span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v14H4zM8 6V4h8v2M8 11h8M8 15h5"/></svg>
          <b>{{ collection.products_count }}</b> {{ curated_label }}
        </span>
        <span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 12h3M11 12h9M4 17h7M15 17h5M14 5v4M7 10v4M11 15v4"/></svg>
          {{ compare_label }}
        </span>
        <span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V9M12 13c-4 0-7-3-7-7 4 0 7 3 7 7ZM12 11c4 0 7-3 7-7-4 0-7 3-7 7Z"/></svg>
          {{ knowledge_label }}
        </span>
      </div>
    </div>

    <div class="main-collection__hero-media{% if hero_image_is_product %} main-collection__hero-media--product{% endif %}">
      {% if hero_image != blank %}
        {{ hero_image | image_url: width: 1600 | image_tag: widths: '480,720,960,1200,1600', sizes: '(min-width: 1051px) 42vw, (min-width: 901px) 48vw, calc(100vw - 2rem)', loading: 'eager', fetchpriority: 'high', alt: hero_image.alt | default: collection.title }}
      {% else %}
        <div class="main-collection__hero-placeholder" aria-hidden="true">
          <svg viewBox="0 0 120 120"><path d="M60 104V50M60 72C35 70 22 53 23 26c24 2 36 18 37 42M60 61c22-2 36-18 38-43-24 1-37 17-38 39"/></svg>
        </div>
      {% endif %}
      <div class="main-collection__media-note">
        <span>{{ collection.products_count }} {{ 'collection.products_count' | t: count: collection.products_count | remove: collection.products_count }}</span>
        <strong>{{ collection.title | escape }}</strong>
      </div>
    </div>
  </header>

  {% if collection.handle == 'interieur-solutions' %}
    <interieur-room-builder
      class="interieur-room-builder"
      data-cart-add-url="{{ routes.cart_add_url | append: '.js' }}"
      data-cart-url="{{ routes.cart_url }}"
      data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
      data-added-label="{{ 'collection.interieur.builder_added' | t | escape }}"
      data-error-label="{{ 'collection.interieur.builder_error' | t | escape }}"
    >
      <section class="interieur-room-builder__section" aria-labelledby="InterieurRoomBuilderHeading">
        <header class="interieur-room-builder__head">
          <div>
            <p class="interieur-room-builder__eyebrow">{{ 'collection.interieur.builder_eyebrow' | t }}</p>
            <h2 id="InterieurRoomBuilderHeading">{{ 'collection.interieur.builder_heading' | t }}</h2>
            <p>{{ 'collection.interieur.builder_intro' | t }}</p>
          </div>
          <div class="interieur-room-builder__steps" aria-label="{{ 'collection.interieur.builder_steps_label' | t }}">
            <span>01 · {{ 'collection.interieur.builder_step_room' | t }}</span>
            <span>02 · {{ 'collection.interieur.builder_step_place' | t }}</span>
            <span>03 · {{ 'collection.interieur.builder_step_setup' | t }}</span>
          </div>
        </header>

        <div class="interieur-room-builder__desktop">
          <div class="interieur-room-builder__toolbar">
            <div class="interieur-room-builder__room">
              <strong>{{ 'collection.interieur.builder_room' | t }}</strong>
              <label>
                <span>{{ 'collection.interieur.builder_width' | t }}</span>
                <input type="number" min="2" max="12" step="0.1" value="4.2" data-room-width>
              </label>
              <label>
                <span>{{ 'collection.interieur.builder_depth' | t }}</span>
                <input type="number" min="2" max="12" step="0.1" value="3.2" data-room-depth>
              </label>
              <label>
                <span>{{ 'collection.interieur.builder_height' | t }}</span>
                <input type="number" min="2" max="5" step="0.1" value="2.5" data-room-height>
              </label>
            </div>

            <div class="interieur-room-builder__library">
              <strong>{{ 'collection.interieur.builder_elements' | t }}</strong>
              <div class="interieur-room-builder__primitive-actions">
                <button type="button" data-add-primitive="plant">{{ 'collection.interieur.builder_plant' | t }}</button>
                <button type="button" data-add-primitive="shelf">{{ 'collection.interieur.builder_shelf' | t }}</button>
                <button type="button" data-add-primitive="window">{{ 'collection.interieur.builder_window' | t }}</button>
              </div>
            </div>

            <div class="interieur-room-builder__products">
              <strong>{{ 'collection.interieur.builder_products' | t }}</strong>
              <label class="visually-hidden" for="InterieurBuilderProduct-{{ section.id }}">{{ 'collection.interieur.builder_product_select' | t }}</label>
              <select id="InterieurBuilderProduct-{{ section.id }}" data-builder-product-select>
                {% for product in collection.products limit: 50 %}
                  {% liquid
                    assign builder_variant = product.selected_or_first_available_variant
                    assign builder_watts = product.metafields.lighting.rated_power_w.value | default: 0 | plus: 0
                    assign builder_mounting = product.metafields.lighting.mounting.value
                    assign builder_tags = product.tags | join: ' '
                    capture builder_search
                      echo product.title
                      echo ' '
                      echo product.type
                      echo ' '
                      echo builder_mounting
                      echo ' '
                      echo builder_tags
                    endcapture
                    assign builder_search = builder_search | strip_newlines | downcase | strip
                  %}
                  {% if builder_variant != blank %}
                    <option
                      value="{{ builder_variant.id }}"
                      data-title="{{ product.title | escape }}"
                      data-price="{{ builder_variant.price }}"
                      data-watts="{{ builder_watts }}"
                      data-search="{{ builder_search | escape }}"
                      data-url="{{ product.url }}"
                      {% if product.featured_image != blank %}data-image="{{ product.featured_image | image_url: width: 320 }}"{% endif %}
                    >
                      {{ product.title | escape }} · {{ builder_variant.price | money }}
                    </option>
                  {% endif %}
                {% endfor %}
              </select>
              <button type="button" class="interieur-room-builder__add-product" data-add-product>
                {{ 'collection.interieur.builder_add_product' | t }}
              </button>
            </div>
          </div>

          <div class="interieur-room-builder__viewport" data-builder-viewport>
            <canvas
              class="interieur-room-builder__canvas"
              data-room-canvas
              width="1600"
              height="900"
              aria-label="{{ 'collection.interieur.builder_canvas_label' | t }}"
            ></canvas>
            <div class="interieur-room-builder__hint">{{ 'collection.interieur.builder_hint' | t }}</div>
            <div class="interieur-room-builder__selection" data-selection hidden>
              <strong data-selection-title></strong>
              <span data-selection-meta></span>
            </div>
          </div>

          <div class="interieur-room-builder__controls">
            <div class="interieur-room-builder__camera" role="group" aria-label="{{ 'collection.interieur.builder_camera' | t }}">
              <button type="button" data-camera="-15" aria-label="{{ 'collection.interieur.builder_camera_left' | t }}">↶</button>
              <button type="button" data-camera="15" aria-label="{{ 'collection.interieur.builder_camera_right' | t }}">↷</button>
            </div>

            <div class="interieur-room-builder__object-actions" role="group" aria-label="{{ 'collection.interieur.builder_object_actions' | t }}">
              <button type="button" data-object-rotate="-15">{{ 'collection.interieur.builder_rotate_left' | t }}</button>
              <button type="button" data-object-rotate="15">{{ 'collection.interieur.builder_rotate_right' | t }}</button>
              <button type="button" data-duplicate>{{ 'collection.interieur.builder_duplicate' | t }}</button>
              <button type="button" data-delete>{{ 'collection.interieur.builder_delete' | t }}</button>
            </div>

            <button type="button" class="interieur-room-builder__reset" data-builder-reset>
              {{ 'collection.interieur.builder_reset' | t }}
            </button>
          </div>

          <div class="interieur-room-builder__summary">
            <div>
              <span>{{ 'collection.interieur.builder_objects' | t }}</span>
              <strong data-summary-count>0</strong>
            </div>
            <div>
              <span>{{ 'collection.interieur.builder_price' | t }}</span>
              <strong data-summary-price>—</strong>
            </div>
            <div>
              <span>{{ 'collection.interieur.builder_power' | t }}</span>
              <strong data-summary-watts>0 W</strong>
            </div>
            <div>
              <span>{{ 'collection.interieur.builder_density' | t }}</span>
              <strong data-summary-density>0 W/m²</strong>
            </div>
            <button type="button" class="interieur-room-builder__cart" data-add-setup disabled>
              {{ 'collection.interieur.builder_cart' | t }}
            </button>
            <p class="interieur-room-builder__status" data-builder-status aria-live="polite"></p>
          </div>
        </div>
      </section>
    </interieur-room-builder>
  {% endif %}

  {% if collection.handle == 'interieur-solutions' %}
    <interieur-solutions-configurator
    class="interieur-configurator"
    data-result-one="{{ 'collection.interieur.result_one' | t | escape }}"
    data-result-many="{{ 'collection.interieur.result_many' | t | escape }}"
    data-no-result="{{ 'collection.interieur.no_result' | t | escape }}"
    data-budget-relaxed="{{ 'collection.interieur.budget_relaxed' | t | escape }}"
    data-profile-copy="{{ 'collection.interieur.result_copy' | t | escape }}"
  >
    <section class="interieur-configurator__section" aria-labelledby="InterieurConfiguratorHeading">
      <header class="interieur-configurator__head">
        <div>
          <p class="interieur-configurator__eyebrow">{{ 'collection.interieur.eyebrow' | t }}</p>
          <h2 id="InterieurConfiguratorHeading">{{ 'collection.interieur.heading' | t }}</h2>
          <p class="interieur-configurator__intro">{{ 'collection.interieur.intro' | t }}</p>
        </div>
        <div class="interieur-configurator__progress" aria-hidden="true">
          <span>{{ 'collection.interieur.steps.room' | t }}</span>
          <span>{{ 'collection.interieur.steps.project' | t }}</span>
          <span>{{ 'collection.interieur.steps.mount' | t }}</span>
          <span>{{ 'collection.interieur.steps.light' | t }}</span>
          <span>{{ 'collection.interieur.steps.budget' | t }}</span>
        </div>
      </header>

      <div class="interieur-configurator__workspace">
        <form class="interieur-configurator__form" data-config-form>
          <fieldset>
            <legend>{{ 'collection.interieur.steps.room' | t }}</legend>
            <div class="interieur-configurator__options">
              <label><input type="radio" name="room" value="living" checked><span data-option-label>{{ 'collection.interieur.room.living' | t }}</span></label>
              <label><input type="radio" name="room" value="office"><span data-option-label>{{ 'collection.interieur.room.office' | t }}</span></label>
              <label><input type="radio" name="room" value="kitchen"><span data-option-label>{{ 'collection.interieur.room.kitchen' | t }}</span></label>
              <label><input type="radio" name="room" value="plantroom"><span data-option-label>{{ 'collection.interieur.room.plantroom' | t }}</span></label>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ 'collection.interieur.steps.project' | t }}</legend>
            <div class="interieur-configurator__options interieur-configurator__options--wide">
              <label><input type="radio" name="project" value="single" checked><span data-option-label>{{ 'collection.interieur.project.single' | t }}</span></label>
              <label><input type="radio" name="project" value="shelf"><span data-option-label>{{ 'collection.interieur.project.shelf' | t }}</span></label>
              <label><input type="radio" name="project" value="pendant"><span data-option-label>{{ 'collection.interieur.project.pendant' | t }}</span></label>
              <label><input type="radio" name="project" value="station"><span data-option-label>{{ 'collection.interieur.project.station' | t }}</span></label>
              <label><input type="radio" name="project" value="habitat"><span data-option-label>{{ 'collection.interieur.project.habitat' | t }}</span></label>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ 'collection.interieur.steps.mount' | t }}</legend>
            <div class="interieur-configurator__options interieur-configurator__options--wide">
              <label><input type="radio" name="mount" value="open" checked><span data-option-label>{{ 'collection.interieur.mount.open' | t }}</span></label>
              <label><input type="radio" name="mount" value="e27"><span data-option-label>{{ 'collection.interieur.mount.e27' | t }}</span></label>
              <label><input type="radio" name="mount" value="shelf"><span data-option-label>{{ 'collection.interieur.mount.shelf' | t }}</span></label>
              <label><input type="radio" name="mount" value="pendant"><span data-option-label>{{ 'collection.interieur.mount.pendant' | t }}</span></label>
              <label><input type="radio" name="mount" value="floor"><span data-option-label>{{ 'collection.interieur.mount.floor' | t }}</span></label>
              <label><input type="radio" name="mount" value="system"><span data-option-label>{{ 'collection.interieur.mount.system' | t }}</span></label>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ 'collection.interieur.steps.light' | t }}</legend>
            <div class="interieur-configurator__options">
              <label><input type="radio" name="light" value="supplement" checked><span data-option-label>{{ 'collection.interieur.light.supplement' | t }}</span></label>
              <label><input type="radio" name="light" value="balanced"><span data-option-label>{{ 'collection.interieur.light.balanced' | t }}</span></label>
              <label><input type="radio" name="light" value="intensive"><span data-option-label>{{ 'collection.interieur.light.intensive' | t }}</span></label>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ 'collection.interieur.steps.budget' | t }}</legend>
            <div class="interieur-configurator__options">
              <label><input type="radio" name="budget" value="75"><span data-option-label>{{ 'collection.interieur.budget.under_75' | t }}</span></label>
              <label><input type="radio" name="budget" value="150" checked><span data-option-label>{{ 'collection.interieur.budget.under_150' | t }}</span></label>
              <label><input type="radio" name="budget" value="300"><span data-option-label>{{ 'collection.interieur.budget.under_300' | t }}</span></label>
              <label><input type="radio" name="budget" value="500"><span data-option-label>{{ 'collection.interieur.budget.under_500' | t }}</span></label>
              <label><input type="radio" name="budget" value="open"><span data-option-label>{{ 'collection.interieur.budget.open' | t }}</span></label>
            </div>
          </fieldset>

          <button type="button" class="interieur-configurator__reset" data-reset>
            {{ 'collection.interieur.reset' | t }}
          </button>
        </form>

        <aside class="interieur-configurator__profile" aria-live="polite">
          <p class="interieur-configurator__eyebrow">{{ 'collection.interieur.result_eyebrow' | t }}</p>
          <h3 data-profile-title>{{ 'collection.interieur.result_default' | t }}</h3>
          <p data-profile-copy>{{ 'collection.interieur.result_copy' | t }}</p>
          <div class="interieur-configurator__chips" data-profile-chips></div>
          <strong class="interieur-configurator__count" data-result-count></strong>
          <span class="interieur-configurator__budget-note" data-budget-note hidden></span>
          <a class="interieur-configurator__all-link" href="#InterieurCatalog">
            {{ 'collection.interieur.all_products' | t }} <span aria-hidden="true">↓</span>
          </a>
        </aside>
      </div>

      <div class="interieur-configurator__recommendations">
        <header>
          <p class="interieur-configurator__eyebrow">{{ 'collection.interieur.recommendations_eyebrow' | t }}</p>
          <h3>{{ 'collection.interieur.recommendations' | t }}</h3>
          <p>{{ 'collection.interieur.recommendations_intro' | t }}</p>
        </header>

        <div class="interieur-configurator__grid" data-recommendations>
          {% for product in collection.products limit: 50 %}
            {% liquid
              assign watts = product.metafields.lighting.rated_power_w.value | default: 0 | plus: 0
              assign mounting = product.metafields.lighting.mounting.value
              assign role = product.metafields.leaf_configurator.role.value
              assign price_value = product.price_min | divided_by: 100.0
              assign tags_text = product.tags | join: ' '
              capture search_blob
                echo product.title
                echo ' '
                echo product.type
                echo ' '
                echo product.vendor
                echo ' '
                echo tags_text
                echo ' '
                echo mounting
                echo ' '
                echo role
              endcapture
              assign search_blob = search_blob | strip_newlines | downcase | strip
            %}
            <div
              class="interieur-configurator__product"
              data-solution-card
              data-search="{{ search_blob | escape }}"
              data-price="{{ price_value }}"
              data-watts="{{ watts }}"
              {% if forloop.index > 4 %}hidden{% endif %}
            >
              {% render 'product-card', product: product, compact: true, interactive_facts: true %}
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
  </interieur-solutions-configurator>
  {% endif %}

  <div{% if collection.handle == 'interieur-solutions' %} id="InterieurCatalog"{% endif %} class="main-collection__catalog{% if has_type_filters %} main-collection__catalog--filtered{% endif %}">
    {% if has_type_filters %}
      <aside class="main-collection__sidebar" id="CollectionFilters-{{ section.id }}">
        {% if section.settings.brand_logo != blank %}
          <a class="main-collection__sidebar-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            {{ section.settings.brand_logo | image_url: width: 360 | image_tag: widths: '120,180,240,360', sizes: '160px', loading: 'lazy', alt: shop.name }}
          </a>
        {% endif %}
        <div class="main-collection__filter-landscape">
          <p class="main-collection__landscape-label">{{ landscape_label }}</p>
          <div class="main-collection__filters" role="group" aria-label="{{ 'collection.filter' | t }}">
            <button type="button" class="main-collection__filter" data-product-filter="all" data-filter-label="{{ 'collection.all' | t | escape }}" aria-pressed="true">
              <span class="main-collection__filter-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></svg>
              </span>
              <span>{{ 'collection.all' | t }}</span>
            </button>
            {% for product_type in product_types %}
              {% assign product_type_downcase = product_type | downcase %}
              <button type="button" class="main-collection__filter" data-product-filter="{{ product_type | handleize }}" data-filter-label="{{ product_type | escape }}" aria-pressed="false">
                <span class="main-collection__filter-icon" aria-hidden="true">
                  {% if product_type_downcase contains 'licht' or product_type_downcase contains 'led' or product_type_downcase contains 'lamp' %}
                    <svg viewBox="0 0 24 24"><path d="M9 18h6M10 22h4M8 14c-1.4-1.1-2-2.8-2-4.6A6 6 0 0 1 18 9.4c0 1.8-.7 3.5-2 4.6-.8.7-1.2 1.4-1.3 2H9.3c-.1-.6-.5-1.3-1.3-2Z"/></svg>
                  {% elsif product_type_downcase contains 'substrat' or product_type_downcase contains 'mix' %}
                    <svg viewBox="0 0 24 24"><path d="m4 8 8-4 8 4-8 4-8-4Zm0 4 8 4 8-4M4 16l8 4 8-4"/></svg>
                  {% elsif product_type_downcase contains 'topf' or product_type_downcase contains 'gefäß' or product_type_downcase contains 'gefass' %}
                    <svg viewBox="0 0 24 24"><path d="M7 8h10l-1 12H8L7 8ZM5 5h14v3H5z"/></svg>
                  {% elsif product_type_downcase contains 'pflanz' %}
                    <svg viewBox="0 0 24 24"><path d="M12 21V10M12 15c-4 0-7-3-7-7 4 0 7 3 7 7ZM12 12c4 0 7-3 7-7-4 0-7 3-7 7Z"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24"><path d="M4 6h16v12H4zM8 10h8M8 14h5"/></svg>
                  {% endif %}
                </span>
                <span>{{ product_type | escape }}</span>
              </button>
            {% endfor %}
          </div>
        </div>
      </aside>
    {% endif %}

    <div class="main-collection__results">
      <div class="main-collection__tools">
        {% if has_type_filters %}
          <div class="main-collection__active-context" data-filter-context aria-live="polite">
            <span class="main-collection__context-icon" data-filter-context-icon aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></svg>
            </span>
            <strong data-filter-context-label>{{ 'collection.all' | t }}</strong>
            <span class="main-collection__context-count" data-filter-context-count>{{ collection.products_count }}</span>
          </div>
        {% endif %}

        <form class="main-collection__sort" action="{{ collection.url }}" method="get">
          <label for="SortBy-{{ section.id }}">{{ 'collection.sort_by' | t }}</label>
          <select id="SortBy-{{ section.id }}" name="sort_by" data-sort-select>
            {% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}
          </select>
          <noscript><button type="submit">{{ 'collection.apply' | t }}</button></noscript>
        </form>
      </div>

      {% paginate collection.products by 48 %}
        <div class="main-collection__grid" id="CollectionProducts-{{ section.id }}">
          {% for product in collection.products %}<div data-product-type="{{ product.type | handleize }}">{% render 'product-card', product: product, interactive_facts: true %}</div>{% endfor %}
        </div>
        {% if paginate.pages > 1 %}<nav class="main-collection__pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}
      {% endpaginate %}
    </div>
  </div>
</section>

{% stylesheet %}
  .main-collection { padding-block: clamp(1.5rem, 4vw, 4rem) clamp(3rem, 6vw, 6rem); }
  .main-collection__hero { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(420px, .98fr); gap: clamp(2rem, 5vw, 5.5rem); align-items: center; margin-bottom: clamp(2rem, 4vw, 3.6rem); }
  .main-collection__hero-copy { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding-block: clamp(1.5rem, 4vw, 4rem); }
  .main-collection__eyebrow { display: inline-flex; align-items: center; gap: .55rem; margin: 0 0 1rem; color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .main-collection__eyebrow-icon { width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid color-mix(in srgb, var(--accent), transparent 55%); }
  .main-collection__eyebrow-icon svg { width: 17px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .main-collection h1 { max-width: 14ch; margin: 0; font-size: clamp(3rem, 5.4vw, 5.6rem); line-height: .94; letter-spacing: -.065em; overflow-wrap: anywhere; }
  .main-collection__intro { max-width: 62ch; margin: 1.25rem 0 0; color: var(--muted); font-size: clamp(1rem, 1.35vw, 1.15rem); line-height: 1.65; }
  .main-collection__knowledge { max-width: 760px; margin-top: 1.25rem; }
  .main-collection__knowledge .leaf-atoms { margin: 0; }
  .main-collection__actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.7rem; }
  .main-collection__primary-action, .main-collection__secondary-action { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: .7rem; padding: .7rem 1rem; border: 1px solid var(--text); text-decoration: none; font-size: .82rem; font-weight: 850; transition: transform .2s ease, background .2s ease, color .2s ease; }
  .main-collection__primary-action { background: var(--text); color: var(--background); }
  .main-collection__secondary-action { color: var(--text); }
  .main-collection__primary-action:hover, .main-collection__secondary-action:hover { transform: translateY(-2px); }
  .main-collection__secondary-action:hover { background: var(--surface); }
  .main-collection__signals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .7rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .main-collection__signals span { display: grid; grid-template-columns: 24px 1fr; align-items: center; gap: .55rem; color: var(--muted); font-size: .72rem; line-height: 1.35; }
  .main-collection__signals svg { width: 22px; fill: none; stroke: var(--accent); stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; }
  .main-collection__signals b { color: var(--text); }
  .main-collection__hero-media { position: relative; aspect-ratio: 4 / 3; min-height: 0; max-height: 440px; overflow: hidden; border: 1px solid var(--border); background: var(--surface); }
  .main-collection__hero-media > img { width: 100%; height: 100%; min-height: 0; object-fit: cover; object-position: center; }
  .main-collection__hero-media--product > img { object-fit: contain; padding: clamp(.8rem, 2vw, 1.6rem); }
  .main-collection__hero-placeholder { height: 100%; min-height: 0; display: grid; place-items: center; background: linear-gradient(135deg, var(--surface), var(--background)); }
  .main-collection__hero-placeholder svg { width: min(44%, 190px); fill: none; stroke: var(--accent); stroke-width: 1.1; opacity: .7; }
  .main-collection__media-note { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: .75rem .9rem; border: 1px solid color-mix(in srgb, white, transparent 45%); background: color-mix(in srgb, var(--background), transparent 10%); backdrop-filter: blur(12px); }
  .main-collection__media-note span { color: var(--muted); font-size: .72rem; }
  .main-collection__media-note strong { font-size: .78rem; text-align: right; }
  .main-collection__catalog { min-width: 0; }
  .main-collection__catalog--filtered { display: grid; grid-template-columns: minmax(210px, 240px) minmax(0, 1fr); gap: clamp(1.5rem, 3vw, 2.75rem); align-items: start; }
  .main-collection__sidebar { scroll-margin-top: 110px; position: sticky; top: 96px; min-width: 0; padding-right: 1.2rem; border-right: 1px solid var(--border); }
  .main-collection__sidebar-brand { width: min(100%, 160px); display: inline-flex; margin: 0 0 1.2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
  .main-collection__sidebar-brand img { display: block; width: 100%; height: auto; }
