{% liquid
 assign is_en = false
 if request.locale.iso_code contains 'en'
  assign is_en = true
 endif
 assign target_url = section.settings.target.url
 if target_url == blank
  assign target_url = '/pages/nature-explorer'
 endif
%}
<section class="leaf-nature-teaser" aria-labelledby="LeafNatureTitle-{{ section.id }}">
  <div class="leaf-nature-teaser__copy">
    <p class="leaf-nature-teaser__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 id="LeafNatureTitle-{{ section.id }}">{% if is_en %}{{ section.settings.heading_en | escape }}{% else %}{{ section.settings.heading_de | escape }}{% endif %}</h2>
    <p>{% if is_en %}{{ section.settings.description_en | escape }}{% else %}{{ section.settings.description_de | escape }}{% endif %}</p>
    <a href="{% render 'leaf-localized-url', url: target_url %}">{% if is_en %}{{ section.settings.cta_en | escape }}{% else %}{{ section.settings.cta_de | escape }}{% endif %}<span aria-hidden="true"> ↗</span></a>
  </div>
  {% if section.settings.image != blank %}
    <div class="leaf-nature-teaser__media">{{ section.settings.image | image_url: width: 960 | image_tag: loading: 'lazy', widths: '400,640,960', sizes: '(min-width: 900px) 38vw, 90vw', alt: section.settings.image.alt | default: section.settings.heading_de }}</div>
  {% endif %}
</section>
<style>
.leaf-nature-teaser{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:clamp(18px,4vw,60px);padding:clamp(26px,4vw,50px);background:#e9eee7;color:#254737;margin:clamp(26px,4vw,56px) auto;max-width:1320px;border-radius:8px;overflow:hidden}
.leaf-nature-teaser__copy{max-width:650px}.leaf-nature-teaser__eyebrow{margin:0 0 10px!important;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#607a61}.leaf-nature-teaser h2{font-size:clamp(24px,3vw,39px);font-weight:500;line-height:1.16;letter-spacing:-.025em;margin:0 0 12px}.leaf-nature-teaser__copy>p:not(.leaf-nature-teaser__eyebrow){font-size:15px;line-height:1.65;color:#4d6656;margin:0 0 18px}
.leaf-nature-teaser a{display:inline-flex;min-height:44px;gap:10px;align-items:center;font-weight:700;color:#254737;text-underline-offset:5px}.leaf-nature-teaser a:focus-visible{outline:3px solid #294e37;outline-offset:4px}.leaf-nature-teaser__media{width:min(30vw,360px);border-radius:7px;overflow:hidden;aspect-ratio:3/2}.leaf-nature-teaser__media img{width:100%;height:100%;object-fit:cover;display:block}
@media(max-width:750px){.leaf-nature-teaser{margin:22px 16px;grid-template-columns:1fr;padding:22px}.leaf-nature-teaser__media{width:100%;aspect-ratio:16/9}}
</style>
{% schema %}
{
 "name":"Nature Explorer Teaser",
 "settings":[
  {"type":"text","id":"eyebrow","label":"Überzeile","default":"LEAF LIVING LAB"},
  {"type":"text","id":"heading_de","label":"Überschrift DE","default":"Entdecke, wie Pflanzenwelten zusammenhängen."},
  {"type":"text","id":"heading_en","label":"Heading EN","default":"Explore how plant worlds connect."},
  {"type":"textarea","id":"description_de","label":"Beschreibung DE","default":"Ein interaktiver Blick auf Lebensräume, Wurzeln und Böden. Zum Erkunden, wenn du tiefer einsteigen möchtest."},
  {"type":"textarea","id":"description_en","label":"Description EN","default":"An optional interactive exploration of habitats, roots and soils."},
  {"type":"text","id":"cta_de","label":"Button DE","default":"Nature Explorer öffnen"},
  {"type":"text","id":"cta_en","label":"Button EN","default":"Open Nature Explorer"},
  {"type":"page","id":"target","label":"Explorer-Seite"},
  {"type":"image_picker","id":"image","label":"Vorschaubild (optional)"}
 ],
 "presets":[{"name":"Nature Explorer Teaser"}]
}
{% endschema %}
