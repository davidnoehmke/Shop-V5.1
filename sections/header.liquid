<header class="site-header" style="--logo-width: {{ section.settings.logo_width }}px" data-site-header>
  <div class="page-width site-header__inner">
    {% if section.settings.menu != blank %}
      <details class="site-header__mobile" data-mobile-menu>
        <summary
          aria-controls="MobileMenu-{{ section.id }}"
          aria-expanded="false"
          aria-label="{{ 'accessibility.menu' | t | escape }}"
          data-open-label="{{ 'accessibility.menu' | t | escape }}"
          data-close-label="{{ 'accessibility.close' | t | escape }}"
        >
          <svg class="site-header__menu-icon site-header__menu-icon--open" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          <svg class="site-header__menu-icon site-header__menu-icon--close" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
        </summary>
        <nav id="MobileMenu-{{ section.id }}" class="site-header__mobile-panel" data-mobile-menu-panel>
          <ul class="site-header__mobile-list">
            {% for link in section.settings.menu.links %}
              <li>
                {% if link.links != blank %}
                  <details class="site-header__mobile-disclosure">
                    <summary>
                      <span class="site-header__mobile-title">{% render 'leaf-menu-icon', link: link %}<span>{{ link.title }}</span></span>
                      <svg class="site-header__chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg>
                    </summary>
                    <div class="site-header__mobile-submenu">
                      <a class="site-header__mobile-overview" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                        <span>{{ link.title }}</span>
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M12 6l4 4-4 4"/></svg>
                      </a>
                      <ul>
                        {% for child_link in link.links %}
                          <li>
                            {% if child_link.links != blank %}
                              <details class="site-header__mobile-disclosure site-header__mobile-disclosure--nested">
                                <summary>
                                  <span>{{ child_link.title }}</span>
                                  <svg class="site-header__chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg>
                                </summary>
                                <div class="site-header__mobile-submenu site-header__mobile-submenu--nested">
                                  <a class="site-header__mobile-overview" href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>
                                    <span>{{ child_link.title }}</span>
                                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M12 6l4 4-4 4"/></svg>
                                  </a>
                                  <ul>
                                    {% for grandchild_link in child_link.links %}
                                      <li><a href="{{ grandchild_link.url }}"{% if grandchild_link.current %} aria-current="page"{% endif %}>{{ grandchild_link.title }}</a></li>
                                    {% endfor %}
                                  </ul>
                                </div>
                              </details>
                            {% else %}
                              <a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title }}</a>
                            {% endif %}
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  </details>
                {% else %}
                  <a class="site-header__mobile-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><span class="site-header__mobile-title">{% render 'leaf-menu-icon', link: link %}<span>{{ link.title }}</span></span></a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>
      </details>
    {% endif %}
    <a class="site-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <span class="site-header__wordmark">LEAFerservice</span><sup class="site-header__tm" aria-hidden="true">™</sup>
    </a>
    {% if section.settings.menu != blank %}
      <nav class="site-header__desktop" aria-label="{{ 'accessibility.menu' | t }}">
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{% render 'leaf-menu-icon', link: link %}<span>{{ link.title }}</span></a>{% endfor %}
      </nav>
    {% endif %}
    <div class="site-header__actions">
      <form class="site-header__search" action="{{ routes.search_url }}" method="get" role="search" data-header-search>
        <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">{{ 'header.search' | t }}</label>
        <input id="HeaderSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'header.search' | t }}" autocomplete="off">
        <button type="submit" aria-label="{{ 'header.search' | t }}" data-search-toggle><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg></button>
      </form>
      <a class="site-header__account site-header__icon-action" href="{{ routes.account_login_url }}" aria-label="{{ 'header.account' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7.5" r="4"/><path d="M4.5 21c.5-5 3-7.5 7.5-7.5s7 2.5 7.5 7.5"/></svg></a>
      <a class="site-header__cart site-header__icon-action" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t: count: cart.item_count }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 4h2l2 11.5h11.5l2-8.5H6"/><circle cx="9" cy="20" r="1.2"/><circle cx="17" cy="20" r="1.2"/></svg>{% if cart.item_count > 0 %}<span class="site-header__cart-count">{{ cart.item_count }}</span>{% endif %}</a>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header { position: sticky; z-index: 20; top: 0; border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--background), transparent 3%); backdrop-filter: blur(14px); }
  .site-header__inner { min-height: 78px; display: grid; grid-template-columns: minmax(210px, .72fr) minmax(0, 1.55fr) minmax(250px, .73fr); align-items: center; gap: clamp(1rem, 2vw, 2.5rem); }
  .site-header__brand { width: min(100%, var(--logo-width)); display: inline-flex; align-items: center; gap: .55rem; font-family: var(--heading-font); font-size: 1.45rem; font-weight: 600; text-decoration: none; }
  .site-header__brand > svg { width: 34px; flex: 0 0 auto; }
  .site-header__wordmark { font-family: var(--heading-font); font-size: clamp(1.35rem, 1.5vw, 1.8rem); font-weight: 700; letter-spacing: -.035em; line-height: 1; }
  .site-header__brand img { width: 100%; height: auto; }
  .site-header__tm { align-self: flex-start; margin: .22rem 0 0 -.35rem; color: var(--accent); font-family: ui-sans-serif, system-ui, sans-serif; font-size: .88rem; font-weight: 900; line-height: 1; text-shadow: 0 0 1px currentColor; }
  .site-header__desktop { display: flex; justify-content: center; gap: clamp(.85rem, 1.45vw, 1.7rem); white-space: nowrap; }
  .site-header__desktop a { position: relative; min-height: 44px; display: inline-flex; align-items: center; gap: .42rem; font-size: .84rem; font-weight: 680; text-decoration: none; }
  .site-header__nav-icon { width: 17px; height: 17px; display: inline-grid; place-items: center; flex: 0 0 auto; color: var(--accent); }
  .site-header__nav-icon svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; }
  .site-header__mobile-title { display: inline-flex; align-items: center; gap: .65rem; min-width: 0; }
  .site-header__desktop a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -.45rem; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform .25s var(--ease-out); }
  .site-header__desktop a:hover::after { transform: scaleX(1); transform-origin: left; }
  .site-header__desktop a:hover { color: var(--accent); }
  .site-header__actions { justify-self: end; display: flex; align-items: center; gap: .35rem; }
  .site-header__search { width: clamp(170px, 15vw, 250px); min-height: 42px; display: grid; grid-template-columns: 1fr 42px; align-items: center; border: 1px solid var(--border); background: var(--background); }
  .site-header__search input { width: 100%; min-width: 0; height: 40px; padding: 0 .75rem; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: .82rem; }
  .site-header__search button { width: 42px; height: 40px; display: grid; place-items: center; border: 0; border-left: 1px solid var(--border); background: transparent; color: var(--text); cursor: pointer; }
  .site-header__search button:hover, .site-header__search button:focus-visible { background: var(--surface); color: var(--accent); }
  .site-header__icon-action { width: 44px; justify-content: center; padding-inline: 0 !important; }
  .site-header__actions > a { position: relative; min-height: 42px; display: inline-flex; align-items: center; gap: .5rem; padding: .45rem .7rem; border: 1px solid transparent; color: var(--text); text-decoration: none; transition: border-color .2s ease, background-color .2s ease, color .2s ease; }
  .site-header__actions > a:hover, .site-header__actions > a:focus-visible { border-color: var(--border); background: var(--surface); color: var(--accent); }
  .site-header__mobile > summary { position: relative; display: grid; place-items: center; width: 44px; height: 44px; cursor: pointer; }
  .site-header__mobile > summary:hover { background: var(--surface); }
  .site-header__actions svg, .site-header__mobile svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .site-header__actions svg { width: 20px; }
  .site-header__menu-icon { width: 24px; }
  .site-header__action-label { font-size: .72rem; font-weight: 760; letter-spacing: .02em; }
  .site-header__cart-count { position: absolute; top: 2px; right: 2px; min-width: 16px; height: 16px; padding-inline: 3px; display: grid; place-items: center; background: var(--accent); color: #fff; font-size: .6rem; font-weight: 800; }
  .site-header__mobile { display: none; }
  .site-header__mobile > summary, .site-header__mobile-disclosure > summary { list-style: none; }
  .site-header__mobile > summary::-webkit-details-marker, .site-header__mobile-disclosure > summary::-webkit-details-marker { display: none; }
  .site-header__menu-icon--close { display: none; }
  .site-header__mobile[open] .site-header__menu-icon--open { display: none; }
  .site-header__mobile[open] .site-header__menu-icon--close { display: block; }
  .site-header__mobile-panel { display: none; visibility: hidden; pointer-events: none; }
  .site-header__mobile[open] > .site-header__mobile-panel { position: absolute; z-index: 30; inset-inline: 0; top: 100%; display: block; visibility: visible; pointer-events: auto; height: var(--site-header-menu-height, calc(100dvh - 78px)); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; padding: 1rem max(1rem, calc((100vw - var(--page-width)) / 2)); border-top: 1px solid var(--border); background: var(--background); box-shadow: var(--shadow-soft); }
  .site-header__mobile-list, .site-header__mobile-submenu ul { margin: 0; padding: 0; list-style: none; }
  .site-header__mobile-list > li { border-bottom: 1px solid var(--border); }
  .site-header__mobile-link, .site-header__mobile-disclosure > summary, .site-header__mobile-submenu a { min-height: 54px; display: flex; align-items: center; text-decoration: none; }
  .site-header__mobile-link, .site-header__mobile-disclosure > summary { justify-content: space-between; gap: 1rem; font-family: var(--heading-font); font-size: 1.25rem; font-weight: 600; }
  .site-header__mobile-disclosure > summary { cursor: pointer; }
  .site-header__chevron { width: 20px; flex: 0 0 auto; transition: transform .2s var(--ease-out); }
  .site-header__mobile-disclosure[open] > summary .site-header__chevron { transform: rotate(180deg); }
  .site-header__mobile-submenu { padding: 0 0 .65rem .85rem; }
  .site-header__mobile-submenu a { gap: .65rem; border-top: 1px solid var(--border); font-size: 1rem; font-weight: 650; }
  .site-header__mobile-overview { justify-content: space-between; color: var(--accent); }
  .site-header__mobile-overview svg { width: 20px; flex: 0 0 auto; }
  .site-header__mobile-disclosure--nested > summary { min-height: 50px; font-family: inherit; font-size: 1rem; font-weight: 650; }
  .site-header__mobile-submenu--nested { padding-inline-start: .85rem; }
  .site-header__mobile-panel [aria-current="page"] { color: var(--accent); }
  html.site-header-menu-open, html.site-header-menu-open body { overflow: hidden; overscroll-behavior: none; }
  html.site-header-menu-open body { padding-inline-end: var(--site-header-scrollbar-width, 0px); }
  @media (min-width: 1200px) {
    .site-header__inner { min-height: 88px; grid-template-columns: minmax(230px, .72fr) minmax(0, 1.65fr) minmax(290px, .72fr); gap: clamp(1.25rem, 2vw, 2.75rem); }
    .site-header__brand { width: min(100%, max(var(--logo-width), 210px)); }
    .site-header__tm { margin-top: .08rem; margin-left: -.24rem; font-size: .94rem; }
    .site-header__desktop { gap: clamp(1rem, 1.55vw, 1.9rem); }
    .site-header__desktop a { font-size: .88rem; }
    .site-header__actions > a { min-height: 46px; padding-inline: .8rem; }
  }
  @media (min-width: 1500px) {
    .site-header__inner { min-height: 92px; grid-template-columns: minmax(230px, .8fr) minmax(0, 1.65fr) minmax(320px, .85fr); }
    .site-header__brand { width: min(100%, max(var(--logo-width), 225px)); }
    .site-header__tm { font-size: 1rem; }
  }
  @media (max-width: 1240px) { .site-header__search { width: 48px; min-height:48px; border: 0; } .site-header__search input, .site-header__search label { display: none; } .site-header__search button { width:48px;height:48px;border: 0; } .site-header__search.is-open { position:absolute; z-index:40; inset-inline:0; top:100%; width:auto; min-height:62px; padding:.55rem max(.7rem,calc((100vw - var(--page-width))/2)); display:grid; grid-template-columns:minmax(0,1fr) 50px; border-block:1px solid var(--border); background:var(--background); box-shadow:0 16px 34px rgba(30,45,37,.12); } .site-header__search.is-open input { display:block; height:48px; padding:0 1rem; border:1px solid var(--border); background:var(--surface); font-size:16px; } .site-header__search.is-open button { width:50px;height:48px;border:1px solid var(--border);border-left:0;background:var(--surface); } .site-header__inner { grid-template-columns: 44px minmax(0, 1fr) auto; gap: clamp(.55rem, 2vw, 1.5rem); } .site-header__desktop { display: none; } .site-header__mobile { display: block; justify-self: start; } .site-header__brand { min-width: 0; } .site-header__actions { gap: .1rem; } .site-header__actions > a { width: 44px; min-height: 44px; justify-content: center; padding: 0; border: 0; } .site-header__action-label { display: none; } .site-header__actions svg { width: 24px; } }
  @media (max-width: 520px) { .site-header { padding-top: env(safe-area-inset-top); } .site-header__inner { min-height: 64px; gap: .35rem; } .site-header__brand { font-size: 1.15rem; } .site-header__brand > svg { width: 29px; } .site-header__account { display: none !important; } .site-header__actions { gap: .1rem; } .site-header__mobile[open] > .site-header__mobile-panel { height: var(--site-header-menu-height, calc(100dvh - 64px - env(safe-area-inset-top))); padding-bottom:calc(1rem + env(safe-area-inset-bottom)); } }
{% endstylesheet %}

{% javascript %}
  (() => {
    const desktopBreakpoint = 1240;

    const initMobileMenu = (header) => {
      if (header.dataset.mobileMenuReady === 'true') return;

      const menu = header.querySelector('[data-mobile-menu]');
      const summary = menu?.querySelector(':scope > summary');
      const panel = menu?.querySelector('[data-mobile-menu-panel]');
      if (!menu || !summary || !panel) return;

      header.dataset.mobileMenuReady = 'true';
      const controller = new AbortController();
      const { signal } = controller;
      header.mobileMenuController = controller;

      const setPanelHeight = () => {
        const viewport = window.visualViewport;
        const viewportBottom = viewport ? viewport.offsetTop + viewport.height : window.innerHeight;
        const headerBottom = header.getBoundingClientRect().bottom;
        header.style.setProperty('--site-header-menu-height', `${Math.max(0, viewportBottom - headerBottom)}px`);
      };

      const closeSubmenus = () => {
        panel.querySelectorAll('.site-header__mobile-disclosure[open]').forEach((disclosure) => {
          disclosure.removeAttribute('open');
        });
      };

      const unlockPage = () => {
        document.documentElement.classList.remove('site-header-menu-open');
        document.documentElement.style.removeProperty('--site-header-scrollbar-width');
      };

      const closeMenu = (restoreFocus = false) => {
        menu.removeAttribute('open');
        summary.setAttribute('aria-expanded', 'false');
        summary.setAttribute('aria-label', summary.dataset.openLabel);
        closeSubmenus();
        unlockPage();
        if (restoreFocus) summary.focus();
      };

      const syncMenu = () => {
        const isOpen = menu.open && window.innerWidth <= desktopBreakpoint;
        if (!isOpen) {
          closeMenu();
          return;
        }

        document.querySelectorAll('[data-mobile-menu][open]').forEach((otherMenu) => {
          if (otherMenu !== menu) otherMenu.removeAttribute('open');
        });
        const scrollbarWidth = Math.max(0, window.innerWidth - document.documentElement.clientWidth);
        document.documentElement.style.setProperty('--site-header-scrollbar-width', `${scrollbarWidth}px`);
        document.documentElement.classList.add('site-header-menu-open');
        summary.setAttribute('aria-expanded', 'true');
        summary.setAttribute('aria-label', summary.dataset.closeLabel);
        setPanelHeight();
      };

      closeMenu();
      menu.addEventListener('toggle', syncMenu, { signal });
      panel.addEventListener('click', (event) => {
        if (event.target.closest('a')) closeMenu();
      }, { signal });
      document.addEventListener('pointerdown', (event) => {
        if (menu.open && !menu.contains(event.target)) closeMenu();
      }, { signal });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.open) closeMenu(true);
      }, { signal });
      window.addEventListener('resize', () => {
        if (window.innerWidth > desktopBreakpoint) closeMenu();
        else if (menu.open) setPanelHeight();
      }, { signal });
      window.addEventListener('pageshow', () => closeMenu(), { signal });
      window.visualViewport?.addEventListener('resize', setPanelHeight, { signal });
    };

    const initMobileSearch = (header) => {
      if (header.dataset.mobileSearchReady === 'true') return;
      const form = header.querySelector('[data-header-search]');
      const input = form?.querySelector('input[type="search"]');
      const toggle = form?.querySelector('[data-search-toggle]');
      if (!form || !input || !toggle) return;

      header.dataset.mobileSearchReady = 'true';

      const closeSearch = () => {
        form.classList.remove('is-open');
        input.blur();
      };

      toggle.addEventListener('click', (event) => {
        if (window.innerWidth > desktopBreakpoint) return;
        if (!form.classList.contains('is-open')) {
          event.preventDefault();
          header.querySelector('[data-mobile-menu]')?.removeAttribute('open');
          document.documentElement.classList.remove('site-header-menu-open');
          form.classList.add('is-open');
          requestAnimationFrame(() => input.focus());
          return;
        }
        if (!input.value.trim()) {
          event.preventDefault();
          closeSearch();
        }
      });

      document.addEventListener('pointerdown', (event) => {
        if (form.classList.contains('is-open') && !form.contains(event.target)) closeSearch();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && form.classList.contains('is-open')) closeSearch();
      });
      window.addEventListener('resize', () => {
        if (window.innerWidth > desktopBreakpoint) closeSearch();
      });
    };

    const initAllMobileMenus = (root = document) => {
      root.querySelectorAll('[data-site-header]').forEach((header) => {
        initMobileMenu(header);
        initMobileSearch(header);
      });
    };

    initAllMobileMenus();
    document.addEventListener('shopify:section:load', (event) => initAllMobileMenus(event.target));
    document.addEventListener('shopify:section:unload', (event) => {
      const header = event.target.querySelector('[data-site-header]');
      if (!header) return;
      header.mobileMenuController?.abort();
      document.documentElement.classList.remove('site-header-menu-open');
      document.documentElement.style.removeProperty('--site-header-scrollbar-width');
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "t:sections.header.logo" },
    { "type": "range", "id": "logo_width", "label": "t:sections.header.logo_width", "min": 120, "max": 260, "step": 10, "default": 190, "unit": "px" },
    { "type": "link_list", "id": "menu", "label": "t:sections.header.menu", "default": "main-menu" }
  ]
}
{% endschema %}
