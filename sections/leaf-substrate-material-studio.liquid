{% liquid
  assign source_product = section.settings.source_product
  assign ingredients = source_product.metafields.bundle.component_products.value
  assign is_english = false
  if request.locale.iso_code == 'en'
    assign is_english = true
  endif
%}
{% if source_product != blank and ingredients != blank %}
  <section class="leaf-material-studio" aria-labelledby="leaf-material-studio-title-{{ section.id }}">
    <div class="page-width">
      <div class="leaf-material-studio__head">
        <div>
          <p class="leaf-material-studio__eyebrow">{% if is_english %}LEAF · real materials{% else %}LEAF · echte Bestandteile{% endif %}</p>
          <h2 id="leaf-material-studio-title-{{ section.id }}">{% if is_english %}Know what goes into your mix{% else %}Entdecke die Bestandteile deiner Mischung{% endif %}</h2>
          <p>{% if is_english %}Explore genuine product photos and details before choosing your recipe. The mix and checkout remain in the configurator above.{% else %}Entdecke echte Produktbilder und Eigenschaften, bevor du deine Rezeptur auswählst. Mischung und Kauf bleiben im Konfigurator darüber.{% endif %}</p>
        </div>
      </div>
      <leaf-material-structure class="leaf-material-studio__structure" aria-labelledby="leaf-material-structure-heading-{{ section.id }}">
        <div class="leaf-material-studio__viewer-head">
          <div>
            <h3 id="leaf-material-structure-heading-{{ section.id }}">{% if is_english %}Explore the grain in 3D{% else %}Körnung in 3D entdecken{% endif %}</h3>
            <p>{% if is_english %}Illustrative geometry based on the visual character of each material, not a 3D scan. Real product photos remain available below.{% else %}Schematische Geometrie nach dem sichtbaren Materialcharakter, kein 3D-Scan. Echte Produktbilder findest du weiterhin darunter.{% endif %}</p>
          </div>
          <strong data-structure-name aria-live="polite"></strong>
        </div>
        <div class="leaf-material-studio__viewer">
          <div class="leaf-material-studio__canvas-wrap">
            <canvas width="600" height="380" tabindex="0" role="img" aria-label="{% if is_english %}Three-dimensional material texture. Drag to rotate, or use the arrow keys.{% else %}Dreidimensionale Materialstruktur. Zum Drehen ziehen oder Pfeiltasten verwenden.{% endif %}"></canvas>
            <div class="leaf-material-studio__structure-fallback" data-structure-fallback>
              <img data-structure-photo alt="" loading="lazy" width="600" height="380">
            </div>
          </div>
          <div class="leaf-material-studio__structure-controls" role="group" aria-label="{% if is_english %}Choose material for the 3D illustration{% else %}Material für die 3D-Darstellung auswählen{% endif %}">
            {% for ingredient in ingredients limit: 8 %}
              {% if ingredient != blank %}
                <button type="button" data-material="{{ ingredient.handle | escape }}" data-title="{{ ingredient.title | escape }}" {% if ingredient.featured_image != blank %}data-image="{{ ingredient.featured_image | image_url: width: 960 | escape }}"{% endif %} aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ ingredient.title | escape }}</button>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </leaf-material-structure>
      <div class="leaf-material-studio__grid">
        {% for ingredient in ingredients limit: 8 %}
          {% if ingredient != blank %}
            {% liquid
              assign ingredient_image = ingredient.featured_image
              assign ingredient_alt = ingredient_image.alt | default: ingredient.title
            %}
            <article class="leaf-material-studio__card">
              <a href="{{ ingredient.url }}" class="leaf-material-studio__link" aria-label="{{ ingredient.title | escape }}">
                <div class="leaf-material-studio__media">
                  {% if ingredient_image != blank %}
                    {{ ingredient_image | image_url: width: 680 | image_tag: loading: 'lazy', widths: '240, 360, 520, 680', sizes: '(min-width: 1100px) 22vw, (min-width: 640px) 44vw, 90vw', alt: ingredient_alt }}
                  {% else %}
                    <span class="leaf-material-studio__no-image" aria-hidden="true">{% if is_english %}Material{% else %}Bestandteil{% endif %}</span>
                  {% endif %}
                </div>
                <div class="leaf-material-studio__card-content">
                  <h3>{{ ingredient.title | escape }}</h3>
                  <span class="leaf-material-studio__more">{% if is_english %}Discover material{% else %}Material entdecken{% endif %} <span aria-hidden="true">→</span></span>
                </div>
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
  <script src="{{ 'leaf-material-structure.js' | asset_url }}" defer="defer"></script>
{% endif %}
{% stylesheet %}
.leaf-material-studio{padding:clamp(36px,5vw,76px) 0;background:#f5f3eb;color:#26372f}
.leaf-material-studio__head{max-width:760px;margin-bottom:clamp(22px,3vw,36px)}
.leaf-material-studio__eyebrow{color:#607d6c;font-size:.76rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}
.leaf-material-studio h2{margin:.55rem 0 1rem;font-size:clamp(1.65rem,3.3vw,2.75rem);line-height:1.13;letter-spacing:-.035em}
.leaf-material-studio__head p:last-child{font-size:clamp(.95rem,1.2vw,1.05rem);line-height:1.65;color:#52645a}
.leaf-material-studio__structure{display:block;margin:0 0 clamp(24px,3vw,42px);padding:clamp(16px,2.5vw,30px);border:1px solid #dae3d9;border-radius:20px;background:#eff1e9}
.leaf-material-studio__viewer-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap}
.leaf-material-studio__viewer-head h3{font-size:clamp(1.15rem,2vw,1.5rem);margin:0 0 .4rem}
.leaf-material-studio__viewer-head p{font-size:.9rem;max-width:650px;line-height:1.5;color:#586a5b}
.leaf-material-studio__viewer-head strong{font-size:.89rem;color:#315e43}
.leaf-material-studio__viewer{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(180px,.65fr);gap:16px;align-items:start}
.leaf-material-studio__canvas-wrap{position:relative;min-width:0;aspect-ratio:16/10;overflow:hidden;border-radius:14px;background:#f2f1e9}
.leaf-material-studio__canvas-wrap canvas{display:block;width:100%;height:100%;touch-action:none;cursor:grab}
.leaf-material-studio__canvas-wrap canvas:active{cursor:grabbing}
.leaf-material-studio__canvas-wrap canvas:focus-visible{outline:3px solid #376d4b;outline-offset:-3px}
.leaf-material-studio__structure-fallback{position:absolute;inset:0;background:#e9eee5;display:grid;place-items:center}
.leaf-material-studio__structure-fallback[hidden]{display:none}
.leaf-material-studio__structure-fallback img{max-width:100%;width:100%;height:100%;object-fit:cover}
.leaf-material-studio__structure-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.leaf-material-studio__structure-controls button{border:1px solid #d2ddd1;background:#fff;color:#344a3e;border-radius:9px;padding:11px 9px;min-height:44px;font:inherit;font-size:.86rem;line-height:1.25;text-align:left;cursor:pointer;overflow-wrap:anywhere}
.leaf-material-studio__structure-controls button[aria-pressed="true"]{border-color:#4d7654;background:#e1eee0;box-shadow:inset 0 0 0 1px #4d7654}
.leaf-material-studio__structure-controls button:focus-visible{outline:3px solid #376d4b;outline-offset:2px}
@media(max-width:760px){.leaf-material-studio__viewer{grid-template-columns:1fr}.leaf-material-studio__structure-controls{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:400px){.leaf-material-studio__structure{padding:12px}.leaf-material-studio__canvas-wrap{aspect-ratio:4/3}}
.leaf-material-studio__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(12px,1.7vw,22px)}
.leaf-material-studio__card{min-width:0;overflow:hidden;border-radius:16px;background:#fff;border:1px solid #e0e5de;transition:transform .22s ease,box-shadow .22s ease}
.leaf-material-studio__link{display:block;height:100%;color:inherit;text-decoration:none}
.leaf-material-studio__media{aspect-ratio:4/3;background:#e9eee5;overflow:hidden;display:grid;place-items:center}
.leaf-material-studio__media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
.leaf-material-studio__no-image{color:#5d7868;font-weight:600;font-size:.9rem}
.leaf-material-studio__card-content{padding:clamp(12px,1.5vw,20px)}
.leaf-material-studio__card h3{font-size:clamp(.94rem,1.25vw,1.12rem);line-height:1.35;margin:0 0 .65rem;overflow-wrap:anywhere}
.leaf-material-studio__more{font-size:.87rem;color:#41674e;font-weight:600}
.leaf-material-studio__link:focus-visible{outline:3px solid #376d4b;outline-offset:-3px}
@media(hover:hover){.leaf-material-studio__card:hover{transform:translateY(-3px);box-shadow:0 12px 26px rgba(35,58,41,.1)}.leaf-material-studio__card:hover img{transform:scale(1.045)}}
@media(max-width:1000px){.leaf-material-studio__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.leaf-material-studio__grid{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(240px,78vw);grid-template-columns:none;overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x proximity;scroll-padding-inline:4px;padding:3px 3px 14px;scrollbar-width:thin}.leaf-material-studio__card{border-radius:13px;scroll-snap-align:start}.leaf-material-studio__media{aspect-ratio:4/3}}
@media(prefers-reduced-motion:reduce){.leaf-material-studio__card,.leaf-material-studio__media img{transition:none}.leaf-material-studio__card:hover{transform:none}.leaf-material-studio__card:hover img{transform:none}}
{% endstylesheet %}
{% schema %}
{
  "name": "LEAF Materialstudio",
  "tag": "section",
  "settings": [
    {"type": "product", "id": "source_product", "label": "Konfigurator-Produkt (Metafeld bundle.component_products)"}
  ],
  "presets": [{"name": "LEAF Materialstudio"}]
}
{% endschema %}
