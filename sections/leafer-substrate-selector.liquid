{% javascript %}
  class LeaferSubstrateSelector extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === 'true') return;
      this.dataset.initialized = 'true';

      this.nativeSelect = this.querySelector('[data-variant-select]');
      this.nativeField = this.querySelector('[data-native-field]');
      this.profileChoices = [...this.querySelectorAll('[data-profile-choice]')];
      this.volumeChoices = [...this.querySelectorAll('[data-volume-choice]')];
      this.variants = this.parseData('[data-variants]', []);
      this.matrix = this.parseData('[data-recipe-matrix]', {});
      this.i18n = this.parseData('[data-selector-i18n]', {});
      this.customizer = this.querySelector('[data-customizer]');
      this.customSegments = [...this.querySelectorAll('[data-pot-segment]')];
      this.customOptions = [...this.querySelectorAll('[data-custom-option]')];
      this.customSliderList = this.querySelector('[data-custom-slider-list]');
      this.customSelectedIndex = 0;
      this.customDragState = null;
      this.maxCustomComponents = Math.max(1, Number(this.dataset.maxComponents) || 4);
      this.insightPlants = this.querySelector('[data-insight-plants]');
      this.insightProperties = this.querySelector('[data-insight-properties]');
      this.insightCopy = this.querySelector('[data-insight-copy]');
      this.advancedDetails = this.querySelector('[data-substrate-advanced]');
      this.initCustomizer();

      if (this.advancedDetails && window.location.hash === '#Profi-Konfigurator') this.advancedDetails.open = true;

      if (!this.nativeSelect || !this.variants.length) return;

      const queryVariantId = new URL(window.location.href).searchParams.get('variant');
      if (queryVariantId && this.variants.some((variant) => String(variant.id) === queryVariantId)) {
        this.nativeSelect.value = queryVariantId;
      }

      this.nativeSelect.addEventListener('change', () => {
        const variant = this.variantById(this.nativeSelect.value);
        this.updateVariant(variant, true);
      });

      if (this.profileChoices.length && this.volumeChoices.length) {
        this.profileChoices.forEach((choice) => choice.addEventListener('change', () => this.updateFromChoices()));
        this.volumeChoices.forEach((choice) => choice.addEventListener('change', () => this.updateFromChoices()));
        this.dataset.enhanced = 'true';
        if (this.nativeField) this.nativeField.hidden = true;
      }

      const initialVariant = this.variantById(this.nativeSelect.value) || this.variants.find((variant) => variant.available) || this.variants[0];
      this.updateVariant(initialVariant, false);
    }

    parseData(selector, fallback) {
      const node = this.querySelector(selector);
      if (!node?.textContent.trim()) return fallback;
      try {
        let parsed = JSON.parse(node.textContent);
        if (typeof parsed === 'string') parsed = JSON.parse(parsed);
        return parsed || fallback;
      } catch (error) {
        return fallback;
      }
    }

    t(key, fallback = '') {
      return this.i18n?.[key] || fallback;
    }

    formatText(key, values = {}, fallback = '') {
      let output = this.t(key, fallback);
      Object.entries(values).forEach(([name, value]) => {
        output = output.split(`[${name}]`).join(String(value));
      });
      return output;
    }

    tList(key, fallback = '') {
      return this.t(key, fallback).split('|').map((item) => item.trim()).filter(Boolean);
    }

    isGermanLocale() {
      return String(this.dataset.locale || '').toLowerCase().startsWith('de');
    }

    translateIngredient(name) {
      if (this.isGermanLocale()) return name;
      const normalized = String(name || '').trim().toLowerCase();
      const translations = {
        'kokosfasern': 'Coconut fibre',
        'kokosfaser': 'Coconut fibre',
        'pinienrinde': 'Pine bark',
        'perlite': 'Perlite',
        'bims': 'Pumice',
        'lavagranulat': 'Lava granules',
        'lava': 'Lava granules',
        'sphagnum-moos': 'Sphagnum moss',
        'sphagnum': 'Sphagnum moss',
        'wurmhumus': 'Worm castings',
        'pflanzenkohle': 'Biochar',
        'blähton': 'Expanded clay',
        'algenkalk': 'Algae lime',
        'mykorrhiza': 'Mycorrhiza',
        'aktivierter biokohle-kompost': 'Activated biochar compost',
        'zeolith': 'Zeolite',
        'vermiculit': 'Vermiculite',
        'vermiculite': 'Vermiculite',
        'tongranulat': 'Clay granules'
      };
      return translations[normalized] || name;
    }

    recipeForProfile(profile) {
      const canonicalProfiles = {
        'Herbs & Balcony': 'Kräuter & Balkon',
        'Cacti & Succulents': 'Kakteen & Sukkulenten',
        'Orchids': 'Orchideen',
        'Palms & Green Plants': 'Palmen & Grünpflanzen',
        'Seed Starting & Seedlings': 'Anzucht & Jungpflanzen'
      };
      return this.matrix?.recipes?.[profile] || this.matrix?.recipes?.[canonicalProfiles[profile]];
    }

    variantById(id) {
      return this.variants.find((variant) => String(variant.id) === String(id));
    }

    updateFromChoices() {
      const profile = this.profileChoices.find((choice) => choice.checked)?.value;
      const volume = this.volumeChoices.find((choice) => choice.checked)?.value;
      const variant = this.variants.find((item) => {
        return item.options?.[this.dataset.profileOption] === profile && item.options?.[this.dataset.volumeOption] === volume;
      });
      if (variant) this.updateVariant(variant, true);
    }

    updateVariant(variant, updateUrl) {
      if (!variant) return;

      this.nativeSelect.value = String(variant.id);
      const profile = variant.options?.[this.dataset.profileOption] || '';
      const volume = variant.options?.[this.dataset.volumeOption] || '';
      this.syncChoice(this.profileChoices, profile);
      this.syncChoice(this.volumeChoices, volume);

      const price = this.formatMoney(variant.price);
      this.querySelectorAll('[data-selected-price]').forEach((node) => { node.textContent = price; });

      const summary = this.querySelector('[data-selection-summary]');
      if (summary) summary.textContent = [profile, volume].filter(Boolean).join(' · ');

      const recipeSelection = this.querySelector('[data-recipe-selection]');
      if (recipeSelection) recipeSelection.textContent = [profile, volume].filter(Boolean).join(' · ');

      const availability = this.querySelector('[data-availability]');
      if (availability) {
        availability.dataset.state = variant.available ? 'available' : 'unavailable';
        availability.textContent = variant.available ? this.dataset.availableLabel : this.dataset.unavailableLabel;
      }

      const submit = this.querySelector('[data-submit]');
      if (submit) {
        submit.disabled = !variant.available;
        submit.textContent = variant.available ? this.dataset.addLabel : this.dataset.soldOutLabel;
      }

      this.setProperty('[data-property-profile]', profile);
      this.setProperty('[data-property-volume]', volume);
      const customSegments = this.activeCustomSegments();
      if (customSegments.length) this.renderRecipe(profile, volume);
      const recipeText = customSegments.length ? this.renderCustomRecipe(volume) : this.renderRecipe(profile, volume);
      this.updateInsights(profile, customSegments);
      this.setProperty('[data-property-recipe]', recipeText);
      this.setProperty('[data-property-version]', this.matrix?.version || this.querySelector('[data-recipe-version]')?.textContent.trim() || '');

      if (updateUrl && window.history?.replaceState) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url);
      }
    }


    initCustomizer() {
      if (!this.customizer) return;
      this.customOptions.forEach((option) => {
        option.addEventListener('click', () => {
          const active = option.getAttribute('aria-pressed') === 'true';
          if (!active && this.activeCustomSegments().length >= this.maxCustomComponents) return;
          option.setAttribute('aria-pressed', active ? 'false' : 'true');
          if (!active) {
            const freeSegment = this.customSegments.find((segment) => segment.hidden);
            if (freeSegment) {
              freeSegment.hidden = false;
              freeSegment.dataset.name = option.dataset.name;
              freeSegment.dataset.share = '0';
              freeSegment.dataset.proMin = option.dataset.proMin || '0';
              freeSegment.dataset.proMax = option.dataset.proMax || '100';
              freeSegment.dataset.warning = option.dataset.warning || option.dataset.proMax || '100';
              freeSegment.dataset.aeration = option.dataset.aeration || '';
              freeSegment.dataset.drainage = option.dataset.drainage || '';
              freeSegment.dataset.waterRetention = option.dataset.waterRetention || '';
              freeSegment.dataset.structure = option.dataset.structure || '';
              freeSegment.dataset.nutrient = option.dataset.nutrient || '';
              freeSegment.dataset.technicalNote = option.dataset.technicalNote || '';
              freeSegment.dataset.order = String(this.nextCustomOrder());
              const preview = option.querySelector('img');
              freeSegment.dataset.image = preview?.currentSrc || preview?.src || '';
            }
          } else {
            const segment = this.customSegments.find((item) => item.dataset.name === option.dataset.name);
            if (segment) {
              segment.hidden = true;
              delete segment.dataset.name;
              delete segment.dataset.share;
              delete segment.dataset.proMin;
              delete segment.dataset.proMax;
              delete segment.dataset.warning;
              delete segment.dataset.aeration;
              delete segment.dataset.drainage;
              delete segment.dataset.waterRetention;
              delete segment.dataset.structure;
              delete segment.dataset.nutrient;
              delete segment.dataset.technicalNote;
              delete segment.dataset.order;
              delete segment.dataset.image;
              segment.style.removeProperty('background-image');
              segment.style.removeProperty('background-size');
              segment.style.removeProperty('background-position');
              segment.style.removeProperty('background-blend-mode');
              segment.classList.remove('is-selected');
            }
          }
          this.equalizeCustomSegments();
          this.refreshCustomRecipe();
        });
      });
      this.customSegments.forEach((segment) => {
        segment.addEventListener('click', () => {
          if (segment.hidden || segment.dataset.justDragged === 'true') return;
          this.customSelectedIndex = Number(segment.dataset.index);
          this.customSegments.forEach((item) => item.classList.toggle('is-selected', item === segment));
          const slider = this.customSliderList?.querySelector(`[data-custom-segment-slider="${segment.dataset.index}"]`);
          slider?.focus({ preventScroll: true });
        });
        segment.addEventListener('pointerdown', (event) => this.beginCustomDrag(event, segment));
        segment.addEventListener('pointermove', (event) => this.moveCustomDrag(event, segment));
        segment.addEventListener('pointerup', (event) => this.endCustomDrag(event, segment));
        segment.addEventListener('pointercancel', (event) => this.endCustomDrag(event, segment));
        segment.addEventListener('keydown', (event) => {
          if (segment.hidden || (event.key !== 'ArrowUp' && event.key !== 'ArrowDown')) return;
          event.preventDefault();
          this.moveCustomSegment(segment, event.key === 'ArrowUp' ? -1 : 1);
        });
      });
      this.syncCustomUI();
    }

    activeCustomSegments() {
      return (this.customSegments || [])
        .filter((segment) => !segment.hidden && segment.dataset.name)
        .sort((a, b) => (Number(a.dataset.order) || 0) - (Number(b.dataset.order) || 0));
    }

    nextCustomOrder() {
      return this.activeCustomSegments().reduce((max, segment) => Math.max(max, Number(segment.dataset.order) || 0), -1) + 1;
    }

    visualCustomSegments() {
      return this.activeCustomSegments().slice().sort((a, b) => {
        const aTop = a.getBoundingClientRect().top;
        const bTop = b.getBoundingClientRect().top;
        if (aTop !== bTop) return aTop - bTop;
        return (Number(b.dataset.order) || 0) - (Number(a.dataset.order) || 0);
      });
    }

    beginCustomDrag(event, segment) {
      if (segment.hidden || event.isPrimary === false || (event.pointerType === 'mouse' && event.button !== 0)) return;
      event.preventDefault();
      this.customSelectedIndex = Number(segment.dataset.index);
      this.customDragState = { pointerId: event.pointerId, segment, startY: event.clientY, moved: false };
      segment.classList.add('is-dragging');
      try { segment.setPointerCapture(event.pointerId); } catch {}
    }

    moveCustomDrag(event, segment) {
      const state = this.customDragState;
      if (!state || state.segment !== segment || state.pointerId !== event.pointerId) return;
      const delta = event.clientY - state.startY;
      if (Math.abs(delta) > 5) state.moved = true;
      if (!state.moved) return;
      event.preventDefault();
      segment.style.transform = `translateY(${delta}px)`;
    }

    endCustomDrag(event, segment) {
      const state = this.customDragState;
      if (!state || state.segment !== segment || state.pointerId !== event.pointerId) return;
      const shouldCommit = state.moved && event.type !== 'pointercancel';
      if (shouldCommit) {
        event.preventDefault();
        this.reorderCustomSegments(segment, event.clientY);
        segment.dataset.justDragged = 'true';
        window.setTimeout(() => { delete segment.dataset.justDragged; }, 0);
      }
      segment.style.removeProperty('transform');
      segment.classList.remove('is-dragging');
      try { segment.releasePointerCapture(event.pointerId); } catch {}
      this.customDragState = null;
    }

    reorderCustomSegments(dragged, clientY) {
      const visual = this.visualCustomSegments();
      const shares = new Map(visual.map((segment) => [segment, segment.dataset.share]));
      const withoutDragged = visual.filter((segment) => segment !== dragged);
      let insertAt = withoutDragged.findIndex((segment) => {
        const rect = segment.getBoundingClientRect();
        return clientY < rect.top + rect.height / 2;
      });
      if (insertAt < 0) insertAt = withoutDragged.length;
      withoutDragged.splice(insertAt, 0, dragged);
      withoutDragged.forEach((segment, index) => {
        segment.dataset.order = String(withoutDragged.length - 1 - index);
      });
      shares.forEach((share, segment) => { segment.dataset.share = share; });
      this.updateCustomSegmentVisuals();
      this.renderCustomSliders();
      this.refreshCustomRecipe();
    }

    moveCustomSegment(segment, direction) {
      const visual = this.visualCustomSegments();
      const currentIndex = visual.indexOf(segment);
      const targetIndex = Math.max(0, Math.min(visual.length - 1, currentIndex + direction));
      if (currentIndex < 0 || targetIndex === currentIndex) return;
      visual.splice(currentIndex, 1);
      visual.splice(targetIndex, 0, segment);
      visual.forEach((item, index) => {
        item.dataset.order = String(visual.length - 1 - index);
      });
      this.updateCustomSegmentVisuals();
      this.renderCustomSliders();
      this.refreshCustomRecipe();
      segment.focus({ preventScroll: true });
    }

    equalizeCustomSegments() {
      const segments = this.activeCustomSegments();
      if (!segments.length) {
        this.customSelectedIndex = 0;
        this.syncCustomUI();
        return;
      }

      const minFor = (segment) => Math.max(0, Number(segment.dataset.proMin) || 0);
      const maxFor = (segment) => Math.min(100, Number(segment.dataset.proMax) || 100);
      let remaining = 100;

      segments.forEach((segment) => {
        const minimum = minFor(segment);
        segment.dataset.share = String(minimum);
        remaining -= minimum;
      });

      let guard = 0;
      while (remaining > 0 && guard < 1000) {
        const candidates = segments.filter((segment) => Number(segment.dataset.share) < maxFor(segment));
        if (!candidates.length) break;

        const fairShare = Math.max(1, Math.floor(remaining / candidates.length));
        for (const segment of candidates) {
          if (remaining <= 0) break;
          const current = Number(segment.dataset.share) || 0;
          const capacity = maxFor(segment) - current;
          const addition = Math.min(fairShare, capacity, remaining);
          segment.dataset.share = String(current + addition);
          remaining -= addition;
        }
        guard += 1;
      }

      if (remaining > 0) {
        const fallback = segments.find((segment) => Number(segment.dataset.share) < 100);
        if (fallback) fallback.dataset.share = String(Number(fallback.dataset.share) + remaining);
      }

      this.customSelectedIndex = Number(segments[0].dataset.index);
      this.syncCustomUI();
    }

    balanceCustomSegment(selected, rawValue) {
      const segments = this.activeCustomSegments();
      if (!selected || !segments.length) return;

      if (segments.length === 1) {
        selected.dataset.share = '100';
        this.updateCustomSegmentVisuals();
        this.updateCustomSliderValues();
        this.updateProFeedback();
        return;
      }

      const minFor = (segment) => Math.max(0, Number(segment.dataset.proMin) || 0);
      const maxFor = (segment) => Math.min(100, Number(segment.dataset.proMax) || 100);
      const others = segments.filter((segment) => segment !== selected);
      const othersMin = others.reduce((sum, segment) => sum + minFor(segment), 0);
      const othersMax = others.reduce((sum, segment) => sum + maxFor(segment), 0);
      const selectedMin = Math.max(minFor(selected), 100 - othersMax);
      const selectedMax = Math.min(maxFor(selected), 100 - othersMin);
      const lower = Math.min(selectedMin, selectedMax);
      const upper = Math.max(selectedMin, selectedMax);
      const requested = Math.max(lower, Math.min(upper, Number(rawValue) || lower));
      selected.dataset.share = String(Math.round(requested));

      const targetOtherTotal = 100 - Number(selected.dataset.share);
      const priorWeight = others.reduce((sum, segment) => sum + Math.max(1, Number(segment.dataset.share) || 0), 0);
      let assigned = 0;

      others.forEach((segment) => {
        const proportional = Math.round(targetOtherTotal * Math.max(1, Number(segment.dataset.share) || 0) / priorWeight);
        const share = Math.max(minFor(segment), Math.min(maxFor(segment), proportional));
        segment.dataset.share = String(share);
        assigned += share;
      });

      let delta = targetOtherTotal - assigned;
      let guard = 0;
      while (delta !== 0 && guard < 500) {
        const growing = delta > 0;
        const candidates = others
          .filter((segment) => growing
            ? Number(segment.dataset.share) < maxFor(segment)
            : Number(segment.dataset.share) > minFor(segment))
          .sort((a, b) => {
            const aCapacity = growing ? maxFor(a) - Number(a.dataset.share) : Number(a.dataset.share) - minFor(a);
            const bCapacity = growing ? maxFor(b) - Number(b.dataset.share) : Number(b.dataset.share) - minFor(b);
            return bCapacity - aCapacity;
          });
        if (!candidates.length) break;
        const candidate = candidates[guard % candidates.length];
        candidate.dataset.share = String(Number(candidate.dataset.share) + (growing ? 1 : -1));
        delta += growing ? -1 : 1;
        guard += 1;
      }

      this.updateCustomSegmentVisuals();
      this.updateCustomSliderValues();
      this.updateProFeedback();
    }

    materialColor(name = '') {
      const label = String(name).toLowerCase();
      const materials = [
        { match: /perlit/, color: '#e9e7df' },
        { match: /bims|pumice/, color: '#b7b2a4' },
        { match: /lava/, color: '#544a43' },
        { match: /seramis|tonbruch|blähton|blaehton/, color: '#a75e42' },
        { match: /pinien|rinde|bark/, color: '#745039' },
        { match: /sphagnum|moos|moss/, color: '#8a8351' },
        { match: /kokos|coco/, color: '#896a50' },
        { match: /wurmhumus|kompost|humus|erde/, color: '#433b31' },
        { match: /kohle|biochar/, color: '#383735' },
        { match: /zeolith/, color: '#a1a79b' },
        { match: /sand|quarz/, color: '#c8b999' }
      ];
      return materials.find((entry) => entry.match.test(label))?.color || '#958570';
    }

    materialTextColor(hex) {
      const channels = hex.slice(1).match(/.{2}/g)?.map((channel) => parseInt(channel, 16) / 255) || [0, 0, 0];
      const linear = channels.map((value) => value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4);
      const luminance = 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2];
      return luminance > 0.179 ? '#000000' : '#ffffff';
    }

    updateCustomSegmentVisuals() {
      this.customSegments.forEach((segment) => {
        const share = Number(segment.dataset.share) || 0;
        segment.style.height = share ? `${share}%` : '';
        segment.style.order = String(Number(segment.dataset.order) || 0);
        segment.textContent = share ? `${this.translateIngredient(segment.dataset.name).split(/\s+[–—-]\s+/)[0].trim()} · ${share}%` : '';
        segment.setAttribute('aria-label', share ? this.formatText('segment_percent', { name: segment.dataset.name, share }) : this.t('free_segment'));
        // The pot visualises loose substrate, never packaged product photography.
        const color = this.materialColor(segment.dataset.name);
        segment.style.backgroundColor = color;
        segment.style.color = this.materialTextColor(color);
        segment.style.removeProperty('background-image');
        segment.style.removeProperty('background-size');
        segment.style.removeProperty('background-position');
        segment.style.removeProperty('background-blend-mode');
      });
    }

    renderCustomSliders() {
      if (!this.customSliderList) return;
      const segments = this.activeCustomSegments().slice().sort((a, b) => (Number(b.dataset.order) || 0) - (Number(a.dataset.order) || 0));
      this.customSliderList.replaceChildren();

      segments.forEach((segment) => {
        const row = document.createElement('label');
        row.className = 'leafer-substrate__mix-slider';

        const thumb = document.createElement('span');
        thumb.className = 'leafer-substrate__mix-slider-thumb';
        thumb.setAttribute('aria-hidden', 'true');
        thumb.style.backgroundColor = this.materialColor(segment.dataset.name);

        const name = document.createElement('strong');
        name.className = 'leafer-substrate__mix-slider-name';
        name.textContent = this.translateIngredient(segment.dataset.name);

        const output = document.createElement('output');
        output.dataset.customSegmentOutput = segment.dataset.index;
        output.textContent = `${segment.dataset.share || 0} %`;

        const range = document.createElement('input');
        range.type = 'range';
        range.step = '1';
        range.min = String(Math.max(0, Number(segment.dataset.proMin) || 0));
        range.max = String(Math.min(100, Number(segment.dataset.proMax) || 100));
        range.value = String(Number(segment.dataset.share) || 0);
        range.dataset.customSegmentSlider = segment.dataset.index;
        range.setAttribute('aria-label', segment.dataset.name);
        range.addEventListener('input', () => {
          this.customSelectedIndex = Number(segment.dataset.index);
          this.customSegments.forEach((item) => item.classList.toggle('is-selected', item === segment));
          this.balanceCustomSegment(segment, range.value);
          this.refreshCustomRecipe();
        });

        row.append(thumb, name, output, range);
        this.customSliderList.append(row);
      });
    }

    updateCustomSliderValues() {
      if (!this.customSliderList) return;
      this.activeCustomSegments().forEach((segment) => {
        const slider = this.customSliderList.querySelector(`[data-custom-segment-slider="${segment.dataset.index}"]`);
        const output = this.customSliderList.querySelector(`[data-custom-segment-output="${segment.dataset.index}"]`);
        if (slider) slider.value = String(Number(segment.dataset.share) || 0);
        if (output) output.textContent = `${segment.dataset.share || 0} %`;
      });
    }

    syncCustomUI() {
      const segments = this.activeCustomSegments();
      const count = this.querySelector('[data-customizer-count]');
      const hint = this.querySelector('[data-customizer-hint]');
      const atLimit = segments.length >= this.maxCustomComponents;
      if (count) count.textContent = String(segments.length);
      if (hint) {
        hint.textContent = !segments.length
          ? this.t('hint_empty')
          : atLimit
            ? this.t('hint_limit')
            : this.t('hint_adjust');
      }
      this.customOptions.forEach((option) => {
        const active = segments.some((segment) => segment.dataset.name === option.dataset.name);
        const blocked = atLimit && !active;
        option.setAttribute('aria-pressed', active ? 'true' : 'false');
        option.disabled = blocked;
        option.setAttribute('aria-disabled', blocked ? 'true' : 'false');
      });
      this.updateCustomSegmentVisuals();
      this.renderCustomSliders();
      this.updateProFeedback();
    }

    updateProFeedback() {
      const feedback = this.querySelector('[data-pro-feedback]');
      if (!feedback) return;
      const segments = this.activeCustomSegments();
      if (!segments.length) { feedback.hidden = true; feedback.replaceChildren(); return; }
      const warnings = [];
      const metrics = { aeration: 0, drainage: 0, water: 0, structure: 0, nutrient: 0 };
      let metricWeight = 0;
      segments.forEach((segment) => {
        const share = Number(segment.dataset.share) || 0;
        const warning = Number(segment.dataset.warning) || 100;
        const max = Number(segment.dataset.proMax) || 100;
        if (share > max) warnings.push(this.formatText('warning_max', { name: segment.dataset.name, share, max }));
        else if (share > warning) warnings.push(this.formatText('warning_threshold', { name: segment.dataset.name, share, warning }));
        ['aeration','drainage','structure','nutrient'].forEach((key) => {
          const value = Number(segment.dataset[key]);
          if (Number.isFinite(value) && value > 0) metrics[key] += value * share;
        });
        const water = Number(segment.dataset.waterRetention);
        if (Number.isFinite(water) && water > 0) metrics.water += water * share;
        metricWeight += share;
      });
      feedback.replaceChildren();
      const summary = document.createElement('p');
      summary.className = 'leafer-substrate__pro-summary';
      summary.textContent = warnings.length ? this.t('feedback_warning') : this.t('feedback_ok');
      feedback.append(summary);
      if (warnings.length) {
        const list = document.createElement('ul');
        warnings.forEach((warning) => { const li = document.createElement('li'); li.textContent = warning; list.append(li); });
        feedback.append(list);
      }
      if (metricWeight > 0) {
        const grid = document.createElement('div');
        grid.className = 'leafer-substrate__pro-metrics';
        [[this.t('metric_aeration'),'aeration'],[this.t('metric_drainage'),'drainage'],[this.t('metric_water'),'water'],[this.t('metric_structure'),'structure'],[this.t('metric_nutrient'),'nutrient']].forEach(([label,key]) => {
          if (!metrics[key]) return;
          const item = document.createElement('span');
          item.textContent = `${label} ${Math.round(metrics[key] / metricWeight)}/10`;
          grid.append(item);
        });
        feedback.append(grid);
      }
      const selected = segments.find((segment) => Number(segment.dataset.index) === this.customSelectedIndex) || segments[0];
      if (this.isGermanLocale() && selected?.dataset.technicalNote) { const note = document.createElement('small'); note.textContent = selected.dataset.technicalNote; feedback.append(note); }
      feedback.hidden = false;
    }

    renderCustomRecipe(volume) {
      const segments = this.activeCustomSegments();
      const list = this.querySelector('[data-recipe-list]');
      const empty = this.querySelector('[data-recipe-empty]');
      const sizeKey = String(volume).match(/[\d.,]+/)?.[0]?.replace(',', '.');
      const litresTotal = Number(sizeKey) || 0;
      if (!list || !segments.length) return '';
      list.replaceChildren();
      if (empty) empty.hidden = true;
      const fragment = document.createDocumentFragment();
      const recipeParts = [];
      let total = 0;
      segments.forEach((segment) => {
        const share = Number(segment.dataset.share) || 0;
        const litres = litresTotal * share / 100;
        total += share;
        const row = document.createElement('div');
        row.className = 'leafer-substrate__recipe-row';
        const head = document.createElement('div');
        head.className = 'leafer-substrate__recipe-row-head';
        const name = document.createElement('strong');
        name.textContent = segment.dataset.name;
        const values = document.createElement('span');
        values.className = 'leafer-substrate__recipe-values';
        values.append(
          document.createTextNode(`${this.formatNumber(share)} %`),
          document.createTextNode(' · '),
          document.createTextNode(`${this.formatNumber(litres)} L`)
        );
        head.append(name, values);
        const bar = document.createElement('div');
        bar.className = 'leafer-substrate__recipe-bar';
        const fill = document.createElement('span');
        fill.style.setProperty('--share', `${share}%`);
        bar.append(fill);
        row.append(head, bar);
        fragment.append(row);
        recipeParts.push(`${this.translateIngredient(segment.dataset.name)} ${this.formatNumber(share)} % (${this.formatNumber(litres)} L)`);
      });
      list.append(fragment);
      const totalNode = this.querySelector('[data-recipe-total]');
      if (totalNode) totalNode.textContent = `${this.formatNumber(total)} % · ${volume}`;
      const basisNode = this.querySelector('[data-recipe-basis]');
      if (basisNode) basisNode.textContent = this.t('custom_basis');
      const versionNode = this.querySelector('[data-recipe-version]');
      if (versionNode) versionNode.textContent = this.t('custom_version');
      const totalLabel = this.querySelector('[data-customizer-total]');
      if (totalLabel) totalLabel.textContent = `${this.formatNumber(total)} % · ${this.formatNumber(litresTotal)} L`;
      const notesList = this.querySelector('[data-recipe-notes]');
      if (notesList) {
        notesList.replaceChildren();
        notesList.hidden = true;
      }
      return recipeParts.join(' · ');
    }

    refreshCustomRecipe() {
      const variant = this.variantById(this.nativeSelect?.value);
      if (!variant) return;
      const volume = variant.options?.[this.dataset.volumeOption] || '';
      if (this.activeCustomSegments().length) {
        const profile = variant.options?.[this.dataset.profileOption] || '';
        const recipeText = this.renderCustomRecipe(volume);
        this.updateInsights(profile, this.activeCustomSegments());
        this.setProperty('[data-property-recipe]', recipeText);
        this.setProperty('[data-property-version]', this.t('custom_version'));
      } else {
        const profile = variant.options?.[this.dataset.profileOption] || '';
        this.renderRecipe(profile, volume);
        this.updateInsights(profile, []);
        this.setProperty('[data-property-recipe]', '');
        this.setProperty('[data-property-version]', this.matrix?.version || '');
      }
    }


    updateInsights(profile, customSegments) {
      if (!this.insightPlants || !this.insightProperties) return;
      const normalized = String(profile || '').toLowerCase();
      let rule = {
        plants: this.tList('insight_default_plants'),
        properties: this.tList('insight_default_properties'),
        copy: this.t('insight_default_copy')
      };
      if (normalized.includes('aroid') || normalized.includes('tropical') || normalized.includes('luftig') || normalized.includes('airy')) {
        rule = { plants: this.tList('insight_aroid_plants'), properties: this.tList('insight_aroid_properties'), copy: this.t('insight_aroid_copy') };
      } else if (normalized.includes('kräuter') || normalized.includes('balkon') || normalized.includes('ausgewogen') || normalized.includes('herb') || normalized.includes('balcony') || normalized.includes('balanced')) {
        rule = { plants: this.tList('insight_herb_plants'), properties: this.tList('insight_herb_properties'), copy: this.t('insight_herb_copy') };
      } else if (normalized.includes('kakt') || normalized.includes('sukkulent') || normalized.includes('mineral') || normalized.includes('cactus') || normalized.includes('succulent')) {
        rule = { plants: this.tList('insight_cactus_plants'), properties: this.tList('insight_cactus_properties'), copy: this.t('insight_cactus_copy') };
      } else if (normalized.includes('orchid') || normalized.includes('orchidee') || normalized.includes('rinden') || normalized.includes('bark')) {
        rule = { plants: this.tList('insight_orchid_plants'), properties: this.tList('insight_orchid_properties'), copy: this.t('insight_orchid_copy') };
      } else if (normalized.includes('palm') || normalized.includes('palmen') || normalized.includes('struktur') || normalized.includes('structure')) {
        rule = { plants: this.tList('insight_palm_plants'), properties: this.tList('insight_palm_properties'), copy: this.t('insight_palm_copy') };
      } else if (normalized.includes('anzucht') || normalized.includes('jung') || normalized.includes('fein') || normalized.includes('propagation') || normalized.includes('young') || normalized.includes('seed')) {
        rule = { plants: this.tList('insight_seed_plants'), properties: this.tList('insight_seed_properties'), copy: this.t('insight_seed_copy') };
      }

      const names = customSegments.length ? customSegments.map((segment) => segment.dataset.name) : Object.keys(this.recipeForProfile(profile)?.percent || {});
      const additions = [];
      names.forEach((name) => {
        const item = String(name).toLowerCase();
        if (item.includes('perlit') || item.includes('bims') || item.includes('pumice') || item.includes('lava') || item.includes('blähton') || item.includes('expanded clay')) additions.push(this.t('addition_drainage'));
        if (item.includes('kokos') || item.includes('coconut') || item.includes('sphagnum') || item.includes('moos') || item.includes('moss')) additions.push(this.t('addition_moisture'));
        if (item.includes('rinde') || item.includes('bark')) additions.push(this.t('addition_bark'));
        if (item.includes('wurmhumus') || item.includes('worm') || item.includes('kompost') || item.includes('compost')) additions.push(this.t('addition_nutrient'));
        if (item.includes('algenkalk') || item.includes('algae lime')) additions.push(this.t('addition_ph'));
        if (item.includes('mykorrhiza') || item.includes('mycorrhiza')) additions.push(this.t('addition_root'));
      });
      const properties = [...new Set([...rule.properties, ...additions])];
      this.insightPlants.replaceChildren();
      rule.plants.forEach((plant) => {
        const chip = document.createElement('span');
        chip.textContent = plant;
        this.insightPlants.append(chip);
      });
      this.insightProperties.replaceChildren();
      properties.forEach((property) => {
        const item = document.createElement('li');
        item.textContent = property;
        this.insightProperties.append(item);
      });
      if (this.insightCopy) this.insightCopy.textContent = rule.copy;
    }

    syncChoice(choices, value) {
      choices.forEach((choice) => { choice.checked = choice.value === value; });
    }

    setProperty(selector, value) {
      const input = this.querySelector(selector);
      if (!input) return;
      input.value = value || '';
      input.disabled = !value;
    }

    renderRecipe(profile, volume) {
      const recipe = this.recipeForProfile(profile);
      const sizeKey = String(volume).match(/[\d.,]+/)?.[0]?.replace(',', '.');
      const percentages = recipe?.percent || {};
      const sizes = recipe?.sizes_l?.[sizeKey] || recipe?.sizes_l?.[String(Number(sizeKey))] || {};
      const entries = Object.entries(percentages);
      const lists = [...this.querySelectorAll('[data-recipe-list], [data-base-recipe-list]')];
      const list = lists[0];
      const empty = this.querySelector('[data-recipe-empty]');
      const notesList = this.querySelector('[data-recipe-notes]');

      if (!lists.length || !list) return '';
      lists.forEach((targetList) => targetList.replaceChildren());

      if (!entries.length) {
        if (empty) empty.hidden = false;
        if (notesList) notesList.hidden = true;
        return '';
      }

      if (empty) empty.hidden = true;
      const fragment = document.createDocumentFragment();
      let total = 0;
      const recipeParts = [];

      entries.forEach(([ingredient, rawShare]) => {
        const share = Number(rawShare) || 0;
        const litres = sizes?.[ingredient];
        total += share;

        const row = document.createElement('div');
        row.className = 'leafer-substrate__recipe-row';

        const head = document.createElement('div');
        head.className = 'leafer-substrate__recipe-row-head';

        const name = document.createElement('strong');
        name.textContent = this.translateIngredient(ingredient);

        const values = document.createElement('span');
        values.className = 'leafer-substrate__recipe-values';

        const percentage = document.createElement('span');
        percentage.textContent = `${this.formatNumber(share)} %`;
        values.append(percentage);

        if (litres !== undefined && litres !== null) {
          const amount = document.createElement('span');
          amount.textContent = `${this.formatNumber(litres)} L`;
          values.append(amount);
          recipeParts.push(`${this.translateIngredient(ingredient)} ${this.formatNumber(share)} % (${this.formatNumber(litres)} L)`);
        } else {
          recipeParts.push(`${this.translateIngredient(ingredient)} ${this.formatNumber(share)} %`);
        }

        head.append(name, values);

        const bar = document.createElement('div');
        bar.className = 'leafer-substrate__recipe-bar';
        const fill = document.createElement('span');
        fill.style.setProperty('--share', `${Math.max(0, Math.min(100, share))}%`);
        bar.append(fill);

        row.append(head, bar);
        fragment.append(row);
      });

      lists.forEach((targetList) => targetList.append(fragment.cloneNode(true)));
      const baseSelection = this.querySelector('[data-base-recipe-selection]');
      if (baseSelection) baseSelection.textContent = [profile, volume].filter(Boolean).join(' · ');
      const totalNode = this.querySelector('[data-recipe-total]');
      if (totalNode) totalNode.textContent = `${this.formatNumber(total)} % · ${volume}`;
      const basisNode = this.querySelector('[data-recipe-basis]');
      if (basisNode) basisNode.textContent = this.isGermanLocale() && this.matrix?.basis ? this.matrix.basis : this.t('volume_shares', 'Volume shares');
      const versionNode = this.querySelector('[data-recipe-version]');
      if (versionNode && this.matrix?.version) versionNode.textContent = this.matrix.version;

      this.renderNotes(percentages, notesList);
      return recipeParts.join(' · ');
    }

    renderNotes(percentages, notesList) {
      if (!notesList) return;
      notesList.replaceChildren();
      if (!this.isGermanLocale()) { notesList.hidden = true; return; }
      const notes = Object.entries(this.matrix?.notes || {}).filter(([ingredient]) => Object.prototype.hasOwnProperty.call(percentages, ingredient));
      if (!notes.length) {
        notesList.hidden = true;
        return;
      }

      const fragment = document.createDocumentFragment();
      notes.forEach(([ingredient, note]) => {
        const item = document.createElement('li');
        const label = document.createElement('strong');
        label.textContent = `${ingredient}: `;
        item.append(label, document.createTextNode(note));
        fragment.append(item);
      });
      notesList.append(fragment);
      notesList.hidden = false;
    }

    formatMoney(cents) {
      const amount = Number(cents) / 100;
      try {
        return new Intl.NumberFormat(this.dataset.locale || 'de-DE', {
          style: 'currency',
          currency: this.dataset.currency || 'EUR'
        }).format(amount);
      } catch (error) {
        return `${amount.toFixed(2)} ${this.dataset.currency || 'EUR'}`;
      }
    }

    formatNumber(value) {
      try {
        return new Intl.NumberFormat(this.dataset.locale || 'de-DE', {
          maximumFractionDigits: 2
        }).format(Number(value));
      } catch (error) {
        return String(value);
      }
    }
  }

  if (!customElements.get('leafer-substrate-selector')) {
    customElements.define('leafer-substrate-selector', LeaferSubstrateSelector);
  }
{% endjavascript %}

