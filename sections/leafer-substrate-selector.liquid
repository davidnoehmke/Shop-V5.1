{% liquid
  assign selector_product = section.settings.product
  assign heading_tag = 'h1'
  if section.index > 1
    assign heading_tag = 'h2'
  endif

  assign profile_option_name = section.settings.profile_option_name | default: 'Pflanzentyp'
  assign volume_option_name = section.settings.volume_option_name | default: 'Menge'

  for product_option in selector_product.options_with_values
    case product_option.name
      when 'Pflanzentyp', 'Plant type'
        assign profile_option_name = product_option.name
      when 'Menge', 'Quantity', 'Volume'
        assign volume_option_name = product_option.name
    endcase
  endfor
  assign product_form_id = 'LeaferSubstrateForm-' | append: section.id
  assign profile_blocks = section.blocks | where: 'type', 'profile'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
%}

<leafer-substrate-selector
  {% if request.page_type == 'index' %}id="Substrat-Konfigurator"{% endif %}
  class="leafer-substrate{% if request.page_type == 'index' %} leafer-substrate--home-usp{% endif %}"
  data-max-components="4"
  data-profile-option="{{ profile_option_name | escape }}"
  data-volume-option="{{ volume_option_name | escape }}"
  data-add-label="{{ section.settings.add_label | escape }}"
  data-sold-out-label="{{ section.settings.sold_out_label | escape }}"
  data-available-label="{{ section.settings.available_label | escape }}"
  data-unavailable-label="{{ section.settings.unavailable_label | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-locale="{{ request.locale.iso_code | replace: '_', '-' | escape }}"
  style="--leafer-selector-top: {{ section.settings.padding_top }}px; --leafer-selector-bottom: {{ section.settings.padding_bottom }}px;"
>
  {% if selector_product == blank %}
    <div class="leafer-substrate__empty page-width">
      <p class="leafer-substrate__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <{{ heading_tag }} id="LeaferSubstrateHeading-{{ section.id }}">{{ section.settings.heading }}</{{ heading_tag }}>
      <p>{{ 'substrate_selector.empty_config' | t }}</p>
    </div>
  {% else %}
    {% liquid
      assign selected_variant = selector_product.selected_or_first_available_variant
      assign recipe_matrix = selector_product.metafields.leafer.recipe_matrix.value
      assign recipe_version = selector_product.metafields.leafer.recipe_version.value | default: recipe_matrix.version
      assign component_products = selector_product.metafields.bundle.component_products.value
      assign hero_image = section.settings.image | default: selector_product.featured_image
      assign hero_alt = section.settings.image_alt | default: hero_image.alt | default: selector_product.title
      assign product_subtitle = selector_product.metafields.leafer.subtitle.value
      assign product_intro = selector_product.metafields.leafer.intro.value
      assign usp_1 = selector_product.metafields.leafer.usp_1.value
      assign usp_2 = selector_product.metafields.leafer.usp_2.value
      assign usp_3 = selector_product.metafields.leafer.usp_3.value
      assign selected_profile = blank
      assign selected_volume = blank
      assign profile_option = blank
      assign volume_option = blank
      assign min_price = selector_product.price_min | money
      assign max_price = selector_product.price_max | money

      for selected_option in selected_variant.selected_options
        if selected_option.name == profile_option_name
          assign selected_profile = selected_option.value
        elsif selected_option.name == volume_option_name
          assign selected_volume = selected_option.value
        endif
      endfor

      for option in selector_product.options_with_values
        if option.name == profile_option_name
          assign profile_option = option
        elsif option.name == volume_option_name
          assign volume_option = option
        endif
      endfor

      assign has_components = false
      if component_products != blank
        for component_product in component_products
          if component_product.available and component_product.id != selector_product.id
            assign has_components = true
            break
          endif
        endfor
      endif
    %}

    <div class="leafer-substrate__page" aria-labelledby="LeaferSubstrateHeading-{{ section.id }}">
      <div class="leafer-substrate__hero page-width">
        <div class="leafer-substrate__hero-copy">
          {% if section.settings.eyebrow != blank %}<p class="leafer-substrate__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
          <{{ heading_tag }} id="LeaferSubstrateHeading-{{ section.id }}">{{ section.settings.heading }}</{{ heading_tag }}>
          {% if section.settings.intro != blank %}<div class="leafer-substrate__intro rte">{{ section.settings.intro }}</div>{% endif %}
          {% if product_subtitle != blank and request.locale.iso_code == 'de' %}<p class="leafer-substrate__product-subtitle">{{ product_subtitle | escape }}</p>{% endif %}

          <ul class="leafer-substrate__signals" aria-label="{{ 'substrate_selector.signals_label' | t | escape }}">
            {% if request.locale.iso_code == 'de' %}
              <li>{% if usp_1 != blank %}{{ usp_1 | escape }}{% else %}{{ 'substrate_selector.signal_profiles' | t }}{% endif %}</li>
              <li>{% if usp_2 != blank %}{{ usp_2 | escape }}{% else %}{{ 'substrate_selector.signal_volumes' | t }}{% endif %}</li>
              <li>{% if usp_3 != blank %}{{ usp_3 | escape }}{% else %}{{ 'substrate_selector.signal_recipe_visible' | t }}{% endif %}</li>
            {% else %}
              <li>{{ 'substrate_selector.signal_profiles' | t }}</li>
              <li>{{ 'substrate_selector.signal_volumes' | t }}</li>
              <li>{{ 'substrate_selector.signal_recipe_visible' | t }}</li>
            {% endif %}
          </ul>

          <p class="leafer-substrate__price-range">
            <span>{{ 'substrate_selector.price_range' | t }}</span>
            <strong>{% if selector_product.price_varies %}{{ min_price }} – {{ max_price }}{% else %}{{ min_price }}{% endif %}</strong>
          </p>
        </div>

        <div class="leafer-substrate__hero-media">
          {% if hero_image != blank %}
            {{ hero_image | image_url: width: 1600 | image_tag: widths: '520, 760, 1000, 1300, 1600', sizes: '(min-width: 990px) 46vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
        </div>
      </div>

      <div class="leafer-substrate__commerce page-width">
        <div class="leafer-substrate__purchase-panel">
          <header class="leafer-substrate__panel-head">
            <p class="leafer-substrate__eyebrow">{{ section.settings.selection_eyebrow | escape }}</p>
            <h2>{{ section.settings.selection_heading | escape }}</h2>
            {% if section.settings.selection_text != blank %}<div class="rte">{{ section.settings.selection_text }}</div>{% endif %}
            <div class="leafer-substrate__progress" aria-label="{{ 'substrate_selector.progress_label' | t | escape }}">
              <span class="is-active"><b>1</b><em>{{ 'substrate_selector.progress_profile' | t }}</em></span>
              <i aria-hidden="true">→</i>
              <span><b>2</b><em>{{ 'substrate_selector.progress_volume' | t }}</em></span>
              <i aria-hidden="true">→</i>
              <span><b>3</b><em>{{ 'substrate_selector.progress_recipe' | t }}</em></span>
            </div>
          </header>

          {% if profile_option != blank and volume_option != blank %}
            <div class="leafer-substrate__enhanced" data-enhanced-controls>
              <fieldset class="leafer-substrate__fieldset">
                <legend>{{ section.settings.profile_legend | escape }}</legend>
                <div class="leafer-substrate__options leafer-substrate__options--profiles">
                  {% for option_value in profile_option.values %}
                    {% liquid
                      assign matched_profile_block = blank
                      assign option_key = option_value | strip | handleize
                      for profile_block in profile_blocks
                        assign profile_key = profile_block.settings.option_value | strip | handleize
                        if profile_key == option_key
                          assign matched_profile_block = profile_block
                          break
                        endif
                      endfor
                      assign profile_title = matched_profile_block.settings.title | default: option_value
                      assign profile_description = matched_profile_block.settings.description
                      assign profile_badge = matched_profile_block.settings.badge
                      assign profile_id = 'Profile-' | append: section.id | append: '-' | append: option_value | handleize
                    %}
                    <div class="leafer-substrate__choice" {% if matched_profile_block != blank %}{{ matched_profile_block.shopify_attributes }}{% endif %}>
                      <input
                        id="{{ profile_id }}"
                        type="radio"
                        name="LeaferProfile-{{ section.id }}"
                        value="{{ option_value | escape }}"
                        data-profile-choice
                        {% if option_value == selected_profile %}checked{% endif %}
                      >
                      <label for="{{ profile_id }}">
                        {% if profile_badge != blank %}<small>{{ profile_badge | escape }}</small>{% endif %}
                        <strong>{{ profile_title | escape }}</strong>
                        {% if profile_description != blank %}<span>{{ profile_description | escape }}</span>{% endif %}
                      </label>
                    </div>
                  {% endfor %}
                </div>
              </fieldset>

              <fieldset class="leafer-substrate__fieldset">
                <legend>{{ section.settings.volume_legend | escape }}</legend>
                <div class="leafer-substrate__options leafer-substrate__options--volumes">
                  {% for option_value in volume_option.values %}
                    {% assign volume_id = 'Volume-' | append: section.id | append: '-' | append: option_value | handleize %}
                    <div class="leafer-substrate__choice leafer-substrate__choice--volume">
                      <input
                        id="{{ volume_id }}"
                        type="radio"
                        name="LeaferVolume-{{ section.id }}"
                        value="{{ option_value | escape }}"
                        data-volume-choice
                        {% if option_value == selected_volume %}checked{% endif %}
                      >
                      <label for="{{ volume_id }}"><strong>{{ option_value | escape }}</strong></label>
                    </div>
                  {% endfor %}
                </div>
              </fieldset>
            </div>
          {% endif %}


          {% if selector_product != blank %}
            <details id="Profi-Konfigurator" class="leafer-substrate__advanced" data-substrate-advanced {% if request.page_type == 'index' %}open{% endif %}>
              <summary class="leafer-substrate__advanced-summary">
                <span>
                  <small>{{ 'configurator.advanced.eyebrow' | t }}</small>
                  <strong>{{ 'configurator.advanced.heading' | t }}</strong>
                  <em>{{ 'configurator.advanced.intro' | t }}</em>
                </span>
                <b aria-hidden="true">+</b>
              </summary>
              <div class="leafer-substrate__advanced-body">
            <section class="leafer-substrate__customizer" data-customizer aria-labelledby="LeaferCustomizerHeading-{{ section.id }}">
              <header class="leafer-substrate__customizer-head">
                <div>
                  <p class="leafer-substrate__eyebrow">{{ 'substrate_selector.customizer_eyebrow' | t }}</p>
                  <h2 id="LeaferCustomizerHeading-{{ section.id }}">{{ 'substrate_selector.customizer_heading' | t }}</h2>
                </div>
                <p>{{ 'substrate_selector.customizer_intro' | t }}</p>
              </header>
              <div class="leafer-substrate__customizer-grid">
                <div>
                  <div class="leafer-substrate__pot-slider" data-pot-slider role="group" aria-label="{{ 'substrate_selector.distribution_label' | t | escape }}">
                    {% for pot_index in (1..4) %}
                      <button type="button" class="leafer-substrate__pot-segment" data-pot-segment data-index="{{ forloop.index0 }}" data-order="{{ forloop.index0 }}" hidden aria-label="{{ 'substrate_selector.free_segment' | t | escape }} {{ forloop.index }}" aria-describedby="LeaferPotDragHint-{{ section.id }}"></button>
                    {% endfor %}
                    <span class="leafer-substrate__pot-rim" aria-hidden="true"></span>
                  </div>
                  <p class="leafer-substrate__customizer-total" data-customizer-total>0 % · 0 L</p>
                  <p class="leafer-substrate__pot-drag-hint" id="LeaferPotDragHint-{{ section.id }}">{{ 'substrate_selector.drag_hint' | t }}</p>
                </div>
                <div class="leafer-substrate__component-picker">
                  <div class="leafer-substrate__component-picker-head">
                    <strong>{{ 'substrate_selector.choose_components' | t }}</strong>
                    <span><b data-customizer-count>0</b>/4</span>
                  </div>
                  <div class="leafer-substrate__custom-options" role="region" tabindex="0" aria-label="{{ 'substrate_selector.choose_components' | t | escape }}">
                    {% assign custom_rendered_components = 0 %}
                    {% for component_product in component_products %}
                      {% if component_product.available and component_product.id != selector_product.id %}
                        {% liquid
                          assign component_label = component_product.title
                          if request.locale.iso_code == 'en' and component_product.title == 'Sphagnum-Moos – für Stecklinge & Aroiden'
                            assign component_label = 'live_labels.sphagnum' | t | replace: '&amp;', '&'
                          endif
                          assign component_profile = component_product.metafields.leaf_configurator.component_profile.value
                          assign component_profile_data = component_product.metafields.leaf_configurator.component_profile_data.value

                          assign pro_min = component_profile.pro_min_percent.value
                          if pro_min == blank and component_profile_data != blank
                            assign pro_min = component_profile_data.min_percent
                          endif
                          assign pro_min = pro_min | default: 0

                          assign pro_max = component_profile.pro_max_percent.value
                          if pro_max == blank and component_profile_data != blank
                            assign pro_max = component_profile_data.max_percent
                          endif
                          assign pro_max = pro_max | default: 100

                          assign warning_percent = component_profile.warning_percent.value | default: pro_max
                          assign pro_note = component_profile.technical_note.value

                          assign component_aeration = component_profile.aeration.value
                          if component_aeration == blank and component_profile_data != blank
                            assign component_aeration = component_profile_data.aeration
                          endif

                          assign component_drainage = component_profile.drainage.value
                          if component_drainage == blank and component_profile_data != blank
                            assign component_drainage = component_profile_data.drainage
                          endif

                          assign component_water_retention = component_profile.water_retention.value
                          if component_water_retention == blank and component_profile_data != blank
                            assign component_water_retention = component_profile_data.water_retention
                          endif

                          assign component_structure = component_profile.structure_stability.value
                          if component_structure == blank and component_profile_data != blank
                            assign component_structure = component_profile_data.structure
                          endif

                          assign component_nutrient = component_profile.nutrient_effect.value

                          assign show_pro_component = true
                          if component_profile != blank and component_profile.pro_enabled.value == false
                            assign show_pro_component = false
                          endif
                        %}
                        {% if show_pro_component %}
                        <button type="button" class="leafer-substrate__custom-option" data-custom-option data-name="{{ component_label | escape }}" data-pro-min="{{ pro_min }}" data-pro-max="{{ pro_max }}" data-warning="{{ warning_percent }}" data-aeration="{{ component_aeration }}" data-drainage="{{ component_drainage }}" data-water-retention="{{ component_water_retention }}" data-structure="{{ component_structure }}" data-nutrient="{{ component_nutrient }}" data-technical-note="{{ pro_note | escape }}" aria-pressed="false">
                          <span class="leafer-substrate__material-thumb" aria-hidden="true">
                            {% if component_product.featured_image != blank %}
                              {{ component_product.featured_image | image_url: width: 180 | image_tag: widths: '90, 180', sizes: '54px', loading: 'lazy', alt: '' }}
                            {% else %}
                              <span class="leafer-substrate__material-pattern"></span>
                            {% endif %}
                          </span>
                          <span class="leafer-substrate__custom-option-copy">
                            <strong>{{ component_label | escape }}</strong>
                            <small>{{ component_product.vendor | default: 'LEAFerservice' | escape }}</small>
                          </span>
                          <span class="leafer-substrate__custom-option-check" aria-hidden="true">+</span>
                        </button>
                        {% assign custom_rendered_components = custom_rendered_components | plus: 1 %}
                        {% if custom_rendered_components == 12 %}{% break %}{% endif %}
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                    {% if custom_rendered_components == 0 and component_products == blank %}
                      {% assign fallback_components = 'substrate_selector.fallback_components' | t | split: '|' %}
                      {% for fallback_component in fallback_components %}
                        <button type="button" class="leafer-substrate__custom-option" data-custom-option data-name="{{ fallback_component | escape }}" aria-pressed="false">
                          <span class="leafer-substrate__material-thumb leafer-substrate__material-thumb--generated" aria-hidden="true"><span class="leafer-substrate__material-pattern"></span></span>
                          <span class="leafer-substrate__custom-option-copy"><strong>{{ fallback_component | escape }}</strong><small>{{ 'substrate_selector.component_role' | t }}</small></span>
                          <span class="leafer-substrate__custom-option-check" aria-hidden="true">+</span>
                        </button>
                      {% endfor %}
                    {% endif %}
                  </div>
                  <p class="leafer-substrate__component-scroll-hint">{{ 'substrate_selector.component_scroll_hint' | t }}</p>
                  <div class="leafer-substrate__slider-list" data-custom-slider-list></div>
                  <p class="leafer-substrate__customizer-hint" data-customizer-hint>{{ 'substrate_selector.hint_empty' | t }}</p>
                  <div class="leafer-substrate__pro-feedback" data-pro-feedback hidden aria-live="polite"></div>
                </div>
              </div>
            </section>
              </div>
            </details>
          {% endif %}

          {% form 'product', selector_product, id: product_form_id, class: 'leafer-substrate__form js-leafer-cart-form' %}
            <p data-cart-error hidden role="alert"></p>
            {% if form.errors %}<div class="leafer-substrate__form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}

            <div class="leafer-substrate__native" data-native-field>
              <label for="Variant-{{ section.id }}">{{ section.settings.native_label | escape }}</label>
              <select id="Variant-{{ section.id }}" name="id" data-variant-select>
                {% for variant in selector_product.variants %}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price }}"
                    data-available="{{ variant.available }}"
                    {% if variant.id == selected_variant.id %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title | escape }} · {{ variant.price | money }}{% unless variant.available %} · {{ section.settings.sold_out_label | escape }}{% endunless %}
                  </option>
                {% endfor %}
              </select>
            </div>

            <input type="hidden" name="properties[Pflanzenprofil]" value="" data-property-profile disabled>
            <input type="hidden" name="properties[Menge]" value="" data-property-volume disabled>
            <input type="hidden" name="properties[Rezeptur]" value="" data-property-recipe disabled>
            <input type="hidden" name="properties[Rezepturstand]" value="" data-property-version disabled>

            <div class="leafer-substrate__selection-summary">
              <div>
                <span>{{ 'substrate_selector.selection' | t }}</span>
                <strong data-selection-summary>{{ selected_profile | escape }} · {{ selected_volume | escape }}</strong>
              </div>
              <strong class="leafer-substrate__selected-price" data-selected-price aria-live="polite">{{ selected_variant.price | money }}</strong>
            </div>

            <p class="leafer-substrate__availability" data-availability data-state="{% if selected_variant.available %}available{% else %}unavailable{% endif %}" aria-live="polite">
              {% if selected_variant.available %}{{ section.settings.available_label | escape }}{% else %}{{ section.settings.unavailable_label | escape }}{% endif %}
            </p>

            <p class="leafer-substrate__packing-note" role="note">
              {% if request.locale.iso_code == 'de' %}
                <strong>Einzeln verpackte Bestandteile:</strong> Deine ausgewählten Substratkomponenten werden getrennt portioniert und verpackt geliefert – nicht fertig vorgemischt. Du mischst sie selbst nach deiner Rezeptur. Je nach Umfang deiner Bestellung erfolgt der Versand in einem oder mehreren Paketen.
              {% else %}
                <strong>Individually packed ingredients:</strong> Your selected substrate components are portioned and packed separately, not pre-mixed. Combine them yourself using your recipe. Depending on the size of your order, delivery may consist of one or more parcels.
              {% endif %}
            </p>

            <div class="leafer-substrate__buy-row">
              <label for="Quantity-{{ section.id }}">
                <span>{{ section.settings.quantity_label | escape }}</span>
                <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric">
              </label>
              <button type="submit" name="add" data-submit {% unless selected_variant.available %}disabled{% endunless %}>
                {% if selected_variant.available %}{{ section.settings.add_label | escape }}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}
              </button>
            </div>
          {% endform %}

          <div class="leafer-substrate__reassurance" aria-label="{{ 'substrate_selector.reassurance_label' | t | escape }}">
            <span>✓ {{ 'substrate_selector.reassurance_price' | t }}</span>
            <span>✓ {{ 'substrate_selector.reassurance_recipe' | t }}</span>
            <span>✓ {{ 'substrate_selector.reassurance_claims' | t }}</span>
          </div>
        </div>

        <aside class="leafer-substrate__recipe-panel" aria-labelledby="LeaferRecipeHeading-{{ section.id }}">
          <header class="leafer-substrate__panel-head">
            <p class="leafer-substrate__eyebrow">{{ section.settings.recipe_eyebrow | escape }}</p>
            <h2 id="LeaferRecipeHeading-{{ section.id }}">{{ section.settings.recipe_heading | escape }}</h2>
            {% if section.settings.recipe_intro != blank %}<div class="rte">{{ section.settings.recipe_intro }}</div>{% endif %}
          </header>

          <p class="leafer-substrate__recipe-selection" data-recipe-selection>{{ selected_profile | escape }}{% if selected_profile != blank and selected_volume != blank %} · {% endif %}{{ selected_volume | escape }}</p>
          <p class="leafer-substrate__recipe-empty" data-recipe-empty>{{ 'substrate_selector.recipe_loading' | t }}</p>
          <div class="leafer-substrate__recipe-list" data-recipe-list aria-label="{{ 'substrate_selector.recipe_parts_label' | t | escape }}"></div>

          <dl class="leafer-substrate__recipe-meta">
            <div><dt>{{ 'substrate_selector.total' | t }}</dt><dd data-recipe-total>100 %</dd></div>
            <div><dt>{{ 'substrate_selector.calculation_basis' | t }}</dt><dd data-recipe-basis>{% if request.locale.iso_code == 'de' and recipe_matrix.basis != blank %}{{ recipe_matrix.basis | escape }}{% else %}{{ 'substrate_selector.volume_shares' | t }}{% endif %}</dd></div>
            <div><dt>{{ 'substrate_selector.recipe_version' | t }}</dt><dd data-recipe-version>{{ recipe_version | escape }}</dd></div>
          </dl>

          <ul class="leafer-substrate__recipe-notes" data-recipe-notes hidden></ul>



          <section class="leafer-substrate__base-recipe" data-base-recipe aria-labelledby="LeaferBaseRecipeHeading-{{ section.id }}">
            <p class="leafer-substrate__eyebrow">{{ 'substrate_selector.base_eyebrow' | t }}</p>
            <h3 id="LeaferBaseRecipeHeading-{{ section.id }}">{{ 'substrate_selector.base_heading' | t }}</h3>
            <p class="leafer-substrate__base-recipe-selection" data-base-recipe-selection>{{ selected_profile | escape }}{% if selected_profile != blank and selected_volume != blank %} · {% endif %}{{ selected_volume | escape }}</p>
            <p class="leafer-substrate__base-recipe-copy">{{ 'substrate_selector.base_copy' | t }}</p>
            <div class="leafer-substrate__recipe-list" data-base-recipe-list aria-label="{{ 'substrate_selector.base_parts_label' | t | escape }}"></div>
          </section>

          <section class="leafer-substrate__dynamic-insights" data-dynamic-insights aria-labelledby="LeaferDynamicInsightsHeading-{{ section.id }}">
            <p class="leafer-substrate__eyebrow">{{ 'substrate_selector.insights_eyebrow' | t }}</p>
            <h3 id="LeaferDynamicInsightsHeading-{{ section.id }}">{{ 'substrate_selector.insights_heading' | t }}</h3>
            <p class="leafer-substrate__insight-copy" data-insight-copy></p>
            <div class="leafer-substrate__insight-block">
              <strong>{{ 'substrate_selector.insights_plants' | t }}</strong>
              <div class="leafer-substrate__insight-chips" data-insight-plants></div>
            </div>
            <div class="leafer-substrate__insight-block">
              <strong>{{ 'substrate_selector.insights_properties' | t }}</strong>
              <ul data-insight-properties></ul>
            </div>
          </section>

          <noscript>
            <div class="leafer-substrate__noscript">
              <strong>{{ 'substrate_selector.noscript_heading' | t }}</strong>
              <p>{{ 'substrate_selector.noscript_text' | t }}</p>
            </div>
          </noscript>
        </aside>
      </div>

      {% if step_blocks.size > 0 %}
        <section class="leafer-substrate__steps page-width" aria-labelledby="LeaferStepsHeading-{{ section.id }}">
          <header class="leafer-substrate__section-head">
            <p class="leafer-substrate__eyebrow">{{ section.settings.steps_eyebrow | escape }}</p>
            <h2 id="LeaferStepsHeading-{{ section.id }}">{{ section.settings.steps_heading | escape }}</h2>
          </header>
          <ol>
            {% for block in step_blocks %}
              <li {{ block.shopify_attributes }}>
                <span aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
                <div>
                  <h3>{{ block.settings.heading | escape }}</h3>
                  {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
                </div>
              </li>
            {% endfor %}
          </ol>
        </section>
      {% endif %}

      {% if section.settings.show_description and selector_product.description != blank %}
        <section class="leafer-substrate__details page-width" aria-labelledby="LeaferDetailsHeading-{{ section.id }}">
          <header class="leafer-substrate__section-head">
            <p class="leafer-substrate__eyebrow">{{ section.settings.details_eyebrow | escape }}</p>
            <h2 id="LeaferDetailsHeading-{{ section.id }}">{{ section.settings.details_heading | escape }}</h2>
            {% if product_intro != blank %}<p>{{ product_intro | escape }}</p>{% endif %}
          </header>
          <div class="leafer-substrate__description rte">{{ selector_product.description }}</div>
        </section>
      {% endif %}

      {% if faq_blocks.size > 0 %}
        <section class="leafer-substrate__faq page-width" aria-labelledby="LeaferFaqHeading-{{ section.id }}">
          <header class="leafer-substrate__section-head">
            <p class="leafer-substrate__eyebrow">{{ section.settings.faq_eyebrow | escape }}</p>
            <h2 id="LeaferFaqHeading-{{ section.id }}">{{ section.settings.faq_heading | escape }}</h2>
          </header>
          <div class="leafer-substrate__faq-list">
            {% for block in faq_blocks %}
              <details {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question | escape }} <span aria-hidden="true">+</span></summary>
                <div class="rte">{{ block.settings.answer }}</div>
              </details>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if section.settings.show_components and has_components %}
        <section class="leafer-substrate__components page-width" aria-labelledby="LeaferComponentsHeading-{{ section.id }}">
          <header class="leafer-substrate__section-head">
            <p class="leafer-substrate__eyebrow">{{ section.settings.components_eyebrow | escape }}</p>
            <h2 id="LeaferComponentsHeading-{{ section.id }}">{{ section.settings.components_heading | escape }}</h2>
            {% if section.settings.components_text != blank %}<div class="rte">{{ section.settings.components_text }}</div>{% endif %}
          </header>
          <div class="leafer-substrate__component-grid">
            {% assign rendered_components = 0 %}
            {% for component_product in component_products %}
              {% if component_product.available and component_product.id != selector_product.id %}
                <a class="leafer-substrate__component-card" href="{{ component_product.url }}">
                  <div class="leafer-substrate__component-image">
                    {% if component_product.featured_image != blank %}
                      {{ component_product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 360, 480, 640', sizes: '(min-width: 990px) 30vw, (min-width: 620px) 45vw, 90vw', alt: component_product.featured_image.alt | default: component_product.title }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {% endif %}
                  </div>
                  <div class="leafer-substrate__component-copy">
                    <span>{{ component_product.vendor | default: 'LEAFerservice' | escape }}</span>
                    <h3>{{ component_product.title | escape }}</h3>
                    <strong>{{ component_product.price | money }}</strong>
                  </div>
                </a>
                {% assign rendered_components = rendered_components | plus: 1 %}
                {% if rendered_components == 6 %}{% break %}{% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </section>
      {% endif %}
    </div>

    <script type="application/json" data-variants>
      [
        {% for variant in selector_product.variants %}
          {% assign variant_is_last = forloop.last %}
          {
            "id": {{ variant.id | json }},
            "title": {{ variant.title | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | json }},
            "options": {
              {% for option_value in variant.options %}
                {% assign option_name = selector_product.options[forloop.index0] %}
                {{ option_name | json }}: {{ option_value | json }}{% unless forloop.last %},{% endunless %}
              {% endfor %}
            }
          }{% unless variant_is_last %},{% endunless %}
        {% endfor %}
      ]
    </script>
    <script type="application/json" data-recipe-matrix>{{ recipe_matrix | json }}</script>
    <script type="application/json" data-selector-i18n>
      {
        "hint_empty": {{ 'substrate_selector.hint_empty' | t | json }},
        "hint_limit": {{ 'substrate_selector.hint_limit' | t | json }},
        "hint_adjust": {{ 'substrate_selector.hint_adjust' | t | json }},
        "warning_max": {{ 'substrate_selector.warning_max' | t | json }},
        "warning_threshold": {{ 'substrate_selector.warning_threshold' | t | json }},
        "feedback_warning": {{ 'substrate_selector.feedback_warning' | t | json }},
        "feedback_ok": {{ 'substrate_selector.feedback_ok' | t | json }},
        "metric_aeration": {{ 'substrate_selector.metric_aeration' | t | json }},
        "metric_drainage": {{ 'substrate_selector.metric_drainage' | t | json }},
        "metric_water": {{ 'substrate_selector.metric_water' | t | json }},
        "metric_structure": {{ 'substrate_selector.metric_structure' | t | json }},
        "metric_nutrient": {{ 'substrate_selector.metric_nutrient' | t | json }},
        "segment_percent": {{ 'substrate_selector.segment_percent' | t | json }},
        "free_segment": {{ 'substrate_selector.free_segment' | t | json }},
        "custom_basis": {{ 'substrate_selector.custom_basis' | t | json }},
        "custom_version": {{ 'substrate_selector.custom_version' | t | json }},
        "insight_default_plants": {{ 'substrate_selector.insight_default_plants' | t | json }},
        "insight_default_properties": {{ 'substrate_selector.insight_default_properties' | t | json }},
        "insight_default_copy": {{ 'substrate_selector.insight_default_copy' | t | json }},
        "insight_aroid_plants": {{ 'substrate_selector.insight_aroid_plants' | t | json }},
        "insight_aroid_properties": {{ 'substrate_selector.insight_aroid_properties' | t | json }},
        "insight_aroid_copy": {{ 'substrate_selector.insight_aroid_copy' | t | json }},
        "insight_herb_plants": {{ 'substrate_selector.insight_herb_plants' | t | json }},
        "insight_herb_properties": {{ 'substrate_selector.insight_herb_properties' | t | json }},
        "insight_herb_copy": {{ 'substrate_selector.insight_herb_copy' | t | json }},
        "insight_cactus_plants": {{ 'substrate_selector.insight_cactus_plants' | t | json }},
        "insight_cactus_properties": {{ 'substrate_selector.insight_cactus_properties' | t | json }},
        "insight_cactus_copy": {{ 'substrate_selector.insight_cactus_copy' | t | json }},
        "insight_orchid_plants": {{ 'substrate_selector.insight_orchid_plants' | t | json }},
        "insight_orchid_properties": {{ 'substrate_selector.insight_orchid_properties' | t | json }},
        "insight_orchid_copy": {{ 'substrate_selector.insight_orchid_copy' | t | json }},
        "insight_palm_plants": {{ 'substrate_selector.insight_palm_plants' | t | json }},
        "insight_palm_properties": {{ 'substrate_selector.insight_palm_properties' | t | json }},
        "insight_palm_copy": {{ 'substrate_selector.insight_palm_copy' | t | json }},
        "insight_seed_plants": {{ 'substrate_selector.insight_seed_plants' | t | json }},
        "insight_seed_properties": {{ 'substrate_selector.insight_seed_properties' | t | json }},
        "insight_seed_copy": {{ 'substrate_selector.insight_seed_copy' | t | json }},
        "addition_drainage": {{ 'substrate_selector.addition_drainage' | t | json }},
        "addition_moisture": {{ 'substrate_selector.addition_moisture' | t | json }},
        "addition_bark": {{ 'substrate_selector.addition_bark' | t | json }},
        "addition_nutrient": {{ 'substrate_selector.addition_nutrient' | t | json }},
        "addition_ph": {{ 'substrate_selector.addition_ph' | t | json }},
        "addition_root": {{ 'substrate_selector.addition_root' | t | json }}
      }
    </script>
  {% endif %}
</leafer-substrate-selector>

{% stylesheet %}
  .leafer-substrate { display: block; background: var(--background); color: var(--text); }
  .leafer-substrate__page { padding-block: var(--leafer-selector-top) var(--leafer-selector-bottom); }
  .leafer-substrate__empty { padding-block: clamp(4rem, 10vw, 8rem); }
  .leafer-substrate__empty h1, .leafer-substrate__empty h2 { max-width: 28ch; margin: 0; font-size: clamp(1.8rem, 3.2vw, 2.75rem); line-height: 1.2; letter-spacing: -.025em; }
  .leafer-substrate__eyebrow { margin: 0 0 .65rem; color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .leafer-substrate__hero { display: grid; grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .leafer-substrate__hero-copy { max-width: 720px; }
  .leafer-substrate__hero h1, .leafer-substrate__hero h2 { max-width: 28ch; margin: 0; font-size: clamp(1.8rem, 3.2vw, 2.75rem); line-height: 1.2; letter-spacing: -.025em; }
  .leafer-substrate__intro { max-width: 62ch; margin-top: 1.35rem; font-size: clamp(1.05rem, 1.8vw, 1.25rem); }
  .leafer-substrate__product-subtitle { max-width: 58ch; margin: 1rem 0 0; color: var(--muted); font-weight: 700; }
  .leafer-substrate__signals { margin: 1.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .55rem; list-style: none; }
  .leafer-substrate__signals li { padding: .55rem .75rem; border: 1px solid var(--border); border-radius: 999px; background: color-mix(in srgb, var(--surface), transparent 12%); font-size: .78rem; font-weight: 750; }
  .leafer-substrate__price-range { margin: 1.5rem 0 0; display: flex; align-items: baseline; gap: .75rem; }
  .leafer-substrate__price-range span { color: var(--muted); font-size: .78rem; }
  .leafer-substrate__price-range strong { font-size: 1.25rem; }
  .leafer-substrate__hero-media { aspect-ratio: 5 / 4; display: grid; place-items: center; overflow: hidden; padding: clamp(1rem, 4vw, 3rem); border: 1px solid var(--border); border-radius: var(--radius-large); background: #f3efe5; }
  .leafer-substrate__hero-media img, .leafer-substrate__hero-media svg { width: 100%; height: 100%; object-fit: contain; object-position: center; }

  .leafer-substrate__commerce { margin-top: clamp(3rem, 8vw, 7rem); display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr); gap: clamp(1rem, 3vw, 2rem); align-items: start; }
  .leafer-substrate__purchase-panel, .leafer-substrate__recipe-panel { min-width: 0; padding: clamp(1.25rem, 3vw, 2.25rem); border: 1px solid var(--border); border-radius: var(--radius-large); }
  .leafer-substrate__purchase-panel { background: var(--surface); }
  .leafer-substrate__recipe-panel { position: sticky; top: 1rem; background: linear-gradient(145deg, var(--text), color-mix(in srgb, var(--text), var(--accent) 18%)); color: var(--background); box-shadow: 0 18px 48px color-mix(in srgb, var(--text), transparent 82%); }
  .leafer-substrate__recipe-panel .leafer-substrate__eyebrow { color: var(--accent-soft); }
  .leafer-substrate__panel-head h2, .leafer-substrate__section-head h2 { margin: 0; font-size: clamp(1.35rem, 2.6vw, 1.9rem); line-height: 1.2; letter-spacing: -.025em; }
  .leafer-substrate__progress { margin-top: 1.25rem; padding: .65rem .8rem; display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; border: 1px solid var(--border); border-radius: 999px; background: color-mix(in srgb, var(--background), transparent 15%); color: var(--muted); font-size: .7rem; font-weight: 800; }
  .leafer-substrate__progress span { display: inline-flex; align-items: center; gap: .4rem; white-space: nowrap; }
  .leafer-substrate__progress b { width: 1.45rem; height: 1.45rem; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--text), transparent 84%); color: var(--text); font-size: .68rem; }
  .leafer-substrate__progress span.is-active b { background: var(--accent); color: var(--background); }
  .leafer-substrate__progress em { font-style: normal; }
  .leafer-substrate__progress i { color: var(--accent); font-style: normal; }
  .leafer-substrate__recipe-selection { margin: 1rem 0 0; color: var(--accent-soft); font-size: .78rem; font-weight: 850; letter-spacing: .04em; text-transform: uppercase; }
  .leafer-substrate__panel-head .rte, .leafer-substrate__section-head > p, .leafer-substrate__section-head .rte { max-width: 66ch; margin-top: .9rem; color: var(--muted); }
  .leafer-substrate__recipe-panel .leafer-substrate__panel-head .rte { color: color-mix(in srgb, var(--background), transparent 25%); }
  .leafer-substrate__enhanced { display: none; margin-top: 2rem; gap: 1.6rem; }
  .leafer-substrate[data-enhanced="true"] .leafer-substrate__enhanced { display: grid; }
  .leafer-substrate__fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .leafer-substrate__fieldset legend { margin-bottom: .75rem; padding: 0; font-weight: 850; }
  .leafer-substrate__options { display: grid; gap: .65rem; }
  .leafer-substrate__options--profiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .leafer-substrate__options--volumes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .leafer-substrate__choice { position: relative; min-width: 0; }
  .leafer-substrate__choice input { position: absolute; width: 1px; height: 1px; overflow: hidden; opacity: 0; }
  .leafer-substrate__choice label { min-height: 0; display: flex; flex-direction: column; justify-content: flex-start; gap: .38rem; padding: .85rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--background); cursor: pointer; transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease; }
  .leafer-substrate__choice label small { color: var(--accent); font-size: .64rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .leafer-substrate__choice label strong { font-size: .92rem; line-height: 1.2; }
  .leafer-substrate__choice label span { display: block; color: var(--muted); font-size: .8rem; line-height: 1.45; }
  .leafer-substrate__choice input:checked + label { border-color: var(--accent); background: color-mix(in srgb, var(--accent), transparent 93%); box-shadow: inset 0 0 0 1px var(--accent); }
  .leafer-substrate__choice input:focus-visible + label { outline: 3px solid color-mix(in srgb, var(--accent), white 35%); outline-offset: 3px; }
  .leafer-substrate__choice--volume label { min-height: 58px; align-items: center; padding: .75rem; text-align: center; }
  .leafer-substrate__choice--volume label strong { font-size: 1rem; }
  .leafer-substrate__form { margin-top: 1.5rem; display: grid; gap: 1rem; }
  .leafer-substrate__native { display: grid; gap: .45rem; }
  .leafer-substrate__native[hidden] { display: none; }
  .leafer-substrate__native label, .leafer-substrate__buy-row label > span { font-size: .78rem; font-weight: 800; }
  .leafer-substrate__native select, .leafer-substrate__buy-row input { width: 100%; min-height: 48px; border: 1px solid var(--border); border-radius: 10px; background: var(--background); padding: .7rem .85rem; }
  .leafer-substrate__form-error { padding: .9rem; border: 1px solid #a44; border-radius: var(--radius); background: #fff4f2; color: #6d2119; }
  .leafer-substrate__selection-summary { padding: 1rem 0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-block: 1px solid var(--border); }
  .leafer-substrate__selection-summary > div { min-width: 0; }
  .leafer-substrate__selection-summary > div strong { overflow-wrap: anywhere; }
  .leafer-substrate__selection-summary span, .leafer-substrate__selection-summary strong { display: block; }
  .leafer-substrate__selection-summary span { color: var(--muted); font-size: .72rem; }
  .leafer-substrate__selection-summary > div strong { margin-top: .2rem; }
  .leafer-substrate__selected-price { flex: 0 0 auto; font-size: 1.35rem; }
  .leafer-substrate__availability { margin: 0; display: flex; align-items: center; gap: .5rem; font-size: .82rem; font-weight: 750; }
  .leafer-substrate__availability::before { width: .62rem; height: .62rem; border-radius: 50%; background: #8b4b3d; content: ''; }
  .leafer-substrate__availability[data-state="available"]::before { background: var(--accent); }
  .leafer-substrate__buy-row { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: .7rem; align-items: end; }
  .leafer-substrate__buy-row label { display: grid; gap: .4rem; }
  .leafer-substrate__buy-row button { width: 100%; min-height: 52px; padding-inline: 1rem; }
  .leafer-substrate__buy-row button[disabled] { cursor: not-allowed; opacity: .5; transform: none; box-shadow: none; }
  .leafer-substrate__reassurance { margin-top: 1.2rem; display: grid; gap: .45rem; color: var(--muted); font-size: .74rem; }



  .leafer-substrate__base-recipe { margin-top: 1.5rem; padding: 1rem; border: 1px solid color-mix(in srgb, var(--background), transparent 75%); border-radius: var(--radius); background: color-mix(in srgb, var(--background), transparent 92%); }
  .leafer-substrate__base-recipe h3 { margin: 0; font-size: 1.15rem; line-height: 1.15; letter-spacing: -.025em; }
  .leafer-substrate__base-recipe-selection { margin: .55rem 0 0; color: var(--accent-soft); font-size: .72rem; font-weight: 850; text-transform: uppercase; }
  .leafer-substrate__base-recipe-copy { margin: .55rem 0 0; color: color-mix(in srgb, var(--background), transparent 28%); font-size: .75rem; line-height: 1.45; }
  .leafer-substrate__base-recipe .leafer-substrate__recipe-list { margin-top: 1rem; }

  .leafer-substrate__dynamic-insights { margin-top: 1.35rem; padding-top: 1.2rem; border-top: 1px solid color-mix(in srgb, var(--background), transparent 78%); }
  .leafer-substrate__dynamic-insights h3 { margin: 0; font-size: 1.35rem; line-height: 1.1; letter-spacing: -.03em; }
  .leafer-substrate__insight-copy { margin: .65rem 0 0; color: color-mix(in srgb, var(--background), transparent 25%); font-size: .8rem; line-height: 1.5; }
  .leafer-substrate__insight-block { margin-top: 1rem; }
  .leafer-substrate__insight-block > strong { display: block; margin-bottom: .5rem; font-size: .75rem; }
  .leafer-substrate__insight-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .leafer-substrate__insight-chips span { padding: .38rem .6rem; border: 1px solid color-mix(in srgb, var(--background), transparent 68%); border-radius: 999px; color: var(--background); font-size: .72rem; font-weight: 750; }
  .leafer-substrate__insight-block ul { margin: 0; padding-left: 1.1rem; color: color-mix(in srgb, var(--background), transparent 20%); font-size: .78rem; line-height: 1.55; }

  .leafer-substrate__recipe-empty { margin: 1.5rem 0 0; color: color-mix(in srgb, var(--background), transparent 30%); }
  .leafer-substrate__recipe-list { margin-top: 1.5rem; display: grid; gap: .85rem; }
  .leafer-substrate__recipe-row { display: grid; gap: .4rem; }
  .leafer-substrate__recipe-row-head { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .leafer-substrate__recipe-row-head strong { font-size: .9rem; }
  .leafer-substrate__recipe-values { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .65rem; color: color-mix(in srgb, var(--background), transparent 25%); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .leafer-substrate__recipe-bar { height: 7px; overflow: hidden; border-radius: 999px; background: color-mix(in srgb, var(--background), transparent 88%); }
  .leafer-substrate__recipe-bar span { width: var(--share, 0%); height: 100%; display: block; border-radius: inherit; background: var(--accent-soft); transition: width .3s var(--ease-out); }
  .leafer-substrate__recipe-meta { margin: 1.5rem 0 0; border-top: 1px solid color-mix(in srgb, var(--background), transparent 78%); }
  .leafer-substrate__recipe-meta div { padding-block: .75rem; display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid color-mix(in srgb, var(--background), transparent 86%); }
  .leafer-substrate__recipe-meta dt { color: color-mix(in srgb, var(--background), transparent 35%); font-size: .74rem; }
  .leafer-substrate__recipe-meta dd { margin: 0; font-size: .8rem; font-weight: 800; text-align: right; }
  .leafer-substrate__recipe-notes { margin: 1rem 0 0; padding: .9rem 1rem .9rem 2rem; border-radius: var(--radius); background: color-mix(in srgb, var(--background), transparent 92%); font-size: .75rem; }
  .leafer-substrate__recipe-notes li + li { margin-top: .45rem; }
  .leafer-substrate__noscript { margin-top: 1rem; padding: .9rem; border: 1px solid color-mix(in srgb, var(--background), transparent 72%); border-radius: var(--radius); }
  .leafer-substrate__noscript p { margin-bottom: 0; }


  .leafer-substrate__advanced { margin-top: 1.5rem; border: 1px solid var(--border); background: color-mix(in srgb, var(--background), var(--accent) 2%); }
  .leafer-substrate__advanced-summary { min-height: 72px; padding: 1rem 1.1rem; display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: center; cursor: pointer; list-style: none; }
  .leafer-substrate__advanced-summary::-webkit-details-marker { display: none; }
  .leafer-substrate__advanced-summary span, .leafer-substrate__advanced-summary small, .leafer-substrate__advanced-summary strong, .leafer-substrate__advanced-summary em { display: block; }
  .leafer-substrate__advanced-summary small { color: var(--accent); font-size: .68rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .leafer-substrate__advanced-summary strong { margin-top: .2rem; font-size: 1rem; }
  .leafer-substrate__advanced-summary em { margin-top: .25rem; color: var(--muted); font-size: .75rem; font-style: normal; line-height: 1.45; }
  .leafer-substrate__advanced-summary b { font-size: 1.35rem; font-weight: 500; transition: transform .2s ease; }
  .leafer-substrate__advanced[open] .leafer-substrate__advanced-summary b { transform: rotate(45deg); }
  .leafer-substrate__advanced-body { padding: 0 1rem 1rem; }
  .leafer-substrate__customizer { margin-top: 0; padding: 1.2rem; border: 1px solid var(--border); border-radius: 0; background: color-mix(in srgb, var(--background), var(--accent) 4%); }
