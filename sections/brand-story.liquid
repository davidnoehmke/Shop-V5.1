<section class="brand-story page-width" aria-labelledby="BrandStory-{{ section.id }}">
  <div class="brand-story__identity">
    <div class="brand-story__mark" aria-hidden="true">DN</div>
    <p class="brand-story__signature">David Nöhmke</p>
    <p class="brand-story__role">{{ 'brand_story.role' | t }}</p>
  </div>
  <div class="brand-story__copy">
    <p class="brand-story__eyebrow">{{ 'brand_story.eyebrow' | t }}</p>
    <h2 id="BrandStory-{{ section.id }}">{{ 'brand_story.heading' | t }}</h2>
    <div class="brand-story__columns">
      <p>{{ 'brand_story.text_one' | t }}</p>
      <p>{{ 'brand_story.text_two' | t }}</p>
    </div>
    <div class="brand-story__proof" aria-label="{{ 'brand_story.proof_label' | t }}">
      <span>{{ 'brand_story.proof_one' | t }}</span>
      <span>{{ 'brand_story.proof_two' | t }}</span>
      <span>{{ 'brand_story.proof_three' | t }}</span>
    </div>
    <a class="brand-story__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ 'brand_story.link' | t }}</a>
  </div>
</section>

{% stylesheet %}
  .brand-story { margin-block: var(--space-section); padding-block: clamp(2.5rem, 5vw, 5.5rem); display: grid; grid-template-columns: minmax(220px, .42fr) minmax(0, 1.58fr); gap: clamp(3rem, 7vw, 8rem); align-items: start; border-block: 1px solid var(--border); }
  .brand-story__identity { position: sticky; top: 7rem; display: grid; justify-items: start; }
  .brand-story__mark { width: clamp(118px, 11vw, 164px); aspect-ratio: 1; display: grid; place-items: center; background: var(--accent); color: var(--background); font-family: var(--heading-font); font-size: clamp(2.2rem, 3.5vw, 3.4rem); font-weight: 700; letter-spacing: -.08em; }
  .brand-story__signature { margin: 1.15rem 0 .15rem; font-family: var(--heading-font); font-size: clamp(1.45rem, 2vw, 2rem); font-weight: 650; letter-spacing: -.035em; }
  .brand-story__role { margin: 0; color: var(--muted); font-size: .78rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
  .brand-story__eyebrow { margin: 0; color: var(--accent); font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .brand-story h2 { max-width: 920px; margin: .5rem 0 2rem; font-size: clamp(1.35rem, 2.6vw, 1.9rem); line-height: 1.2; letter-spacing: -.025em; }
  .brand-story__columns { max-width: 980px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); color: var(--muted); }
  .brand-story__columns p { margin: 0; font-size: clamp(1rem, 1.25vw, 1.12rem); line-height: 1.7; }
  .brand-story__proof { max-width: 980px; margin-top: 2rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--border); }
  .brand-story__proof span { min-height: 72px; display: flex; align-items: center; padding: .85rem 1rem; font-size: .78rem; font-weight: 750; }
  .brand-story__proof span + span { border-left: 1px solid var(--border); }
  .brand-story__link { margin-top: 1.5rem; min-height: 48px; padding-inline: 1.5rem; display: inline-flex; align-items: center; border: 1px solid var(--accent); color: var(--accent); font-weight: 750; text-decoration: none; }
  @media (max-width: 760px) { .brand-story { grid-template-columns: 1fr; gap: 2rem; } .brand-story__identity { position: static; grid-template-columns: 88px 1fr; column-gap: 1rem; align-items: end; } .brand-story__mark { width: 88px; grid-row: 1 / span 2; font-size: 1.75rem; } .brand-story__signature { margin: 0; } .brand-story__role { align-self: start; } .brand-story__columns, .brand-story__proof { grid-template-columns: 1fr; } .brand-story__proof span + span { border-left: 0; border-top: 1px solid var(--border); } }
{% endstylesheet %}

{% schema %}
{
  "name": "LEAFerservice Markenstory",
  "settings": [{ "type": "url", "id": "link", "label": "Ziel des Links" }],
  "presets": [{ "name": "LEAFerservice Markenstory" }]
}
{% endschema %}
