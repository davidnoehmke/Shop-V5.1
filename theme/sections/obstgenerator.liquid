{% liquid
  assign featured_product = product
  if section.settings.product != blank
    assign featured_product = section.settings.product
  endif

  assign selected_variant = blank
  if featured_product != blank
    assign selected_variant = featured_product.selected_or_first_available_variant
  endif

  assign hero_image = section.settings.image
  if hero_image == blank
    assign hero_image = featured_product.featured_image
  endif

  assign variety_blocks = section.blocks | where: 'type', 'variety'
  assign included_blocks = section.blocks | where: 'type', 'included'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign form_id = 'LeaferFruitForm-' | append: section.id
%}

<section
  class="leafer-fruit"
  data-leafer-fruit
  style="
    --lf-bg: {{ section.settings.background }};
    --lf-surface: {{ section.settings.surface }};
    --lf-text: {{ section.settings.text_color }};
    --lf-muted: {{ section.settings.muted_color }};
    --lf-accent: {{ section.settings.accent }};
    --lf-accent-contrast: {{ section.settings.accent_contrast }};
    --lf-border: {{ section.settings.border_color }};
    --lf-radius: {{ section.settings.radius }}px;
    --lf-max: {{ section.settings.max_width }}px;
    --lf-pad-y: {{ section.settings.padding_y }}px;
  "
>
  <div class="leafer-fruit__shell">
    <div class="leafer-fruit__hero">
      <div class="leafer-fruit__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="leafer-fruit__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="leafer-fruit__title">{{ section.settings.heading }}</h1>
        {% endif %}

        {% if section.settings.intro != blank %}
          <div class="leafer-fruit__intro rte">{{ section.settings.intro }}</div>
        {% endif %}

        <div class="leafer-fruit__trust" aria-label="{{ section.settings.trust_aria_label | escape }}">
          {% if section.settings.trust_1 != blank %}
            <span>{{ section.settings.trust_1 | escape }}</span>
          {% endif %}
          {% if section.settings.trust_2 != blank %}
            <span>{{ section.settings.trust_2 | escape }}</span>
          {% endif %}
          {% if section.settings.trust_3 != blank %}
            <span>{{ section.settings.trust_3 | escape }}</span>
          {% endif %}
        </div>

        {% if featured_product != blank %}
          <div class="leafer-fruit__buybox" id="LeaferFruitBuybox-{{ section.id }}">
            <div class="leafer-fruit__buybox-head">
              <div>
                <p class="leafer-fruit__buybox-label">{{ section.settings.product_label | escape }}</p>
                <h2 class="leafer-fruit__product-title">{{ featured_product.title | escape }}</h2>
              </div>
              <p
                class="leafer-fruit__price"
                data-product-price
                aria-live="polite"
                aria-label="{{ section.settings.price_label | escape }}"
              >
                {{ selected_variant.price | money }}
              </p>
            </div>

            {% form 'product', featured_product, id: form_id, class: 'leafer-fruit__form' %}
              <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-input>

              {% if featured_product.variants.size > 1 %}
                <fieldset class="leafer-fruit__variant-fieldset">
                  <legend>{{ section.settings.variant_legend | escape }}</legend>
                  <div class="leafer-fruit__variant-grid">
                    {% for variant in featured_product.variants %}
                      <div class="leafer-fruit__variant-choice">
                        <input
                          class="leafer-fruit__variant-radio"
                          type="radio"
                          id="LeaferFruitVariant-{{ section.id }}-{{ variant.id }}"
                          name="LeaferFruitVariant-{{ section.id }}"
                          value="{{ variant.id }}"
                          data-variant-radio
                          data-variant-title="{{ variant.title | escape }}"
                          data-price="{{ variant.price | money | escape }}"
                          data-available="{{ variant.available }}"
                          data-available-label="{{ section.settings.available_label | escape }}"
                          data-sold-out-label="{{ section.settings.sold_out_label | escape }}"
                          data-add-button-label="{{ section.settings.add_to_cart_label | escape }}"
                          {% if variant.id == selected_variant.id %}
                            checked
                          {% endif %}
                          {% unless variant.available %}
                            disabled
                          {% endunless %}
                        >
                        <label for="LeaferFruitVariant-{{ section.id }}-{{ variant.id }}">
                          <span>{{ variant.title | escape }}</span>
                          <small>
                            {{ variant.price | money }}
                            {% unless variant.available %}
                              · {{ section.settings.sold_out_label | escape }}
                            {% endunless %}
                          </small>
                        </label>
                      </div>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endif %}

              <div class="leafer-fruit__purchase-row">
                <div class="leafer-fruit__quantity">
                  <label for="LeaferFruitQuantity-{{ section.id }}">
                    {{ section.settings.quantity_label | escape }}
                  </label>
                  <div class="leafer-fruit__quantity-control">
                    <button
                      type="button"
                      data-quantity-minus
                      aria-label="{{ section.settings.quantity_minus_label | escape }}"
                    >
                      −
                    </button>
                    <input
                      id="LeaferFruitQuantity-{{ section.id }}"
                      type="number"
                      name="quantity"
                      value="1"
                      min="1"
                      inputmode="numeric"
                      data-quantity-input
                    >
                    <button
                      type="button"
                      data-quantity-plus
                      aria-label="{{ section.settings.quantity_plus_label | escape }}"
                    >
                      +
                    </button>
                  </div>
                </div>

                <button
                  class="leafer-fruit__add"
                  type="submit"
                  name="add"
                  data-add-button
                  {% unless selected_variant.available %}
                    disabled
                  {% endunless %}
                >
                  <span data-add-label>
                    {% if selected_variant.available %}
                      {{ section.settings.add_to_cart_label | escape }}
                    {% else %}
                      {{ section.settings.sold_out_label | escape }}
                    {% endif %}
                  </span>
                </button>
              </div>

              <p class="leafer-fruit__availability" data-availability aria-live="polite">
                {% if selected_variant.available %}
                  {{ section.settings.available_label | escape }}
                {% else %}
                  {{ section.settings.sold_out_label | escape }}
                {% endif %}
              </p>
            {% endform %}
          </div>
        {% else %}
          <div class="leafer-fruit__empty">
            <strong>{{ section.settings.empty_title | escape }}</strong>
            <p>{{ section.settings.empty_text | escape }}</p>
          </div>
        {% endif %}
      </div>

      <div class="leafer-fruit__visual">
        <div class="leafer-fruit__image-wrap">
          {% if hero_image != blank %}
            {{
              hero_image
              | image_url: width: 1800
              | image_tag:
                class: 'leafer-fruit__image',
                widths: '480, 720, 960, 1200, 1600, 1800',
                sizes: '(min-width: 990px) 46vw, 100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: section.settings.image_alt
            }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'leafer-fruit__placeholder' }}
          {% endif %}
        </div>

        {% if section.settings.image_note != blank %}
          <p class="leafer-fruit__image-note">{{ section.settings.image_note | escape }}</p>
        {% endif %}
      </div>
    </div>

    {% if variety_blocks.size > 0 %}
      <div class="leafer-fruit__section leafer-fruit__section--varieties">
        <div class="leafer-fruit__section-head">
          <p class="leafer-fruit__eyebrow">{{ section.settings.varieties_eyebrow | escape }}</p>
          <h2>{{ section.settings.varieties_heading | escape }}</h2>
          <div class="rte">{{ section.settings.varieties_intro }}</div>
        </div>

        <div class="leafer-fruit__varieties">
          {% for block in variety_blocks %}
            <article class="leafer-fruit__variety" {{ block.shopify_attributes }}>
              <button
                class="leafer-fruit__variety-button"
                type="button"
                data-variety-select
                data-variant-title="{{ block.settings.variant_title | escape }}"
                aria-pressed="false"
              >
                <span class="leafer-fruit__variety-top">
                  <span class="leafer-fruit__badge">{{ block.settings.badge | escape }}</span>
                  <span class="leafer-fruit__select-cue">{{ section.settings.select_cue | escape }}</span>
                </span>
                <strong>{{ block.settings.heading | escape }}</strong>
                {% if block.settings.botanical_name != blank %}
                  <em>{{ block.settings.botanical_name | escape }}</em>
                {% endif %}
                <span class="leafer-fruit__variety-copy">{{ block.settings.description }}</span>
                <span class="leafer-fruit__facts">
                  {% if block.settings.prep != blank %}
                    <span>
                      <small>{{ section.settings.prep_label | escape }}</small>
                      {{ block.settings.prep | escape }}
                    </span>
                  {% endif %}
                  {% if block.settings.location != blank %}
                    <span>
                      <small>{{ section.settings.location_label | escape }}</small>
                      {{ block.settings.location | escape }}
                    </span>
                  {% endif %}
                  {% if block.settings.level != blank %}
                    <span>
                      <small>{{ section.settings.level_label | escape }}</small>
                      {{ block.settings.level | escape }}
                    </span>
                  {% endif %}
                </span>
              </button>
            </article>
          {% endfor %}
        </div>

        <aside class="leafer-fruit__notice" aria-label="{{ section.settings.notice_aria_label | escape }}">
          <div class="leafer-fruit__notice-icon" aria-hidden="true">i</div>
          <div>
            <h3>{{ section.settings.notice_heading | escape }}</h3>
            <div class="rte">{{ section.settings.notice_text }}</div>
          </div>
        </aside>
      </div>
    {% endif %}

    {% if included_blocks.size > 0 %}
      <div class="leafer-fruit__section">
        <div class="leafer-fruit__section-head leafer-fruit__section-head--center">
          <p class="leafer-fruit__eyebrow">{{ section.settings.included_eyebrow | escape }}</p>
          <h2>{{ section.settings.included_heading | escape }}</h2>
          <div class="rte">{{ section.settings.included_intro }}</div>
        </div>

        <div class="leafer-fruit__included-grid">
          {% for block in included_blocks %}
            <article class="leafer-fruit__info-card" {{ block.shopify_attributes }}>
              <span class="leafer-fruit__info-index">{{ forloop.index | prepend: '0' }}</span>
              <h3>{{ block.settings.heading | escape }}</h3>
              <div class="rte">{{ block.settings.text }}</div>
            </article>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if step_blocks.size > 0 %}
      <div class="leafer-fruit__section leafer-fruit__section--steps">
        <div class="leafer-fruit__section-head">
          <p class="leafer-fruit__eyebrow">{{ section.settings.steps_eyebrow | escape }}</p>
          <h2>{{ section.settings.steps_heading | escape }}</h2>
          <div class="rte">{{ section.settings.steps_intro }}</div>
        </div>

        <ol class="leafer-fruit__steps">
          {% for block in step_blocks %}
            <li {{ block.shopify_attributes }}>
              <span>{{ forloop.index }}</span>
              <div>
                <h3>{{ block.settings.heading | escape }}</h3>
                <div class="rte">{{ block.settings.text }}</div>
              </div>
            </li>
          {% endfor %}
        </ol>
      </div>
    {% endif %}

    {% if benefit_blocks.size > 0 %}
      <div class="leafer-fruit__section">
        <div class="leafer-fruit__section-head leafer-fruit__section-head--center">
          <p class="leafer-fruit__eyebrow">{{ section.settings.benefits_eyebrow | escape }}</p>
          <h2>{{ section.settings.benefits_heading | escape }}</h2>
        </div>

        <div class="leafer-fruit__benefits">
          {% for block in benefit_blocks %}
            <article {{ block.shopify_attributes }}>
              <span aria-hidden="true">✓</span>
              <div>
                <h3>{{ block.settings.heading | escape }}</h3>
                <div class="rte">{{ block.settings.text }}</div>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if faq_blocks.size > 0 %}
      <div class="leafer-fruit__section leafer-fruit__faq-wrap">
        <div class="leafer-fruit__section-head">
          <p class="leafer-fruit__eyebrow">{{ section.settings.faq_eyebrow | escape }}</p>
          <h2>{{ section.settings.faq_heading | escape }}</h2>
          <div class="rte">{{ section.settings.faq_intro }}</div>
        </div>

        <div class="leafer-fruit__faq">
          {% for block in faq_blocks %}
            <details {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question | escape }}</span>
                <span aria-hidden="true">+</span>
              </summary>
              <div class="rte">{{ block.settings.answer }}</div>
            </details>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="leafer-fruit__closing">
      <div>
        <p class="leafer-fruit__eyebrow">{{ section.settings.closing_eyebrow | escape }}</p>
        <h2>{{ section.settings.closing_heading | escape }}</h2>
        <div class="rte">{{ section.settings.closing_text }}</div>
      </div>
      {% if featured_product != blank %}
        <button
          class="leafer-fruit__closing-button"
          type="button"
          data-scroll-to-form
          data-form-target="LeaferFruitBuybox-{{ section.id }}"
        >
          {{ section.settings.closing_button | escape }}
        </button>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .leafer-fruit {
    background: var(--lf-bg);
    color: var(--lf-text);
    font-family: var(--font-body-family, Arial, sans-serif);
    padding-block: var(--lf-pad-y);
  }

  .leafer-fruit *,
  .leafer-fruit *::before,
  .leafer-fruit *::after {
    box-sizing: border-box;
  }

  .leafer-fruit__shell {
    margin-inline: auto;
    max-width: var(--lf-max);
    padding-inline: clamp(18px, 4vw, 54px);
  }

  .leafer-fruit__hero {
    align-items: stretch;
    display: grid;
    gap: clamp(28px, 5vw, 72px);
    grid-template-columns: minmax(0, 1.02fr) minmax(340px, 0.98fr);
  }

  .leafer-fruit__hero-copy {
    align-self: center;
    padding-block: clamp(12px, 4vw, 56px);
  }

  .leafer-fruit__eyebrow {
    color: var(--lf-accent);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  .leafer-fruit__title {
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(2.45rem, 6vw, 5.7rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.96;
    margin: 0;
    max-width: 12ch;
    text-wrap: balance;
  }

  .leafer-fruit__intro {
    color: var(--lf-muted);
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.72;
    margin-top: 24px;
    max-width: 62ch;
  }

  .leafer-fruit .rte > *:first-child {
    margin-top: 0;
  }

  .leafer-fruit .rte > *:last-child {
    margin-bottom: 0;
  }

  .leafer-fruit__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .leafer-fruit__trust span {
    background: color-mix(in srgb, var(--lf-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--lf-accent) 26%, transparent);
    border-radius: 999px;
    color: var(--lf-text);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 9px 13px;
  }

  .leafer-fruit__buybox,
  .leafer-fruit__empty {
    background: var(--lf-surface);
    border: 1px solid var(--lf-border);
    border-radius: var(--lf-radius);
    box-shadow: 0 22px 60px color-mix(in srgb, var(--lf-text) 8%, transparent);
    margin-top: 30px;
    padding: clamp(20px, 3vw, 32px);
  }

  .leafer-fruit__buybox-head {
    align-items: start;
    display: flex;
    gap: 20px;
    justify-content: space-between;
  }

  .leafer-fruit__buybox-label {
    color: var(--lf-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin: 0 0 5px;
    text-transform: uppercase;
  }

  .leafer-fruit__product-title {
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 600;
    line-height: 1.15;
    margin: 0;
  }

  .leafer-fruit__price {
    color: var(--lf-accent);
    flex: 0 0 auto;
    font-size: 1.2rem;
    font-weight: 900;
    margin: 0;
  }

  .leafer-fruit__variant-fieldset {
    border: 0;
    margin: 24px 0 0;
    padding: 0;
  }

  .leafer-fruit__variant-fieldset legend,
  .leafer-fruit__quantity label {
    color: var(--lf-text);
    font-size: 0.82rem;
    font-weight: 800;
    margin-bottom: 10px;
  }

  .leafer-fruit__variant-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .leafer-fruit__variant-choice {
    min-width: 0;
    position: relative;
  }

  .leafer-fruit__variant-radio {
    height: 1px;
    opacity: 0;
    overflow: hidden;
    position: absolute;
    width: 1px;
  }

  .leafer-fruit__variant-choice label {
    background: var(--lf-bg);
    border: 1px solid var(--lf-border);
    border-radius: calc(var(--lf-radius) * 0.55);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 3px;
    height: 100%;
    justify-content: center;
    min-height: 65px;
    padding: 10px 12px;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .leafer-fruit__variant-choice label > span {
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .leafer-fruit__variant-choice label small {
    color: var(--lf-muted);
    font-size: 0.72rem;
  }

  .leafer-fruit__variant-radio:checked + label {
    border-color: var(--lf-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--lf-accent) 18%, transparent);
  }

  .leafer-fruit__variant-radio:focus-visible + label {
    outline: 3px solid color-mix(in srgb, var(--lf-accent) 40%, transparent);
    outline-offset: 2px;
  }

  .leafer-fruit__variant-radio:disabled + label {
    cursor: not-allowed;
    opacity: 0.48;
  }

  .leafer-fruit__purchase-row {
    align-items: end;
    display: grid;
    gap: 12px;
    grid-template-columns: auto minmax(0, 1fr);
    margin-top: 20px;
  }

  .leafer-fruit__quantity {
    display: flex;
    flex-direction: column;
  }

  .leafer-fruit__quantity-control {
    align-items: center;
    border: 1px solid var(--lf-border);
    border-radius: calc(var(--lf-radius) * 0.55);
    display: grid;
    grid-template-columns: 38px 46px 38px;
    min-height: 52px;
    overflow: hidden;
  }

  .leafer-fruit__quantity-control button,
  .leafer-fruit__quantity-control input {
    background: transparent;
    border: 0;
    color: var(--lf-text);
    font: inherit;
    height: 100%;
    min-width: 0;
    text-align: center;
  }

  .leafer-fruit__quantity-control button {
    cursor: pointer;
    font-size: 1.25rem;
  }

  .leafer-fruit__quantity-control input {
    appearance: textfield;
    font-size: 0.9rem;
    font-weight: 800;
    width: 100%;
  }

  .leafer-fruit__quantity-control input::-webkit-inner-spin-button,
  .leafer-fruit__quantity-control input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }

  .leafer-fruit__add,
  .leafer-fruit__closing-button {
    align-items: center;
    background: var(--lf-accent);
    border: 1px solid var(--lf-accent);
    border-radius: calc(var(--lf-radius) * 0.55);
    color: var(--lf-accent-contrast);
    cursor: pointer;
    display: inline-flex;
    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 0.88rem;
    font-weight: 900;
    justify-content: center;
    letter-spacing: 0.035em;
    min-height: 52px;
    padding: 14px 22px;
    text-transform: uppercase;
    transition: filter 180ms ease, transform 180ms ease;
  }

  .leafer-fruit__add:hover,
  .leafer-fruit__closing-button:hover {
    filter: brightness(0.92);
    transform: translateY(-1px);
  }

  .leafer-fruit__add:focus-visible,
  .leafer-fruit__closing-button:focus-visible,
  .leafer-fruit__variety-button:focus-visible,
  .leafer-fruit__quantity-control button:focus-visible,
  .leafer-fruit__faq summary:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--lf-accent) 38%, transparent);
    outline-offset: 3px;
  }

  .leafer-fruit__add:disabled {
    cursor: not-allowed;
    filter: grayscale(0.7);
    opacity: 0.5;
    transform: none;
  }

  .leafer-fruit__availability {
    color: var(--lf-muted);
    font-size: 0.76rem;
    margin: 9px 0 0;
    text-align: right;
  }

  .leafer-fruit__visual {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .leafer-fruit__image-wrap {
    background: color-mix(in srgb, var(--lf-accent) 12%, var(--lf-surface));
    border-radius: var(--lf-radius);
    flex: 1;
    min-height: 650px;
    overflow: hidden;
    position: relative;
    view-transition-name: leafer-fruit-image;
  }

  .leafer-fruit__image,
  .leafer-fruit__placeholder {
    display: block;
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    width: 100%;
  }

  .leafer-fruit__image-note {
    color: var(--lf-muted);
    font-size: 0.75rem;
    line-height: 1.5;
    margin: 10px 4px 0;
  }

  .leafer-fruit__section {
    border-top: 1px solid var(--lf-border);
    margin-top: clamp(74px, 10vw, 140px);
    padding-top: clamp(60px, 8vw, 104px);
  }

  .leafer-fruit__section-head {
    max-width: 760px;
  }

  .leafer-fruit__section-head--center {
    margin-inline: auto;
    text-align: center;
  }

  .leafer-fruit__section-head h2,
  .leafer-fruit__closing h2 {
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(2rem, 4.3vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin: 0;
    text-wrap: balance;
  }

  .leafer-fruit__section-head .rte,
  .leafer-fruit__closing .rte {
    color: var(--lf-muted);
    font-size: 1rem;
    line-height: 1.72;
