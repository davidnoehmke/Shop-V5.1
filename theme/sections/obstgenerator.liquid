{% javascript %}
  (() => {
    const normalize = (value) => String(value || '').trim().toLocaleLowerCase();

    const init = (root) => {
      if (!root || root.dataset.leaferFruitReady === 'true') return;
      root.dataset.leaferFruitReady = 'true';

      const variantInput = root.querySelector('[data-variant-input]');
      const price = root.querySelector('[data-product-price]');
      const availability = root.querySelector('[data-availability]');
      const addButton = root.querySelector('[data-add-button]');
      const addLabel = root.querySelector('[data-add-label]');
      const radios = [...root.querySelectorAll('[data-variant-radio]')];
      const varietyButtons = [...root.querySelectorAll('[data-variety-select]')];

      const updateVariant = (radio) => {
        if (!radio || !variantInput) return;
        const available = radio.dataset.available === 'true';
        const render = () => {
          variantInput.value = radio.value;
          if (price) price.textContent = radio.dataset.price;
          if (availability) {
            availability.textContent = available
              ? radio.dataset.availableLabel
              : radio.dataset.soldOutLabel;
          }
          if (addButton) addButton.disabled = !available;
          if (addLabel) {
            addLabel.textContent = available
              ? radio.dataset.addButtonLabel
              : radio.dataset.soldOutLabel;
          }
          varietyButtons.forEach((button) => {
            const active = normalize(button.dataset.variantTitle) === normalize(radio.dataset.variantTitle);
            button.setAttribute('aria-pressed', String(active));
          });
        };

        if (document.startViewTransition) {
          document.startViewTransition(render);
        } else {
          render();
        }
      };

      radios.forEach((radio) => {
        radio.addEventListener('change', () => updateVariant(radio));
      });

      varietyButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const match = radios.find(
            (radio) => normalize(radio.dataset.variantTitle) === normalize(button.dataset.variantTitle)
          );
          if (!match || match.disabled) return;
          match.checked = true;
          match.dispatchEvent(new Event('change', { bubbles: true }));
          root.querySelector('.leafer-fruit__buybox')?.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
            block: 'center'
          });
        });
      });

      const quantityInput = root.querySelector('[data-quantity-input]');
      root.querySelector('[data-quantity-minus]')?.addEventListener('click', () => {
        if (!quantityInput) return;
        quantityInput.value = Math.max(1, Number(quantityInput.value || 1) - 1);
      });
      root.querySelector('[data-quantity-plus]')?.addEventListener('click', () => {
        if (!quantityInput) return;
        quantityInput.value = Math.max(1, Number(quantityInput.value || 1) + 1);
      });

      root.querySelector('[data-scroll-to-form]')?.addEventListener('click', (event) => {
        const target = document.getElementById(event.currentTarget.dataset.formTarget);
        if (!target) return;
        target.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'center'
        });
        window.setTimeout(() => target.querySelector('input:not([type="hidden"]), button')?.focus(), 450);
      });

      updateVariant(radios.find((radio) => radio.checked) || radios.find((radio) => !radio.disabled));
    };

    const initAll = (scope = document) => {
      scope.querySelectorAll('[data-leafer-fruit]').forEach(init);
    };

    initAll();
    document.addEventListener('shopify:section:load', (event) => initAll(event.target));
  })();
{% endjavascript %}

