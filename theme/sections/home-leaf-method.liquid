  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drei Wege, ein Ziel" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Nicht jeder braucht dieselbe Lösung." },
