{% liquid
  assign content_has_h1 = false
  if page.content contains '<h1' or page.content contains '<H1'
    assign content_has_h1 = true
  endif
%}

<article class="main-page page-width{% if content_has_h1 %} main-page--content-heading{% endif %}">
  {% unless content_has_h1 %}
    <header class="main-page__header">
      <h1>{{ page.title | escape }}</h1>
    </header>
  {% endunless %}
  {% if page.content != blank %}<div class="main-page__content rte">{{ page.content }}</div>{% endif %}
</article>

{% stylesheet %}
  .main-page { max-width: 940px; padding-block: clamp(3rem, 7vw, 7rem); }
  .main-page__header { max-width: 820px; }
  .main-page h1 { margin: 0; font-size: clamp(2.8rem, 7vw, 6rem); line-height: .95; letter-spacing: -.055em; }
  .main-page__content { margin-top: clamp(2rem, 5vw, 3.5rem); font-size: clamp(1rem, 1.4vw, 1.1rem); }
  .main-page--content-heading .main-page__content { margin-top: 0; }
  .main-page__content h1 { margin-top: 0; }
  .main-page__content h2 { margin-top: 2.5em; font-size: clamp(1.8rem, 4vw, 3rem); }
  .main-page__content h3 { margin-top: 2em; font-size: clamp(1.35rem, 3vw, 2rem); }
  .main-page__content img { height: auto; border-radius: var(--radius-large); }
  .main-page__content a { overflow-wrap: anywhere; }
  .main-page__content table { width: 100%; border-collapse: collapse; }
  .main-page__content th, .main-page__content td { padding: .75rem; border: 1px solid var(--border); text-align: left; vertical-align: top; }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_page.name", "settings": [] }
{% endschema %}
