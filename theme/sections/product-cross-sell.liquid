{% liquid
  assign recommendations = product.metafields.custom.cross_sell_products.value
  assign legacy_recommendations = product.metafields.leafer.cross_sell_products.value
  assign cross_sell_context = product.metafields.custom.use_case.value
  assign recommended_substrates = product.metafields.leafer.recommended_substrates.value
  assign recommended_planters = product.metafields.leafer.recommended_planters.value
  assign product_type_downcase = product.type | downcase
  assign fallback_collection = section.settings.collection

  if request.locale.iso_code == 'de'
    assign default_eyebrow = 'Passend zum Einsatz'
    assign default_heading = 'Sinnvolle Ergänzungen'
  else
    assign default_eyebrow = 'Matched to the use case'
    assign default_heading = 'Useful additions'
  endif

  if recommendations == blank and legacy_recommendations != blank
    assign recommendations = legacy_recommendations
  endif

  if recommendations == blank
    if product_type_downcase contains 'pflanzgefäß' or product_type_downcase contains 'stofftopf' or product_type_downcase contains 'topf'
      assign recommendations = recommended_substrates
      if recommendations == blank
        assign recommendations = recommended_planters
      endif
    else
      assign recommendations = recommended_planters
      if recommendations == blank
        assign recommendations = recommended_substrates
      endif
    endif
  endif

  assign has_recommendations = false
  if recommendations != blank
    for recommendation in recommendations
      if recommendation.id != product.id and recommendation.available
        assign has_recommendations = true
        break
      endif
    endfor
  elsif fallback_collection != blank
    for recommendation in fallback_collection.products
      if recommendation.id != product.id and recommendation.available
        assign has_recommendations = true
        break
      endif
    endfor
  endif
%}

{% if has_recommendations %}
  <section class="product-cross-sell page-width" aria-labelledby="CrossSell-{{ section.id }}">
    <header>
      <p>{{ default_eyebrow }}</p>
      <h2 id="CrossSell-{{ section.id }}">{{ section.settings.heading | default: default_heading | escape }}</h2>
      {% if cross_sell_context != blank %}<p class="product-cross-sell__context">{{ cross_sell_context | escape }}</p>{% endif %}
    </header>

    <div class="product-cross-sell__grid">
      {% assign rendered_count = 0 %}
      {% if recommendations != blank %}
        {% for recommendation in recommendations %}
          {% if recommendation.id != product.id and recommendation.available %}
            {% render 'product-card', product: recommendation, compact: true %}
            {% assign rendered_count = rendered_count | plus: 1 %}
            {% if rendered_count >= section.settings.limit %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
      {% else %}
        {% for recommendation in fallback_collection.products %}
          {% if recommendation.id != product.id and recommendation.available %}
            {% render 'product-card', product: recommendation, compact: true %}
            {% assign rendered_count = rendered_count | plus: 1 %}
            {% if rendered_count >= section.settings.limit %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .product-cross-sell { margin-block: var(--space-section); }
  .product-cross-sell header { max-width: 720px; margin-bottom: 2rem; }
  .product-cross-sell header p { margin: 0 0 .5rem; color: var(--accent); font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .product-cross-sell__context { max-width: 62ch; margin: 1rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.55; }
  .product-cross-sell h2 { margin: 0; font-size: clamp(2.2rem, 5vw, 4.5rem); line-height: .98; letter-spacing: -.05em; }
  .product-cross-sell__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 900px) { .product-cross-sell__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .product-cross-sell__grid { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Cross-Selling",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift" },
    { "type": "collection", "id": "collection", "label": "Optionale Fallback-Kollektion" },
    { "type": "range", "id": "limit", "label": "Maximale Produkte", "min": 2, "max": 4, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Cross-Selling" }]
}
{% endschema %}
