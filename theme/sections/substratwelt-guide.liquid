<section class="substratwelt-guide" aria-labelledby="substratwelt-guide-heading">
  {% assign mixes = collections['pflanzsubstrate-mischungen'] %}
  {% assign components = collections['substrate-verbesserer'] %}
  {% assign configurator = all_products['leafer-substrat-konfigurator'] %}
  {% assign mix_example = mixes.products.first %}
  {% assign component_example = components.products.first %}
  <div class="substratwelt-guide__inner">
    <div class="substratwelt-guide__intro">
      <p class="substratwelt-guide__eyebrow">LEAFerservice Substratwelt</p>
      <h2 id="substratwelt-guide-heading">{{ section.settings.heading }}</h2>
      <div class="substratwelt-guide__text">{{ section.settings.text }}</div>
    </div>
    <div class="substratwelt-guide__principles" aria-label="Substrat-Eigenschaften">
      <span><strong>Luft</strong> im Wurzelraum</span>
      <span><strong>Wasser</strong> passend dosieren</span>
      <span><strong>Struktur</strong> gezielt aufbauen</span>
    </div>
    <div class="substratwelt-guide__paths">
      <article class="substratwelt-path">
        <a class="substratwelt-path__image" href="{{ mixes.url }}" aria-label="Fertige Substrate und Mischungen">
          {% if mixes.image %}{{ mixes.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: mixes.image.alt | default: 'Fertige Pflanzsubstrate und Mischungen' }}{% endif %}
        </a>
        <div class="substratwelt-path__body">
          <p class="substratwelt-guide__eyebrow">Schnell starten</p>
          <h3><a href="{{ mixes.url }}">Fertige Substrate &amp; Mischungen</a></h3>
          {% if mix_example.metafields.leafer.intro.value != blank %}<p>{{ mix_example.metafields.leafer.intro.value }}</p>{% else %}<p>Abgestimmte Mischungen für unterschiedliche Pflanzen- und Kulturbedingungen.</p>{% endif %}
          <span class="substratwelt-path__meta">{{ mixes.products_count }} Produkte · Für Monstera, Aroiden, Orchideen &amp; mehr</span>
          <a class="substratwelt-path__link" href="{{ mixes.url }}">Mischung auswählen <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="substratwelt-path">
        <a class="substratwelt-path__image" href="{{ components.url }}" aria-label="Substratbestandteile und Zusätze">
          {% if components.image %}{{ components.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: components.image.alt | default: 'Substratbestandteile und Zusätze' }}{% endif %}
        </a>
        <div class="substratwelt-path__body">
          <p class="substratwelt-guide__eyebrow">Selbst aufbauen</p>
          <h3><a href="{{ components.url }}">Substratbestandteile &amp; Zusätze</a></h3>
          {% if component_example.metafields.leafer.intro.value != blank %}<p>{{ component_example.metafields.leafer.intro.value }}</p>{% else %}<p>Mineralische und organische Komponenten für individuelle Mischungen und gezielte Anpassungen.</p>{% endif %}
          <span class="substratwelt-path__meta">{{ components.products_count }} Produkte · Lava, Bims, Perlite, Zeolith &amp; mehr</span>
          <a class="substratwelt-path__link" href="{{ components.url }}">Bestandteile entdecken <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="substratwelt-path substratwelt-path--accent">
        <a class="substratwelt-path__image" href="{{ configurator.url }}" aria-label="Substrat individuell konfigurieren">
          {% if configurator.featured_image %}{{ configurator.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: configurator.title }}{% endif %}
        </a>
        <div class="substratwelt-path__body">
          <p class="substratwelt-guide__eyebrow">Individuell planen</p>
          <h3><a href="{{ configurator.url }}">Substrat konfigurieren</a></h3>
          {% if configurator.metafields.leafer.intro.value != blank %}<p>{{ configurator.metafields.leafer.intro.value }}</p>{% else %}<p>Stelle deine Mischung passend zu Pflanze, Standort, Gefäß und Gießverhalten zusammen.</p>{% endif %}
          {% if configurator.metafields.leafer.usp_1.value != blank %}<span class="substratwelt-path__meta">{{ configurator.metafields.leafer.usp_1.value }} · {{ configurator.metafields.leafer.usp_2.value }} · Bis 100&nbsp;% abstimmbar</span>{% endif %}
          <a class="substratwelt-path__link" href="{{ configurator.url }}">Konfigurator öffnen <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
    <div class="substratwelt-guide__method">
      <div><strong>Warum mehrere Bestandteile?</strong><span>Ein gutes Substrat ist ein System: Luftführung, Wasserführung und Struktur müssen zur Pflanze und zu deinen Bedingungen passen.</span></div>
      <div><strong>Fertig oder individuell?</strong><span>Nutze eine Fertigmischung für einen einfachen Einstieg oder passe einzelne Komponenten gezielt an.</span></div>
      <a href="{{ configurator.url }}">Meine Mischung zusammenstellen <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
{% stylesheet %}
.substratwelt-guide{background:#f5f7f2;color:#1d2922;padding:4.5rem 1.25rem}.substratwelt-guide__inner{max-width:1240px;margin:0 auto}.substratwelt-guide__intro{max-width:760px;margin-bottom:1.5rem}.substratwelt-guide__eyebrow{color:#4f8f79;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin:0 0 .65rem}.substratwelt-guide h2{font-size:clamp(2rem,4vw,3.5rem);line-height:1.05;margin:0 0 1rem}.substratwelt-guide__text{color:#536158;font-size:1.05rem;line-height:1.65}.substratwelt-guide__principles{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.75rem 0 2rem}.substratwelt-guide__principles span{background:#fff;border:1px solid #dce5dc;border-radius:999px;padding:.65rem 1rem;font-size:.9rem}.substratwelt-guide__principles strong{color:#36725e}.substratwelt-guide__paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.substratwelt-path{background:#fff;border:1px solid #e0e8e0;border-radius:1.1rem;overflow:hidden;display:flex;flex-direction:column;min-width:0}.substratwelt-path--accent{border-color:#8bb9a1;box-shadow:0 10px 30px rgba(54,114,94,.1)}.substratwelt-path__image{aspect-ratio:1/1;background:#eef3ed;display:block;overflow:hidden}.substratwelt-path__image img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.substratwelt-path:hover .substratwelt-path__image img{transform:scale(1.035)}.substratwelt-path__body{display:flex;flex-direction:column;gap:.65rem;padding:1.25rem;height:100%}.substratwelt-path__body .substratwelt-guide__eyebrow{margin-bottom:0}.substratwelt-path h3{font-size:1.25rem;line-height:1.2;margin:0}.substratwelt-path h3 a{color:inherit;text-decoration:none}.substratwelt-path p:not(.substratwelt-guide__eyebrow){color:#536158;font-size:.92rem;line-height:1.55;margin:0}.substratwelt-path__meta{color:#36725e;font-size:.78rem;line-height:1.45}.substratwelt-path__link{color:#36725e;font-size:.88rem;font-weight:700;margin-top:auto;text-decoration:none}.substratwelt-guide__method{display:grid;grid-template-columns:1fr 1fr auto;gap:1rem;align-items:center;background:#1d2922;border-radius:1rem;color:#fff;margin-top:1.5rem;padding:1.35rem 1.4rem}.substratwelt-guide__method strong,.substratwelt-guide__method span{display:block}.substratwelt-guide__method span{color:#c9d9cc;font-size:.87rem;line-height:1.45;margin-top:.25rem}.substratwelt-guide__method>a{background:#9dd0b1;border-radius:999px;color:#173223;font-weight:700;padding:.75rem 1rem;text-decoration:none;white-space:nowrap}.substratwelt-guide__method>a span{color:inherit;display:inline;font-size:inherit;margin:0}@media(max-width:900px){.substratwelt-guide__paths{grid-template-columns:1fr 1fr}.substratwelt-path:last-child{grid-column:1/-1;max-width:calc(50% - .5rem)}}@media(max-width:600px){.substratwelt-guide{padding:3rem 1rem}.substratwelt-guide__paths{grid-template-columns:1fr}.substratwelt-path:last-child{grid-column:auto;max-width:none}.substratwelt-guide__method{grid-template-columns:1fr}.substratwelt-guide__method>a{justify-self:start}}
{% endstylesheet %}
{% schema %}
{"name":"Substratwelt – Guide","settings":[{"type":"text","id":"heading","label":"Überschrift","default":"Finde die richtige Grundlage für starke Wurzeln"},{"type":"richtext","id":"text","label":"Einleitung","default":"<p>Vergleiche Fertigmischungen und einzelne Komponenten nach Funktion, Einsatzgebiet und Wurzelraum.</p>"}],"presets":[{"name":"Substratwelt – Guide"}]}
{% endschema %}