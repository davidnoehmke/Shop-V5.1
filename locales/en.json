  "collection_seo": {
    "eyebrow": "LEAFerservice collection knowledge",
    "faq_heading": "Questions before choosing",
    "substrates": {
      "heading": "Specialist substrates and ingredients for controlled root environments",
      "lead": "Monstera, Philodendron, Alocasia, orchids, palms and succulents need different balances of air, moisture and structural stability.",
      "body": "Finished LEAFerservice mixes provide a balanced starting point, while pine bark, perlite, pumice, lava, clay pebbles, coconut chips, sphagnum, vermiculite, zeolite, charcoal and worm castings allow precise adjustments. The important question is not how many ingredients a mix contains, but what each one contributes.",
      "question_one": "Which substrate suits Monstera and Philodendron?",
      "answer_one": "Many aroids benefit from a coarse, airy mix that drains freely while retaining balanced residual moisture. Pot size, light and watering habits still matter.",
      "question_two": "Can I mix substrate ingredients myself?",
      "answer_two": "Yes. Give every ingredient a purpose and make sure all volume shares add up to 100 percent. The substrate configurator helps you plan the ratio."
    },
    "houseplants": {
      "heading": "Choose houseplants by root zone, location and care needs",
      "lead": "Monstera, Philodendron, Alocasia and other houseplants differ in light needs, root structure and moisture requirements. Choose the plant, container and substrate as one system.",
      "body": "For houseplants, the full system matters: roots, substrate, pot and location. Many aroids benefit from airy, structurally stable mixes, while other foliage plants may prefer more even moisture. Use the product and guide content to match plant, substrate and container by function.",
      "question_one": "Which substrate suits tropical houseplants?",
      "answer_one": "Many Monstera, Philodendron and Alocasia species benefit from an airy, coarse mix. Pot size, light and watering habits still determine the final balance.",
      "question_two": "How should I choose the right container?",
      "answer_two": "Choose the container around the existing root ball and water balance. Oversized pots dry more slowly, so drainage and substrate structure remain important."
    },
    "planters": {
      "heading": "Planters, fabric pots and watering systems matched to the root zone",
      "lead": "Volume, material, drainage and water reservoirs change how quickly a substrate dries and how much oxygen reaches the roots.",
      "body": "LEAFerservice brings together breathable fabric pots, decorative planters and proven LECHUZA watering systems. Choose size based on the existing root ball rather than foliage alone, leaving room to grow without creating an oversized volume that stays wet for too long.",
      "question_one": "Which pot size should I choose when repotting?",
      "answer_one": "The next practical size above the current root ball is usually enough. A much larger pot dries more slowly and can create persistently wet areas.",
      "question_two": "Does a fabric pot need a saucer?",
      "answer_two": "Yes indoors. Breathable fabric allows excess water to escape, so a waterproof saucer or cachepot protects floors and shelves."
    },
    "smart_grow": {
      "heading": "Smart grow equipment for propagation, cuttings and controlled plant light",
      "lead": "Germination and young plant growth become more reliable when moisture, warmth and light are actively managed.",
      "body": "LEAFerservice combines coconut propagation plugs, rockwool cubes, heat mats and dimmable full-spectrum LEDs. Match every tool to the growing area and stage rather than running equipment permanently at maximum output.",
      "question_one": "When is a heat mat useful?",
      "answer_one": "It is useful on cool windowsills and for warmth-loving seeds. Monitor the actual temperature in the growing medium to prevent overheating and drying.",
      "question_two": "How much LED power do I need?",
      "answer_two": "That depends on the lit area, hanging distance, plant and growth stage. Start seedlings conservatively and focus on even coverage."
    },
    "care": {
      "heading": "Plant care tools for precise watering, training and repotting",
      "lead": "Useful accessories solve a specific problem: water reaches the substrate, climbing plants gain support and repotting stays controlled.",
      "body": "The LEAFerservice care range includes narrow-spout watering cans and modular supports for Monstera and Philodendron. Choose accessories for pot size, plant height and placement rather than appearance alone.",
      "question_one": "Why is a long watering spout useful?",
      "answer_one": "It reaches the substrate between large leaves and closely grouped pots, allowing slow and precise watering near the root ball.",
      "question_two": "Which plants benefit from a moss pole?",
      "answer_two": "Climbing aroids such as Monstera, Philodendron, Epipremnum and Scindapsus benefit from stable, correctly attached support."
    },
    "sets": {
      "heading": "Propagation kits and plant bundles with a clear purpose",
      "lead": "A good kit reduces decisions without hiding the essentials. LEAFerservice combines products by application rather than availability.",
      "body": "Herb and microgreen kits simplify starting on a windowsill or kitchen shelf. Check available light, space and the time you can spend monitoring moisture before choosing.",
      "question_one": "What should a propagation kit contain?",
      "answer_one": "A suitable container, appropriate growing medium and clear guidance on light, moisture and temperature.",
      "question_two": "Are these kits suitable for beginners?",
      "answer_two": "Yes, provided the care guidance and actual site conditions are taken into account."
    },
    "default": {
      "heading": "Selected products for well-planned plant projects",
      "lead": "LEAFerservice connects substrates, planters, propagation tools and accessories around a clear practical purpose.",
      "body": "Every product page explains benefits, use and suitable additions. Filter by product type and compare variants to find a solution that matches the plant and location.",
      "question_one": "How do I find the right product?",
      "answer_one": "Start with the plant, location and problem you want to solve. Product filters and usage details narrow the choice.",
      "question_two": "Are matching additions shown?",
      "answer_two": "Yes. Product pages display complementary items such as substrate ingredients, planters or propagation equipment."
    }
