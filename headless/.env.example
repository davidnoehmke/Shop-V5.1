# Required for the real guest storefront, cart and checkout.
# Set values in Vercel Preview, then redeploy; never commit populated env files.
# SESSION_SECRET: generate at least 32 random bytes in a trusted secret manager.
SESSION_SECRET=""
# Hostnames only (no https:// or trailing slash).
PUBLIC_STORE_DOMAIN=""
PUBLIC_STOREFRONT_API_TOKEN=""
PUBLIC_CHECKOUT_DOMAIN=""

# Optional server-only Storefront token; do not put Admin API credentials here.
PRIVATE_STOREFRONT_API_TOKEN=""
# Optional Hydrogen analytics/channel attribution. Not required for guest checkout.
PUBLIC_STOREFRONT_ID=""

# Optional for guest shopping; required to enable Customer Account API login.
# Register the exact Preview origin and /account/authorize callback in Shopify.
# Hydrogen 2026.4 derives the Customer Account URL from SHOP_ID;
# PUBLIC_CUSTOMER_ACCOUNT_API_URL is not consumed by this installed version.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
SHOP_ID=""

