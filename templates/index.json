      "blocks": {
        "substrate": {
          "type": "question",
          "settings": {
            "topic": "substrate",
            "question": "Welches Substrat passt zu meiner Pflanze?",
            "answer": "<p>Orientiere dich an Wurzeltyp, Standort und Gießroutine. Fertige Mischungen geben dir einen abgestimmten Startpunkt; einzelne Bestandteile verändern gezielt Luftführung, Drainage oder Feuchtepuffer.</p>"
          }
        },
        "application": {
          "type": "question",
          "settings": {
            "topic": "application",
            "question": "Wann brauche ich einen Substratzusatz?",
            "answer": "<p>Wenn du eine konkrete Eigenschaft verändern möchtest. Beginne mit einer klaren Funktion pro Bestandteil und passe die Anteile schrittweise an.</p>"
          }
        },
        "plants": {
          "type": "question",
          "settings": {
            "topic": "plants",
            "question": "Wie finde ich die passende Topfgröße?",
            "answer": "<p>Wähle die nächste sinnvolle Größe über dem aktuellen Wurzelballen. Ablauf, Material und Gießroutine sollten zusammenpassen.</p>"
          }
        },
        "availability": {
          "type": "question",
          "settings": {
            "topic": "shipping",
            "question": "Wo sehe ich Preis und Verfügbarkeit?",
            "answer": "<p>Preis, Varianten und aktuelle Verfügbarkeit stehen direkt am jeweiligen Produkt. Nicht verfügbare Varianten lassen sich nicht auswählen.</p>"
          }
        }
