{% endstylesheet %}

<script>
(() => {
  const root = document.currentScript.previousElementSibling;
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const API = root.dataset.supabaseUrl;
  const KEY = root.dataset.supabaseKey;
  const lang = root.dataset.locale === 'en' ? 'en' : 'de';
  const copy = (de,en) => lang === 'en' ? en : de;
  const stateKey = 'leaf-room-studio-v2';
  const sessionKey = 'leaf-room-supabase-session-v1';
  const projectStatus = root.querySelector('[data-project-status]');
  const accountStatus = root.querySelector('[data-account-status]');
  const photoInput = root.querySelector('[data-room-photo]');
  const photoStage = root.querySelector('[data-photo-stage]');
  const photoCanvas = root.querySelector('[data-photo-canvas]');
  const photoCtx = photoCanvas?.getContext('2d');
  const plan = root.querySelector('[data-plan-canvas]');
  const ctx = plan?.getContext('2d');
  const productSelect = root.querySelector('[data-product-select]');
  const accountDialog = root.querySelector('[data-account-dialog]');
  let photoImage = null;
  let photoFile = null;
  let measurePoints = [];
  let measurementMode = 'reference';
  let pixelsPerCm = null;
  let drag = null;
  let selectedId = null;

  const room = {width:4.2,depth:3.2,height:2.5};
  let objects = [];
  let projectId = crypto.randomUUID();
  let photoPath = '';
  let measurement = {source:'manual',reference_cm:null,measured_cm:null,estimated:true};

  const safeSession = () => {
    try { return JSON.parse(localStorage.getItem(sessionKey) || 'null'); } catch { return null; }
  };
  const saveSession = session => {
    try {
      const expiresAt = Date.now() + Math.max(60, Number(session.expires_in || 3600)) * 1000;
      localStorage.setItem(sessionKey, JSON.stringify({...session, expires_at_ms:expiresAt}));
    } catch {}
  };
  const clearSession = () => { try { localStorage.removeItem(sessionKey); } catch {} };

  async function authFetch(path, options = {}) {
    const headers = new Headers(options.headers || {});
    headers.set('apikey', KEY);
    headers.set('content-type', headers.get('content-type') || 'application/json');
    const session = safeSession();
    if (session?.access_token) headers.set('authorization', 'Bearer ' + session.access_token);
    return fetch(API + path, {...options, headers});
  }

  async function ensureSession() {
    let session = safeSession();
    if (session?.access_token && Number(session.expires_at_ms || 0) > Date.now() + 60000) return session;
    if (session?.refresh_token) {
      const refreshed = await authFetch('/auth/v1/token?grant_type=refresh_token', {
        method:'POST', body:JSON.stringify({refresh_token:session.refresh_token})
      });
      if (refreshed.ok) {
        session = await refreshed.json();
        saveSession(session);
        syncAccountState();
        return session;
      }
      clearSession();
    }
    const response = await fetch(API + '/auth/v1/signup', {
      method:'POST',
      headers:{apikey:KEY,'content-type':'application/json'},
      body:JSON.stringify({data:{}})
    });
    if (!response.ok) {
      const body = await response.json().catch(() => ({}));
      throw new Error(body.msg || body.message || body.error_description || 'anonymous_auth_unavailable');
    }
    session = await response.json();
    if (!session?.access_token || !session?.user?.id) throw new Error('anonymous_auth_unavailable');
    saveSession(session);
    syncAccountState();
    return session;
  }

  function syncAccountState() {
    const session = safeSession();
    const authenticated = Boolean(session?.access_token && session?.user?.id);
    root.classList.toggle('is-authenticated', authenticated);
    root.querySelectorAll('[data-open-account]').forEach(button => button.hidden = false);
    const label = root.querySelector('[data-account-label]');
    const description = root.querySelector('[data-account-copy]');
    const create = root.querySelector('[data-create-anon]');
    if (authenticated) {
      if (label) label.textContent = session.user?.is_anonymous === false ? copy('Gesichertes LEAF Konto','Secured LEAF account') : copy('Anonymes LEAF Konto','Anonymous LEAF account');
      if (description) description.textContent = copy('Projekte können privat in der Cloud gespeichert werden.','Projects can be stored privately in the cloud.');
      if (create) create.hidden = true;
    } else {
      if (label) label.textContent = copy('Gastmodus','Guest mode');
      if (description) description.textContent = copy('Frei planen. Ein Konto wird nur für Cloud-Speicherung benötigt.','Plan freely. An account is only needed for cloud saving.');
      if (create) create.hidden = false;
    }
  }

  function clamp(value,min,max){ return Math.min(max,Math.max(min,value)); }
  function money(cents){
    try{return new Intl.NumberFormat(lang === 'en' ? 'en-DE':'de-DE',{style:'currency',currency:root.dataset.currency||'EUR'}).format(Number(cents||0)/100)}
    catch{return (Number(cents||0)/100).toFixed(2)+' €'}
  }
  function sanitizePdf(text){return String(text||'').replace(/[äÄ]/g,'ae').replace(/[öÖ]/g,'oe').replace(/[üÜ]/g,'ue').replace(/ß/g,'ss').replace(/[^ -~]/g,' ')}
  function objectPreset(kind){
    const presets={
      plant:{title:copy('Pflanze','Plant'),width:.55,depth:.55,color:'#5f8258'},
      shelf:{title:copy('Regal','Shelf'),width:1.2,depth:.42,color:'#947b60'},
      window:{title:copy('Fenster','Window'),width:1.4,depth:.16,color:'#93c2cd'},
      planter:{title:copy('Pflanzgefäß','Planter'),width:.55,depth:.55,color:'#a78970'},
      light:{title:copy('Leuchte','Light'),width:.45,depth:.45,color:'#c3ad63'},
      system:{title:copy('System','System'),width:1.15,depth:.7,color:'#718176'}
    }; return presets[kind]||presets.system;
  }
  function productKind(search){return /regal|station|gewächshaus|terrarium/.test(search)?'system':/topf|gefäß|planter|lechuza|elho|blomus/.test(search)?'planter':'light'}

  function addObject(kind, product = null) {
    const p=objectPreset(kind);
    const id=crypto.randomUUID();
    const obj={id,kind,title:product?.title||p.title,x:room.width/2,z:room.depth/2,width:p.width,depth:p.depth,rotation:0,color:p.color,variantId:product?.variantId||null,price:Number(product?.price||0),url:product?.url||'',image:product?.image||'',dimensionsVerified:false};
    objects.push(obj); selectedId=id; persistLocal(); drawPlan(); updateSummary();
  }

  function persistLocal(){
    try { localStorage.setItem(stateKey,JSON.stringify({projectId,room,objects,photoPath,measurement,title:root.querySelector('[data-project-title]')?.value||''})); } catch {}
  }
  function restoreLocal(){
    try{
      const saved=JSON.parse(localStorage.getItem(stateKey)||'null');
      if(!saved)return;
      projectId=saved.projectId||projectId;
      Object.assign(room,saved.room||{});
      objects=Array.isArray(saved.objects)?saved.objects.slice(0,60):[];
      photoPath=saved.photoPath||'';
      measurement=saved.measurement||measurement;
      if(saved.title && root.querySelector('[data-project-title]'))root.querySelector('[data-project-title]').value=saved.title;
    }catch{}
    ['width','depth','height'].forEach(k=>{const el=root.querySelector('[data-room-'+k+']');if(el)el.value=Number(room[k]).toFixed(2)});
  }

  function planMetrics(){
    const dpr=Math.min(window.devicePixelRatio||1,2);
    const rect=plan.getBoundingClientRect();
    const w=Math.max(1,Math.round(rect.width*dpr)),h=Math.max(1,Math.round(rect.height*dpr));
    if(plan.width!==w||plan.height!==h){plan.width=w;plan.height=h}
    const pad=Math.max(40*dpr,Math.min(w,h)*.08);
    const scale=Math.min((w-pad*2)/room.width,(h-pad*2)/room.depth);
    return {w,h,pad,scale,ox:(w-room.width*scale)/2,oy:(h-room.depth*scale)/2,dpr};
  }
  function drawPlan(){
    if(!ctx)return;
    const m=planMetrics();ctx.clearRect(0,0,m.w,m.h);
    ctx.fillStyle='#eef0e8';ctx.fillRect(m.ox,m.oy,room.width*m.scale,room.depth*m.scale);
    ctx.strokeStyle='#708177';ctx.lineWidth=Math.max(1,m.dpr);ctx.strokeRect(m.ox,m.oy,room.width*m.scale,room.depth*m.scale);
    ctx.strokeStyle='rgba(70,95,79,.12)';
    for(let x=.5;x<room.width;x+=.5){ctx.beginPath();ctx.moveTo(m.ox+x*m.scale,m.oy);ctx.lineTo(m.ox+x*m.scale,m.oy+room.depth*m.scale);ctx.stroke()}
    for(let z=.5;z<room.depth;z+=.5){ctx.beginPath();ctx.moveTo(m.ox,m.oy+z*m.scale);ctx.lineTo(m.ox+room.width*m.scale,m.oy+z*m.scale);ctx.stroke()}
    objects.forEach(obj=>{
      const x=m.ox+(obj.x-obj.width/2)*m.scale,z=m.oy+(obj.z-obj.depth/2)*m.scale,w=obj.width*m.scale,h=obj.depth*m.scale;
      ctx.save();ctx.translate(x+w/2,z+h/2);ctx.rotate((obj.rotation||0)*Math.PI/180);
      ctx.fillStyle=obj.color||'#728177';ctx.fillRect(-w/2,-h/2,w,h);
      ctx.strokeStyle=obj.id===selectedId?'#1f5638':'rgba(34,54,43,.4)';ctx.lineWidth=obj.id===selectedId?3*m.dpr:1*m.dpr;ctx.strokeRect(-w/2,-h/2,w,h);ctx.restore();
      obj._hit={x,z,w,h};
      ctx.fillStyle='#24362c';ctx.font=Math.max(11*m.dpr,Math.min(14*m.dpr,w/8))+'px system-ui';ctx.textAlign='center';
      const title=(obj.title||'').slice(0,26);ctx.fillText(title,x+w/2,z+h/2+4*m.dpr,Math.max(40,w-8*m.dpr));
    });
    ctx.fillStyle='rgba(36,54,44,.72)';ctx.font=12*m.dpr+'px system-ui';ctx.textAlign='left';ctx.fillText(room.width.toFixed(2)+' m × '+room.depth.toFixed(2)+' m',m.ox,m.oy-10*m.dpr);
    syncSelection();
  }
  function objectAt(clientX,clientY){
    const rect=plan.getBoundingClientRect(),sx=plan.width/rect.width,sy=plan.height/rect.height,x=(clientX-rect.left)*sx,y=(clientY-rect.top)*sy;
    return [...objects].reverse().find(o=>o._hit&&x>=o._hit.x&&x<=o._hit.x+o._hit.w&&y>=o._hit.z&&y<=o._hit.z+o._hit.h);
  }
  function canvasToRoom(clientX,clientY){
    const rect=plan.getBoundingClientRect(),m=planMetrics(),sx=plan.width/rect.width,sy=plan.height/rect.height;
    return {x:clamp(((clientX-rect.left)*sx-m.ox)/m.scale,0,room.width),z:clamp(((clientY-rect.top)*sy-m.oy)/m.scale,0,room.depth)};
  }
  function syncSelection(){
    const box=root.querySelector('[data-selection]'),obj=objects.find(o=>o.id===selectedId);
    if(!box)return;box.hidden=!obj;if(obj)root.querySelector('[data-selection-title]').textContent=obj.title;
  }
  function updateSummary(){
    const products=objects.filter(o=>o.variantId),total=products.reduce((s,o)=>s+Number(o.price||0),0);
    root.querySelector('[data-summary-count]').textContent=String(objects.length);
    root.querySelector('[data-summary-products]').textContent=String(products.length);
    root.querySelector('[data-summary-price]').textContent=products.length?money(total):'—';
    root.querySelector('[data-add-setup]').disabled=!products.length;
  }

  function drawPhoto(){
    if(!photoImage||!photoCtx)return;
    const maxW=1200,maxH=800,ratio=Math.min(maxW/photoImage.naturalWidth,maxH/photoImage.naturalHeight,1);
    photoCanvas.width=Math.round(photoImage.naturalWidth*ratio);photoCanvas.height=Math.round(photoImage.naturalHeight*ratio);
    photoCtx.drawImage(photoImage,0,0,photoCanvas.width,photoCanvas.height);
    if(measurePoints.length){
      photoCtx.fillStyle='#f5fff7';photoCtx.strokeStyle='#1f7048';photoCtx.lineWidth=4;
      measurePoints.forEach(p=>{photoCtx.beginPath();photoCtx.arc(p.x,p.y,8,0,Math.PI*2);photoCtx.fill();photoCtx.stroke()});
      if(measurePoints.length===2){photoCtx.beginPath();photoCtx.moveTo(measurePoints[0].x,measurePoints[0].y);photoCtx.lineTo(measurePoints[1].x,measurePoints[1].y);photoCtx.stroke()}
    }
  }
  function linePixels(){if(measurePoints.length!==2)return 0;return Math.hypot(measurePoints[1].x-measurePoints[0].x,measurePoints[1].y-measurePoints[0].y)}

  photoInput?.addEventListener('change',()=>{
    const file=photoInput.files?.[0];if(!file)return;
    if(file.size>10*1024*1024){projectStatus.textContent=copy('Foto ist größer als 10 MB.','Photo is larger than 10 MB.');return}
    photoFile=file;const url=URL.createObjectURL(file),img=new Image();
    img.onload=()=>{photoImage=img;measurePoints=[];pixelsPerCm=null;photoStage.hidden=false;root.querySelector('[data-measure-controls]').hidden=false;root.querySelector('[data-photo-consent-wrap]').hidden=false;drawPhoto();URL.revokeObjectURL(url)};
    img.src=url;
  });
  photoCanvas?.addEventListener('pointerup',event=>{
    if(!photoImage)return;
    const rect=photoCanvas.getBoundingClientRect(),x=(event.clientX-rect.left)*(photoCanvas.width/rect.width),y=(event.clientY-rect.top)*(photoCanvas.height/rect.height);
    if(measurePoints.length>=2)measurePoints=[];measurePoints.push({x,y});drawPhoto();
    if(measurePoints.length===2&&measurementMode==='measure'&&pixelsPerCm){
      const cm=linePixels()/pixelsPerCm;measurement={...measurement,source:'photo_reference',measured_cm:Math.round(cm*10)/10,estimated:true};
      const result=root.querySelector('[data-measure-result]');if(result)result.textContent=copy('Gemessene Strecke: ','Measured line: ')+measurement.measured_cm.toFixed(1)+' cm';
      const apply=root.querySelector('[data-measure-apply]');if(apply)apply.hidden=false;
      root.querySelector('[data-accuracy-label]').textContent=copy('Foto-Referenzmessung · Näherung, bitte prüfen','Photo reference measurement · estimate, please verify');
      persistLocal();
    }
  });
  root.querySelector('[data-set-reference]')?.addEventListener('click',()=>{
    const px=linePixels(),cm=Number(root.querySelector('[data-reference-cm]')?.value||0);
    if(px<=0||cm<10)return;
    pixelsPerCm=px/cm;measurementMode='measure';measurement={source:'photo_reference',reference_cm:cm,measured_cm:null,estimated:true};
    measurePoints=[];drawPhoto();root.querySelector('[data-measure-line]').disabled=false;
    root.querySelector('[data-measure-result]').textContent=copy('Referenz gesetzt. Markiere jetzt eine weitere Strecke im Foto.','Reference set. Now mark another line in the photo.');
  });
  root.querySelector('[data-measure-line]')?.addEventListener('click',()=>{measurementMode='measure';measurePoints=[];drawPhoto()});
  root.querySelectorAll('[data-apply-measure]').forEach(button=>button.addEventListener('click',()=>{
    if(!measurement.measured_cm)return;
    const key=button.dataset.applyMeasure;
    const meters=clamp(measurement.measured_cm/100,1,20);
    room[key]=meters;
    const input=root.querySelector('[data-room-'+key+']');if(input)input.value=meters.toFixed(2);
    measurement={...measurement,applied_to:key};
    persistLocal();drawPlan();
    root.querySelector('[data-measure-result]').textContent=copy('Übernommen: ','Applied: ')+meters.toFixed(2)+' m';
  }));

  root.querySelectorAll('[data-room-width],[data-room-depth],[data-room-height]').forEach(input=>input.addEventListener('input',()=>{
    const key=input.hasAttribute('data-room-width')?'width':input.hasAttribute('data-room-depth')?'depth':'height';
    room[key]=clamp(Number(input.value||room[key]),key==='height'?1.8:1,key==='height'?6:20);persistLocal();drawPlan();
  }));
  root.querySelectorAll('[data-add-kind]').forEach(button=>button.addEventListener('click',()=>addObject(button.dataset.addKind)));
  root.querySelector('[data-add-product]')?.addEventListener('click',()=>{
    const option=productSelect?.selectedOptions?.[0];if(!option?.value)return;
    const search=(option.dataset.search||'').toLowerCase();
    addObject(productKind(search),{variantId:option.value,title:option.dataset.title||option.textContent.trim(),price:option.dataset.price,url:option.dataset.url,image:option.dataset.image});
  });
  root.querySelector('[data-rotate]')?.addEventListener('click',()=>{const o=objects.find(x=>x.id===selectedId);if(o){o.rotation=((o.rotation||0)+45)%360;persistLocal();drawPlan()}});
  root.querySelector('[data-duplicate]')?.addEventListener('click',()=>{const o=objects.find(x=>x.id===selectedId);if(o){objects.push({...o,id:crypto.randomUUID(),x:clamp(o.x+.2,0,room.width),z:clamp(o.z+.2,0,room.depth)});selectedId=objects.at(-1).id;persistLocal();drawPlan();updateSummary()}});
  root.querySelector('[data-delete]')?.addEventListener('click',()=>{objects=objects.filter(x=>x.id!==selectedId);selectedId=null;persistLocal();drawPlan();updateSummary()});
  plan?.addEventListener('pointerdown',event=>{const o=objectAt(event.clientX,event.clientY);selectedId=o?.id||null;if(o){drag={id:o.id};plan.setPointerCapture?.(event.pointerId)}drawPlan()});
  plan?.addEventListener('pointermove',event=>{if(!drag)return;const o=objects.find(x=>x.id===drag.id);if(!o)return;const p=canvasToRoom(event.clientX,event.clientY);o.x=clamp(p.x,o.width/2,room.width-o.width/2);o.z=clamp(p.z,o.depth/2,room.depth-o.depth/2);drawPlan()});
  const stopDrag=()=>{if(drag){drag=null;persistLocal()}};
  plan?.addEventListener('pointerup',stopDrag);plan?.addEventListener('pointercancel',stopDrag);

  async function uploadPhoto(session){
    if(!photoFile||!root.querySelector('[data-photo-consent]')?.checked)return '';
    const ext=(photoFile.type.split('/')[1]||'jpg').replace('jpeg','jpg'),path=session.user.id+'/'+projectId+'/room.'+ext;
    const response=await fetch(API+'/storage/v1/object/leaf-room-projects/'+path,{
      method:'POST',headers:{apikey:KEY,authorization:'Bearer '+session.access_token,'content-type':photoFile.type,'x-upsert':'true'},body:photoFile
    });
    if(!response.ok)throw new Error('photo_upload_failed');return path;
  }
  function projectPayload(session){
    const products=objects.filter(o=>o.variantId).map(({variantId,title,price,url,x,z,rotation,width,depth,dimensionsVerified})=>({variant_id:String(variantId),title,price_cents:price,url,x,z,rotation,width_m:width,depth_m:depth,dimensions_verified:Boolean(dimensionsVerified)}));
    return {
      id:projectId,resume_code:projectId,mode:'project',project_kind:'room',owner_user_id:session.user.id,
      title:(root.querySelector('[data-project-title]')?.value||copy('Mein Pflanzenraum','My plant room')).slice(0,80),
      schema_version:1,locale:root.dataset.locale||'de',recipe:{},addons:[],
      room_geometry:{width_m:room.width,depth_m:room.depth,height_m:room.height},
      room_objects:objects.map(({_hit,...o})=>o),room_products:products,room_measurement:measurement,
      room_photo_path:photoPath||null,room_photo_consent_at:photoPath?new Date().toISOString():null,
      preferences:{product_usage_optional:true},result_summary:{object_count:objects.length,product_count:products.length,measurement_estimated:Boolean(measurement.estimated)},
      updated_at:new Date().toISOString()
    };
  }
  async function saveCloud(){
    projectStatus.textContent=copy('Projekt wird gespeichert…','Saving project…');
    try{
      const session=await ensureSession();
      if(photoFile&&root.querySelector('[data-photo-consent]')?.checked)photoPath=await uploadPhoto(session);
      const payload=projectPayload(session);
      const response=await fetch(API+'/rest/v1/configurator_projects?on_conflict=resume_code',{
        method:'POST',headers:{apikey:KEY,authorization:'Bearer '+session.access_token,'content-type':'application/json',prefer:'resolution=merge-duplicates,return=representation'},body:JSON.stringify(payload)
      });
      if(!response.ok)throw new Error('project_save_failed');
      persistLocal();projectStatus.textContent=copy('Projekt privat gespeichert.','Project saved privately.');await loadProjectList();
    }catch(error){
      projectStatus.textContent=copy('Cloud-Speicherung ist derzeit nicht verfügbar. Dein Projekt bleibt lokal auf diesem Gerät erhalten.','Cloud saving is currently unavailable. Your project remains stored locally on this device.');
    }
  }
  root.querySelector('[data-save-cloud]')?.addEventListener('click',saveCloud);
  root.querySelector('[data-create-anon]')?.addEventListener('click',async()=>{
    const button=root.querySelector('[data-create-anon]');button.disabled=true;
    try{await ensureSession();projectStatus.textContent=copy('Anonymes Konto erstellt. Es enthält keine Pflichtangaben zu deiner Identität.','Anonymous account created. It contains no required identity details.');await loadProjectList()}
    catch{projectStatus.textContent=copy('Anonyme Konten sind in Supabase noch nicht aktiviert. Du kannst den Planer trotzdem lokal und den PDF-Export vollständig nutzen.','Anonymous accounts are not enabled in Supabase yet. You can still use the planner locally and export PDFs.')}
    finally{button.disabled=false}
  });

  async function saveProfile(){
    try{
      const session=await ensureSession(),name=(root.querySelector('[data-display-name]')?.value||'').trim().slice(0,80);
      const response=await fetch(API+'/rest/v1/leaf_profiles?on_conflict=user_id',{
        method:'POST',headers:{apikey:KEY,authorization:'Bearer '+session.access_token,'content-type':'application/json',prefer:'resolution=merge-duplicates'},body:JSON.stringify({user_id:session.user.id,display_name:name||null,profile_mode:name?'pseudonymous':'anonymous',preferences:{},updated_at:new Date().toISOString()})
      });
      if(!response.ok)throw new Error();accountStatus.textContent=copy('Profil gespeichert.','Profile saved.');
    }catch{accountStatus.textContent=copy('Profil konnte nicht gespeichert werden.','Profile could not be saved.')}
  }
  root.querySelector('[data-save-profile]')?.addEventListener('click',saveProfile);

  root.querySelector('[data-link-email]')?.addEventListener('click',async()=>{
    const email=(root.querySelector('[data-account-email]')?.value||'').trim();
    if(!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)){accountStatus.textContent=copy('Bitte gültige E-Mail eingeben.','Please enter a valid email.');return}
    try{
      const session=await ensureSession();
      const response=await fetch(API+'/auth/v1/user',{method:'PUT',headers:{apikey:KEY,authorization:'Bearer '+session.access_token,'content-type':'application/json'},body:JSON.stringify({email})});
      const body=await response.json().catch(()=>({}));if(!response.ok)throw new Error(body.msg||body.message||'link_failed');
      accountStatus.textContent=copy('Bestätigungs-E-Mail wurde angefordert. Nach Bestätigung bleibt dasselbe Projektkonto bestehen.','Verification email requested. After verification the same project account remains in place.');
    }catch{accountStatus.textContent=copy('E-Mail konnte nicht verknüpft werden. Falls die Adresse bereits existiert, melde dich später mit diesem Konto an.','Email could not be linked. If the address already exists, sign in with that account later.')}
  });

  async function loadProjectList(){
    const list=root.querySelector('[data-project-list]'),session=safeSession();if(!list||!session?.user?.id)return;
    try{
      const response=await fetch(API+'/rest/v1/configurator_projects?select=id,resume_code,title,room_geometry,room_objects,room_products,room_measurement,room_photo_path,updated_at&project_kind=eq.room&owner_user_id=eq.'+encodeURIComponent(session.user.id)+'&order=updated_at.desc&limit=20',{headers:{apikey:KEY,authorization:'Bearer '+session.access_token}});
      if(!response.ok)throw new Error();const rows=await response.json();
      list.innerHTML='';list.className='leaf-room-studio__project-list';
      if(!rows.length){list.innerHTML='<p>'+copy('Noch keine Cloud-Projekte gespeichert.','No cloud projects saved yet.')+'</p>';return}
      rows.forEach(row=>{
        const card=document.createElement('div');card.className='leaf-room-studio__project-card';
        const info=document.createElement('div'),title=document.createElement('strong'),small=document.createElement('small'),button=document.createElement('button');
        title.textContent=row.title||copy('Pflanzenraum','Plant room');small.textContent=new Date(row.updated_at).toLocaleString(lang==='en'?'en-GB':'de-DE');
        info.append(title,small);button.type='button';button.textContent=copy('Öffnen','Open');button.addEventListener('click',()=>loadProject(row));card.append(info,button);list.append(card);
      });
    }catch{list.innerHTML='<p>'+copy('Projekte konnten nicht geladen werden.','Projects could not be loaded.')+'</p>'}
  }
  function loadProject(row){
    projectId=row.id||row.resume_code||crypto.randomUUID();Object.assign(room,{width:Number(row.room_geometry?.width_m||4.2),depth:Number(row.room_geometry?.depth_m||3.2),height:Number(row.room_geometry?.height_m||2.5)});
    objects=Array.isArray(row.room_objects)?row.room_objects:[];measurement=row.room_measurement||measurement;photoPath=row.room_photo_path||'';
    root.querySelector('[data-project-title]').value=row.title||copy('Mein Pflanzenraum','My plant room');
    ['width','depth','height'].forEach(k=>root.querySelector('[data-room-'+k+']').value=Number(room[k]).toFixed(2));
    selectedId=null;persistLocal();drawPlan();updateSummary();accountDialog?.close();projectStatus.textContent=copy('Gespeicherten Raum geladen.','Saved room loaded.');
  }
  root.querySelector('[data-refresh-projects]')?.addEventListener('click',loadProjectList);
  root.querySelectorAll('[data-open-account]').forEach(button=>button.addEventListener('click',()=>{accountDialog?.showModal();loadProjectList()}));

  root.querySelector('[data-add-setup]')?.addEventListener('click',async()=>{
    const products=objects.filter(o=>o.variantId),button=root.querySelector('[data-add-setup]');if(!products.length)return;
    const grouped=new Map();products.forEach(o=>grouped.set(o.variantId,(grouped.get(o.variantId)||0)+1));button.disabled=true;
    try{
      const response=await fetch(root.dataset.cartAddUrl||'/cart/add.js',{method:'POST',headers:{'content-type':'application/json','accept':'application/json'},body:JSON.stringify({items:[...grouped.entries()].map(([id,quantity])=>({id,quantity}))})});
      if(!response.ok)throw new Error();window.location.href=root.dataset.cartUrl||'/cart';
    }catch{projectStatus.textContent=copy('Produkte konnten nicht in den Warenkorb gelegt werden.','Products could not be added to cart.');button.disabled=false}
  });

  root.querySelector('[data-download-pdf]')?.addEventListener('click',async()=>{
    const button=root.querySelector('[data-download-pdf]');button.disabled=true;projectStatus.textContent=copy('PDF wird erstellt…','Creating PDF…');
    try{
      const {jsPDF}=await import('https://cdn.jsdelivr.net/npm/jspdf@4.2.1/+esm');
      const doc=new jsPDF({unit:'mm',format:'a4'}),title=sanitizePdf(root.querySelector('[data-project-title]')?.value||'LEAF Room Studio');
      doc.setFontSize(20);doc.text('LEAF Room Studio',15,18);doc.setFontSize(13);doc.text(title,15,28);
      doc.setFontSize(10);doc.text(sanitizePdf(copy('Raummasse: ','Room dimensions: '))+room.width.toFixed(2)+' m x '+room.depth.toFixed(2)+' m x '+room.height.toFixed(2)+' m',15,37);
      doc.text(sanitizePdf(copy('Messung: Planvorschlag / Foto-Referenz ist eine Naeherung und vor Ort zu pruefen.','Measurement: planning estimate / photo reference must be verified on site.')),15,44,{maxWidth:180});
      const image=plan.toDataURL('image/jpeg',.88);doc.addImage(image,'JPEG',15,54,180,116);
      let y=178;doc.setFontSize(12);doc.text(sanitizePdf(copy('Eingesetzte LEAF-Produkte','Placed LEAF products')),15,y);y+=7;doc.setFontSize(9);
      const products=objects.filter(o=>o.variantId);if(!products.length){doc.text(sanitizePdf(copy('Keine Produkte - reine Raumplanung.','No products - room planning only.')),15,y)}
      else{products.slice(0,14).forEach((o,i)=>{doc.text((i+1)+'. '+sanitizePdf(o.title)+' - '+sanitizePdf(money(o.price)),15,y,{maxWidth:180});y+=6})}
      const total=products.reduce((s,o)=>s+Number(o.price||0),0);if(products.length){y+=2;doc.setFontSize(10);doc.text(sanitizePdf(copy('Preisstand bei Export: ','Price at export: '))+sanitizePdf(money(total)),15,y)}
      doc.setFontSize(8);doc.text(sanitizePdf(copy('Produkte und Preise muessen vor dem Kauf im Shopify-Warenkorb erneut bestaetigt werden.','Products and prices must be reconfirmed in the Shopify cart before purchase.')),15,286,{maxWidth:180});
      doc.save('LEAF-Room-Studio-'+new Date().toISOString().slice(0,10)+'.pdf');projectStatus.textContent=copy('PDF wurde erstellt.','PDF created.');
    }catch{projectStatus.textContent=copy('PDF-Modul konnte nicht geladen werden. Nutze vorübergehend die Druckfunktion des Browsers als PDF.','PDF module could not load. Use the browser print function as PDF for now.');window.print()}
    finally{button.disabled=false}
  });

  restoreLocal();syncAccountState();drawPlan();updateSummary();
  new ResizeObserver(()=>drawPlan()).observe(plan);
})();
</script>