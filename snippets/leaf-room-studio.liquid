{% doc %}
Renders the mobile-first LEAF Room Studio with optional anonymous Supabase account,
private room-photo storage, measured room planning, Shopify product placement and free PDF export.
@param {collection} collection - Interieur collection used as the optional Shopify product library.
@param {string} section_id - Unique section identifier.
{% enddoc %}
{% liquid
  assign locale = request.locale.iso_code
  assign is_en = false
  if locale == 'en'
    assign is_en = true
  endif
%}
<leaf-room-studio
  id="InterieurRoomBuilderHeading"
  class="leaf-room-studio"
  data-supabase-url="https://vbqimcwaxcydegqlkkgw.supabase.co"
  data-supabase-key="sb_publishable_25iJ4M8n-lOcpAMwrcSADg_2sA96tCU"
  data-cart-add-url="{{ routes.cart_add_url | append: '.js' }}"
  data-cart-url="{{ routes.cart_url }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-locale="{{ request.locale.iso_code | escape }}"
>
  <section class="leaf-room-studio__shell" aria-labelledby="LeafRoomStudioTitle-{{ section_id }}">
    <header class="leaf-room-studio__hero">
      <div>
        <p class="leaf-room-studio__eyebrow">{% if is_en %}LEAF Room Studio · optional account{% else %}LEAF Room Studio · Konto optional{% endif %}</p>
        <h2 id="LeafRoomStudioTitle-{{ section_id }}">{% if is_en %}Turn your real room into a plant setup.{% else %}Mach aus deinem echten Raum ein Pflanzen-Setup.{% endif %}</h2>
        <p>{% if is_en %}Upload a room photo, calibrate a known distance and plan with neutral objects or real LEAF products. Saving, personalization and product use are optional.{% else %}Raumfoto aufnehmen, eine bekannte Strecke kalibrieren und anschließend mit neutralen Objekten oder echten LEAF-Produkten planen. Speichern, Personalisierung und Produkte bleiben optional.{% endif %}</p>
      </div>
      <ol class="leaf-room-studio__steps" aria-label="{% if is_en %}Planning steps{% else %}Planungsschritte{% endif %}">
        <li><b>01</b><span>{% if is_en %}Photo & measure{% else %}Foto & messen{% endif %}</span></li>
        <li><b>02</b><span>{% if is_en %}Plan room{% else %}Raum planen{% endif %}</span></li>
        <li><b>03</b><span>{% if is_en %}Place setup{% else %}Setup platzieren{% endif %}</span></li>
        <li><b>04</b><span>{% if is_en %}Save / PDF{% else %}Speichern / PDF{% endif %}</span></li>
      </ol>
    </header>

    <div class="leaf-room-studio__account" data-account-bar>
      <div>
        <span data-account-dot aria-hidden="true"></span>
        <strong data-account-label>{% if is_en %}Guest mode{% else %}Gastmodus{% endif %}</strong>
        <small data-account-copy>{% if is_en %}Plan freely. An account is only needed for cloud saving.{% else %}Frei planen. Ein Konto wird nur für Cloud-Speicherung benötigt.{% endif %}</small>
      </div>
      <div class="leaf-room-studio__account-actions">
        <button type="button" class="button button--secondary" data-create-anon>{% if is_en %}Create anonymous account{% else %}Anonymes Konto anlegen{% endif %}</button>
        <button type="button" class="button button--secondary" data-open-account hidden>{% if is_en %}Account & projects{% else %}Konto & Projekte{% endif %}</button>
      </div>
    </div>

    <div class="leaf-room-studio__grid">
      <section class="leaf-room-studio__panel" aria-labelledby="RoomPhotoTitle-{{ section_id }}">
        <div class="leaf-room-studio__panel-head">
          <span>01</span>
          <div><h3 id="RoomPhotoTitle-{{ section_id }}">{% if is_en %}Photo & measurement{% else %}Foto & Vermessung{% endif %}</h3>
          <p>{% if is_en %}One photo gives an estimate, not survey-grade accuracy. Calibrate with a known distance and correct dimensions at any time.{% else %}Ein Foto liefert eine Näherung, keine vermessungstechnische Genauigkeit. Kalibriere mit einer bekannten Strecke und korrigiere Maße jederzeit.{% endif %}</p></div>
        </div>
        <label class="leaf-room-studio__photo-upload">
          <input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" data-room-photo>
          <span>{% if is_en %}Take or choose room photo{% else %}Raumfoto aufnehmen oder auswählen{% endif %}</span>
          <small>{% if is_en %}The photo stays on this device unless you explicitly allow cloud storage.{% else %}Das Foto bleibt auf diesem Gerät, solange du Cloud-Speicherung nicht ausdrücklich erlaubst.{% endif %}</small>
        </label>
        <div class="leaf-room-studio__photo-stage" data-photo-stage hidden>
          <canvas data-photo-canvas width="1200" height="800" aria-label="{% if is_en %}Room photo measurement{% else %}Raumfoto Vermessung{% endif %}"></canvas>
          <p data-measure-hint>{% if is_en %}Tap two points that represent a known distance.{% else %}Tippe zwei Punkte an, deren reale Distanz du kennst.{% endif %}</p>
        </div>
        <div class="leaf-room-studio__measure-controls" data-measure-controls hidden>
          <label><span>{% if is_en %}Reference length (cm){% else %}Referenzlänge (cm){% endif %}</span><input type="number" min="10" max="1000" step="1" value="100" data-reference-cm></label>
          <button type="button" class="button button--secondary" data-set-reference>{% if is_en %}Use selected line as reference{% else %}Markierte Strecke als Referenz nutzen{% endif %}</button>
          <button type="button" class="button button--secondary" data-measure-line disabled>{% if is_en %}Measure another line{% else %}Weitere Strecke messen{% endif %}</button>
          <div class="leaf-room-studio__measure-apply" data-measure-apply hidden>
            <button type="button" data-apply-measure="width">{% if is_en %}Use as room width{% else %}Als Raumbreite übernehmen{% endif %}</button>
            <button type="button" data-apply-measure="depth">{% if is_en %}Use as room depth{% else %}Als Raumtiefe übernehmen{% endif %}</button>
          </div>
          <p class="leaf-room-studio__measure-result" data-measure-result aria-live="polite"></p>
        </div>
        <label class="leaf-room-studio__consent" data-photo-consent-wrap hidden>
          <input type="checkbox" data-photo-consent>
          <span>{% if is_en %}Store this room photo privately with my project. Without this consent only geometry and planning data are stored.{% else %}Dieses Raumfoto privat mit meinem Projekt speichern. Ohne diese Einwilligung werden nur Geometrie und Planungsdaten gespeichert.{% endif %}</span>
        </label>
      </section>

      <section class="leaf-room-studio__panel" aria-labelledby="RoomDimensionsTitle-{{ section_id }}">
        <div class="leaf-room-studio__panel-head">
          <span>02</span>
          <div><h3 id="RoomDimensionsTitle-{{ section_id }}">{% if is_en %}Confirm room dimensions{% else %}Raummaße bestätigen{% endif %}</h3>
          <p>{% if is_en %}Use the photo estimate or enter known measurements directly.{% else %}Nutze die Fotomessung oder trage bekannte Maße direkt ein.{% endif %}</p></div>
        </div>
        <div class="leaf-room-studio__dimensions">
          <label><span>{% if is_en %}Width (m){% else %}Breite (m){% endif %}</span><input type="number" min="1" max="20" step="0.05" value="4.20" data-room-width></label>
          <label><span>{% if is_en %}Depth (m){% else %}Tiefe (m){% endif %}</span><input type="number" min="1" max="20" step="0.05" value="3.20" data-room-depth></label>
          <label><span>{% if is_en %}Height (m){% else %}Höhe (m){% endif %}</span><input type="number" min="1.8" max="6" step="0.05" value="2.50" data-room-height></label>
        </div>
        <div class="leaf-room-studio__accuracy">
          <strong>{% if is_en %}Measurement status{% else %}Messstatus{% endif %}</strong>
          <span data-accuracy-label>{% if is_en %}Manually entered · verify on site{% else %}Manuell eingetragen · vor Ort prüfen{% endif %}</span>
        </div>
      </section>
    </div>

    <section class="leaf-room-studio__workspace" aria-labelledby="RoomPlanTitle-{{ section_id }}">
      <div class="leaf-room-studio__workspace-head">
        <div><span>03</span><h3 id="RoomPlanTitle-{{ section_id }}">{% if is_en %}Arrange the room{% else %}Raum einrichten{% endif %}</h3></div>
        <p>{% if is_en %}Use neutral planning objects or add real products. Product placement is indicative until verified physical product dimensions are available.{% else %}Nutze neutrale Planungsobjekte oder füge reale Produkte hinzu. Produktplatzierungen sind Planvorschläge, solange keine verifizierten Produktmaße vorliegen.{% endif %}</p>
      </div>
      <div class="leaf-room-studio__tools">
        <div class="leaf-room-studio__primitive-tools" role="group" aria-label="{% if is_en %}Planning objects{% else %}Planungsobjekte{% endif %}">
          <button type="button" data-add-kind="plant">{% if is_en %}+ Plant{% else %}+ Pflanze{% endif %}</button>
          <button type="button" data-add-kind="shelf">{% if is_en %}+ Shelf{% else %}+ Regal{% endif %}</button>
          <button type="button" data-add-kind="window">{% if is_en %}+ Window{% else %}+ Fenster{% endif %}</button>
          <button type="button" data-add-kind="planter">{% if is_en %}+ Planter{% else %}+ Gefäß{% endif %}</button>
        </div>
        <div class="leaf-room-studio__product-tools">
          <label>
            <span>{% if is_en %}Optional LEAF product{% else %}Optionales LEAF-Produkt{% endif %}</span>
            <select data-product-select>
              <option value="">{% if is_en %}Choose a product…{% else %}Produkt auswählen…{% endif %}</option>
              {% for product in collection.products limit: 80 %}
                {% assign variant = product.selected_or_first_available_variant %}
                {% if variant != blank and product.available %}
                  <option
                    value="{{ variant.id }}"
                    data-title="{{ product.title | escape }}"
                    data-price="{{ variant.price }}"
                    data-url="{{ product.url }}"
                    data-search="{{ product.title | append: ' ' | append: product.type | append: ' ' | append: product.tags | downcase | escape }}"
                    {% if product.featured_image != blank %}data-image="{{ product.featured_image | image_url: width: 320 }}"{% endif %}
                  >{{ product.title | escape }} · {{ variant.price | money }}</option>
                {% endif %}
              {% endfor %}
            </select>
          </label>
          <button type="button" class="button button--secondary" data-add-product>{% if is_en %}Add product{% else %}Produkt einsetzen{% endif %}</button>
        </div>
      </div>
      <div class="leaf-room-studio__plan-wrap">
        <canvas class="leaf-room-studio__plan" data-plan-canvas width="1400" height="900" aria-label="{% if is_en %}Interactive room plan{% else %}Interaktiver Raumplan{% endif %}"></canvas>
        <div class="leaf-room-studio__selection" data-selection hidden>
          <strong data-selection-title></strong>
          <div>
            <button type="button" data-rotate>{% if is_en %}Rotate{% else %}Drehen{% endif %}</button>
            <button type="button" data-duplicate>{% if is_en %}Duplicate{% else %}Duplizieren{% endif %}</button>
            <button type="button" data-delete>{% if is_en %}Delete{% else %}Löschen{% endif %}</button>
          </div>
        </div>
      </div>
      <div class="leaf-room-studio__summary">
        <div><span>{% if is_en %}Objects{% else %}Objekte{% endif %}</span><strong data-summary-count>0</strong></div>
        <div><span>{% if is_en %}LEAF products{% else %}LEAF-Produkte{% endif %}</span><strong data-summary-products>0</strong></div>
        <div><span>{% if is_en %}Current product total{% else %}Aktueller Produktwert{% endif %}</span><strong data-summary-price>—</strong></div>
        <button type="button" class="button" data-add-setup disabled>{% if is_en %}Add selected products to cart{% else %}Gewählte Produkte in den Warenkorb{% endif %}</button>
      </div>
    </section>

    <section class="leaf-room-studio__project" aria-labelledby="RoomProjectTitle-{{ section_id }}">
      <div class="leaf-room-studio__panel-head">
        <span>04</span>
        <div><h3 id="RoomProjectTitle-{{ section_id }}">{% if is_en %}Save, personalize or export{% else %}Speichern, personalisieren oder exportieren{% endif %}</h3>
        <p>{% if is_en %}Nothing here is required. The PDF download is always free and does not require an account.{% else %}Nichts davon ist Pflicht. Der PDF-Download ist immer kostenlos und benötigt kein Konto.{% endif %}</p></div>
      </div>
      <div class="leaf-room-studio__project-actions">
        <label class="leaf-room-studio__title-input"><span>{% if is_en %}Project name{% else %}Projektname{% endif %}</span><input type="text" maxlength="80" value="{% if is_en %}My plant room{% else %}Mein Pflanzenraum{% endif %}" data-project-title></label>
        <button type="button" class="button" data-save-cloud>{% if is_en %}Save project{% else %}Projekt speichern{% endif %}</button>
        <button type="button" class="button button--secondary" data-download-pdf>{% if is_en %}Download free PDF{% else %}PDF kostenlos herunterladen{% endif %}</button>
        <button type="button" class="button button--secondary" data-open-account>{% if is_en %}Account & projects{% else %}Konto & Projekte{% endif %}</button>
      </div>
      <p class="leaf-room-studio__status" data-project-status aria-live="polite"></p>
    </section>

    <dialog class="leaf-room-studio__dialog" data-account-dialog>
      <form method="dialog" class="leaf-room-studio__dialog-card">
        <div class="leaf-room-studio__dialog-head">
          <div><strong>{% if is_en %}LEAF account & projects{% else %}LEAF Konto & Projekte{% endif %}</strong><small>{% if is_en %}Anonymous by default. Personal details are optional.{% else %}Standardmäßig anonym. Persönliche Angaben sind optional.{% endif %}</small></div>
          <button type="submit" aria-label="{% if is_en %}Close{% else %}Schließen{% endif %}">×</button>
        </div>
        <div class="leaf-room-studio__dialog-grid">
          <section>
            <h4>{% if is_en %}Profile{% else %}Profil{% endif %}</h4>
            <label><span>{% if is_en %}Display name (optional){% else %}Anzeigename (optional){% endif %}</span><input type="text" maxlength="80" placeholder="{% if is_en %}e.g. Urban Jungle{% else %}z. B. Urban Jungle{% endif %}" data-display-name></label>
            <button type="button" class="button button--secondary" data-save-profile>{% if is_en %}Save profile{% else %}Profil speichern{% endif %}</button>
          </section>
          <section>
            <h4>{% if is_en %}Secure access across devices{% else %}Zugriff geräteübergreifend sichern{% endif %}</h4>
            <p>{% if is_en %}Add an email to the same anonymous account. Your project ownership remains unchanged.{% else %}Füge demselben anonymen Konto eine E-Mail hinzu. Die Eigentümerschaft deiner Projekte bleibt unverändert.{% endif %}</p>
            <label><span>E-Mail</span><input type="email" autocomplete="email" data-account-email></label>
            <button type="button" class="button button--secondary" data-link-email>{% if is_en %}Send verification{% else %}Bestätigung senden{% endif %}</button>
          </section>
        </div>
        <section class="leaf-room-studio__projects">
          <div class="leaf-room-studio__projects-head"><h4>{% if is_en %}Saved rooms{% else %}Gespeicherte Räume{% endif %}</h4><button type="button" data-refresh-projects>{% if is_en %}Refresh{% else %}Aktualisieren{% endif %}</button></div>
          <div data-project-list><p>{% if is_en %}Create an anonymous account to save rooms in the cloud.{% else %}Lege ein anonymes Konto an, um Räume in der Cloud zu speichern.{% endif %}</p></div>
        </section>
        <p class="leaf-room-studio__dialog-status" data-account-status aria-live="polite"></p>
      </form>
    </dialog>
  </section>
</leaf-room-studio>

{% stylesheet %}
.leaf-room-studio{display:block;margin-block:clamp(2rem,5vw,5rem);scroll-margin-top:110px}.leaf-room-studio__shell{border:1px solid var(--border);background:var(--background);overflow:hidden}.leaf-room-studio__hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr);gap:clamp(2rem,6vw,6rem);padding:clamp(1.4rem,4vw,3.4rem);background:linear-gradient(135deg,color-mix(in srgb,var(--accent-soft),white 30%),var(--background));border-bottom:1px solid var(--border)}.leaf-room-studio__eyebrow{margin:0 0 .7rem;color:var(--accent);font-size:.7rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.leaf-room-studio__hero h2{max-width:17ch;margin:0;font-size:clamp(2rem,4vw,4rem);line-height:1.02;letter-spacing:-.05em}.leaf-room-studio__hero p:last-child{max-width:58ch;color:var(--muted);line-height:1.65}.leaf-room-studio__steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin:0;padding:0;list-style:none}.leaf-room-studio__steps li{min-height:84px;display:grid;grid-template-columns:34px 1fr;align-items:center;gap:.6rem;padding:.8rem;border-top:3px solid var(--accent);background:color-mix(in srgb,var(--background),transparent 12%)}.leaf-room-studio__steps b{color:var(--accent);font-size:.7rem}.leaf-room-studio__steps span{font-size:.8rem;font-weight:760}.leaf-room-studio__account{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.85rem clamp(1rem,3vw,1.5rem);border-bottom:1px solid var(--border);background:var(--surface)}.leaf-room-studio__account>div:first-child{display:grid;grid-template-columns:12px minmax(0,1fr);gap:.1rem .55rem;align-items:center}.leaf-room-studio__account small{grid-column:2;color:var(--muted);font-size:.72rem}.leaf-room-studio__account-actions{display:flex;flex-wrap:wrap;gap:.5rem}.leaf-room-studio [data-account-dot]{width:10px;height:10px;border-radius:999px;background:var(--muted)}.leaf-room-studio.is-authenticated [data-account-dot]{background:var(--accent)}.leaf-room-studio__grid{display:grid;grid-template-columns:1.15fr .85fr}.leaf-room-studio__panel{padding:clamp(1.15rem,3vw,2rem);border-bottom:1px solid var(--border)}.leaf-room-studio__panel:first-child{border-right:1px solid var(--border)}.leaf-room-studio__panel-head{display:grid;grid-template-columns:36px 1fr;gap:.8rem;margin-bottom:1rem}.leaf-room-studio__panel-head>span,.leaf-room-studio__workspace-head>div>span{width:32px;height:32px;display:grid;place-items:center;border:1px solid var(--border);color:var(--accent);font-size:.68rem;font-weight:850}.leaf-room-studio__panel-head h3,.leaf-room-studio__workspace-head h3{margin:0;font-size:clamp(1.25rem,2vw,1.7rem);line-height:1.15}.leaf-room-studio__panel-head p,.leaf-room-studio__workspace-head p{margin:.35rem 0 0;color:var(--muted);font-size:.85rem;line-height:1.5}.leaf-room-studio__photo-upload{min-height:120px;display:grid;place-items:center;align-content:center;gap:.35rem;padding:1rem;border:1px dashed color-mix(in srgb,var(--accent),transparent 50%);background:color-mix(in srgb,var(--accent-soft),transparent 60%);text-align:center;cursor:pointer}.leaf-room-studio__photo-upload input{position:absolute;opacity:0;pointer-events:none}.leaf-room-studio__photo-upload span{font-weight:800}.leaf-room-studio__photo-upload small{max-width:46ch;color:var(--muted)}.leaf-room-studio__photo-stage{margin-top:1rem}.leaf-room-studio__photo-stage canvas{display:block;width:100%;max-height:420px;object-fit:contain;border:1px solid var(--border);background:#111;touch-action:manipulation}.leaf-room-studio__photo-stage p{margin:.5rem 0 0;color:var(--muted);font-size:.75rem}.leaf-room-studio__measure-controls{display:grid;grid-template-columns:minmax(140px,.7fr) 1fr 1fr;gap:.6rem;margin-top:.8rem;align-items:end}.leaf-room-studio label{display:grid;gap:.35rem}.leaf-room-studio label>span{font-size:.72rem;font-weight:760}.leaf-room-studio input,.leaf-room-studio select{width:100%;min-height:46px;border:1px solid var(--border);background:var(--background);color:var(--text);padding:.55rem .7rem;font:inherit}.leaf-room-studio__measure-apply{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.45rem}.leaf-room-studio__measure-apply[hidden]{display:none}.leaf-room-studio__measure-apply button{min-height:44px;border:1px solid var(--border);background:var(--surface);color:var(--text);padding:.55rem .75rem;font:inherit}.leaf-room-studio__measure-result{grid-column:1/-1;margin:0;color:var(--accent);font-size:.78rem;font-weight:760}.leaf-room-studio__consent{display:grid!important;grid-template-columns:auto 1fr!important;gap:.55rem!important;margin-top:.8rem;padding:.7rem;border:1px solid var(--border);background:var(--surface)}.leaf-room-studio__consent input{width:18px;min-height:auto;margin-top:.15rem}.leaf-room-studio__consent span{font-size:.76rem!important;font-weight:500!important;line-height:1.45}.leaf-room-studio__dimensions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}.leaf-room-studio__accuracy{display:flex;justify-content:space-between;gap:1rem;margin-top:1rem;padding:.75rem;border:1px solid var(--border);font-size:.76rem}.leaf-room-studio__accuracy span{color:var(--muted);text-align:right}.leaf-room-studio__workspace{padding:clamp(1.15rem,3vw,2rem);border-bottom:1px solid var(--border)}.leaf-room-studio__workspace-head{display:grid;grid-template-columns:minmax(0,.8fr) minmax(260px,1.2fr);gap:2rem;align-items:end;margin-bottom:1rem}.leaf-room-studio__workspace-head>div{display:flex;align-items:center;gap:.75rem}.leaf-room-studio__workspace-head p{margin:0}.leaf-room-studio__tools{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:.75rem}.leaf-room-studio__primitive-tools{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.4rem}.leaf-room-studio__primitive-tools button,.leaf-room-studio__selection button,.leaf-room-studio__projects-head button{min-height:44px;border:1px solid var(--border);background:var(--surface);color:var(--text);padding:.5rem;font:inherit}.leaf-room-studio__product-tools{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.45rem;align-items:end}.leaf-room-studio__plan-wrap{position:relative}.leaf-room-studio__plan{display:block;width:100%;aspect-ratio:16/9;max-height:660px;border:1px solid var(--border);background:linear-gradient(145deg,#f4f2eb,#e8eee7);touch-action:none}.leaf-room-studio__selection{position:absolute;right:.65rem;top:.65rem;max-width:min(360px,70%);padding:.65rem;border:1px solid var(--border);background:color-mix(in srgb,var(--background),transparent 4%);backdrop-filter:blur(12px)}.leaf-room-studio__selection>div{display:flex;gap:.35rem;margin-top:.45rem}.leaf-room-studio__summary{display:grid;grid-template-columns:repeat(3,minmax(0,.65fr)) minmax(220px,1.1fr);gap:1px;margin-top:.75rem;border:1px solid var(--border);background:var(--border)}.leaf-room-studio__summary>div{min-height:72px;display:flex;flex-direction:column;justify-content:center;padding:.7rem;background:var(--surface)}.leaf-room-studio__summary span{color:var(--muted);font-size:.68rem}.leaf-room-studio__summary strong{margin-top:.2rem}.leaf-room-studio__summary>.button{border-radius:0}.leaf-room-studio__project{padding:clamp(1.15rem,3vw,2rem)}.leaf-room-studio__project-actions{display:grid;grid-template-columns:minmax(180px,1fr) repeat(3,auto);gap:.6rem;align-items:end}.leaf-room-studio__status{margin:.7rem 0 0;color:var(--muted);font-size:.78rem}.leaf-room-studio__dialog{width:min(920px,calc(100% - 1rem));max-height:88%;padding:0;border:1px solid var(--border);background:var(--background);color:var(--text)}.leaf-room-studio__dialog::backdrop{background:rgba(10,18,13,.48);backdrop-filter:blur(4px)}.leaf-room-studio__dialog-card{padding:0}.leaf-room-studio__dialog-head{display:flex;justify-content:space-between;gap:1rem;padding:1rem 1.1rem;border-bottom:1px solid var(--border)}.leaf-room-studio__dialog-head>div{display:grid}.leaf-room-studio__dialog-head small{color:var(--muted)}.leaf-room-studio__dialog-head button{width:44px;height:44px;border:0;background:var(--surface);font-size:1.4rem}.leaf-room-studio__dialog-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border)}.leaf-room-studio__dialog-grid section{display:grid;gap:.7rem;padding:1rem;background:var(--background)}.leaf-room-studio__dialog-grid h4,.leaf-room-studio__projects h4{margin:0}.leaf-room-studio__dialog-grid p{margin:0;color:var(--muted);font-size:.8rem;line-height:1.45}.leaf-room-studio__projects{padding:1rem;border-top:1px solid var(--border)}.leaf-room-studio__projects-head{display:flex;align-items:center;justify-content:space-between;gap:1rem}.leaf-room-studio__project-list{display:grid;gap:.5rem;margin-top:.7rem}.leaf-room-studio__project-card{display:grid;grid-template-columns:1fr auto;gap:.5rem;padding:.7rem;border:1px solid var(--border);background:var(--surface)}.leaf-room-studio__project-card small{color:var(--muted)}.leaf-room-studio__dialog-status{margin:0;padding:0 1rem 1rem;color:var(--accent);font-size:.78rem}
