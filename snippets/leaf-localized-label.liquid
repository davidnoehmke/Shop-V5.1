{%- liquid
  assign label_key = blank
  if request.locale.iso_code == 'en'
    case text
      when 'Lösung finden'
        assign label_key = 'live_labels.solutions'
      when 'Substrat planen'
        assign label_key = 'live_labels.substrate_plan'
      when 'Interieur planen'
        assign label_key = 'live_labels.interior_plan'
      when 'Pflanzen & Räume'
        assign label_key = 'live_labels.plants_rooms'
      when 'Interieur Solutions'
        assign label_key = 'live_labels.interior'
      when 'Pflanzgefäße'
        assign label_key = 'live_labels.planters'
      when 'Substrat & Wurzeln'
        assign label_key = 'live_labels.substrate_roots'
      when 'Fertige Substrate'
        assign label_key = 'live_labels.ready_mix'
      when 'Bestandteile & Zusätze'
        assign label_key = 'live_labels.ingredients'
      when 'Eigene Mischung planen'
        assign label_key = 'live_labels.custom_mix'
      when 'Substratbestandteile verstehen'
        assign label_key = 'live_labels.ingredient_guide'
      when 'Anzucht & Pflege'
        assign label_key = 'live_labels.propagation_care'
      when 'Pflanzenpflege & Zubehör'
        assign label_key = 'live_labels.care'
      when 'Rankhilfen'
        assign label_key = 'live_labels.supports'
      when 'Wissen & Hilfe'
        assign label_key = 'live_labels.knowledge'
      when 'Kontakt & Rückruf'
        assign label_key = 'live_labels.contact'
      when 'Suche'
        assign label_key = 'live_labels.search'
      when 'Impressum'
        assign label_key = 'live_labels.legal'
      when 'Nutzungsbedingungen'
        assign label_key = 'live_labels.terms'
      when 'Datenschutzerklärung'
        assign label_key = 'live_labels.privacy'
      when 'Rückgabe & Erstattung'
        assign label_key = 'live_labels.refund'
      when 'Versandrichtlinie'
        assign label_key = 'live_labels.shipping'
      when 'Versandoptionen'
        assign label_key = 'live_labels.shipping_options'
      when 'Im Bestellprozess prüfen'
        assign label_key = 'live_labels.shipping_check'
      when 'Zahlungsarten'
        assign label_key = 'live_labels.payment'
      when 'Im Checkout verfügbar'
        assign label_key = 'live_labels.payment_available'
      when 'Kundenservice'
        assign label_key = 'live_labels.support'
      when 'Kontakt und Hilfe im Service'
        assign label_key = 'live_labels.support_help'
      when 'Sphagnum-Moos – für Stecklinge & Aroiden'
        assign label_key = 'live_labels.sphagnum'
    endcase
  endif
-%}
{%- if label_key != blank -%}{{- label_key | t -}}{%- else -%}{{- text | escape -}}{%- endif -%}
