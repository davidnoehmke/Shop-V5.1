{% doc %}
Renders a ready-made substrate mix with sizes, purchase form and recipe details.
@param {product} product - The mix product
@param {string} section_id - Parent section ID
@param {number} index - Product position
{% enddoc %}
{% liquid
  assign anchor = 'Mix-' | append: section_id | append: '-' | append: product.id
  assign form_id = anchor | append: '-form'
  assign image_alt = product.featured_image.alt | default: product.title
  assign intro = product.description | strip_html | truncatewords: 30
  assign ingredients = product.metafields.leafer.ingredients
  assign suitable = product.metafields.leafer.suitable_for
  assign application = product.metafields.leafer.additive_application
  assign water = product.metafields.leafer.water_behavior
  if request.locale.iso_code == 'de'
    assign intro = product.metafields.leafer.intro.value | default: product.metafields.leafer.subtitle.value | default: intro
  endif
  assign ordered_variants = product.variants | sort: 'price'
  assign initial_variant = ordered_variants | where: 'available', true | first
  if initial_variant == blank
    assign initial_variant = product.selected_or_first_available_variant
  endif
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
  assign cart_error = 'mix_highlights.cart_error' | t
%}
<article class="mix-highlight" id="{{ anchor }}" aria-labelledby="{{ anchor }}-title">
  <a class="mix-highlight__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if product.featured_image != blank %}
      {{ product.featured_image | image_url: width: 1200 | image_tag: widths: '360,540,720,960,1200', sizes: '(min-width: 901px) 46vw, 92vw', loading: image_loading, fetchpriority: image_priority, alt: image_alt }}
    {% endif %}
  </a>
  <div class="mix-highlight__body">
    <p class="mix-highlight__eyebrow"><span>{{ 'mix_highlights.ready' | t }}</span><span aria-hidden="true">0{{ index }}</span></p>
    <h2 id="{{ anchor }}-title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
    {% if intro != blank %}<p class="mix-highlight__intro">{{ intro | strip_html | escape }}</p>{% endif %}
    {% if request.locale.iso_code == 'de' and suitable.value != blank %}
      <p class="mix-highlight__suitable"><strong>{{ 'mix_highlights.suitable' | t }}</strong>{% render 'leaf-metafield-value', field: suitable %}</p>
    {% endif %}
    {% assign formatted_price = product.price | money %}
    <p class="mix-highlight__price">{% if product.price_varies %}{{ 'product.from_price' | t: price: formatted_price }}{% else %}{{ formatted_price }}{% endif %}</p>
    <p class="mix-highlight__tax">{% if cart.taxes_included %}{{ 'led_highlights.tax' | t }} · {% endif %}{% if shop.shipping_policy.url != blank %}<a href="{{ shop.shipping_policy.url }}">{{ 'led_highlights.shipping' | t }}</a>{% endif %}</p>
    {% if product.available and product.requires_selling_plan == false %}
      {% form 'product', product, id: form_id, class: 'mix-highlight__form js-leafer-cart-form', data-cart-error-message: cart_error %}
        {{ form.errors | default_errors }}
        {% if product.variants.size > 1 %}
          <label for="{{ anchor }}-size">{{ 'mix_highlights.size' | t }}</label>
          <select id="{{ anchor }}-size" name="id">
            {% for variant in ordered_variants %}
              <option value="{{ variant.id }}"{% if variant.id == initial_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                {{ variant.title | escape }} · {{ variant.price | money }}{% if variant.unit_price_measurement %} · {{ variant.unit_price | unit_price_with_measurement: variant.unit_price_measurement }}{% endif %}{% unless variant.available %} · {{ 'product.sold_out' | t }}{% endunless %}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ initial_variant.id }}">
        {% endif %}
        <input type="hidden" name="quantity" value="1">
        <button class="button" type="submit" name="add">{{ 'product.add_to_cart' | t }}</button>
        <p class="mix-highlight__error" data-cart-error role="alert" hidden></p>
      {% endform %}
    {% else %}
      <a class="button button--secondary" href="{{ product.url }}">{% if product.available %}{{ 'mix_highlights.details' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</a>
    {% endif %}
    {% if request.locale.iso_code == 'de' and ingredients.value != blank %}
      <details class="mix-highlight__details">
        <summary>{{ 'mix_highlights.ingredients' | t }}</summary>
        <div class="mix-highlight__details-body">
          {% if ingredients.type contains 'list.' %}<ul>{% for ingredient in ingredients.value %}<li>{{ ingredient | escape }}</li>{% endfor %}</ul>{% else %}{% render 'leaf-metafield-value', field: ingredients %}{% endif %}
          {% if product.metafields.leafer.mixing_ratio.value != blank %}<p>{{ product.metafields.leafer.mixing_ratio.value | escape }}</p>{% endif %}
        </div>
      </details>
    {% endif %}
    {% if request.locale.iso_code == 'de' %}
      {% if application.value != blank or water.value != blank %}
        <details class="mix-highlight__details">
          <summary>{{ 'mix_highlights.application' | t }}</summary>
          <div class="mix-highlight__details-body">
            {% if application.value != blank %}<p>{% render 'leaf-metafield-value', field: application %}</p>{% endif %}
            {% if water.value != blank %}<p>{% render 'leaf-metafield-value', field: water %}</p>{% endif %}
          </div>
        </details>
      {% endif %}
    {% endif %}
    {% if product.description != blank %}<details class="mix-highlight__details"><summary>{{ 'mix_highlights.description' | t }}</summary><div class="mix-highlight__details-body">{{ product.description }}</div></details>{% endif %}
    <a class="mix-showcase__text-link" href="{{ product.url }}">{{ 'mix_highlights.details' | t }} <span aria-hidden="true">→</span></a>
  </div>
</article>
