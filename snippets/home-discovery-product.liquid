{% if product != blank %}{% assign copy=product.metafields.leafer.intro.value | default: product.description | strip_html | truncate: 190 %}{% assign function=product.metafields.leafer.primary_function.value | default: product.metafields.leafer.subtitle.value | default: 'Ausgewählte Lösung' %}<article class="home-discovery__product" data-item data-topic="{{ topic }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% endif %}<div class="home-discovery__product-body"><p class="home-discovery__eyebrow">{{ label }}</p><h3>{{ product.title }}</h3><p class="home-discovery__function">{{ function }}</p>{% assign product_rating = product.metafields.reviews.rating.value %}{% assign product_rating_count = product.metafields.reviews.rating_count.value %}{% if product_rating != blank and product_rating_count != blank and product_rating_count > 0 %}<p class="home-discovery__rating" aria-label="{{ product_rating.rating }} von {{ product_rating.scale_max }} Sternen bei {{ product_rating_count }} Bewertungen"><span aria-hidden="true">★★★★★</span> <span>{{ product_rating.rating }} / {{ product_rating.scale_max }} · {{ product_rating_count }} {% if product_rating_count == 1 %}Bewertung{% else %}Bewertungen{% endif %}</span></p>{% endif %}<p>{{ copy }}</p><a href="{{ product.url }}">{{ details }}</a></div></article>{% endif %}