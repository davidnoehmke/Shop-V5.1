{% if product != blank %}
  {% assign copy = product.metafields.leafer.intro.value | default: product.description | strip_html | strip | truncatewords: 18 %}
  {% assign function = product.metafields.leafer.primary_function.value | default: product.metafields.leafer.subtitle.value | default: 'Ausgewählte Lösung' %}
  {% assign card_image = product.featured_image %}
  {% if card_image == blank and product.media.first.preview_image != blank %}
    {% assign card_image = product.media.first.preview_image %}
  {% endif %}
  <article class="home-discovery__product" data-item data-topic="{{ topic }}">
    <a class="home-discovery__media" href="{{ product.url }}" aria-label="{{ product.title | escape }} ansehen">
      {% if card_image != blank %}
        {{ card_image | image_url: width: 900 | image_tag:
          loading: 'lazy',
          widths: '320, 480, 640, 900',
          sizes: '(min-width: 900px) 22vw, 100vw',
          alt: card_image.alt | default: product.title
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'home-discovery__placeholder' }}
      {% endif %}
    </a>
    <div class="home-discovery__product-body">
      <p class="home-discovery__eyebrow">{{ label }}</p>
      <h3>{{ product.title }}</h3>
      <p class="home-discovery__function">{{ function }}</p>
      <p>{{ copy }}</p>
      <a href="{{ product.url }}">{{ details }}</a>
    </div>
  </article>
{% endif %}
