{% doc %}
Renders a product card with an optional compact layout and variant-safe quick add.
@param {product} product - Product to display
@param {boolean} [compact] - Use the compact card layout
@param {boolean} [interactive_facts] - Enable tap/click quick facts on collection cards
{% enddoc %}

{% liquid
  assign card_variant = product.selected_or_first_available_variant
  assign formatted_price = product.price_min | money
  assign card_image_alt = product.featured_image.alt | default: product.title
  assign card_descriptor = product.metafields.leafer.subtitle.value
  assign card_function = product.metafields.leafer.primary_function.value
  assign card_suitable = product.metafields.leafer.suitable_for.value
  assign card_difficulty = product.metafields.leafer.difficulty.value
  assign card_power = product.metafields.lighting.rated_power_w.value
  assign card_cct = product.metafields.lighting.cct_k.value
  assign card_mounting = product.metafields.lighting.mounting.value
  assign can_quick_add = false
  assign has_quick_facts = false

  if interactive_facts
    if card_function != blank or card_suitable != blank or card_difficulty != blank or card_power != blank or card_cct != blank or card_mounting != blank
      assign has_quick_facts = true
    endif
  endif
  assign from_price_text = 'product.from_price' | t: price: formatted_price
  assign choose_options_text = 'product.choose_options' | t
  assign sold_out_text = 'product.sold_out' | t
  assign bestseller_text = 'product.bestseller' | t
  assign special_mix_text = 'product.special_mix' | t
  assign quick_add_text = 'product.quick_add' | t: product: product.title

  if card_descriptor == blank
    assign card_descriptor = product.metafields.leafer.primary_function.value
  endif
  if card_descriptor == blank
    assign card_descriptor = product.type
  endif

  if from_price_text contains 'Translation missing'
    if request.locale.iso_code == 'de'
      assign from_price_text = 'Ab ' | append: formatted_price
    else
      assign from_price_text = 'From ' | append: formatted_price
    endif
  endif

  if choose_options_text contains 'Translation missing'
    if request.locale.iso_code == 'de'
      assign choose_options_text = 'Optionen wählen'
    else
      assign choose_options_text = 'Choose options'
    endif
  endif

  if sold_out_text contains 'Translation missing'
    assign sold_out_text = 'Ausverkauft'
  endif
  if bestseller_text contains 'Translation missing'
    assign bestseller_text = 'Bestseller'
  endif
  if special_mix_text contains 'Translation missing'
    assign special_mix_text = 'Spezialmischung'
  endif
  if quick_add_text contains 'Translation missing'
    assign quick_add_text = 'In den Warenkorb legen'
  endif

  if product.has_only_default_variant and card_variant != blank and card_variant.available
    assign can_quick_add = true
  endif
%}

<article class="product-card{% if compact %} product-card--compact{% endif %}{% if can_quick_add %} product-card--quick-add{% endif %}">
  <a class="product-card__link" href="{{ product.url }}">
    <div class="product-card__media">
      {% if product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 900 | image_tag: widths: '240, 360, 480, 640, 800, 900', sizes: '(min-width: 901px) 23vw, 46vw', loading: 'lazy', alt: card_image_alt }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <div class="product-card__copy">
      {% if product.tags contains 'Bestseller' or product.type == 'Spezialmischung' %}
        <span class="product-card__badge">
          {% if product.tags contains 'Bestseller' %}{{ bestseller_text }}{% else %}{{ special_mix_text }}{% endif %}
        </span>
      {% endif %}

      <h3>{{ product.title | escape }}</h3>
      {% if card_descriptor != blank %}<p>{{ card_descriptor | escape }}</p>{% endif %}

      <strong>
        {% if product.available %}
          {% if product.price_varies %}
            {{ from_price_text }}
          {% else %}
            {{ formatted_price }}
          {% endif %}
        {% else %}
          {{ sold_out_text }}
        {% endif %}
      </strong>

      {% unless product.has_only_default_variant %}
        {% if product.available %}
          <span class="product-card__options">{{ choose_options_text }} <span aria-hidden="true">→</span></span>
        {% endif %}
      {% endunless %}
    </div>
  </a>

  {% if has_quick_facts %}
    <details class="product-card__facts">
      <summary aria-label="{{ card_function | default: card_descriptor | default: product.title | escape }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10v7M12 7h.01"/></svg>
      </summary>
      <div class="product-card__facts-panel">
        {% if card_function != blank %}
          <span class="product-card__fact-row">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V10M12 15c-4 0-7-3-7-7 4 0 7 3 7 7ZM12 12c4 0 7-3 7-7-4 0-7 3-7 7Z"/></svg>
            <span>{{ card_function | escape }}</span>
          </span>
        {% endif %}
        {% if card_suitable != blank %}
          <span class="product-card__fact-row">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 18c3-6 6-9 14-12M7 7c2 0 4 2 4 4-3 0-5-1-6-3M13 13c2-2 5-2 7-1-1 3-3 5-7 5"/></svg>
            <span>{{ card_suitable | join: ' · ' | escape }}</span>
          </span>
        {% endif %}
        {% if card_power != blank or card_cct != blank %}
          <span class="product-card__fact-row">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 22h4M8 14c-1.4-1.1-2-2.8-2-4.6A6 6 0 0 1 18 9.4c0 1.8-.7 3.5-2 4.6-.8.7-1.2 1.4-1.3 2H9.3c-.1-.6-.5-1.3-1.3-2Z"/></svg>
            <span>{% if card_power != blank %}{{ card_power }} W{% endif %}{% if card_power != blank and card_cct != blank %} · {% endif %}{% if card_cct != blank %}{{ card_cct }} K{% endif %}</span>
          </span>
        {% endif %}
        {% if card_mounting != blank %}
          <span class="product-card__fact-row">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h16M7 20V8h10v12M9 8V4h6v4"/></svg>
            <span>{{ card_mounting | strip_html | truncatewords: 10 | escape }}</span>
          </span>
        {% endif %}
        {% if card_difficulty != blank %}
          <span class="product-card__fact-row">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18h4l3-5 3 3 2-6 4 8"/></svg>
            <span>{{ card_difficulty | escape }}</span>
          </span>
        {% endif %}
      </div>
    </details>
  {% endif %}

  {% if can_quick_add %}
    {% form 'product', product, class: 'product-card__form' %}
      <input type="hidden" name="id" value="{{ card_variant.id }}">
      <button type="submit" name="add" aria-label="{{ quick_add_text | escape }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2 12h11l2-9H6M10 10h6M13 7v6M9 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM17 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/></svg>
      </button>
    {% endform %}
  {% endif %}
</article>

{% stylesheet %}
  .product-card { position: relative; min-width: 0; border: 1px solid var(--border); border-radius: var(--radius); background: color-mix(in srgb, var(--background), white 25%); overflow: hidden; transition: transform .3s var(--ease-out), border-color .2s ease, box-shadow .3s var(--ease-out); }
  .product-card:focus-within { border-color: color-mix(in srgb, var(--accent), transparent 45%); box-shadow: var(--shadow-soft); }
  .product-card__link { display: block; height: 100%; padding: 1rem; text-decoration: none; }
  .product-card__media { aspect-ratio: 1 / 1; display: grid; place-items: center; overflow: hidden; padding: clamp(.6rem, 1.35vw, 1.1rem); background: #f5f2eb; }
  .product-card__media img,
  .product-card__media svg { width: 100%; height: 100%; object-fit: contain; object-position: center; transition: transform .35s ease; }
  .product-card__copy { padding-top: 1rem; }
  .product-card--quick-add .product-card__copy { padding-right: 50px; }
  .product-card__badge { display: inline-block; margin-bottom: .4rem; padding: .2rem .5rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: .65rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
  .product-card__copy h3,
  .product-card__copy p,
  .product-card__copy strong { display: block; margin: 0; font-family: inherit; }
  .product-card__copy h3 { display: -webkit-box; min-height: 2.8em; overflow: hidden; font-size: .95rem; font-weight: 750; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .product-card__copy p { min-height: 1.3em; color: var(--muted); font-size: .78rem; }
  .product-card__copy strong { margin-top: .8rem; font-size: 1.05rem; }
  .product-card__options { display: inline-flex; align-items: center; gap: .35rem; margin-top: .65rem; color: var(--accent); font-size: .78rem; font-weight: 800; }
  .product-card__facts { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
  .product-card__facts summary { position: absolute; top: 1.65rem; right: 1.65rem; width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid var(--border); background: color-mix(in srgb, var(--background), white 18%); color: var(--text); cursor: pointer; list-style: none; pointer-events: auto; transition: background .2s ease, color .2s ease, border-color .2s ease; }
  .product-card__facts summary::-webkit-details-marker { display: none; }
  .product-card__facts summary svg { width: 19px; fill: none; stroke: currentColor; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; }
  .product-card__facts[open] summary { border-color: var(--accent); background: var(--accent); color: #fff; }
  .product-card__facts-panel { position: absolute; top: 4.55rem; left: .75rem; right: .75rem; display: grid; gap: .55rem; padding: .8rem; border: 1px solid color-mix(in srgb, var(--accent), transparent 55%); background: color-mix(in srgb, var(--background), white 10%); box-shadow: 0 16px 34px rgba(30,45,37,.14); backdrop-filter: blur(14px); pointer-events: auto; }
  .product-card__fact-row { display: grid; grid-template-columns: 22px minmax(0,1fr); align-items: start; gap: .55rem; color: var(--text); font-size: .72rem; line-height: 1.4; }
  .product-card__fact-row svg { width: 18px; fill: none; stroke: var(--accent); stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; }
  .product-card__form { position: absolute; right: 1rem; bottom: 1rem; z-index: 4; }
  .product-card__form button { width: 48px; min-height: 48px; padding: 0; }
  .product-card__form svg { width: 21px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .product-card--compact .product-card__link { padding: .8rem; }
  .product-card--compact .product-card__media { aspect-ratio: 1 / 1; padding: clamp(.5rem, 1vw, .9rem); }
  .product-card--compact.product-card--quick-add .product-card__copy { padding-right: 46px; }
  .product-card--compact .product-card__form { right: .75rem; bottom: .75rem; }
  .product-card--compact .product-card__form button { width: 44px; min-height: 44px; background: transparent; border-color: var(--border); color: var(--text); }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover { transform: translateY(-5px); border-color: color-mix(in srgb, var(--accent), transparent 58%); box-shadow: var(--shadow-soft); }
    .product-card:hover .product-card__media img { transform: scale(1.035); }
  }

  @media (max-width: 560px) {
    .product-card__link { padding: .55rem; }
    .product-card__media { aspect-ratio: 1 / 1; padding: .3rem; }
    .product-card__copy { padding: .75rem .1rem 0; }
    .product-card--quick-add .product-card__copy { padding-right: .1rem; padding-bottom: 3.25rem; }
    .product-card__copy h3 { min-height: 3.6em; font-size: .88rem; line-height: 1.2; -webkit-line-clamp: 3; hyphens: auto; }
    .product-card__copy p { display: block; min-height: 1.3em; margin-top: .35rem; font-size: .7rem; }
    .product-card__copy strong { margin-top: .45rem; font-size: .95rem; }
    .product-card__options { font-size: .72rem; }
    .product-card__facts summary { top: .85rem; right: .85rem; width: 36px; height: 36px; }
    .product-card__facts-panel { top: 3.45rem; left: .45rem; right: .45rem; padding: .65rem; }
    .product-card__fact-row { font-size: .68rem; }
    .product-card__form { right: .55rem; bottom: .55rem; }
    .product-card__form button,
    .product-card--compact .product-card__form button { width: 48px; min-height: 48px; }
  }
{% endstylesheet %}
