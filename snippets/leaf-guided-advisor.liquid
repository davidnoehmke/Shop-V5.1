{% doc %}
Renders one shared, mobile-first advisor for collection pages. The advisor derives public decision options from product metafields and keeps specialist configurators separate as advanced tools.
@param {collection} collection - Current collection.
@param {string} section_id - Parent collection section id for anchor targets.
{% enddoc %}

{% liquid
  assign advisor_products = collection.products
  assign advisor_count = collection.products_count
  assign advisor_has_guidance = false
  for advisor_product in advisor_products limit: 50
    if advisor_product.metafields.leaf_configurator.problem_tags.value != blank or advisor_product.metafields.leaf_configurator.growth_goals.value != blank or advisor_product.metafields.leaf_configurator.location_types.value != blank or advisor_product.metafields.leaf_configurator.room_types.value != blank or advisor_product.metafields.leaf_configurator.light_conditions.value != blank or advisor_product.metafields.leaf_configurator.plant_stages.value != blank or advisor_product.metafields.leaf_configurator.setup_types.value != blank or advisor_product.metafields.leaf_configurator.watering_styles.value != blank or advisor_product.metafields.leaf_configurator.appearance_preferences.value != blank or advisor_product.metafields.leafer.suitable_for.value != blank or advisor_product.metafields.leafer.primary_function.value != blank or advisor_product.metafields.lighting.use_cases.value != blank
      assign advisor_has_guidance = true
      break
    endif
  endfor
%}

{% if advisor_count > 0 and advisor_has_guidance %}
<leaf-guided-advisor
  id="LeafAdvisor"
  class="leaf-advisor"
  data-storage-key="leaf-guided-advisor-v1"
  data-collection="{{ collection.handle | escape }}"
  data-match-label="{{ 'collection.advisor.match_label' | t | escape }}"
  data-view-label="{{ 'collection.advisor.view_product' | t | escape }}"
  data-result-count-label="{{ 'collection.advisor.result_count' | t | escape }}"
>
  <section class="leaf-advisor__shell" aria-labelledby="LeafAdvisorHeading">
    <header class="leaf-advisor__head">
      <div>
        <p class="leaf-advisor__eyebrow">{{ 'collection.advisor.eyebrow' | t }}</p>
        <h2 id="LeafAdvisorHeading">{{ 'collection.advisor.heading' | t }}</h2>
        <p>{{ 'collection.advisor.intro' | t }}</p>
      </div>
      <div class="leaf-advisor__head-actions">
        <span class="leaf-advisor__resume" data-resume hidden>{{ 'collection.advisor.resume' | t }}</span>
        <a href="#CollectionProducts-{{ section_id }}">{{ 'collection.advisor.skip_to_products' | t }}</a>
      </div>
    </header>

    <div class="leaf-advisor__progress" aria-label="{{ 'collection.advisor.progress_label' | t }}">
      <div class="leaf-advisor__progress-copy">
        <strong data-progress-text></strong>
        <span data-selection-summary>{{ 'collection.advisor.no_selection' | t }}</span>
      </div>
      <div class="leaf-advisor__progress-track" aria-hidden="true"><span data-progress-bar></span></div>
    </div>

    <div class="leaf-advisor__layout">
      <div class="leaf-advisor__flow">
        <fieldset class="leaf-advisor__step" data-step="need">
          <legend>{{ 'collection.advisor.need_heading' | t }}</legend>
          <p>{{ 'collection.advisor.need_text' | t }}</p>
          <div class="leaf-advisor__options" data-options="need"></div>
        </fieldset>

        <fieldset class="leaf-advisor__step" data-step="context" hidden>
          <legend>{{ 'collection.advisor.context_heading' | t }}</legend>
          <p>{{ 'collection.advisor.context_text' | t }}</p>
          <div class="leaf-advisor__options" data-options="context"></div>
        </fieldset>

        <fieldset class="leaf-advisor__step" data-step="preference" hidden>
          <legend>{{ 'collection.advisor.preference_heading' | t }}</legend>
          <p>{{ 'collection.advisor.preference_text' | t }}</p>
          <div class="leaf-advisor__options" data-options="preference"></div>
        </fieldset>

        <div class="leaf-advisor__step leaf-advisor__step--result" data-step="result" hidden>
          <div class="leaf-advisor__result-head">
            <div>
              <p class="leaf-advisor__eyebrow">{{ 'collection.advisor.result_eyebrow' | t }}</p>
              <h3>{{ 'collection.advisor.result_heading' | t }}</h3>
            </div>
            <button type="button" data-reset>{{ 'collection.advisor.reset' | t }}</button>
          </div>
          <p data-result-copy>{{ 'collection.advisor.result_text' | t }}</p>
          <div class="leaf-advisor__results" data-results aria-live="polite"></div>
          <a class="leaf-advisor__all-products" href="#CollectionProducts-{{ section_id }}">{{ 'collection.advisor.all_products' | t }} <span aria-hidden="true">↓</span></a>
        </div>

        <div class="leaf-advisor__nav">
          <button type="button" class="leaf-advisor__back" data-back>{{ 'collection.advisor.back' | t }}</button>
          <button type="button" class="leaf-advisor__next" data-next>{{ 'collection.advisor.next' | t }}</button>
        </div>
      </div>

      <aside class="leaf-advisor__summary" aria-live="polite">
        <p class="leaf-advisor__eyebrow">{{ 'collection.advisor.summary_eyebrow' | t }}</p>
        <h3>{{ 'collection.advisor.summary_heading' | t }}</h3>
        <div class="leaf-advisor__summary-list" data-summary-list>
          <span>{{ 'collection.advisor.no_selection' | t }}</span>
        </div>
        <p>{{ 'collection.advisor.summary_note' | t }}</p>
      </aside>
    </div>

    <div data-product-source hidden>
      {% for card_product in advisor_products limit: 50 %}
        {% liquid
          assign problem_tags = card_product.metafields.leaf_configurator.problem_tags.value
          assign growth_goals = card_product.metafields.leaf_configurator.growth_goals.value
          assign light_use_cases = card_product.metafields.lighting.use_cases.value
          assign primary_function = card_product.metafields.leafer.primary_function.value

          assign location_types = card_product.metafields.leaf_configurator.location_types.value
          assign room_types = card_product.metafields.leaf_configurator.room_types.value
          assign light_conditions = card_product.metafields.leaf_configurator.light_conditions.value
          assign plant_stages = card_product.metafields.leaf_configurator.plant_stages.value
          assign suitable_for = card_product.metafields.leafer.suitable_for.value

          assign setup_types = card_product.metafields.leaf_configurator.setup_types.value
          assign watering_styles = card_product.metafields.leaf_configurator.watering_styles.value
          assign appearance_preferences = card_product.metafields.leaf_configurator.appearance_preferences.value
          assign mounting = card_product.metafields.lighting.mounting.value
          assign dimmable = card_product.metafields.lighting.dimmable.value

          capture needs_blob
            if problem_tags != blank
              echo problem_tags | join: '||'
            endif
            if growth_goals != blank
              echo '||'
              echo growth_goals | join: '||'
            endif
            if light_use_cases != blank
              echo '||'
              echo light_use_cases | join: '||'
            endif
            if primary_function != blank
              echo '||'
              echo primary_function
            endif
          endcapture

          capture context_blob
            if location_types != blank
              echo location_types | join: '||'
            endif
            if room_types != blank
              echo '||'
              echo room_types | join: '||'
            endif
            if light_conditions != blank
              echo '||'
              echo light_conditions | join: '||'
            endif
            if plant_stages != blank
              echo '||'
              echo plant_stages | join: '||'
            endif
            if suitable_for != blank
              echo '||'
              echo suitable_for | join: '||'
            endif
          endcapture

          capture preference_blob
            if setup_types != blank
              echo setup_types | join: '||'
            endif
            if watering_styles != blank
              echo '||'
              echo watering_styles | join: '||'
            endif
            if appearance_preferences != blank
              echo '||'
              echo appearance_preferences | join: '||'
            endif
            if mounting != blank
              echo '||'
              echo mounting
            endif
            if dimmable == true
              echo '||'
              echo 'collection.advisor.dimmable' | t
            endif
          endcapture

          assign card_image = card_product.featured_image
          assign card_price = card_product.price_min | money
          assign card_price_sort = card_product.price_min | divided_by: 100.0
        %}
        <span
          data-advisor-product
          data-title="{{ card_product.title | escape }}"
          data-url="{{ card_product.url }}"
          data-price="{{ card_price | escape }}"
          data-price-sort="{{ card_price_sort }}"
          data-needs="{{ needs_blob | strip | escape }}"
          data-contexts="{{ context_blob | strip | escape }}"
          data-preferences="{{ preference_blob | strip | escape }}"
          {% if card_image != blank %}data-image="{{ card_image | image_url: width: 480 }}"{% endif %}
        ></span>
      {% endfor %}
    </div>
  </section>
</leaf-guided-advisor>

{% stylesheet %}
.leaf-advisor{display:block;margin-block:clamp(1.5rem,4vw,3.5rem);scroll-margin-top:96px}
.leaf-advisor__shell{border:1px solid var(--border);background:var(--background)}
.leaf-advisor__head{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(210px,.55fr);gap:1.5rem;align-items:end;padding:clamp(1rem,2.5vw,1.5rem);border-bottom:1px solid var(--border)}
.leaf-advisor__head h2{margin:.2rem 0 0;max-width:18ch;font-size:clamp(1.7rem,3vw,2.7rem);line-height:1;letter-spacing:-.04em}
.leaf-advisor__head p:not(.leaf-advisor__eyebrow){max-width:64ch;margin:.7rem 0 0;color:var(--muted);line-height:1.55}
.leaf-advisor__eyebrow{margin:0;color:var(--accent);font-size:.68rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}
.leaf-advisor__head-actions{display:flex;flex-direction:column;align-items:flex-end;gap:.55rem;font-size:.76rem}
.leaf-advisor__head-actions a{color:var(--text);font-weight:800;text-underline-offset:3px}
.leaf-advisor__resume{padding:.35rem .5rem;border:1px solid var(--accent);color:var(--accent);font-weight:800}
.leaf-advisor__progress{padding:.75rem clamp(1rem,2.5vw,1.5rem);border-bottom:1px solid var(--border);background:var(--surface)}
.leaf-advisor__progress-copy{display:flex;justify-content:space-between;gap:1rem;align-items:center;font-size:.72rem}
.leaf-advisor__progress-copy span{color:var(--muted);text-align:right}
.leaf-advisor__progress-track{height:3px;margin-top:.55rem;background:var(--border);overflow:hidden}
.leaf-advisor__progress-track span{display:block;height:100%;width:25%;background:var(--accent);transition:width .2s ease}
.leaf-advisor__layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr)}
.leaf-advisor__flow{min-width:0;padding:clamp(1rem,2.5vw,1.5rem)}
.leaf-advisor__step{min-width:0;margin:0;padding:0;border:0}
.leaf-advisor__step[hidden]{display:none}
.leaf-advisor__step legend,.leaf-advisor__step--result h3{margin:0;font-size:clamp(1.35rem,2.4vw,2rem);font-weight:850;line-height:1.05}
.leaf-advisor__step>p{max-width:58ch;margin:.55rem 0 1rem;color:var(--muted);line-height:1.5}
.leaf-advisor__options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}
.leaf-advisor__option{min-height:54px;padding:.7rem .8rem;border:1px solid var(--border);background:var(--background);color:var(--text);text-align:left;font:inherit;font-size:.78rem;font-weight:750;cursor:pointer}
.leaf-advisor__option[aria-pressed="true"]{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,var(--background));box-shadow:inset 3px 0 0 var(--accent)}
.leaf-advisor__nav{display:flex;justify-content:space-between;gap:.65rem;margin-top:1.2rem;padding-top:1rem;border-top:1px solid var(--border)}
.leaf-advisor__nav button{min-height:50px;min-width:120px;padding:.65rem .9rem;border:1px solid var(--text);font:inherit;font-size:.78rem;font-weight:850;cursor:pointer}
.leaf-advisor__back{background:transparent;color:var(--text)}
.leaf-advisor__next{margin-left:auto;background:var(--text);color:var(--background)}
.leaf-advisor__summary{padding:clamp(1rem,2.5vw,1.5rem);border-left:1px solid var(--border);background:var(--surface)}
.leaf-advisor__summary h3{margin:.3rem 0 .9rem;font-size:1.15rem}
.leaf-advisor__summary-list{display:flex;flex-wrap:wrap;gap:.4rem}
.leaf-advisor__summary-list span{display:inline-flex;padding:.4rem .55rem;border:1px solid var(--border);background:var(--background);font-size:.7rem}
.leaf-advisor__summary>p:last-child{margin:1rem 0 0;color:var(--muted);font-size:.72rem;line-height:1.5}
.leaf-advisor__result-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}
.leaf-advisor__result-head button{border:0;background:none;color:var(--muted);text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.leaf-advisor__results{display:grid;gap:.65rem;margin-top:1rem}
.leaf-advisor__result-card{display:grid;grid-template-columns:76px minmax(0,1fr) auto;gap:.8rem;align-items:center;padding:.7rem;border:1px solid var(--border);background:var(--surface)}
.leaf-advisor__result-card img{width:76px;height:76px;object-fit:contain;background:var(--background)}
.leaf-advisor__result-card strong,.leaf-advisor__result-card span{display:block}
.leaf-advisor__result-card strong{font-size:.84rem;line-height:1.3}
.leaf-advisor__result-card span{margin-top:.2rem;color:var(--muted);font-size:.7rem}
.leaf-advisor__result-card a{min-height:44px;display:inline-flex;align-items:center;padding:.55rem .7rem;border:1px solid var(--text);color:var(--text);font-size:.72rem;font-weight:850;text-decoration:none}
.leaf-advisor__all-products{display:inline-flex;margin-top:1rem;font-size:.78rem;font-weight:850;color:var(--text)}
@media(max-width:820px){
  .leaf-advisor__head{grid-template-columns:1fr;align-items:start}
  .leaf-advisor__head-actions{align-items:flex-start}
  .leaf-advisor__layout{grid-template-columns:1fr}
  .leaf-advisor__summary{border-left:0;border-top:1px solid var(--border)}
}
@media(max-width:749px){
  .leaf-advisor{margin-inline:calc(var(--page-padding,1rem) * -1)}
  .leaf-advisor__shell{border-inline:0}
  .leaf-advisor__head{padding:1rem}
  .leaf-advisor__head h2{font-size:clamp(1.7rem,8vw,2.3rem)}
  .leaf-advisor__progress{position:sticky;top:0;z-index:6;padding:.7rem 1rem}
  .leaf-advisor__flow{padding:1rem 1rem 0}
  .leaf-advisor__options{grid-template-columns:1fr}
  .leaf-advisor__option{min-height:56px;font-size:.8rem}
  .leaf-advisor__summary{display:none}
  .leaf-advisor__nav{position:sticky;bottom:0;z-index:5;margin-inline:-1rem;padding: .75rem 1rem max(.75rem,env(safe-area-inset-bottom));background:color-mix(in srgb,var(--background) 94%,transparent);backdrop-filter:blur(12px)}
  .leaf-advisor__nav button{min-height:54px;flex:1}
  .leaf-advisor__result-card{grid-template-columns:64px minmax(0,1fr);align-items:start}
  .leaf-advisor__result-card img{width:64px;height:64px}
  .leaf-advisor__result-card a{grid-column:1/-1;justify-content:center}
}
@media(prefers-reduced-motion:reduce){.leaf-advisor__progress-track span{transition:none}}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('leaf-guided-advisor')) {
  customElements.define('leaf-guided-advisor', class extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      this.rows = Array.from(this.querySelectorAll('[data-advisor-product]')).map((node) => ({
        title: node.dataset.title || '',
        url: node.dataset.url || '',
        price: node.dataset.price || '',
        priceSort: Number(node.dataset.priceSort || 0),
        image: node.dataset.image || '',
        need: this.values(node.dataset.needs),
        context: this.values(node.dataset.contexts),
        preference: this.values(node.dataset.preferences)
      }));
      this.state = { need: '', context: '', preference: '' };
      this.groupOrder = ['need', 'context', 'preference'];
      this.optionSets = {};
      this.groupOrder.forEach((group) => this.buildOptions(group));
      this.steps = this.groupOrder.filter((group) => this.optionSets[group]?.length).concat('result');
      if (!this.steps.length) return;
      this.restore();
      this.index = 0;
      this.bind();
      this.update();
    }

    values(raw) {
      return String(raw || '').split('||').map((value) => value.trim()).filter(Boolean);
    }

    key(value) {
      return String(value || '').trim().toLocaleLowerCase();
    }

    buildOptions(group) {
      const counts = new Map();
      this.rows.forEach((row) => {
        row[group].forEach((value) => {
          const normalized = this.key(value);
          if (!normalized) return;
          const current = counts.get(normalized) || { value, count: 0 };
          current.count += 1;
          counts.set(normalized, current);
        });
      });
      const options = Array.from(counts.values())
        .sort((a, b) => b.count - a.count || a.value.localeCompare(b.value))
        .slice(0, 10);
      this.optionSets[group] = options;
      const host = this.querySelector('[data-options="' + group + '"]');
      if (!host) return;
      options.forEach((item) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'leaf-advisor__option';
        button.dataset.optionGroup = group;
        button.dataset.optionValue = item.value;
        button.setAttribute('aria-pressed', 'false');
        button.textContent = item.value;
        host.append(button);
      });
    }

    bind() {
      this.addEventListener('click', (event) => {
        const option = event.target.closest('[data-option-group]');
        if (option) {
          const group = option.dataset.optionGroup;
          const value = option.dataset.optionValue || '';
          this.state[group] = this.state[group] === value ? '' : value;
          this.save();
          this.updateOptions();
          this.updateSummary();
          return;
        }
        if (event.target.closest('[data-next]')) {
          if (this.index < this.steps.length - 1) this.index += 1;
          this.update();
          return;
        }
        if (event.target.closest('[data-back]')) {
          if (this.index > 0) this.index -= 1;
          this.update();
          return;
        }
        if (event.target.closest('[data-reset]')) {
          this.state = { need: '', context: '', preference: '' };
          this.index = 0;
          this.save();
          this.update();
        }
      });
    }

    restore() {
      try {
        const stored = JSON.parse(localStorage.getItem(this.dataset.storageKey) || '{}');
        const selected = stored?.selected || {};
        this.groupOrder.forEach((group) => {
          const valid = this.optionSets[group]?.some((item) => this.key(item.value) === this.key(selected[group]));
          if (valid) this.state[group] = selected[group];
        });
        if (Object.values(this.state).some(Boolean)) {
          const resume = this.querySelector('[data-resume]');
          if (resume) resume.hidden = false;
        }
      } catch {}
    }

    save() {
      try {
        localStorage.setItem(this.dataset.storageKey, JSON.stringify({
          selected: this.state,
          collection: this.dataset.collection || '',
          updatedAt: Date.now()
        }));
      } catch {}
    }

    updateOptions() {
      this.querySelectorAll('[data-option-group]').forEach((button) => {
        const group = button.dataset.optionGroup;
        button.setAttribute('aria-pressed', String(this.key(this.state[group]) === this.key(button.dataset.optionValue)));
      });
    }

    updateSummary() {
      const selected = this.groupOrder.map((group) => this.state[group]).filter(Boolean);
      const label = selected.length ? selected.join(' · ') : this.querySelector('[data-selection-summary]')?.textContent || '';
      const progressSummary = this.querySelector('[data-selection-summary]');
      if (progressSummary) progressSummary.textContent = selected.length ? label : '—';
      const host = this.querySelector('[data-summary-list]');
      if (!host) return;
      host.replaceChildren();
      if (!selected.length) {
        const empty = document.createElement('span');
        empty.textContent = '—';
        host.append(empty);
        return;
      }
      selected.forEach((value) => {
        const chip = document.createElement('span');
        chip.textContent = value;
        host.append(chip);
      });
    }

    update() {
      const active = this.steps[this.index];
      this.querySelectorAll('[data-step]').forEach((node) => {
        node.hidden = node.dataset.step !== active;
      });
      const back = this.querySelector('[data-back]');
      const next = this.querySelector('[data-next]');
      if (back) back.hidden = this.index === 0 || active === 'result';
      if (next) next.hidden = active === 'result';
      const progressText = this.querySelector('[data-progress-text]');
      if (progressText) progressText.textContent = String(this.index + 1) + '/' + String(this.steps.length);
      const bar = this.querySelector('[data-progress-bar]');
      if (bar) bar.style.width = (((this.index + 1) / this.steps.length) * 100) + '%';
      this.updateOptions();
      this.updateSummary();
      if (active === 'result') this.renderResults();
    }

    renderResults() {
      const selected = this.groupOrder.filter((group) => this.state[group]).map((group) => ({
        group,
        value: this.state[group],
        key: this.key(this.state[group])
      }));
      const ranked = this.rows.map((row) => {
        let score = 0;
        let matched = 0;
        selected.forEach((selection) => {
          const values = row[selection.group].map((value) => this.key(value));
          if (!values.includes(selection.key)) return;
          matched += 1;
          score += selection.group === 'need' ? 5 : selection.group === 'context' ? 3 : 2;
        });
        return { row, score, matched };
      }).sort((a, b) => b.score - a.score || a.row.priceSort - b.row.priceSort);

      const shortlist = (selected.length ? ranked.filter((item) => item.matched > 0) : ranked).slice(0, 3);
      const host = this.querySelector('[data-results]');
      const copy = this.querySelector('[data-result-copy]');
      if (!host) return;
      host.replaceChildren();

      if (copy) {
        copy.textContent = String(shortlist.length) + ' ' + (this.dataset.resultCountLabel || '');
      }

      shortlist.forEach((item) => {
        const article = document.createElement('article');
        article.className = 'leaf-advisor__result-card';
        if (item.row.image) {
          const image = document.createElement('img');
          image.src = item.row.image;
          image.alt = '';
          image.loading = 'lazy';
          article.append(image);
        } else {
          const spacer = document.createElement('span');
          spacer.setAttribute('aria-hidden', 'true');
          article.append(spacer);
        }
        const copyNode = document.createElement('div');
        const title = document.createElement('strong');
        title.textContent = item.row.title;
        const meta = document.createElement('span');
        const match = selected.length ? String(item.matched) + '/' + String(selected.length) + ' ' + (this.dataset.matchLabel || '') : '';
        meta.textContent = [match, item.row.price].filter(Boolean).join(' · ');
        copyNode.append(title, meta);
        const link = document.createElement('a');
        link.href = item.row.url;
        link.textContent = this.dataset.viewLabel || '';
        article.append(copyNode, link);
        host.append(article);
      });
    }
  });
}
{% endjavascript %}
{% endif %}