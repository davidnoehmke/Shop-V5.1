{% doc %}
  Adds a display unit only when the populated value does not already contain it.
  Preserves textual units instead of silently reinterpreting their meaning.
  @param {metafield} field - Populated technical metafield.
  @param {string} unit - Unit used for a bare value.
{% enddoc %}
{%- liquid
  assign value = field.value | append: '' | strip
  assign normalized = value | downcase
  assign normalized_unit = unit | downcase
  assign has_unit = false
  if normalized contains normalized_unit
    assign has_unit = true
  elsif unit == 'µmol/s'
    if normalized contains 'µmol' or normalized contains 'μmol'
      assign has_unit = true
    endif
  endif
-%}
{%- if value != blank -%}{{ value | escape }}{% unless has_unit %} {{ unit | escape }}{% endunless %}{%- endif -%}
