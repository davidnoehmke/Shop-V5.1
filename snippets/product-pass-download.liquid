{% doc %}
  Renders an optional product PDF; a variant PDF takes precedence.
  @param {metafield} product_pass_pdf - A product file_reference metafield.
  @param {metafield} variant_pass_pdf - An optional variant file_reference metafield.
{% enddoc %}
{% liquid
  assign default_pass_url = product_pass_pdf.value.url
  assign active_pass_url = variant_pass_pdf.value.url | default: default_pass_url
%}
<leaf-product-pass>
  <aside class="product-pass-download"{% if active_pass_url == blank %} hidden{% endif %} aria-labelledby="ProductPass-{{ section.id }}" data-product-pass-download data-default-pass-url="{{ default_pass_url | escape }}">
    <div>
      <p class="product-pass-download__eyebrow">Pflegewissen zum Produkt</p>
      <h2 id="ProductPass-{{ section.id }}">Produktpass herunterladen</h2>
      <p>Pflege-, Anwendungs- und Mischhinweise passend zu diesem Produkt – kompakt als PDF.</p>
    </div>
    <a class="button button--secondary"{% if active_pass_url != blank %} href="{{ active_pass_url | escape }}"{% endif %} target="_blank" rel="noopener" data-product-pass-link>
      PDF öffnen <span aria-hidden="true">↗</span>
    </a>
  </aside>
</leaf-product-pass>
<script>
  if (!customElements.get('leaf-product-pass')) {
    customElements.define('leaf-product-pass', class extends HTMLElement {
      connectedCallback() {
        this.hostSection = this.closest('.main-product') || this.parentElement;
        this.syncPass = () => {
          const panel = this.querySelector('[data-product-pass-download]');
          const link = this.querySelector('[data-product-pass-link]');
          const option = this.hostSection?.querySelector('[data-product-variant]')?.selectedOptions?.[0];
          if (!panel || !link) return;
          const candidate = option
            ? (option.dataset.passUrl || panel.dataset.defaultPassUrl || '')
            : (link.getAttribute('href') || panel.dataset.defaultPassUrl || '');
          let safeUrl = '';
          try {
            const parsed = new URL(candidate, document.baseURI);
            if (candidate && ['https:', 'http:'].includes(parsed.protocol)) safeUrl = parsed.href;
          } catch (_) { /* Missing or invalid files must not become links to the current page. */ }
          if (safeUrl) link.setAttribute('href', safeUrl);
          else link.removeAttribute('href');
          panel.hidden = !safeUrl;
        };
        this.hostSection?.addEventListener('product:variant-change', this.syncPass);
        this.syncPass();
      }
      disconnectedCallback() {
        this.hostSection?.removeEventListener('product:variant-change', this.syncPass);
      }
    });
  }
</script>
{% stylesheet %}
  leaf-product-pass { display: block; }
  .product-pass-download { display: grid; gap: 1rem; margin-top: 1.4rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: color-mix(in srgb, var(--accent-soft), transparent 45%); }
  .product-pass-download[hidden] { display: none !important; }
  .product-pass-download__eyebrow { margin: 0 0 .2rem; color: var(--accent); font-size: .7rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  .product-pass-download h2 { margin: 0; font-size: 1.2rem; line-height: 1.05; }
  .product-pass-download p:not(.product-pass-download__eyebrow) { margin: .45rem 0 0; color: var(--muted); font-size: .82rem; }
  .product-pass-download .button { justify-self: start; min-height: 44px; padding-inline: 1rem; font-size: .82rem; }
  .product-pass-download .button span { margin-left: .4rem; }
  @media (min-width: 801px) { .product-pass-download { grid-template-columns: 1fr auto; align-items: center; } .product-pass-download .button { justify-self: end; } }
{% endstylesheet %}
