{% doc %}
Adds page-level semantic data only where it complements commerce schema generated elsewhere.
Internal keyword/search-intent strategy is intentionally not emitted to the storefront.
{% enddoc %}

{% liquid
  assign structured_name = blank
  assign structured_description = blank
  assign public_about = blank
  assign use_case = blank
  assign knowledge_atoms = blank

  if request.page_type == 'product'
    assign structured_name = seo_title | default: product.title
    assign structured_description = seo_description | default: product.metafields.custom.seo_description.value | default: product.description | strip_html | strip
    assign public_about = product.metafields.leafer.primary_function.value | default: product.type | strip_html | strip
    assign use_case = product.metafields.custom.use_case.value | default: product.metafields.leafer.suitable_for.value | strip_html | strip
    assign knowledge_atoms = product.metafields.leafer.knowledge_atoms.value
  elsif request.page_type == 'collection'
    assign structured_name = seo_title | default: collection.title
    assign structured_description = seo_description | default: collection.metafields.leafer.intro.value | default: collection.description | strip_html | strip
    assign public_about = collection.title | strip_html | strip
    assign knowledge_atoms = collection.metafields.leafer.knowledge_atoms.value
  endif
%}

{% if request.page_type == 'product' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": {{ canonical_url | append: '#content' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ structured_name | json }},
      "description": {{ structured_description | truncate: 320 | json }},
      "mainEntity": {"@id": {{ canonical_url | append: '#product' | json }}}{% if public_about != blank %},
      "about": {{ public_about | json }}{% endif %}{% if use_case != blank %},
      "audience": {"@type": "Audience", "audienceType": {{ use_case | truncate: 240 | json }}}{% endif %}{% if knowledge_atoms != blank %},
      "mentions": [
        {% for atom in knowledge_atoms limit: 12 %}
          {"@type":"Thing","name":{{ atom.name.value | json }}}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]{% endif %}
    }
  </script>
{% elsif request.page_type == 'collection' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": {{ canonical_url | append: '#collection' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ structured_name | json }},
      "description": {{ structured_description | truncate: 320 | json }}{% if public_about != blank %},
      "about": {{ public_about | json }}{% endif %}{% if knowledge_atoms != blank %},
      "mentions": [
        {% for atom in knowledge_atoms limit: 12 %}
          {"@type":"Thing","name":{{ atom.name.value | json }}}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]{% endif %}
    }
  </script>
{% endif %}
