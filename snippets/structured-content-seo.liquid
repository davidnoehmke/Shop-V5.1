{% doc %}
Adds page-level semantic data only where it complements commerce schema generated elsewhere. Product commerce schema remains owned by Shopify/the active commerce SEO layer. Longtail and search-intent fields are editorial inputs and are not emitted as obsolete meta-keywords or hidden keyword lists.
{% enddoc %}

{% liquid
  assign structured_name = blank
  assign structured_description = blank
  assign search_intent = blank
  assign use_case = blank

  if request.page_type == 'product'
    assign structured_name = seo_title | default: product.title
    assign structured_description = seo_description | default: product.metafields.custom.seo_description.value | default: product.description | strip_html | strip
    assign search_intent = product.metafields.leafer.search_intent.value | strip_html | strip
    assign use_case = product.metafields.custom.use_case.value | default: product.metafields.leafer.suitable_for.value | strip_html | strip
  elsif request.page_type == 'collection'
    assign structured_name = seo_title | default: collection.title
    assign structured_description = seo_description | default: collection.description | strip_html | strip
    assign search_intent = collection.metafields.leafer.search_intent.value | strip_html | strip
  endif
%}

{% if request.page_type == 'product' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": {{ canonical_url | append: '#content' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ structured_name | json }},
      "description": {{ structured_description | truncate: 320 | json }},
      "mainEntity": {"@id": {{ canonical_url | append: '#product' | json }}}{% if search_intent != blank %},
      "about": {{ search_intent | json }}{% endif %}{% if use_case != blank %},
      "audience": {"@type": "Audience", "audienceType": {{ use_case | truncate: 240 | json }}}{% endif %}
    }
  </script>
{% elsif request.page_type == 'collection' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": {{ canonical_url | append: '#collection' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ structured_name | json }},
      "description": {{ structured_description | truncate: 320 | json }}{% if search_intent != blank %},
      "about": {{ search_intent | json }}{% endif %}
    }
  </script>
{% endif %}
