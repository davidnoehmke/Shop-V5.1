{% doc %}
Renders an inline LEAF knowledge icon from a semantic icon key.

@param {string} icon_key - Semantic icon key stored on the content atom.
{% enddoc %}

{% case icon_key %}
  {% when 'air' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h10c2.7 0 2.7-4 0-4-1.1 0-2 .6-2.5 1.4M4 13h14c2.7 0 2.7 4 0 4-1.1 0-2-.6-2.5-1.4M4 17h7"/></svg>
  {% when 'water', 'water_reservoir' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3s6 7 6 12a6 6 0 0 1-12 0c0-5 6-12 6-12Z"/><path d="M9 16c.6 1.2 1.5 1.8 3 1.8"/></svg>
  {% when 'leaf', 'moss', 'fiber', 'succulent' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z"/><path d="M6 18c3-4 6-7 10-9"/></svg>
  {% when 'light' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 22h4M8 14c-1.4-1.1-2-2.8-2-4.6A6 6 0 0 1 18 9.4c0 1.8-.7 3.5-2 4.6-.8.7-1.2 1.4-1.3 2H9.3c-.1-.6-.5-1.3-1.3-2Z"/></svg>
  {% when 'pot' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8h10l-1 12H8L7 8ZM5 5h14v3H5z"/></svg>
  {% when 'seed', 'sprout' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V10M12 14c-4 0-7-3-7-7 4 0 7 3 7 7ZM12 12c4 0 7-3 7-7-4 0-7 3-7 7Z"/></svg>
  {% when 'support' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V4M7 8c3 0 5 2 5 5M17 11c-3 0-5 2-5 5M6 21h12"/></svg>
  {% when 'bundle' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 8 8-4 8 4-8 4-8-4Zm0 0v8l8 4 8-4V8M12 12v8"/></svg>
  {% when 'room' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V7l8-4 8 4v13M8 20v-6h8v6"/></svg>
  {% when 'care' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18c2-4 5-7 10-10M5 20l3-3M14 5l5 5M4 10l5-5 10 10-5 5L4 10Z"/></svg>
  {% when 'layers', 'bark', 'humus' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 8 8-4 8 4-8 4-8-4Zm0 4 8 4 8-4M4 16l8 4 8-4"/></svg>
  {% when 'porous_stone', 'lava', 'crystal', 'granulate', 'clay' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 17 2-9 6-4 6 5-1 9-8 2-5-3Z"/><path d="M9 10h.01M14 8h.01M13 14h.01M8 15h.01"/></svg>
  {% else %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4M12 16h.01"/></svg>
{% endcase %}
