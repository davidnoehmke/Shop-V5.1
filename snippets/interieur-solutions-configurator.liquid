{% doc %}
Renders the Interieur Solutions system configurator for the dedicated collection.
@param {collection} collection - Interieur Solutions collection whose products are ranked.
{% enddoc %}

{% if collection != blank and collection.handle == 'interieur-solutions' %}
  <interieur-solutions-configurator
    class="interieur-configurator"
    data-result-one="{{ 'collection.interieur.result_one' | t | escape }}"
    data-result-many="{{ 'collection.interieur.result_many' | t | escape }}"
    data-no-result="{{ 'collection.interieur.no_result' | t | escape }}"
    data-budget-relaxed="{{ 'collection.interieur.budget_relaxed' | t | escape }}"
    data-profile-copy="{{ 'collection.interieur.result_copy' | t | escape }}"
  >
    <section class="interieur-configurator__section" aria-labelledby="InterieurConfiguratorHeading">
      <header class="interieur-configurator__head">
        <div>
          <p class="interieur-configurator__eyebrow">{{ 'collection.interieur.eyebrow' | t }}</p>
          <h2 id="InterieurConfiguratorHeading">{{ 'collection.interieur.heading' | t }}</h2>
          <p class="interieur-configurator__intro">{{ 'collection.interieur.intro' | t }}</p>
        </div>
        <div class="interieur-configurator__progress" aria-hidden="true">
          <span>{{ 'collection.interieur.steps.room' | t }}</span>
          <span>{{ 'collection.interieur.steps.project' | t }}</span>
          <span>{{ 'collection.interieur.steps.mount' | t }}</span>
          <span>{{ 'collection.interieur.steps.light' | t }}</span>
          <span>{{ 'collection.interieur.steps.budget' | t }}</span>
        </div>
      </header>

      <div class="interieur-configurator__workspace">
        <form class="interieur-configurator__form" data-config-form>
          <fieldset>
            <legend>{{ 'collection.interieur.steps.room' | t }}</legend>
            <div class="interieur-configurator__options">
              <label><input type="radio" name="room" value="living" checked><span data-option-label>{{ 'collection.interieur.room.living' | t }}</span></label>
              <label><input type="radio" name="room" value="office"><span data-option-label>{{ 'collection.interieur.room.office' | t }}</span></label>
              <label><input type="radio" name="room" value="kitchen"><span data-option-label>{{ 'collection.interieur.room.kitchen' | t }}</span></label>
              <label><input type="radio" name="room" value="plantroom"><span data-option-label>{{ 'collection.interieur.room.plantroom' | t }}</span></label>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ 'collection.interieur.steps.project' | t }}</legend>
            <div class="interieur-configurator__options interieur-configurator__options--wide">
              <label><input type="radio" name="project" value="single" checked><span data-option-label>{{ 'collection.interieur.project.single' | t }}</span></label>
              <label><input type="radio" name="project" value="shelf"><span data-option-label>{{ 'collection.interieur.project.shelf' | t }}</span></label>
              <label><input type="radio" name="project" value="pendant"><span data-option-label>{{ 'collection.interieur.project.pendant' | t }}</span></label>
              <label><input type="radio" name="project" value="station"><span data-option-label>{{ 'collection.interieur.project.station' | t }}</span></label>
              <label><input type="radio" name="project" value="habitat"><span data-option-label>{{ 'collection.interieur.project.habitat' | t }}</span></label>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ 'collection.interieur.steps.mount' | t }}</legend>
            <div class="interieur-configurator__options interieur-configurator__options--wide">
              <label><input type="radio" name="mount" value="open" checked><span data-option-label>{{ 'collection.interieur.mount.open' | t }}</span></label>
              <label><input type="radio" name="mount" value="e27"><span data-option-label>{{ 'collection.interieur.mount.e27' | t }}</span></label>
              <label><input type="radio" name="mount" value="shelf"><span data-option-label>{{ 'collection.interieur.mount.shelf' | t }}</span></label>
              <label><input type="radio" name="mount" value="pendant"><span data-option-label>{{ 'collection.interieur.mount.pendant' | t }}</span></label>
              <label><input type="radio" name="mount" value="floor"><span data-option-label>{{ 'collection.interieur.mount.floor' | t }}</span></label>
              <label><input type="radio" name="mount" value="system"><span data-option-label>{{ 'collection.interieur.mount.system' | t }}</span></label>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ 'collection.interieur.steps.light' | t }}</legend>
            <div class="interieur-configurator__options">
              <label><input type="radio" name="light" value="supplement" checked><span data-option-label>{{ 'collection.interieur.light.supplement' | t }}</span></label>
              <label><input type="radio" name="light" value="balanced"><span data-option-label>{{ 'collection.interieur.light.balanced' | t }}</span></label>
              <label><input type="radio" name="light" value="intensive"><span data-option-label>{{ 'collection.interieur.light.intensive' | t }}</span></label>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ 'collection.interieur.steps.budget' | t }}</legend>
            <div class="interieur-configurator__options">
              <label><input type="radio" name="budget" value="75"><span data-option-label>{{ 'collection.interieur.budget.under_75' | t }}</span></label>
              <label><input type="radio" name="budget" value="150" checked><span data-option-label>{{ 'collection.interieur.budget.under_150' | t }}</span></label>
              <label><input type="radio" name="budget" value="300"><span data-option-label>{{ 'collection.interieur.budget.under_300' | t }}</span></label>
              <label><input type="radio" name="budget" value="500"><span data-option-label>{{ 'collection.interieur.budget.under_500' | t }}</span></label>
              <label><input type="radio" name="budget" value="open"><span data-option-label>{{ 'collection.interieur.budget.open' | t }}</span></label>
            </div>
          </fieldset>

          <button type="button" class="interieur-configurator__reset" data-reset>
            {{ 'collection.interieur.reset' | t }}
          </button>
        </form>

        <aside class="interieur-configurator__profile" aria-live="polite">
          <p class="interieur-configurator__eyebrow">{{ 'collection.interieur.result_eyebrow' | t }}</p>
          <h3 data-profile-title>{{ 'collection.interieur.result_default' | t }}</h3>
          <p data-profile-copy>{{ 'collection.interieur.result_copy' | t }}</p>
          <div class="interieur-configurator__chips" data-profile-chips></div>
          <strong class="interieur-configurator__count" data-result-count></strong>
          <span class="interieur-configurator__budget-note" data-budget-note hidden></span>
          <a class="interieur-configurator__all-link" href="#CollectionProducts-{{ section.id | default: 'interieur' }}">
            {{ 'collection.interieur.all_products' | t }} <span aria-hidden="true">↓</span>
          </a>
        </aside>
      </div>

      <div class="interieur-configurator__recommendations">
        <header>
          <p class="interieur-configurator__eyebrow">{{ 'collection.interieur.recommendations_eyebrow' | t }}</p>
          <h3>{{ 'collection.interieur.recommendations' | t }}</h3>
          <p>{{ 'collection.interieur.recommendations_intro' | t }}</p>
        </header>

        <div class="interieur-configurator__grid" data-recommendations>
          {% for product in collection.products limit: 50 %}
            {% liquid
              assign watts = product.metafields.lighting.rated_power_w.value | default: 0 | plus: 0
              assign mounting = product.metafields.lighting.mounting.value
              assign role = product.metafields.leaf_configurator.role.value
              assign price_value = product.price_min | divided_by: 100.0
              assign tags_text = product.tags | join: ' '
              capture search_blob
                echo product.title
                echo ' '
                echo product.type
                echo ' '
                echo product.vendor
                echo ' '
                echo tags_text
                echo ' '
                echo mounting
                echo ' '
                echo role
              endcapture
              assign search_blob = search_blob | strip_newlines | downcase | strip
            %}
            <div
              class="interieur-configurator__product"
              data-solution-card
              data-search="{{ search_blob | escape }}"
              data-price="{{ price_value }}"
              data-watts="{{ watts }}"
              hidden
            >
              {% render 'product-card', product: product, compact: true, interactive_facts: true %}
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
  </interieur-solutions-configurator>

  {% stylesheet %}
    .interieur-configurator { display: block; margin-block: clamp(2.5rem, 5vw, 5rem); }
    .interieur-configurator__section { border-block: 1px solid var(--border); padding-block: clamp(2.5rem, 5vw, 5rem); }
    .interieur-configurator__head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr); gap: clamp(2rem, 6vw, 6rem); align-items: end; }
    .interieur-configurator__eyebrow { margin: 0 0 .6rem; color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
    .interieur-configurator__head h2 { max-width: 13ch; margin: 0; font-size: clamp(2.5rem, 5vw, 5rem); line-height: .96; letter-spacing: -.05em; }
    .interieur-configurator__intro { max-width: 68ch; margin: 1rem 0 0; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.65; }
    .interieur-configurator__progress { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .35rem; }
    .interieur-configurator__progress span { min-height: 52px; display: flex; align-items: flex-end; padding: .55rem .45rem; border-top: 3px solid var(--accent); color: var(--muted); font-size: .64rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }

    .interieur-configurator__workspace { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr); gap: clamp(1.5rem, 4vw, 4rem); margin-top: 2rem; align-items: start; }
    .interieur-configurator__form { display: grid; gap: 1rem; }
    .interieur-configurator__form fieldset { margin: 0; padding: 1rem; border: 1px solid var(--border); }
    .interieur-configurator__form legend { padding: 0 .45rem; color: var(--text); font-size: .78rem; font-weight: 850; letter-spacing: .06em; text-transform: uppercase; }
    .interieur-configurator__options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .45rem; }
    .interieur-configurator__options--wide { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .interieur-configurator__options label { min-width: 0; }
    .interieur-configurator__options input { position: absolute; opacity: 0; pointer-events: none; }
    .interieur-configurator__options span { min-height: 48px; display: flex; align-items: center; justify-content: center; padding: .55rem .65rem; border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer; font-size: .76rem; font-weight: 750; line-height: 1.25; text-align: center; transition: border-color .18s ease, background-color .18s ease, color .18s ease, transform .18s ease; }
    .interieur-configurator__options input:checked + span { border-color: var(--accent); background: var(--accent); color: #fff; }
    .interieur-configurator__options input:focus-visible + span { outline: 3px solid color-mix(in srgb, var(--accent), white 40%); outline-offset: 2px; }
    @media (hover: hover) { .interieur-configurator__options span:hover { transform: translateY(-2px); border-color: var(--accent); } }
    .interieur-configurator__reset { justify-self: start; min-height: 44px; border: 0; border-bottom: 1px solid currentColor; border-radius: 0; padding: 0; background: transparent; color: var(--muted); box-shadow: none; font-size: .78rem; }
    .interieur-configurator__reset:hover { transform: none; box-shadow: none; color: var(--accent); }

    .interieur-configurator__profile { position: sticky; top: 100px; padding: clamp(1.2rem, 2.5vw, 2rem); border: 1px solid var(--border); background: color-mix(in srgb, var(--surface), var(--background) 20%); }
    .interieur-configurator__profile h3 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.8rem); line-height: 1; letter-spacing: -.04em; }
    .interieur-configurator__profile > p:not(.interieur-configurator__eyebrow) { margin: .9rem 0 0; color: var(--muted); line-height: 1.6; }
    .interieur-configurator__chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1rem; }
    .interieur-configurator__chips span { padding: .35rem .5rem; border: 1px solid var(--border); color: var(--muted); font-size: .7rem; font-weight: 750; }
    .interieur-configurator__count { display: block; margin-top: 1.2rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 1.05rem; }
    .interieur-configurator__budget-note { display: block; margin-top: .5rem; color: var(--accent); font-size: .76rem; font-weight: 750; }
    .interieur-configurator__budget-note[hidden] { display: none; }
    .interieur-configurator__all-link { display: inline-flex; gap: .45rem; align-items: center; margin-top: 1.2rem; color: var(--text); font-size: .8rem; font-weight: 800; text-decoration: none; }

    .interieur-configurator__recommendations { margin-top: clamp(2rem, 5vw, 4rem); }
    .interieur-configurator__recommendations > header { display: grid; grid-template-columns: minmax(0, .8fr) minmax(300px, 1.2fr); gap: 1rem 3rem; align-items: end; margin-bottom: 1.2rem; }
    .interieur-configurator__recommendations > header .interieur-configurator__eyebrow { grid-column: 1 / -1; margin-bottom: 0; }
    .interieur-configurator__recommendations h3 { margin: 0; font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1; letter-spacing: -.04em; }
    .interieur-configurator__recommendations > header > p:last-child { margin: 0; color: var(--muted); line-height: 1.6; }
    .interieur-configurator__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
    .interieur-configurator__product[hidden] { display: none; }

    @media (max-width: 1050px) {
      .interieur-configurator__head, .interieur-configurator__workspace { grid-template-columns: 1fr; }
      .interieur-configurator__profile { position: static; }
      .interieur-configurator__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 720px) {
      .interieur-configurator__progress { grid-template-columns: repeat(5, minmax(76px, 1fr)); overflow-x: auto; padding-bottom: .35rem; }
      .interieur-configurator__options, .interieur-configurator__options--wide { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .interieur-configurator__recommendations > header { grid-template-columns: 1fr; }
      .interieur-configurator__recommendations > header .interieur-configurator__eyebrow { grid-column: auto; }
      .interieur-configurator__grid { gap: .55rem; }
    }
    @media (max-width: 390px) {
      .interieur-configurator__form fieldset { padding: .75rem; }
      .interieur-configurator__options span { min-height: 46px; padding: .45rem; font-size: .7rem; }
    }
  {% endstylesheet %}

  {% javascript %}
    class InterieurSolutionsConfigurator extends HTMLElement {
      connectedCallback() {
        if (this.dataset.ready === 'true') return;
        this.dataset.ready = 'true';

        this.form = this.querySelector('[data-config-form]');
        this.cards = [...this.querySelectorAll('[data-solution-card]')];
        this.profileTitle = this.querySelector('[data-profile-title]');
        this.profileCopy = this.querySelector('[data-profile-copy]');
        this.profileChips = this.querySelector('[data-profile-chips]');
        this.resultCount = this.querySelector('[data-result-count]');
        this.budgetNote = this.querySelector('[data-budget-note]');
        this.results = this.querySelector('[data-recommendations]');

        this.form?.addEventListener('input', () => this.update());
        this.querySelector('[data-reset]')?.addEventListener('click', () => this.reset());

        this.update();
      }

      value(name) {
        return this.form?.querySelector(`input[name="${name}"]:checked`)?.value || '';
      }

      label(name) {
        return this.form?.querySelector(`input[name="${name}"]:checked`)?.closest('label')?.querySelector('[data-option-label]')?.textContent?.trim() || '';
      }

      includes(text, terms) {
        return terms.some((term) => text.includes(term));
      }

      score(card, state) {
        const text = (card.dataset.search || '').toLocaleLowerCase('de-DE');
        const watts = Number(card.dataset.watts || 0);
        let score = 0;

        const projectTerms = {
          single: ['e27', 'par30', 'par38', 'teleskop', 'willow', 'vita', 'pflanzenlampe', 'pflanzenleuchte'],
          shelf: ['regal', 'grove', 'aurora', 'bar', 'tube', 'cx91', 'cx83'],
          pendant: ['pendel', 'pendant', 'wand', 'luna', 'aspect', 'stello'],
          station: ['pflanzenregal', 'gewächshaus', 'station', 'growzelt', 'vivosun', 'barrina', 'cx91', 'cx83'],
          habitat: ['terrarium', 'aquascap', 'wasserpflanz', 'daytime', 'sera', 'repmac']
        };
        if (this.includes(text, projectTerms[state.project] || [])) score += state.project === 'habitat' ? 8 : 6;

        const roomTerms = {
          living: ['soltech', 'mother', 'premium', 'wohn', 'willow', 'aspect', 'vita', 'grove'],
          office: ['mother', 'soltech', 'regal', 'stand', 'plantspectrum', 'grove'],
          kitchen: ['e27', 'bloom', '7w', '10w', '15w', 'kräuter', 'teleskop'],
          plantroom: ['sansi', 'barrina', 'vivosun', '60w', 'grow', 'station', 'gewächshaus']
        };
        if (this.includes(text, roomTerms[state.room] || [])) score += 4;

        const mountTerms = {
          e27: ['e27', 'par30', 'par38', 'bulb', 'leuchtmittel'],
          shelf: ['regal', 'grove', 'aurora', 'bar', 'tube'],
          pendant: ['pendel', 'pendant', 'wand', 'luna', 'aspect'],
          floor: ['stand', 'standfuß', 'floor', 'willow', 'stello', 'alta', 'teleskop'],
          system: ['station', 'gewächshaus', 'terrarium', 'zelt', 'regal']
        };
        if (state.mount !== 'open' && this.includes(text, mountTerms[state.mount] || [])) score += 5;

        if (state.light === 'supplement') {
          if (watts > 0 && watts <= 15) score += 4;
          if (this.includes(text, ['7w', '10w', '15w', 'e27', 'teleskop'])) score += 2;
        }
        if (state.light === 'balanced') {
          if (watts >= 10 && watts <= 35) score += 4;
          if (this.includes(text, ['20w', '24w', '25w', '32'])) score += 2;
        }
        if (state.light === 'intensive') {
          if (watts >= 25) score += 5;
          if (this.includes(text, ['36w', '60w', 'station', 'gewächshaus', 'plantspectrum32'])) score += 3;
        }

        if (state.project === 'habitat' && this.includes(text, ['terrarium', 'aquascap', 'wasserpflanz'])) score += 4;
        if (state.project === 'station' && this.includes(text, ['regal', 'station', 'gewächshaus'])) score += 4;
        if (state.room === 'living' && this.includes(text, ['growzelt', 'vivosun'])) score -= 4;

        return score;
      }

      update() {
        if (!this.form || !this.cards.length) return;

        const state = {
          room: this.value('room'),
          project: this.value('project'),
          mount: this.value('mount'),
          light: this.value('light'),
          budget: this.value('budget')
        };
        const budget = state.budget === 'open' ? Infinity : Number(state.budget || 150);

        const ranked = this.cards
          .map((card) => ({
            card,
            score: this.score(card, state),
            price: Number(card.dataset.price || 0)
          }))
          .sort((a, b) => b.score - a.score || a.price - b.price);

        let eligible = ranked.filter((item) => item.price <= budget && item.score > 0);
        let relaxed = false;

        if (eligible.length === 0) {
          eligible = ranked.filter((item) => item.score > 0);
          relaxed = true;
        }
        if (eligible.length === 0) eligible = ranked;

        const top = eligible.slice(0, 4);
        const selected = new Set(top.map((item) => item.card));

        this.cards.forEach((card) => {
          card.hidden = !selected.has(card);
        });
        top.forEach((item) => this.results?.append(item.card));

        const projectLabel = this.label('project');
        const roomLabel = this.label('room');
        if (this.profileTitle) this.profileTitle.textContent = [projectLabel, roomLabel].filter(Boolean).join(' · ');
        if (this.profileCopy) this.profileCopy.textContent = this.dataset.profileCopy || '';

        if (this.profileChips) {
          this.profileChips.replaceChildren();
          ['mount', 'light', 'budget'].forEach((name) => {
            const text = this.label(name);
            if (!text) return;
            const chip = document.createElement('span');
            chip.textContent = text;
            this.profileChips.append(chip);
          });
        }

        if (this.resultCount) {
          this.resultCount.textContent = top.length === 1
            ? (this.dataset.resultOne || '1')
            : `${top.length} ${this.dataset.resultMany || ''}`.trim();
        }

        if (this.budgetNote) {
          this.budgetNote.hidden = !relaxed;
          this.budgetNote.textContent = relaxed ? (this.dataset.budgetRelaxed || '') : '';
        }
      }

      reset() {
        if (!this.form) return;
        this.form.reset();
        this.update();
      }
    }

    if (!customElements.get('interieur-solutions-configurator')) {
      customElements.define('interieur-solutions-configurator', InterieurSolutionsConfigurator);
    }
  {% endjavascript %}
{% endif %}
