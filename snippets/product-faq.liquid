{%- comment -%}
  All current product JSON templates render product-seo-details, which owns the
  visible FAQ block. Do not repeat it beside the purchase form.
  For a future template without product-seo-details, opt in with standalone: true.
{%- endcomment -%}
{%- if standalone -%}
  {%- capture faq_markup -%}{%- render 'product-faq-entries', product: product -%}{%- endcapture -%}
  {%- assign faq_markup = faq_markup | strip -%}
  {%- if faq_markup != blank -%}
    <section class="product-seo-details__faq">
      <h2>{% if request.locale.iso_code == 'de' %}Häufige Fragen{% else %}Frequently asked questions{% endif %}</h2>
      <div class="product-seo-details__faq-list">{{ faq_markup }}</div>
    </section>
  {%- endif -%}
{%- endif -%}
