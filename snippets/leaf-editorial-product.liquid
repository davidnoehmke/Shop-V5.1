{% liquid
assign selected_variant = product.selected_or_first_available_variant
assign intro = product.metafields.leafer.intro.value | default: product.description | strip_html | truncatewords: 55
assign form_id = 'Editorial-' | append: section_id | append: '-' | append: product.id
%}
<article class="leaf-editorial" id="Product-{{ section_id }}-{{ product.id }}">
<div class="leaf-editorial__media"><a href="{{ product.url }}">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1200 | image_tag: widths: '360,540,760,960,1200', sizes: '(min-width: 761px) 45vw, 94vw', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a></div>
<div class="leaf-editorial__content">
<p>{{ product.type | default: product.vendor | escape }}</p><h2><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
{% if intro != blank %}<p>{{ intro | escape }}</p>{% endif %}
{% if product.metafields.leafer.suitable_for.value != blank %}<p>{{ product.metafields.leafer.suitable_for.value | escape }}</p>{% endif %}
{% form 'product', product, id: form_id, class: 'leaf-editorial__form' %}
{% if product.variants.size > 1 %}
<label for="Variant-{{ form_id }}">{% if request.locale.iso_code == 'en' %}Choose option{% else %}Variante wählen{% endif %}</label>
<select id="Variant-{{ form_id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == selected_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }} · {{ variant.price | money }}{% unless variant.available %} · {% if request.locale.iso_code == 'en' %}Unavailable{% else %}Nicht verfügbar{% endif %}{% endunless %}</option>{% endfor %}</select>
{% else %}<input type="hidden" name="id" value="{{ selected_variant.id }}">{% endif %}
<div class="leaf-editorial__purchase"><strong>{% if product.price_varies %}{% if request.locale.iso_code == 'en' %}From{% else %}Ab{% endif %} {% endif %}{{ product.price_min | money }}</strong><button type="submit"{% unless product.available %} disabled{% endunless %}>{% if product.available %}{% if request.locale.iso_code == 'en' %}Add to cart{% else %}In den Warenkorb{% endif %}{% else %}{% if request.locale.iso_code == 'en' %}Sold out{% else %}Ausverkauft{% endif %}{% endif %}</button></div>
{% endform %}
<a href="{{ product.url }}">{% if request.locale.iso_code == 'en' %}Product details and suitability{% else %}Produktdetails und Eignung{% endif %} →</a>
</div></article>