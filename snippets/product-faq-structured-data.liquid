{%- if product != blank -%}
  {%- capture faq_entities -%}{%- render 'product-faq-entries', product: product, format: 'json' -%}{%- endcapture -%}
  {%- assign faq_entities = faq_entities | strip -%}
  {%- if faq_entities != blank -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_entities }}]}</script>
  {%- endif -%}
{%- endif -%}
