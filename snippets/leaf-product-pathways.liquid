{% doc %}
  Links to up to two existing guides for the current product category.
  @param {product} product - Current product.
{% enddoc %}
{%- capture product_kind -%}{%- render 'leaf-product-kind', product: product -%}{%- endcapture -%}
{%- liquid
  assign candidates = ''
  case product_kind
    when 'light'
      assign candidates = 'pflanzenlampe-watt-ppf-ppfd-abstand-flaeche|e27-t8-high-power-pflanzenlampe-vergleich'
    when 'mix'
      assign candidates = 'leafers-substrate-nice2know|substratbestandteile-perlite-bims-lava-erklaert'
    when 'component'
      assign candidates = 'substratbestandteile-perlite-bims-lava-erklaert'
      if product.handle == 'leaferbims-premium-bims' or product.handle == 'leaferperlite-premium-perlite'
        assign candidates = 'bims-oder-perlit-unterschiede-pflanzsubstrat|substratbestandteile-perlite-bims-lava-erklaert'
      endif
    when 'plant'
      assign candidates = 'interieur-begruenung-led-gefaess-substrat-pflanzen'
  endcase
  assign guide_handles = candidates | split: '|' | uniq
-%}
{%- capture guide_links -%}
  {%- for guide_handle in guide_handles limit: 2 -%}
    {%- unless guide_handle == blank -%}
      {%- liquid
        assign guide_key = 'leafers-nice2know-blog/' | append: guide_handle
        assign guide = articles[guide_key]
        assign guide_url = guide.url
        assign url_start = guide_url | slice: 0, 7
        if routes.root_url != '/' and url_start == '/blogs/'
          assign guide_url = routes.root_url | append: guide_url
        endif
      -%}
      {%- if guide != blank and guide.url != blank and guide.published_at != blank -%}
        <a href="{{ guide_url | escape }}"><span>{{ guide.title | escape }}</span><span aria-hidden="true">→</span></a>
      {%- endif -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if guide_links != blank -%}
  <nav class="leaf-product-pathways" aria-label="{{ 'product.content.guides' | t }}">
    <h3>{{ 'product.content.guides' | t }}</h3>
    <div class="leaf-product-pathways__links">{{ guide_links }}</div>
  </nav>
{%- endif -%}
{% stylesheet %}
  .leaf-product-pathways { margin-top: 1.8rem; padding-top: 1.2rem; border-top: 1px solid var(--border); }
  .leaf-product-pathways h3 { margin: 0 0 .6rem; font-size: 1.05rem; }
  .leaf-product-pathways__links { display: grid; gap: .25rem; }
  .leaf-product-pathways__links a { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 48px; padding-block: .6rem; color: var(--text); text-underline-offset: .2em; font-size: .9rem; }
  .leaf-product-pathways__links a:hover { color: var(--accent); }
  .leaf-product-pathways__links a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
{% endstylesheet %}
